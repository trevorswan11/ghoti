import std;

test "compile-time concatenation" {
    constexpr combined := "a" ++ "b" ++ "c";
    @expect(std.mem.eql(u8, combined, "abc"));
}

const plain: [2]u8 = .{ 1, 2 };

test "concatenation takes its sentinel from the right operand only" {
    constexpr rhs_has_sentinel := plain ++ "cd";
    @expect(@bitSizeOf(@typeOf(rhs_has_sentinel)) == @bitSizeOf([4:0]u8));
    constexpr rhs_has_none := "ab" ++ plain;
    @expect(@bitSizeOf(@typeOf(rhs_has_none)) == @bitSizeOf([4]u8));
}
