const Shape := interface {
    pub const area := fn(&self): i32;
    pub const scaled := fn(&self, k: i32): i32 {
        return self.area() * k;
    };
};

const Box := struct { w: i32, h: i32 };

impl Shape for Box {
    pub const area := fn(&self): i32 {
        return self.w * self.h;
    };
}

const total := fn(s: ^dyn Shape): i32 {
    return s.area() + s.scaled(2);
};

pub const main := fn(): i32 {
    var b := Box{ .w = 3, .h = 4 };
    return total(^b);
};
