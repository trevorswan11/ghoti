pub const Array := fn(T: type, comptime n: usize): type {
    return [n]T;
};

pub const main := fn(): i32 {
    let mut arr: Array(i32, 4) = .{ 1, 2, 3, 4 };
    let sum := blk: {
        let mut acc: i32 = 0;
        for (arr) |a| {
            acc += a;
        };
        break :blk acc;
    };
    return sum;
};
