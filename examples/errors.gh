import std;

pub const main = fn(args: [][:0]u8): std.Result(i32, std.fmt.Error) {
    if (args.len <= 1) {
        std.io.eprintln("Expected at least 1 arg")!;
        return .of(1);
    }

    // This will print the error name on failure through an error path
    errdefer |e| std.io.eprintln("{}", e)!;

    // `std.fmt.Error` is `std.io.Error || enum { ... }` so io errors are a subset of it
    let mut file: std.io.File = .open(args[1], .{})?;
    defer file.close();

    let mut buf: [4096]mut u8 = undefined;
    loop {
        // Match patterms can branch based on captures
        match (file.read(buf)) {
            .ok(0) => break, // This must come before the next |n| branch
            .ok(|n|) => std.io.print("{}", buf[0..n])?,
            .err(|e|) => return .fail(e), // Will trigger both `errdefer`s and `defer`s
        }
    }

    return .of(0);
};
