import std;

const Point := @Struct(
    builtin.StructInfo{
        .fields = [2]builtin.StructFieldInfo{
            .{ .name = "x", .@"type" = i32, .has_default = false },
            .{ .name = "y", .@"type" = i32, .has_default = false },
            .{ .name = "z", .@"type" = i32, .has_default = true },
        },
        .is_extern = false,
        .is_packed = false,
        .backing_bits = 0,
    },
    1,
);

impl Point {
    pub const sum := fn(self): i32 {
        return self.x + self.y + self.z;
    };
}

test "Type creation" {
    const p: Point = .{ .x = 2, .y = 9 };
    @expect(p.sum() == 12);
}
