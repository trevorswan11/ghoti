import std;

const Point := @Struct(
    .{
        .fields = ^.{
            .{ .name = "x", .@"type" = i32 },
            .{ .name = "y", .@"type" = i32 },
            .{ .name = "z", .@"type" = i32, .default_value = @ptrCast(^opaque, ^1) },
        },
        .is_extern = false,
        .is_packed = false,
        .backing_bits = 0,
    },
);

impl Point {
    pub const sum := fn(self): i32 {
        return self.x + self.y + self.z;
    };
}

test "Type creation" {
    const p: Point = .{ .x = 2, .y = 9 };
    @expect(p.sum() == 12);
}
