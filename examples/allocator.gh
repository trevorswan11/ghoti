import std;

pub const main = fn(): std.Result(i32, std.mem.AllocError) {
    errdefer |e| {
        std.io.eprintln(@tagName(e))!;
    }

    let allocator = std.heap.page_allocator;
    let mem = allocator.alloc(i32, 10)?;
    defer allocator.free(mem);

    for (mem, 0..) |&mut v, i| {
        v = @intCast(i32, i);
    }

    let mut acc: i32 = 0;
    for (mem) |v| {
        acc += v;
    };
    return .of(acc);
};
