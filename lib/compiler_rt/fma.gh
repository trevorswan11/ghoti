import std;
import "compiler_rt.gh" as compiler_rt;

const math = std.math;
const symbol = compiler_rt.symbol;

comptime {
    symbol(__fmah, "__fmah");
    symbol(fmaf, "fmaf");
    symbol(fma, "fma");
    symbol(__fmax, "__fmax");
    symbol(fmaq, "fmaf128");
    symbol(fmal, "fmal");

    @cfg (compiler_rt.is_windows_msvc) {
        symbol(fmaf64x, "fmaf64x");
    }
}

const __fmah = fn(x: f16, y: f16, z: f16) callconv(.c): f16 {
    return fma_f16(x, y, z);
};

pub const fma_f16 = fn(x: f16, y: f16, z: f16): f16 {
    // TODO: more efficient implementation
    return @floatCast(fma_f32(@floatCast(x), @floatCast(y), @floatCast(z)));
};

const fmaf = fn(x: f32, y: f32, z: f32) callconv(.c): f32 {
    return fma_f32(x, y, z);
};

pub const fma_f32 = fn(x: f32, y: f32, z: f32): f32 {
    let xy = @as(f64, x) * @as(f64, y);
    let xy_z = xy + @as(f64, z);
    let u: u64 = @bitCast(xy_z);
    let e = (u >> 52) & 0x7ff;

    if ((u & 0x1fffffff) != 0x10000000 or e == 0x7ff or
        (xy_z - xy == @as(f64, z) and xy_z - @as(f64, z) == xy)) {
        return @floatCast(xy_z);
    } else {
        // Correct double rounding at an f32 midpoint.
        let negative = (u >> 63) != 0;
        let err = if (negative == (@as(f64, z) > xy)) xy - xy_z + @as(f64, z)
            else @as(f64, z) - xy_z + xy;
        return @floatCast(@bitCast(f64, if (negative == (err < 0.0)) u + 1 else u - 1));
    }
};

const fma = fn(x: f64, y: f64, z: f64) callconv(.c): f64 {
    return fma_f64(x, y, z);
};

/// NOTE: Upstream fma.c has been rewritten completely to raise fp exceptions more accurately.
pub const fma_f64 = fn(x: f64, y: f64, z: f64): f64 {
    if (!math.is_finite(x) or !math.is_finite(y)) {
        return x * y + z;
    }
    if (!math.is_finite(z)) {
        return z;
    }
    if (x == 0.0 or y == 0.0) {
        return x * y + z;
    }
    if (z == 0.0) {
        return x * y;
    }

    let x1 = math.frexp(x);
    let ex = x1.exponent;
    let xs = x1.significand;
    let x2 = math.frexp(y);
    let ey = x2.exponent;
    let ys = x2.significand;
    let x3 = math.frexp(z);
    let ez = x3.exponent;
    let mut zs = x3.significand;

    let mut spread = ex + ey - ez;
    if (spread < -53) return z;
    if (spread <= 53 * 2) {
        zs = math.scalbn(zs, -spread);
    } else {
        zs = math.copysign(math.float_min(f64), zs);
    }

    let xy = dd_mul(xs, ys);
    let r = dd_add(xy.hi, zs);
    spread = ex + ey;

    if (r.hi == 0.0) {
        return if (xy.lo == 0.0) xy.hi + zs else math.scalbn(xy.lo, spread);
    }

    let adj = add_adjusted(r.lo, xy.lo);
    if (spread + math.ilogb(r.hi) > -1023) {
        return math.scalbn(r.hi + adj, spread);
    } else {
        return add_and_denorm(r.hi, adj, spread);
    }
};

@cfg (compiler_rt.is_windows_msvc) {
    const fmaf64x = fn(a: f80, b: f80, c: f80) callconv(.c): f80 {
        return fma_f80(a, b, c);
    };
}

const __fmax = fn(a: u80, b: u80, c: u80) callconv(.c): u80 {
    return @bitCast(fma_f80(@bitCast(a), @bitCast(b), @bitCast(c)));
};

pub const fma_f80 = fn(a: f80, b: f80, c: f80): f80 {
    // TODO: more efficient implementation
    return @floatCast(fma_f128(@floatCast(a), @floatCast(b), @floatCast(c)));
};

const fmaq = fn(x: f128, y: f128, z: f128) callconv(.c): f128 {
    return fma_f128(x, y, z);
};

/// Fused multiply-add: Compute x * y + z with a single rounding error.
///
/// We use scaling to avoid overflow/underflow, along with the
/// canonical precision-doubling technique adapted from:
///
///      Dekker, T.  A Floating-Point Technique for Extending the
///      Available Precision.  Numer. Math. 18, 224-242 (1971).
pub const fma_f128 = fn(x: f128, y: f128, z: f128): f128 {
    if (!math.is_finite(x) or !math.is_finite(y)) {
        return x * y + z;
    }
    if (!math.is_finite(z)) {
        return z;
    }
    if (x == 0.0 or y == 0.0) {
        return x * y + z;
    }
    if (z == 0.0) {
        return x * y;
    }

    let x1 = math.frexp(x);
    let ex = x1.exponent;
    let xs = x1.significand;
    let x2 = math.frexp(y);
    let ey = x2.exponent;
    let ys = x2.significand;
    let x3 = math.frexp(z);
    let ez = x3.exponent;
    let mut zs = x3.significand;

    let mut spread = ex + ey - ez;
    if (spread < -113) return z;
    if (spread <= 113 * 2) {
        zs = math.scalbn(zs, -spread);
    } else {
        zs = math.copysign(math.float_min(f128), zs);
    }

    let xy = dd_mul128(xs, ys);
    let r = dd_add128(xy.hi, zs);
    spread = ex + ey;

    if (r.hi == 0.0) {
        return if (xy.lo == 0.0) xy.hi + zs else math.scalbn(xy.lo, spread);
    }

    let adj = add_adjusted128(r.lo, xy.lo);
    if (spread + math.ilogb(r.hi) > -16383) {
        return math.scalbn(r.hi + adj, spread);
    } else {
        return add_and_denorm128(r.hi, adj, spread);
    }
};

pub const fmal = fn(x: c_longdouble, y: c_longdouble, z: c_longdouble) callconv(.c): c_longdouble {
    return match comptime (@typeInfo(c_longdouble).float.bits) {
        64 => fma_f64(x, y, z),
        80 => fma_f80(x, y, z),
        128 => fma_f128(x, y, z),
        _ => unreachable,
    };
};

const dd = struct {
    hi: f64,
    lo: f64,
};

const dd_add = fn(a: f64, b: f64): dd {
    let mut ret: dd = undefined;
    ret.hi = a + b;
    let s = ret.hi - a;
    ret.lo = (a - (ret.hi - s)) + (b - s);
    return ret;
};

const dd_mul = fn(a: f64, b: f64): dd {
    let mut ret: dd = undefined;
    const split: f64 = 0x1.0p27 + 1.0;

    let mut p = a * split;
    let mut ha = a - p;
    ha += p;
    let la = a - ha;

    p = b * split;
    let mut hb = b - p;
    hb += p;
    let lb = b - hb;

    p = ha * hb;
    let q = ha * lb + la * hb;

    ret.hi = p + q;
    ret.lo = p - ret.hi + q + la * lb;
    return ret;
};

const add_adjusted = fn(a: f64, b: f64): f64 {
    let mut sum = dd_add(a, b);
    if (sum.lo != 0.0) {
        let mut uhii: u64 = @bitCast(u64, sum.hi);
        if (uhii & 1 == 0) {
            // hibits += copysign(1.0, sum.hi, sum.lo)
            let uloi: u64 = @bitCast(u64, sum.lo);
            uhii = uhii +% 1 -% ((uhii ^ uloi) >> 62);
            sum.hi = @bitCast(f64, uhii);
        }
    }
    return sum.hi;
};

const add_and_denorm = fn(a: f64, b: f64, scale: i32): f64 {
    let mut sum = dd_add(a, b);
    if (sum.lo != 0.0) {
        let mut uhii: u64 = @bitCast(u64, sum.hi);
        let bits_lost = -@intCast(i32, (uhii >> 52) & 0x7ff) - scale + 1;
        if ((bits_lost != 1) != (uhii & 1 != 0)) {
            let uloi: u64 = @bitCast(u64, sum.lo);
            uhii = uhii +% 1 -% (((uhii ^ uloi) >> 62) & 2);
            sum.hi = @bitCast(f64, uhii);
        }
    }
    return math.scalbn(sum.hi, scale);
};

/// A struct that represents a floating-point number with twice the precision
/// of f128. We maintain the invariant that "hi" stores the high-order
/// bits of the result.
const dd128 = struct {
    hi: f128,
    lo: f128,
};

/// Compute a+b exactly, returning the exact result in a struct dd128. We assume
/// that both a and b are finite, but make no assumptions about their relative
/// magnitudes.
const dd_add128 = fn(a: f128, b: f128): dd128 {
    let mut ret: dd128 = undefined;
    ret.hi = a + b;
    let s = ret.hi - a;
    ret.lo = (a - (ret.hi - s)) + (b - s);
    return ret;
};

/// Compute a+b, with a small tweak: The least significant bit of the
/// result is adjusted into a sticky bit summarizing all the bits that
/// were lost to rounding. This adjustment negates the effects of double
/// rounding when the result is added to another number with a higher
/// exponent. For an explanation of round and sticky bits, see any reference
/// on FPU design, e.g.,
///
///     J. Coonen. An Implementation Guide to a Proposed Standard for
///     Floating-Point Arithmetic. Computer, vol. 13, no. 1, Jan 1980.
const add_adjusted128 = fn(a: f128, b: f128): f128 {
    let mut sum = dd_add128(a, b);
    if (sum.lo != 0.0) {
        let mut uhii: u128 = @bitCast(sum.hi);
        if (uhii & 1 == 0) {
            // hibits += copysign(1.0, sum.hi, sum.lo)
            let uloi: u128 = @bitCast(sum.lo);
            uhii = uhii +% 1 -% ((uhii ^ uloi) >> 126);
            sum.hi = @bitCast(f128, uhii);
        }
    }
    return sum.hi;
};

/// Compute ldexp(a+b, scale) with a single rounding error. It is assumed
/// that the result will be subnormal, and care is taken to ensure that
/// double rounding does not occur.
const add_and_denorm128 = fn(a: f128, b: f128, scale: i32): f128 {
    let mut sum = dd_add128(a, b);
    // If we are losing at least two bits of accuracy to denormalization,
    // then the first lost bit becomes a round bit, and we adjust the
    // lowest bit of sum.hi to make it a sticky bit summarizing all the
    // bits in sum.lo. With the sticky bit adjusted, the hardware will
    // break any ties in the correct direction.
    //
    // If we are losing only one bit to denormalization, however, we must
    // break the ties manually.
    if (sum.lo != 0.0) {
        let mut uhii: u128 = @bitCast(sum.hi);
        let bits_lost = -@intCast(i32, (uhii >> 112) & 0x7fff) - scale + 1;
        if ((bits_lost != 1) != (uhii & 1 != 0)) {
            let uloi: u128 = @bitCast(sum.lo);
            uhii = uhii +% 1 -% (((uhii ^ uloi) >> 126) & 2);
            sum.hi = @bitCast(f128, uhii);
        }
    }
    return math.scalbn(sum.hi, scale);
};

/// Compute a*b exactly, returning the exact result in a struct dd128. We assume
/// that both a and b are normalized, so no underflow or overflow will occur.
/// The current rounding mode must be round-to-nearest.
const dd_mul128 = fn(a: f128, b: f128): dd128 {
    let mut ret: dd128 = undefined;
    const split: f128 = 0x1.0p57 + 1.0;

    let mut p = a * split;
    let mut ha = a - p;
    ha += p;
    let la = a - ha;

    p = b * split;
    let mut hb = b - p;
    hb += p;
    let lb = b - hb;

    p = ha * hb;
    let q = ha * lb + la * hb;

    ret.hi = p + q;
    ret.lo = p - ret.hi + q + la * lb;
    return ret;
};

test "fma16" {
    const epsilon: f16 = 0.001;

    @expect(math.approx_eq_abs(f16, fma_f16(0.0, 5.0, 9.124), 9.124, epsilon));
    @expect(math.approx_eq_abs(f16, fma_f16(0.2, 5.0, 9.124), 10.124, epsilon));
    @expect(math.approx_eq_abs(f16, fma_f16(1.5, 5.0, 9.124), 16.624, epsilon));
}

test "fma32" {
    const epsilon = 0.000001;

    @expect(math.approx_eq_abs(f32, fma_f32(0.0, 5.0, 9.124), 9.124, epsilon));
    @expect(math.approx_eq_abs(f32, fma_f32(0.2, 5.0, 9.124), 10.124, epsilon));
    @expect(math.approx_eq_abs(f32, fma_f32(0.8923, 5.0, 9.124), 13.5855, epsilon));
    @expect(math.approx_eq_abs(f32, fma_f32(1.5, 5.0, 9.124), 16.624, epsilon));
    @expect(math.approx_eq_abs(f32, fma_f32(37.45, 5.0, 9.124), 196.374004, epsilon));
    @expect(math.approx_eq_abs(f32, fma_f32(89.123, 5.0, 9.124), 454.739005, epsilon));
    @expect(math.approx_eq_abs(f32, fma_f32(123123.234375, 5.0, 9.124), 615625.295875, epsilon));

    // Avoid double rounding when the f64 sum lands on an f32 midpoint.
    @expect(@bitCast(u32, fma_f32(0x1.000002p0, 1.5, -0x1p-60)) == 0x3fc00001);
}

test "fma64" {
    const epsilon = 0.000001;

    @expect(math.approx_eq_abs(f64, fma_f64(0.0, 5.0, 9.124), 9.124, epsilon));
    @expect(math.approx_eq_abs(f64, fma_f64(0.2, 5.0, 9.124), 10.124, epsilon));
    @expect(math.approx_eq_abs(f64, fma_f64(0.8923, 5.0, 9.124), 13.5855, epsilon));
    @expect(math.approx_eq_abs(f64, fma_f64(1.5, 5.0, 9.124), 16.624, epsilon));
    @expect(math.approx_eq_abs(f64, fma_f64(37.45, 5.0, 9.124), 196.374, epsilon));
    @expect(math.approx_eq_abs(f64, fma_f64(89.123, 5.0, 9.124), 454.739, epsilon));
    @expect(math.approx_eq_abs(f64, fma_f64(123123.234375, 5.0, 9.124), 615625.295875, epsilon));

    // Special operands.
    @expect(math.is_nan(fma_f64(math.inf(f64), 0.0, 1.0)));
    @expect(math.is_nan(fma_f64(math.inf(f64), 1.0, -math.inf(f64))));
    @expect(fma_f64(2.0, 3.0, math.inf(f64)) == math.inf(f64));
    @expect(fma_f64(math.float_max(f64), 2.0, 0.0) == math.inf(f64));
    @expect(math.is_nan(fma_f64(math.nan(f64), 1.0, 1.0)));

    // Addend dominates product.
    @expect(fma_f64(-0.6, math.float_true_min(f64), -1.438e308) == -1.438e308);
    @expect(fma_f64(0x1p-600, 0x1p-600, 1.0) == 1.0);
    @expect(
        fma_f64(math.float_true_min(f64), math.float_true_min(f64), math.float_max(f64)) ==
            math.float_max(f64),
    );

    // Subnormal result is rounded once.
    @expect(@bitCast(
        u64,
        fma_f64(
            @bitCast(f64, 0xbbbcae314558d732u64),
            @bitCast(f64, 0x843d607d0e518063u64),
            @bitCast(f64, 0x800000ba24d8f3bau64),
        ),
    ) == 0x000d2971831e2f43);
    @expect(@bitCast(
        u64,
        fma_f64(
            @bitCast(f64, 0x2af4b8a2ad5294f0u64),
            @bitCast(f64, 0x14ef6dd2b62857c2u64),
            @bitCast(f64, 0x000000248ff787f4u64),
        ),
    ) == 0x000516a34ce113eb);
    @expect(@bitCast(
        u64,
        fma_f64(
            @bitCast(f64, 0x3e81368dcd4cb557u64),
            @bitCast(f64, 0x817514ce659bdad8u64),
            @bitCast(f64, 0x800075cba3b3043cu64),
        ),
    ) == 0x800bccc9d0e68a53u64);

    // Sign of zero.
    @expect(@bitCast(
        u64,
        fma_f64(
            @bitCast(f64, 0x2001526ce7a829e5u64),
            @bitCast(f64, 0xa00c9ac305fd618au64),
            @bitCast(f64, 0x001ef7cb10a75631u64),
        ),
    ) == 0x8000000000000000u64);
    @expect(!math.signbit(fma_f64(1.0, 1.0, -1.0)));
    @expect(math.signbit(fma_f64(-math.float_true_min(f64), 0.5, 0.0)));
    @expect(math.signbit(fma_f64(-0.0, 1.0, -0.0)));
}

test "fma80" {
    const epsilon: f80 = 0.000001;

    @expect(math.approx_eq_abs(f80, fma_f80(0.0, 5.0, 9.124), 9.124, epsilon));
    @expect(math.approx_eq_abs(f80, fma_f80(0.2, 5.0, 9.124), 10.124, epsilon));
    @expect(math.approx_eq_abs(f80, fma_f80(1.5, 5.0, 9.124), 16.624, epsilon));
}

test "fma128" {
    const epsilon = 0.000001;

    @expect(math.approx_eq_abs(f128, fma_f128(0.0, 5.0, 9.124), 9.124, epsilon));
    @expect(math.approx_eq_abs(f128, fma_f128(0.2, 5.0, 9.124), 10.124, epsilon));
    @expect(math.approx_eq_abs(f128, fma_f128(0.8923, 5.0, 9.124), 13.5855, epsilon));
    @expect(math.approx_eq_abs(f128, fma_f128(1.5, 5.0, 9.124), 16.624, epsilon));
    @expect(math.approx_eq_abs(f128, fma_f128(37.45, 5.0, 9.124), 196.374, epsilon));
    @expect(math.approx_eq_abs(f128, fma_f128(89.123, 5.0, 9.124), 454.739, epsilon));
    @expect(math.approx_eq_abs(f128, fma_f128(123123.234375, 5.0, 9.124), 615625.295875, epsilon));

    // Addend dominates product.
    @expect(fma_f128(-0.6, math.float_true_min(f128), -1.0e4932) == -1.0e4932);
    @expect(@bitCast(
        u128,
        fma_f128(
            @bitCast(f128, 0xa4d80b69452301dd5a3efab045ca0371u128),
            @bitCast(f128, 0x13a5efea97a6ece0f0b24ffab5fcdcb4u128),
            @bitCast(f128, 0x8000f2eb9b403234570b698042da365du128),
        ),
    ) == 0x8000f2eb9b403234570b698042da365du128);

    // Subnormal result is rounded once.
    @expect(@bitCast(
        u128,
        fma_f128(
            @bitCast(f128, 0x2d83ef38da3dc9f883f14ecb887541ceu128),
            @bitCast(f128, 0x123129a960f91ee507caa6a6702fc33eu128),
            @bitCast(f128, 0x0000f5ea6135ffda377d6eff2506556bu128),
        ),
    ) == 0x0000f5ea6135ffda377d6f2322102a7bu128);

    // Sign of zero.
    @expect(@bitCast(
        u128,
        fma_f128(
            @bitCast(f128, 0x1fd32f92b54d7cefc06df6f8521f1bc3u128),
            @bitCast(f128, 0x202bb49b61ca93fdb382f78b6a2a32e2u128),
            @bitCast(f128, 0x8000816f87a4a3a99ed5f1db8e4c0404u128),
        ),
    ) == 0x80000000000000000000000000000000u128);
}

test "fmal" {
    const epsilon: c_longdouble = 0.000001;

    @expect(math.approx_eq_abs(c_longdouble, fmal(0.0, 5.0, 9.124), 9.124, epsilon));
    @expect(math.approx_eq_abs(c_longdouble, fmal(0.2, 5.0, 9.124), 10.124, epsilon));
    @expect(math.approx_eq_abs(c_longdouble, fmal(1.5, 5.0, 9.124), 16.624, epsilon));
}
