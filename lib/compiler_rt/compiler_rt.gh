import std;

import "addf3.gh" as _;

/// Exports `func` with the given name with hidden visitibility and weak linkage
pub const symbol = fn(comptime func: auto, comptime name: [:0]u8): void {
    @cfg (!testing) {
        @export(func, .{ .name = name, .linkage = .weak, .visibility = .hidden });
    } else {
        _ = func;
        _ = name;
    }
};

/// MSVC's linker looks for this symbol in any object that uses floating point
@cfg (os == .windows and abi == .msvc) {
    let mut _fltused: c_int = 1;
}

pub const @"f128" = struct {
    pub const Abi = match comptime (@targetEndian()) {
        .little => extern struct { lo: u64, hi: u64 },
        .big => extern struct { hi: u64, lo: u64 },
    };
    const Repr = packed struct { lo: u64, hi: u64 };

    pub const to_abi = fn(raw: f128): Abi {
        let repr: Repr = @bitCast(raw);
        return .{ .lo = repr.lo, .hi = repr.hi };
    };

    pub const from_abi = fn(abi: Abi): f128 {
        let repr: Repr = .{ .lo = abi.lo, .hi = abi.hi };
        return @bitCast(repr);
    };

    pub const ComplexAbi = ComplexAbiFor(f128, @This());
};

const ComplexAbiFor = fn(Float: type, float: type): type {
    return struct {
        pub const Abi = extern struct { real: float.Abi, imag: float.Abi };

        pub const to_abi = fn(raw: Complex(Float)): Abi {
            return .{ .real = float.to_abi(raw.real), .imag = float.to_abi(raw.imag) };
        };

        pub const from_abi = fn(abi: Abi): Complex(Float) {
            return .{ .real = float.from_abi(abi.real), .imag = float.from_abi(abi.imag) };
        };
    };
};

pub const Complex = fn(Float: type): type {
    return struct { real: Float, imag: Float };
};

pub const normalize = fn(T: type, significand: ^mut auto): i32 {
    const Z = @typeInfo(@TypeOf(significand)).pointer.child;
    const integer_bit = @as(Z, 1) << std.math.float_fractional_bits(T);

    let shift = @clz(*significand) - @clz(integer_bit);
    *significand <<= @as(std.math.Log2Int(Z), @intCast(shift));
    return @as(i32, 1) - shift;
};

@[inline(.always)] pub const fneg = fn(a: auto): @TypeOf(a) {
    comptime @assert(@typeInfo(T) == .float);
    const bits = @typeInfo(@TypeOf(a)).float.bits;
    const U = @Int(.{ .signedness = .unsigned, .bits = bits });
    const sign_bit_mask = @as(U, 1) << (bits - 1);
    const negated = @bitCast(U, a) ^ sign_bit_mask;
    return @bitCast(negated);
};

test {
    import "addf3.gh";
}
