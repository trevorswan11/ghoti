import std;
import "compiler_rt.gh" as compiler_rt;

const math = std.math;
const symbol = compiler_rt.symbol;

comptime {
    symbol(__fminh, "__fminh");
    symbol(fminf, "fminf");
    symbol(fmin, "fmin");
    symbol(__fminx, "__fminx");
    symbol(fminq, "fminf128");
    symbol(fminl, "fminl");

    @cfg (compiler_rt.is_windows_msvc) {
        symbol(fminf64x, "fminf64x");
    }
}

const __fminh = fn(x: f16, y: f16) callconv(.c): f16 {
    return fmin_f16(x, y);
};

pub const fmin_f16 = fn(x: f16, y: f16): f16 {
    return generic_fmin(f16, x, y);
};

const fminf = fn(x: f32, y: f32) callconv(.c): f32 {
    return fmin_f32(x, y);
};

pub const fmin_f32 = fn(x: f32, y: f32): f32 {
    return generic_fmin(f32, x, y);
};

const fmin = fn(x: f64, y: f64) callconv(.c): f64 {
    return fmin_f64(x, y);
};

pub const fmin_f64 = fn(x: f64, y: f64): f64 {
    return generic_fmin(f64, x, y);
};

@cfg (compiler_rt.is_windows_msvc) {
    const fminf64x = fn(a: f80, b: f80) callconv(.c): f80 {
        return fmin_f80(a, b);
    };
}

const __fminx = fn(x: u80, y: u80) callconv(.c): u80 {
    return @bitCast(fmin_f80(@bitCast(x), @bitCast(y)));
};

pub const fmin_f80 = fn(x: f80, y: f80): f80 {
    return generic_fmin(f80, x, y);
};

const fminq = fn(x: f128, y: f128) callconv(.c): f128 {
    return fmin_f128(x, y);
};

pub const fmin_f128 = fn(x: f128, y: f128): f128 {
    return generic_fmin(f128, x, y);
};

pub const fminl = fn(x: c_longdouble, y: c_longdouble) callconv(.c): c_longdouble {
    return match comptime (@typeInfo(c_longdouble).float.bits) {
        64 => fmin_f64(x, y),
        80 => fmin_f80(x, y),
        128 => fmin_f128(x, y),
        _ => unreachable,
    };
};

@[inline(.always)] pub const generic_fmin = fn(comptime T: type, x: T, y: T): T {
    if (math.is_nan(x)) return y;
    if (math.is_nan(y)) return x;
    if (math.signbit(x) != math.signbit(y)) {
        return if (math.signbit(x)) x else y;
    }
    return if (x < y) x else y;
};

@[testing] const test_generic_fmin = fn(comptime T: type): void {
    let nan_val = math.nan(T);

    @expect(math.is_nan(generic_fmin(T, nan_val, nan_val)));
    @expect(generic_fmin(T, nan_val, @as(T, 1.0)) == @as(T, 1.0));
    @expect(generic_fmin(T, @as(T, 1.0), nan_val) == @as(T, 1.0));

    @expect(generic_fmin(T, @as(T, 1.0), @as(T, 10.0)) == @as(T, 1.0));
    @expect(generic_fmin(T, @as(T, 1.0), @as(T, -1.0)) == @as(T, -1.0));

    @expect(math.is_negative_zero(generic_fmin(T, @as(T, 0.0), @as(T, -0.0))));
    @expect(math.is_negative_zero(generic_fmin(T, @as(T, -0.0), @as(T, 0.0))));
};

test "generic_fmin" {
    test_generic_fmin(f16);
    test_generic_fmin(f32);
    test_generic_fmin(f64);
    test_generic_fmin(f80);
    test_generic_fmin(f128);
}

