test "fminl" {
    let nan_val = math.nan(c_longdouble);
    @expect(math.is_nan(fminl(nan_val, nan_val)));
    @expect(fminl(nan_val, 1.0) == 1.0);
    @expect(fminl(1.0, nan_val) == 1.0);
    @expect(fminl(1.0, 10.0) == 1.0);
    @expect(fminl(1.0, -1.0) == -1.0);
}

test "fmin_f16" {
    @expect(fmin_f16(1.0, 2.0) == 1.0);
    @expect(fmin_f16(2.0, 1.0) == 1.0);
    @expect(fmin_f16(math.nan(f16), 1.0) == 1.0);
    @expect(math.is_negative_zero(fmin_f16(0.0, -0.0)));
    @expect(math.is_negative_zero(fmin_f16(-0.0, 0.0)));
}

test "fmin_f32" {
    @expect(fmin_f32(1.0, 2.0) == 1.0);
    @expect(fmin_f32(2.0, 1.0) == 1.0);
    @expect(fmin_f32(math.nan(f32), 1.0) == 1.0);
    @expect(math.is_negative_zero(fmin_f32(0.0, -0.0)));
    @expect(math.is_negative_zero(fmin_f32(-0.0, 0.0)));
}

test "fmin_f64" {
    @expect(fmin_f64(1.0, 2.0) == 1.0);
    @expect(fmin_f64(2.0, 1.0) == 1.0);
    @expect(fmin_f64(math.nan(f64), 1.0) == 1.0);
    @expect(math.is_negative_zero(fmin_f64(0.0, -0.0)));
    @expect(math.is_negative_zero(fmin_f64(-0.0, 0.0)));
}

test "fmin_f80" {
    @expect(fmin_f80(1.0, 2.0) == 1.0);
    @expect(fmin_f80(2.0, 1.0) == 1.0);
    @expect(fmin_f80(math.nan(f80), 1.0) == 1.0);
    @expect(math.is_negative_zero(fmin_f80(0.0, -0.0)));
    @expect(math.is_negative_zero(fmin_f80(-0.0, 0.0)));
}

test "fmin_f128" {
    @expect(fmin_f128(1.0, 2.0) == 1.0);
    @expect(fmin_f128(2.0, 1.0) == 1.0);
    @expect(fmin_f128(math.nan(f128), 1.0) == 1.0);
    @expect(math.is_negative_zero(fmin_f128(0.0, -0.0)));
    @expect(math.is_negative_zero(fmin_f128(-0.0, 0.0)));
}
