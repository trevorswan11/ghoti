//! Ported from:
//!
//! https://codeberg.org/ziglang/zig/src/tag/0.17.1/lib/compiler_rt/truncf.zig
//! https://codeberg.org/ziglang/zig/src/tag/0.17.1/lib/compiler_rt/truncf_test.zig
import std;
import "compiler_rt.gh" as compiler_rt;

const math = std.math;
const symbol = compiler_rt.symbol;

comptime {
    @cfg (compiler_rt.want_aeabi) {
        if (compiler_rt.gnu_f16_abi) {
            // symbol(__aeabi_f2h, "__gnu_f2h_ieee");
        } else {
            // symbol(__aeabi_f2h, "__aeabi_f2h");
        }
        // symbol(__aeabi_d2h, "__aeabi_d2h");
    } else @cfg (compiler_rt.gnu_f16_abi) {
        // symbol(__truncsfhf2, "__gnu_f2h_ieee");
    }
    // symbol(__truncsfhf2, "__truncsfhf2");
    // symbol(__truncdfhf2, "__truncdfhf2");
    symbol(__truncxfhf2, "__truncxfhf2");
    // symbol(__trunctfhf2, "__trunctfhf2");

    @cfg (compiler_rt.want_aeabi) {
        // symbol(__aeabi_d2f, "__aeabi_d2f");
    }
    // symbol(__truncdfsf2, "__truncdfsf2");
    symbol(__truncxfsf2, "__truncxfsf2");
    // symbol(__trunctfsf2, "__trunctfsf2");
    symbol(__truncxfdf2, "__truncxfdf2");
    // symbol(__trunctfdf2, "__trunctfdf2");
    // symbol(__trunctfxf2, "__trunctfxf2");
}

const __truncxfhf2 = fn(a: compiler_rt.f80) callconv(.c): f16 {
    return f16_float_cast_f80(@bitCast(a));
};

@[inline(.always)] const f16_float_cast_f80 = fn(a: f80): f16 {
    return trunc_f80(f16, a);
};

@[testing] const test_f16_float_cast_f80 = fn(a: f80, expected: u16): bool {
    let actual: u16 = @bitCast(f16_float_cast_f80(a));
    return expected == actual;
};

test "f16_float_cast_f80" {
    @expect(test_f16_float_cast_f80(0x1p-24, 0x0001));
    @expect(test_f16_float_cast_f80(0x1.8p-24, 0x0002));
    @expect(test_f16_float_cast_f80(0x1.8p-20, 0x0018));
    @expect(test_f16_float_cast_f80(0x1p-17, 0x0080));
    @expect(test_f16_float_cast_f80(0x1.fep-15, 0x03fc));
}

const __truncxfsf2 = fn(a: compiler_rt.f80) callconv(.c): f32 {
    return f32_float_cast_f80(@bitCast(a));
};

@[inline(.always)] const f32_float_cast_f80 = fn(a: f80): f32 {
    return trunc_f80(f32, a);
};

@[testing] const test_f32_float_cast_f80 = fn(a: f80, expected: u32): bool {
    let actual: u32 = @bitCast(f32_float_cast_f80(a));
    return expected == actual;
};

test "f32_float_cast_f80" {
    @expect(test_f32_float_cast_f80(0x1p-149, 0x00000001));
    @expect(test_f32_float_cast_f80(0x1p-147, 0x00000004));
}

const __truncxfdf2 = fn(a: compiler_rt.f80) callconv(.c): f64 {
    return f64_float_cast_f80(@bitCast(a));
};

@[inline(.always)] const f64_float_cast_f80 = fn(a: f80): f64 {
    return trunc_f80(f64, a);
};

@[testing] const test_f64_float_cast_f80 = fn(a: f80, expected: u64): bool {
    let actual: u64 = @bitCast(f64_float_cast_f80(a));
    return expected == actual;
};

test "f64_float_cast_f80" {
    @expect(test_f64_float_cast_f80(0x1p-1074, 0x0000000000000001));
    @expect(test_f64_float_cast_f80(0x1.8p-1073, 0x0000000000000003));
}

@[inline(.always)] const trunc_f80 = fn(comptime Dst: type, a: f80): Dst {
    const DstRep = @Int(.{ .signedness = .unsigned, .bits = @typeInfo(Dst).float.bits });
    const src_sig_bits = math.float_mantissa_bits(f80) - 1; // -1 for the integer bit
    const dst_sig_bits = math.float_mantissa_bits(Dst);

    const src_exp_bias = 16383;

    const round_mask = (1 << (src_sig_bits - dst_sig_bits)) - 1;
    const halfway = 1 << (src_sig_bits - dst_sig_bits - 1);

    const dst_bits = @typeInfo(Dst).float.bits;
    const dst_exp_bits = dst_bits - dst_sig_bits - 1;
    const dst_inf_exp = (1 << dst_exp_bits) - 1;
    const dst_exp_bias = dst_inf_exp >> 1;

    const underflow = src_exp_bias + 1 - dst_exp_bias;
    const overflow = src_exp_bias + dst_inf_exp - dst_exp_bias;

    const dst_qnan = 1 << (dst_sig_bits - 1);
    const dst_nan_mask = dst_qnan - 1;

    // Break a into a sign and representation of the absolute value
    let mut a_rep: math.f80 = .from_float(a);
    let sign = a_rep.exp & 0x8000;
    a_rep.exp &= 0x7FFF;
    let significand = a_rep.fraction;
    a_rep.fraction &= 0x7FFFFFFFFFFFFFFF;
    let mut abs_result: DstRep = undefined;

    if (a_rep.exp -% underflow < a_rep.exp -% overflow) {
        // The exponent of a is within the range of normal numbers in the
        // destination format.  We can convert by simply right-shifting with
        // rounding and adjusting the exponent.
        abs_result = @as(DstRep, a_rep.exp) << dst_sig_bits;
        abs_result |= @truncate(a_rep.fraction >> (src_sig_bits - dst_sig_bits));
        abs_result -%= @as(DstRep, src_exp_bias - dst_exp_bias) << dst_sig_bits;

        let round_bits = a_rep.fraction & round_mask;
        if (round_bits > halfway) {
            // Round to nearest
            abs_result += 1;
        } else if (round_bits == halfway) {
            // Ties to even
            abs_result += abs_result & 1;
        }
    } else if (a_rep.exp == 0x7FFF and a_rep.fraction != 0) {
        // a is NaN.
        // Conjure the result by beginning with infinity, setting the qNaN
        // bit and inserting the (truncated) trailing NaN field.
        abs_result = @intCast(DstRep, dst_inf_exp) << dst_sig_bits;
        abs_result |= dst_qnan;
        abs_result |= @intCast((a_rep.fraction >> (src_sig_bits - dst_sig_bits)) & dst_nan_mask);
    } else if (a_rep.exp >= overflow) {
        // a overflows to infinity.
        abs_result = @intCast(DstRep, dst_inf_exp) << dst_sig_bits;
    } else {
        // a underflows on conversion to the destination type or is an exact
        // zero.  The result may be a denormal or zero.  Extract the exponent
        // to get the shift amount for the denormalization.
        let shift = src_exp_bias - dst_exp_bias - a_rep.exp + 1;

        // Right shift by the denormalization amount with sticky.
        if (shift > src_sig_bits) {
            abs_result = 0;
        } else {
            let sticky: u1 = @intFromBool(significand << @intCast(src_sig_bits + 1 - shift) != 0);
            let denormalized_significand = (significand >> @intCast(shift)) | sticky;
            abs_result = @intCast(denormalized_significand >> (src_sig_bits - dst_sig_bits));
            let round_bits = denormalized_significand & round_mask;
            if (round_bits > halfway) {
                // Round to nearest
                abs_result += 1;
            } else if (round_bits == halfway) {
                // Ties to even
                abs_result += abs_result & 1;
            }
        }
    }

    @[align(@alignOf(Dst))] let result = abs_result | (@as(DstRep, sign) << (dst_bits - 16));
    return @bitCast(result);
};
