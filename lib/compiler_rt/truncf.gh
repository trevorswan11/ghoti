//! Ported from:
//!
//! https://codeberg.org/ziglang/zig/src/tag/0.17.1/lib/compiler_rt/truncf.zig
//! https://codeberg.org/ziglang/zig/src/tag/0.17.1/lib/compiler_rt/truncf_test.zig
import std;
import "compiler_rt.gh" as compiler_rt;

const math = std.math;
const symbol = compiler_rt.symbol;

comptime {
    @cfg (compiler_rt.want_aeabi) {
        if (compiler_rt.gnu_f16_abi) {
            symbol(__aeabi_f2h, "__gnu_f2h_ieee");
        } else {
            symbol(__aeabi_f2h, "__aeabi_f2h");
        }
        symbol(__aeabi_d2h, "__aeabi_d2h");
    } else @cfg (compiler_rt.gnu_f16_abi) {
        symbol(__truncsfhf2, "__gnu_f2h_ieee");
    }
    symbol(__truncsfhf2, "__truncsfhf2");
    symbol(__truncdfhf2, "__truncdfhf2");
    symbol(__truncxfhf2, "__truncxfhf2");
    symbol(__trunctfhf2, "__trunctfhf2");

    @cfg (compiler_rt.want_aeabi) {
        symbol(__aeabi_d2f, "__aeabi_d2f");
    }
    symbol(__truncdfsf2, "__truncdfsf2");
    symbol(__truncxfsf2, "__truncxfsf2");
    symbol(__trunctfsf2, "__trunctfsf2");
    symbol(__truncxfdf2, "__truncxfdf2");
    // symbol(__trunctfdf2, "__trunctfdf2");
    // symbol(__trunctfxf2, "__trunctfxf2");
}

@cfg (compiler_rt.want_aeabi) {
    const __aeabi_f2h = fn(a: u32) callconv(.aapcs): u16 {
        return @bitCast(f16_float_cast_f32(@bitCast(a)));
    };

    const __aeabi_d2h = fn(a: u64) callconv(.aapcs): u16 {
        return @bitCast(f16_float_cast_f64(@bitCast(a)));
    };

    const __aeabi_d2f = fn(a: f64) callconv(.aapcs): f32 {
        return f32_float_cast_f64(a);
    };
}

@cfg (os == .macos and arch == .x86) {
    // Darwin x86 uses different abi for f16 for some reason
    const __truncsfhf2 = fn(a: f32) callconv(.c): u16 {
        return @bitCast(f16_float_cast_f32(a));
    };

    const __truncdfhf2 = fn(a: f64) callconv(.c): u16 {
        return @bitCast(f16_float_cast_f64(a));
    };
} else {
    const __truncsfhf2 = fn(a: f32) callconv(.c): f16 {
        return f16_float_cast_f32(a);
    };

    const __truncdfhf2 = fn(a: f64) callconv(.c): f16 {
        return f16_float_cast_f64(a);
    };
}

@[inline(.always)] const f16_float_cast_f32 = fn(a: f32): f16 {
    return truncf(f16, f32, a);
};

@[testing] const test_f16_float_cast_f32 = fn(a: u32, expected: u16): bool {
    let actual: u16 = @bitCast(f16_float_cast_f32(@bitCast(a)));
    return actual == expected;
};

test "f16_float_cast_f32" {
    @expect(test_f16_float_cast_f32(0x7fc00000, 0x7e00)); // qNaN
    @expect(test_f16_float_cast_f32(0x7fe00000, 0x7f00)); // sNaN

    @expect(test_f16_float_cast_f32(0, 0)); // 0
    @expect(test_f16_float_cast_f32(0x80000000, 0x8000)); // -0

    @expect(test_f16_float_cast_f32(0x7f800000, 0x7c00)); // inf
    @expect(test_f16_float_cast_f32(0xff800000, 0xfc00)); // -inf

    @expect(test_f16_float_cast_f32(0x477ff000, 0x7c00)); // 65520 -> inf
    @expect(test_f16_float_cast_f32(0xc77ff000, 0xfc00)); // -65520 -> -inf

    @expect(test_f16_float_cast_f32(0x71cc3892, 0x7c00)); // 0x1.987124876876324p+100 -> inf
    @expect(test_f16_float_cast_f32(0xf1cc3892, 0xfc00)); // -0x1.987124876876324p+100 -> -inf

    @expect(test_f16_float_cast_f32(0x38800000, 0x0400)); // normal (min), 2**-14
    @expect(test_f16_float_cast_f32(0xb8800000, 0x8400)); // normal (min), -2**-14

    @expect(test_f16_float_cast_f32(0x477fe000, 0x7bff)); // normal (max), 65504
    @expect(test_f16_float_cast_f32(0xc77fe000, 0xfbff)); // normal (max), -65504

    @expect(test_f16_float_cast_f32(0x477fe100, 0x7bff)); // normal, 65505 -> 65504
    @expect(test_f16_float_cast_f32(0xc77fe100, 0xfbff)); // normal, -65505 -> -65504

    @expect(test_f16_float_cast_f32(0x477fef00, 0x7bff)); // normal, 65519 -> 65504
    @expect(test_f16_float_cast_f32(0xc77fef00, 0xfbff)); // normal, -65519 -> -65504

    @expect(test_f16_float_cast_f32(0x3f802000, 0x3c01)); // normal, 1 + 2**-10
    @expect(test_f16_float_cast_f32(0xbf802000, 0xbc01)); // normal, -1 - 2**-10

    @expect(test_f16_float_cast_f32(0x3eaaa000, 0x3555)); // normal, approx. 1/3
    @expect(test_f16_float_cast_f32(0xbeaaa000, 0xb555)); // normal, approx. -1/3

    @expect(test_f16_float_cast_f32(0x40490fdb, 0x4248)); // normal, 3.1415926535
    @expect(test_f16_float_cast_f32(0xc0490fdb, 0xc248)); // normal, -3.1415926535

    @expect(test_f16_float_cast_f32(0x45cc3892, 0x6e62)); // normal, 0x1.987124876876324p+12

    @expect(test_f16_float_cast_f32(0x3f800000, 0x3c00)); // normal, 1
    @expect(test_f16_float_cast_f32(0x38800000, 0x0400)); // normal, 0x1.0p-14

    @expect(test_f16_float_cast_f32(0x33800000, 0x0001)); // denormal (min), 2**-24
    @expect(test_f16_float_cast_f32(0xb3800000, 0x8001)); // denormal (min), -2**-24

    @expect(test_f16_float_cast_f32(0x387fc000, 0x03ff)); // denormal (max), 2**-14 - 2**-24
    @expect(test_f16_float_cast_f32(0xb87fc000, 0x83ff)); // denormal (max), -2**-14 + 2**-24

    @expect(test_f16_float_cast_f32(0x35800000, 0x0010)); // denormal, 0x1.0p-20
    @expect(test_f16_float_cast_f32(0x33280000, 0x0001)); // denormal, 0x1.5p-25 -> 0x1.0p-24
    @expect(test_f16_float_cast_f32(0x33000000, 0x0000)); // 0x1.0p-25 -> zero
}

@[inline(.always)] const f16_float_cast_f64 = fn(a: f64): f16 {
    return truncf(f16, f64, a);
};

@[testing] const test_f16_float_cast_f64 = fn(a: f64, expected: u16): bool {
    let rep: u16 = @bitCast(f16_float_cast_f64(a));

    if (rep == expected) {
        return true;
    }
    // test other possible NaN representation(signal NaN)
    else if (expected == 0x7e00) {
        if ((rep & 0x7c00) == 0x7c00 and (rep & 0x3ff) > 0) {
            return true;
        }
    }
    return false;
};

@[testing] const test_f16_float_cast_f64_raw = fn(a: u64, expected: u16): bool {
    let actual: u16 = @bitCast(f16_float_cast_f64(@bitCast(a)));
    return actual == expected;
};

test "f16_float_cast_f64" {
    @expect(test_f16_float_cast_f64_raw(0x7ff8000000000000, 0x7e00)); // qNaN
    @expect(test_f16_float_cast_f64_raw(0x7ff0000000008000, 0x7e00)); // NaN

    @expect(test_f16_float_cast_f64_raw(0x7ff0000000000000, 0x7c00)); //inf
    @expect(test_f16_float_cast_f64_raw(0xfff0000000000000, 0xfc00)); // -inf

    @expect(test_f16_float_cast_f64(0.0, 0x0)); // zero
    @expect(test_f16_float_cast_f64_raw(0x80000000 << 32, 0x8000)); // -zero

    @expect(test_f16_float_cast_f64(3.1415926535, 0x4248));
    @expect(test_f16_float_cast_f64(-3.1415926535, 0xc248));

    @expect(test_f16_float_cast_f64(0x1.987124876876324p+1000, 0x7c00));
    @expect(test_f16_float_cast_f64(0x1.987124876876324p+12, 0x6e62));
    @expect(test_f16_float_cast_f64(0x1.0p+0, 0x3c00));
    @expect(test_f16_float_cast_f64(0x1.0p-14, 0x0400));

    // denormal
    @expect(test_f16_float_cast_f64(0x1.0p-20, 0x0010));
    @expect(test_f16_float_cast_f64(0x1.0p-24, 0x0001));
    @expect(test_f16_float_cast_f64(-0x1.0p-24, 0x8001));
    @expect(test_f16_float_cast_f64(0x1.5p-25, 0x0001));

    // and back to zero
    @expect(test_f16_float_cast_f64(0x1.0p-25, 0x0000));
    @expect(test_f16_float_cast_f64(-0x1.0p-25, 0x8000));

    // max (precise)
    @expect(test_f16_float_cast_f64(65504.0, 0x7bff));

    // max (rounded)
    @expect(test_f16_float_cast_f64(65519.0, 0x7bff));

    // max (to +inf)
    @expect(test_f16_float_cast_f64(65520.0, 0x7c00));
    @expect(test_f16_float_cast_f64(-65520.0, 0xfc00));
    @expect(test_f16_float_cast_f64(65536.0, 0x7c00));
}

const __truncxfhf2 = fn(a: compiler_rt.f80) callconv(.c): f16 {
    return f16_float_cast_f80(@bitCast(a));
};

@[inline(.always)] const f16_float_cast_f80 = fn(a: f80): f16 {
    return trunc_f80(f16, a);
};

@[testing] const test_f16_float_cast_f80 = fn(a: f80, expected: u16): bool {
    let actual: u16 = @bitCast(f16_float_cast_f80(a));
    return expected == actual;
};

test "f16_float_cast_f80" {
    @expect(test_f16_float_cast_f80(0x1p-24, 0x0001));
    @expect(test_f16_float_cast_f80(0x1.8p-24, 0x0002));
    @expect(test_f16_float_cast_f80(0x1.8p-20, 0x0018));
    @expect(test_f16_float_cast_f80(0x1p-17, 0x0080));
    @expect(test_f16_float_cast_f80(0x1.fep-15, 0x03fc));
}

const __trunctfhf2 = fn(a: f128) callconv(.c): f16 {
    return truncf(f16, f128, a);
};

@[testing] const test__trunctfhf2 = fn(a: f128, expected: u16): bool {
    let x: u16 = @bitCast(__trunctfhf2(a));
    return x == expected;
};

test "__trunctfhf2" {
    // qNaN
    @expect(test__trunctfhf2(@bitCast(0x7fff8000000000000000000000000000u128), 0x7e00));
    // NaN
    @expect(test__trunctfhf2(@bitCast(0x7fff0000000000000000000000000001u128), 0x7e00));
    // inf
    @expect(test__trunctfhf2(@bitCast(0x7fff0000000000000000000000000000u128), 0x7c00));
    @expect(test__trunctfhf2(-@bitCast(0x7fff0000000000000000000000000000u128), 0xfc00));
    // zero
    @expect(test__trunctfhf2(0.0, 0x0));
    @expect(test__trunctfhf2(-0.0, 0x8000));

    @expect(test__trunctfhf2(3.1415926535, 0x4248));
    @expect(test__trunctfhf2(-3.1415926535, 0xc248));
    @expect(test__trunctfhf2(0x1.987124876876324p+100, 0x7c00));
    @expect(test__trunctfhf2(0x1.987124876876324p+12, 0x6e62));
    @expect(test__trunctfhf2(0x1.0p+0, 0x3c00));
    @expect(test__trunctfhf2(0x1.0p-14, 0x0400));
    // denormal
    @expect(test__trunctfhf2(0x1.0p-20, 0x0010));
    @expect(test__trunctfhf2(0x1.0p-24, 0x0001));
    @expect(test__trunctfhf2(-0x1.0p-24, 0x8001));
    @expect(test__trunctfhf2(0x1.5p-25, 0x0001));
    // and back to zero
    @expect(test__trunctfhf2(0x1.0p-25, 0x0000));
    @expect(test__trunctfhf2(-0x1.0p-25, 0x8000));
    // max (precise)
    @expect(test__trunctfhf2(65504.0, 0x7bff));
    // max (rounded)
    @expect(test__trunctfhf2(65519.0, 0x7bff));
    // max (to +inf)
    @expect(test__trunctfhf2(65520.0, 0x7c00));
    @expect(test__trunctfhf2(65536.0, 0x7c00));
    @expect(test__trunctfhf2(-65520.0, 0xfc00));

    @expect(test__trunctfhf2(0x1.23a2abb4a2ddee355f36789abcdep+5, 0x508f));
    @expect(test__trunctfhf2(0x1.e3d3c45bd3abfd98b76a54cc321fp-9, 0x1b8f));
    @expect(test__trunctfhf2(0x1.234eebb5faa678f4488693abcdefp+453, 0x7c00));
    @expect(test__trunctfhf2(0x1.edcba9bb8c76a5a43dd21f334634p-43, 0x0));
}

const __truncdfsf2 = fn(a: f64) callconv(.c): f32 {
    return f32_float_cast_f64(a);
};

@[inline(.always)] const f32_float_cast_f64 = fn(a: f64): f32 {
    return truncf(f32, f64, a);
};

@[testing] const test_f32_float_cast_f64 = fn(a: f64, expected: u32): bool {
    let x = f32_float_cast_f64(a);

    let rep: u32 = @bitCast(x);
    if (rep == expected) {
        return true;
    }
    // test other possible NaN representation(signal NaN)
    else if (expected == 0x7fc00000) {
        if ((rep & 0x7f800000) == 0x7f800000 and (rep & 0x7fffff) > 0) {
            return true;
        }
    }
    return false;
};

test "f32_float_cast_f64" {
    // nan & qnan
    @expect(test_f32_float_cast_f64(@bitCast(0x7ff8000000000000u64), 0x7fc00000));
    @expect(test_f32_float_cast_f64(@bitCast(0x7ff0000000000001u64), 0x7fc00000));
    // inf
    @expect(test_f32_float_cast_f64(@bitCast(0x7ff0000000000000u64), 0x7f800000));
    @expect(test_f32_float_cast_f64(@bitCast(0xfff0000000000000u64), 0xff800000));

    @expect(test_f32_float_cast_f64(0.0, 0x0));
    @expect(test_f32_float_cast_f64(1.0, 0x3f800000));
    @expect(test_f32_float_cast_f64(-1.0, 0xbf800000));

    // huge number becomes inf
    @expect(test_f32_float_cast_f64(340282366920938463463374607431768211456.0, 0x7f800000));
}

const __truncxfsf2 = fn(a: compiler_rt.f80) callconv(.c): f32 {
    return f32_float_cast_f80(@bitCast(a));
};

@[inline(.always)] const f32_float_cast_f80 = fn(a: f80): f32 {
    return trunc_f80(f32, a);
};

@[testing] const test_f32_float_cast_f80 = fn(a: f80, expected: u32): bool {
    let actual: u32 = @bitCast(f32_float_cast_f80(a));
    return expected == actual;
};

test "f32_float_cast_f80" {
    @expect(test_f32_float_cast_f80(0x1p-149, 0x00000001));
    @expect(test_f32_float_cast_f80(0x1p-147, 0x00000004));
}

const __trunctfsf2 = fn(a: f128) callconv(.c): f32 {
    return truncf(f32, f128, a);
};

@[testing] const test__trunctfsf2 = fn(a: f128, expected: u32): bool {
    let x = __trunctfsf2(a);

    let rep: u32 = @bitCast(x);
    if (rep == expected) {
        return true;
    }
    // test other possible NaN representation(signal NaN)
    else if (expected == 0x7fc00000) {
        if ((rep & 0x7f800000) == 0x7f800000 and (rep & 0x7fffff) > 0) {
            return true;
        }
    }
    return false;
};

test "__trunctfsf2" {
    // qnan
    @expect(test__trunctfsf2(@bitCast(0x7fff800000000000 << 64), 0x7fc00000));
    // nan
    @expect(test__trunctfsf2(
        @bitCast((0x7fff000000000000 | (0x810000000000 & 0xffffffffffff)) << 64),
        0x7fc08000,
    ));
    // inf
    @expect(test__trunctfsf2(@bitCast(0x7fff000000000000 << 64), 0x7f800000));
    // zero
    @expect(test__trunctfsf2(0.0, 0x0));

    @expect(test__trunctfsf2(0x1.23a2abb4a2ddee355f36789abcdep+5, 0x4211d156));
    @expect(test__trunctfsf2(0x1.e3d3c45bd3abfd98b76a54cc321fp-9, 0x3b71e9e2));
    @expect(test__trunctfsf2(0x1.234eebb5faa678f4488693abcdefp+4534, 0x7f800000));
    @expect(test__trunctfsf2(0x1.edcba9bb8c76a5a43dd21f334634p-435, 0x0));
}

const __truncxfdf2 = fn(a: compiler_rt.f80) callconv(.c): f64 {
    return f64_float_cast_f80(@bitCast(a));
};

@[inline(.always)] const f64_float_cast_f80 = fn(a: f80): f64 {
    return trunc_f80(f64, a);
};

@[testing] const test_f64_float_cast_f80 = fn(a: f80, expected: u64): bool {
    let actual: u64 = @bitCast(f64_float_cast_f80(a));
    return expected == actual;
};

test "f64_float_cast_f80" {
    @expect(test_f64_float_cast_f80(0x1p-1074, 0x0000000000000001));
    @expect(test_f64_float_cast_f80(0x1.8p-1073, 0x0000000000000003));
}

@[inline(.always)] const truncf = fn(comptime Dst: type, comptime Src: type, a: Src): Dst {
    const SrcRep = @Int(.{ .signedness = .unsigned, .bits = @typeInfo(Src).float.bits });
    const DstRep = @Int(.{ .signedness = .unsigned, .bits = @typeInfo(Dst).float.bits });
    const src_sig_bits = math.float_mantissa_bits(Src);
    const dst_sig_bits = math.float_mantissa_bits(Dst);

    const src_bits = @typeInfo(Src).float.bits;
    const src_exp_bits = src_bits - src_sig_bits - 1;
    const src_inf_exp = (1 << src_exp_bits) - 1;
    const src_exp_bias = src_inf_exp >> 1;

    const src_min_normal = 1 << src_sig_bits;
    const src_significand_mask = src_min_normal - 1;
    const src_infinity = src_inf_exp << src_sig_bits;
    const src_sign_mask = 1 << (src_sig_bits + src_exp_bits);
    const src_abs_mask = src_sign_mask - 1;
    const round_mask = (1 << (src_sig_bits - dst_sig_bits)) - 1;
    const halfway = 1 << (src_sig_bits - dst_sig_bits - 1);
    const src_qnan = 1 << (src_sig_bits - 1);
    const src_nan_code = src_qnan - 1;

    const dst_bits = @typeInfo(Dst).float.bits;
    const dst_exp_bits = dst_bits - dst_sig_bits - 1;
    const dst_inf_exp = (1 << dst_exp_bits) - 1;
    const dst_exp_bias = dst_inf_exp >> 1;

    const underflow_exponent = src_exp_bias + 1 - dst_exp_bias;
    const overflow_exponent = src_exp_bias + dst_inf_exp - dst_exp_bias;
    const underflow = underflow_exponent << src_sig_bits;
    const overflow = overflow_exponent << src_sig_bits;

    const dst_qnan = 1 << (dst_sig_bits - 1);
    const dst_nan_code = dst_qnan - 1;

    // Break a into a sign and representation of the absolute value
    let a_rep: SrcRep = @bitCast(a);
    let a_abs: SrcRep = a_rep & src_abs_mask;
    let sign: SrcRep = a_rep & src_sign_mask;
    let mut abs_result: DstRep = undefined;

    if (a_abs -% underflow < a_abs -% overflow) {
        // The exponent of a is within the range of normal numbers in the
        // destination format. We can convert by simply right-shifting with
        // rounding and adjusting the exponent.
        abs_result = @truncate(a_abs >> (src_sig_bits - dst_sig_bits));
        abs_result -%= @as(DstRep, src_exp_bias - dst_exp_bias) << dst_sig_bits;

        let round_bits: SrcRep = a_abs & round_mask;
        if (round_bits > halfway) {
            // Round to nearest
            abs_result += 1;
        } else if (round_bits == halfway) {
            // Ties to even
            abs_result += abs_result & 1;
        }
    } else if (a_abs > src_infinity) {
        // a is NaN.
        // Conjure the result by beginning with infinity, setting the qNaN
        // bit and inserting the (truncated) trailing NaN field.
        abs_result = @intCast(DstRep, dst_inf_exp) << dst_sig_bits;
        abs_result |= dst_qnan;
        abs_result |=
            @intCast(((a_abs & src_nan_code) >> (src_sig_bits - dst_sig_bits)) & dst_nan_code);
    } else if (a_abs >= overflow) {
        // a overflows to infinity.
        abs_result = @intCast(DstRep, dst_inf_exp) << dst_sig_bits;
    } else {
        // a underflows on conversion to the destination type or is an exact
        // zero. The result may be a denormal or zero. Extract the exponent
        // to get the shift amount for the denormalization.
        let a_exp: u32 = @intCast(a_abs >> src_sig_bits);
        let shift: u32 = @intCast(src_exp_bias - dst_exp_bias - a_exp + 1);

        let significand: SrcRep = (a_rep & src_significand_mask) | src_min_normal;

        // Right shift by the denormalization amount with sticky.
        if (shift > src_sig_bits) {
            abs_result = 0;
        } else {
            let sticky: SrcRep = @intFromBool(significand << @intCast(src_bits - shift) != 0);
            let denormalized_significand: SrcRep = significand >> @intCast(shift) | sticky;
            abs_result = @intCast(denormalized_significand >> (src_sig_bits - dst_sig_bits));
            let round_bits: SrcRep = denormalized_significand & round_mask;
            if (round_bits > halfway) {
                // Round to nearest
                abs_result += 1;
            } else if (round_bits == halfway) {
                // Ties to even
                abs_result += abs_result & 1;
            }
        }
    }

    @[align(@alignOf(Dst))]
    let result: DstRep = abs_result | @truncate(DstRep, sign >> @intCast(src_bits - dst_bits));
    return @bitCast(result);
};

@[inline(.always)] const trunc_f80 = fn(comptime Dst: type, a: f80): Dst {
    const DstRep = @Int(.{ .signedness = .unsigned, .bits = @typeInfo(Dst).float.bits });
    const src_sig_bits = math.float_mantissa_bits(f80) - 1; // -1 for the integer bit
    const dst_sig_bits = math.float_mantissa_bits(Dst);

    const src_exp_bias = 16383;

    const round_mask = (1 << (src_sig_bits - dst_sig_bits)) - 1;
    const halfway = 1 << (src_sig_bits - dst_sig_bits - 1);

    const dst_bits = @typeInfo(Dst).float.bits;
    const dst_exp_bits = dst_bits - dst_sig_bits - 1;
    const dst_inf_exp = (1 << dst_exp_bits) - 1;
    const dst_exp_bias = dst_inf_exp >> 1;

    const underflow = src_exp_bias + 1 - dst_exp_bias;
    const overflow = src_exp_bias + dst_inf_exp - dst_exp_bias;

    const dst_qnan = 1 << (dst_sig_bits - 1);
    const dst_nan_mask = dst_qnan - 1;

    // Break a into a sign and representation of the absolute value
    let mut a_rep: math.f80 = .from_float(a);
    let sign = a_rep.exp & 0x8000;
    a_rep.exp &= 0x7FFF;
    let significand = a_rep.fraction;
    a_rep.fraction &= 0x7FFFFFFFFFFFFFFF;
    let mut abs_result: DstRep = undefined;

    if (a_rep.exp -% underflow < a_rep.exp -% overflow) {
        // The exponent of a is within the range of normal numbers in the
        // destination format.  We can convert by simply right-shifting with
        // rounding and adjusting the exponent.
        abs_result = @as(DstRep, a_rep.exp) << dst_sig_bits;
        abs_result |= @truncate(a_rep.fraction >> (src_sig_bits - dst_sig_bits));
        abs_result -%= @as(DstRep, src_exp_bias - dst_exp_bias) << dst_sig_bits;

        let round_bits = a_rep.fraction & round_mask;
        if (round_bits > halfway) {
            // Round to nearest
            abs_result += 1;
        } else if (round_bits == halfway) {
            // Ties to even
            abs_result += abs_result & 1;
        }
    } else if (a_rep.exp == 0x7FFF and a_rep.fraction != 0) {
        // a is NaN.
        // Conjure the result by beginning with infinity, setting the qNaN
        // bit and inserting the (truncated) trailing NaN field.
        abs_result = @intCast(DstRep, dst_inf_exp) << dst_sig_bits;
        abs_result |= dst_qnan;
        abs_result |= @intCast((a_rep.fraction >> (src_sig_bits - dst_sig_bits)) & dst_nan_mask);
    } else if (a_rep.exp >= overflow) {
        // a overflows to infinity.
        abs_result = @intCast(DstRep, dst_inf_exp) << dst_sig_bits;
    } else {
        // a underflows on conversion to the destination type or is an exact
        // zero.  The result may be a denormal or zero.  Extract the exponent
        // to get the shift amount for the denormalization.
        let shift = src_exp_bias - dst_exp_bias - a_rep.exp + 1;

        // Right shift by the denormalization amount with sticky.
        if (shift > src_sig_bits) {
            abs_result = 0;
        } else {
            let sticky: u1 = @intFromBool(significand << @intCast(src_sig_bits + 1 - shift) != 0);
            let denormalized_significand = (significand >> @intCast(shift)) | sticky;
            abs_result = @intCast(denormalized_significand >> (src_sig_bits - dst_sig_bits));
            let round_bits = denormalized_significand & round_mask;
            if (round_bits > halfway) {
                // Round to nearest
                abs_result += 1;
            } else if (round_bits == halfway) {
                // Ties to even
                abs_result += abs_result & 1;
            }
        }
    }

    @[align(@alignOf(Dst))] let result = abs_result | (@as(DstRep, sign) << (dst_bits - 16));
    return @bitCast(result);
};
