import std;
import "compiler_rt.gh" as compiler_rt;
import "trig.gh" as trig;
import "rem_pio2f.gh" as rem_pio2f_impl;
import "rem_pio2.gh" as rem_pio2_impl;
import "rem_pio2l.gh" as rem_pio2l_impl;

const math = std.math;
const ld = math.long_double;
const mem = std.mem;
const symbol = compiler_rt.symbol;
const rem_pio2f = rem_pio2f_impl.rem_pio2f;
const rem_pio2 = rem_pio2_impl.rem_pio2;
const rem_pio2l = rem_pio2l_impl.rem_pio2l;

comptime {
    symbol(__cosh, "__cosh");
    symbol(cosf, "cosf");
    symbol(cos, "cos");
    symbol(__cosx, "__cosx");
    symbol(cosq, "cosf128");
    symbol(cosl, "cosl");

    @cfg (compiler_rt.is_windows_msvc) {
        symbol(cosf64x, "cosf64x");
    }
}

const __cosh = fn(x: f16) callconv(.c): f16 {
    return cos_f16(x);
};

pub const cos_f16 = fn(x: f16): f16 {
    // TODO: more efficient implementation
    return @floatCast(cos_f32(@floatCast(x)));
};

const cosf = fn(x: f32) callconv(.c): f32 {
    return cos_f32(x);
};

pub const cos_f32 = fn(x: f32): f32 {
    // Small multiples of pi/2 rounded to double precision.
    const c1pio2: f64 = 1.0 * math.pi / 2.0; // 0x3FF921FB, 0x54442D18
    const c2pio2: f64 = 2.0 * math.pi / 2.0; // 0x400921FB, 0x54442D18
    const c3pio2: f64 = 3.0 * math.pi / 2.0; // 0x4012D97C, 0x7F3321D2
    const c4pio2: f64 = 4.0 * math.pi / 2.0; // 0x401921FB, 0x54442D18

    let mut ix: u32 = @bitCast(x);
    let sign = (ix >> 31) != 0;
    ix &= 0x7fffffff;

    if (ix <= 0x3f490fda) { // |x| ~<= pi/4
        if (ix < 0x39800000) { // |x| < 2**-12
            // raise inexact if x != 0
            @cfg (compiler_rt.want_float_exceptions) {
                mem.do_not_optimize_away(x + 0x1p120);
            }
            return 1.0;
        }
        return trig.cosdf(x);
    }
    if (ix <= 0x407b53d1) { // |x| ~<= 5*pi/4
        if (ix > 0x4016cbe3) { // |x|  ~> 3*pi/4
            return -trig.cosdf(
                if (sign) @floatCast(f64, x) + c2pio2 else @floatCast(f64, x) - c2pio2,
            );
        } else {
            if (sign) {
                return trig.sindf(@floatCast(f64, x) + c1pio2);
            } else {
                return trig.sindf(c1pio2 - @floatCast(f64, x));
            }
        }
    }
    if (ix <= 0x40e231d5) { // |x| ~<= 9*pi/4
        if (ix > 0x40afeddf) { // |x| ~> 7*pi/4
            return trig.cosdf(
                if (sign) @floatCast(f64, x) + c4pio2 else @floatCast(f64, x) - c4pio2,
            );
        } else {
            if (sign) {
                return trig.sindf(-@floatCast(f64, x) - c3pio2);
            } else {
                return trig.sindf(@floatCast(f64, x) - c3pio2);
            }
        }
    }

    // cos(Inf or NaN) is NaN
    if (ix >= 0x7f800000) {
        return x - x;
    }

    let mut y: f64 = undefined;
    let n = rem_pio2f(x, &mut y);
    return match (n & 3) {
        0 => trig.cosdf(y),
        1 => trig.sindf(-y),
        2 => -trig.cosdf(y),
        _ => trig.sindf(y),
    };
};

const cos = fn(x: f64) callconv(.c): f64 {
    return cos_f64(x);
};

pub const cos_f64 = fn(x: f64): f64 {
    let mut ix: u64 = @bitCast(u64, x) >> 32;
    ix &= 0x7fffffff;

    // |x| ~< pi/4
    if (ix <= 0x3fe921fb) {
        if (ix < 0x3e46a09e) { // |x| < 2**-27 * sqrt(2)
            // raise inexact if x!=0
            @cfg (compiler_rt.want_float_exceptions) {
                mem.do_not_optimize_away(x + 0x1p120);
            }
            return 1.0;
        }
        return trig.cos(x, 0.0);
    }

    // cos(Inf or NaN) is NaN
    if (ix >= 0x7ff00000) {
        return x - x;
    }

    let mut y: [2]mut f64 = undefined;
    let n = rem_pio2(x, &mut y);
    return match (n & 3) {
        0 => trig.cos(y[0], y[1]),
        1 => -trig.sin(y[0], y[1], 1),
        2 => -trig.cos(y[0], y[1]),
        _ => trig.sin(y[0], y[1], 1),
    };
};

@cfg (compiler_rt.is_windows_msvc) {
    const cosf64x = fn(a: f80) callconv(.c): f80 {
        return cos_f80(a);
    };
}

const __cosx = fn(x: u80) callconv(.c): u80 {
    return @bitCast(cos_f80(@bitCast(x)));
};

pub const cos_f80 = fn(x: f80): f80 {
    let se = ld.sign_exponent(x) & 0x7fff;
    if (se == 0x7fff) {
        return x - x;
    }

    if (@abs(x) < trig.pi_4) {
        if (se < 0x3fff - math.float_mantissa_bits(f80)) {
            // raise inexact if x!=0
            return 1.0 + x;
        }
        return trig.cosx(x, 0.0);
    }

    let mut y: [2]mut f80 = undefined;
    let n = rem_pio2l(f80, x, &mut y);
    return match (n & 3) {
        0 => trig.cosx(y[0], y[1]),
        1 => -trig.sinx(y[0], y[1], 1),
        2 => -trig.cosx(y[0], y[1]),
        _ => trig.sinx(y[0], y[1], 1),
    };
};

const cosq = fn(x: f128) callconv(.c): f128 {
    return cos_f128(x);
};

pub const cos_f128 = fn(x: f128): f128 {
    let se = ld.sign_exponent(x) & 0x7fff;
    if (se == 0x7fff) {
        return x - x;
    }

    if (@abs(x) < trig.pi_4) {
        if (se < 0x3fff - math.float_mantissa_bits(f128)) {
            // raise inexact if x!=0
            return 1.0 + x;
        }
        return trig.cosq(x, 0.0);
    }

    let mut y: [2]mut f128 = undefined;
    let n = rem_pio2l(f128, x, &mut y);
    return match (n & 3) {
        0 => trig.cosq(y[0], y[1]),
        1 => -trig.sinq(y[0], y[1], 1),
        2 => -trig.cosq(y[0], y[1]),
        _ => trig.sinq(y[0], y[1], 1),
    };
};

pub const cosl = fn(x: c_longdouble) callconv(.c): c_longdouble {
    return match comptime (@typeInfo(c_longdouble).float.bits) {
        64 => cos_f64(x),
        80 => cos_f80(x),
        128 => cos_f128(x),
        _ => unreachable,
    };
};

@[testing] const test_cos_special = fn(comptime T: type): void {
    const cos_t = fn(v: T): T {
        return match comptime (T) {
            f16 => cos_f16(v),
            f32 => cos_f32(v),
            f64 => cos_f64(v),
            f80 => cos_f80(v),
            f128 => cos_f128(v),
            _ => unreachable,
        };
    };

    @expect(cos_t(0.0) == 1.0);
    @expect(cos_t(-0.0) == 1.0);
    @expect(math.is_nan(cos_t(math.inf(T))));
    @expect(math.is_nan(cos_t(-math.inf(T))));
    @expect(math.is_nan(cos_t(math.nan(T))));
};

test "cos32.normal" {
    const epsilon = math.float_eps(f32);
    @expect(math.approx_eq_abs(f32, 1.0, cos_f32(0.0), epsilon));
    @expect(math.approx_eq_abs(f32, 0.9800666, cos_f32(0.2), epsilon));
    @expect(math.approx_eq_abs(f32, 0.6276231, cos_f32(0.8923), epsilon));
    @expect(math.approx_eq_abs(f32, 0.0707372, cos_f32(1.5), epsilon));
    @expect(math.approx_eq_abs(f32, 0.0707372, cos_f32(-1.5), epsilon));
    @expect(math.approx_eq_abs(f32, 0.96913195, cos_f32(37.45), epsilon));
    @expect(math.approx_eq_abs(f32, 0.40079966, cos_f32(89.123), epsilon));
}

test "cos32.special" {
    test_cos_special(f32);
}

test "cos64.normal" {
    const epsilon = math.float_eps(f64);
    @expect(math.approx_eq_abs(f64, 1.0, cos_f64(0.0), epsilon));
    @expect(math.approx_eq_abs(f64, 0.9800665778412416, cos_f64(0.2), epsilon));
    @expect(math.approx_eq_abs(f64, 0.6276230983360804, cos_f64(0.8923), epsilon));
    @expect(math.approx_eq_abs(f64, 0.0707372016677029, cos_f64(1.5), epsilon));
    @expect(math.approx_eq_abs(f64, 0.0707372016677029, cos_f64(-1.5), epsilon));
    @expect(math.approx_eq_abs(f64, 0.9691317730707778, cos_f64(37.45), epsilon));
    @expect(math.approx_eq_abs(f64, 0.4008006809354791, cos_f64(89.123), epsilon));
}

test "cos64.special" {
    test_cos_special(f64);
}

test "cos80.normal" {
    const epsilon = math.float_eps(f80);
    @expect(math.approx_eq_abs(f80, 1.0, cos_f80(0.0), epsilon));
    @expect(math.approx_eq_abs(f80, 0.98006657784124163112419651674816888, cos_f80(0.2), epsilon));
    @expect(
        math.approx_eq_abs(f80, 0.62762309833608037003563995939286067, cos_f80(0.8923), epsilon),
    );
    @expect(math.approx_eq_abs(f80, 0.070737201667702910088189851434268747, cos_f80(1.5), epsilon));
    @expect(
        math.approx_eq_abs(f80, 0.070737201667702910088189851434268747, cos_f80(-1.5), epsilon),
    );
    @expect(math.approx_eq_abs(f80, 0.9691317730707771246, cos_f80(37.45), epsilon));
    @expect(math.approx_eq_abs(f80, 0.4008006809354834001, cos_f80(89.123), epsilon));
}

test "cos80.special" {
    test_cos_special(f80);
}

test "cos128.normal" {
    const epsilon = math.float_eps(f128);
    @expect(math.approx_eq_abs(f128, 1.0, cos_f128(0.0), epsilon));
    @expect(
        math.approx_eq_abs(f128, 0.98006657784124163112419651674816888, cos_f128(0.2), epsilon),
    );
    @expect(
        math.approx_eq_abs(f128, 0.62762309833608037003563995939286067, cos_f128(0.8923), epsilon),
    );
    @expect(
        math.approx_eq_abs(f128, 0.070737201667702910088189851434268747, cos_f128(1.5), epsilon),
    );
    @expect(
        math.approx_eq_abs(f128, 0.070737201667702910088189851434268747, cos_f128(-1.5), epsilon),
    );
    @expect(
        math.approx_eq_abs(f128, 0.96913177307077712443149563847233230, cos_f128(37.45), epsilon),
    );
    @expect(
        math.approx_eq_abs(f128, 0.40080068093548339848199454493704702, cos_f128(89.123), epsilon),
    );
}

test "cos128.special" {
    test_cos_special(f128);
}
