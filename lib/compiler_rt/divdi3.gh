//! 64-bit integer division for 32-bit targets, which have no instruction for it
import "compiler_rt.gh" as compiler_rt;

const symbol = compiler_rt.symbol;

comptime {
    symbol(udivdi3, "__udivdi3");
    symbol(umoddi3, "__umoddi3");
    symbol(divdi3, "__divdi3");
    symbol(moddi3, "__moddi3");
    @cfg (os == .windows and arch == .x86 and abi == .msvc) {
        symbol(aulldiv, "_aulldiv");
        symbol(aullrem, "_aullrem");
        symbol(alldiv, "_alldiv");
        symbol(allrem, "_allrem");
    }
}

const DivMod = struct {
    quotient: u64,
    remainder: u64,
};

/// Divides one bit at a time, so that no 64-bit division (the routine being written) is needed;
/// when both fit 32 bits, the target's own 32-bit division does it
@[no_builtins] const udivmod = fn(a: u64, b: u64): DivMod {
    if ((a >> 32) == 0 and (b >> 32) == 0) {
        let x = @truncate(u32, a);
        let y = @truncate(u32, b);
        return .{ .quotient = @as(u64, x / y), .remainder = @as(u64, x % y) };
    }
    let mut quotient: u64 = 0;
    let mut remainder: u64 = 0;
    let mut bit: u64 = 64;
    while (bit > 0) {
        bit -= 1;
        remainder = (remainder << 1) | ((a >> bit) & 1);
        if (remainder >= b) {
            remainder -= b;
            quotient |= @as(u64, 1) << bit;
        }
    }
    return .{ .quotient = quotient, .remainder = remainder };
};

const magnitude = fn(x: i64): u64 {
    return if (x < 0) 0 -% @bitCast(u64, x) else @bitCast(u64, x);
};

const negate_if = fn(negative: bool, x: u64): i64 {
    return @bitCast(i64, if (negative) 0 -% x else x);
};

const udivdi3 = fn(a: u64, b: u64) callconv(.c): u64 {
    return udivmod(a, b).quotient;
};

const umoddi3 = fn(a: u64, b: u64) callconv(.c): u64 {
    return udivmod(a, b).remainder;
};

/// Rounds toward zero, as `/` does
const divdi3 = fn(a: i64, b: i64) callconv(.c): i64 {
    return negate_if((a < 0) != (b < 0), udivmod(magnitude(a), magnitude(b)).quotient);
};

/// Takes the dividend's sign, as `%` does
const moddi3 = fn(a: i64, b: i64) callconv(.c): i64 {
    return negate_if(a < 0, udivmod(magnitude(a), magnitude(b)).remainder);
};

// MSVC's x86 helpers take both operands on the stack, pop them on return (`ret $16`), and leave
// the result in edx:eax. Each re-pushes its operands for the C routine above
@cfg (os == .windows and arch == .x86 and abi == .msvc) {
    @[naked] const aulldiv = fn() callconv(.c): void {
        asm {
            template:
                \\pushl 16(%%esp)
                \\pushl 16(%%esp)
                \\pushl 16(%%esp)
                \\pushl 16(%%esp)
                \\calll ___udivdi3
                \\addl $16, %%esp
                \\retl $16
            ,
            clobbers: ("memory"),
            options: (volatile, noreturn, att),
        };
    };

    @[naked] const aullrem = fn() callconv(.c): void {
        asm {
            template:
                \\pushl 16(%%esp)
                \\pushl 16(%%esp)
                \\pushl 16(%%esp)
                \\pushl 16(%%esp)
                \\calll ___umoddi3
                \\addl $16, %%esp
                \\retl $16
            ,
            clobbers: ("memory"),
            options: (volatile, noreturn, att),
        };
    };

    @[naked] const alldiv = fn() callconv(.c): void {
        asm {
            template:
                \\pushl 16(%%esp)
                \\pushl 16(%%esp)
                \\pushl 16(%%esp)
                \\pushl 16(%%esp)
                \\calll ___divdi3
                \\addl $16, %%esp
                \\retl $16
            ,
            clobbers: ("memory"),
            options: (volatile, noreturn, att),
        };
    };

    @[naked] const allrem = fn() callconv(.c): void {
        asm {
            template:
                \\pushl 16(%%esp)
                \\pushl 16(%%esp)
                \\pushl 16(%%esp)
                \\pushl 16(%%esp)
                \\calll ___moddi3
                \\addl $16, %%esp
                \\retl $16
            ,
            clobbers: ("memory"),
            options: (volatile, noreturn, att),
        };
    };
}

test "unsigned 64-bit division matches the native operators" {
    const cases: [6][2]u64 = .{
        .{ 0, 1 },
        .{ 7, 2 },
        .{ 0xFFFF_FFFF_FFFF_FFFF, 3 },
        .{ 0x1234_5678_9ABC_DEF0, 0x1_0000_0001 },
        .{ 1 << 40, 1 << 40 },
        .{ 5, 0xFFFF_FFFF_FFFF },
    };
    for (cases) |c| {
        @expect(udivdi3(c[0], c[1]) == c[0] / c[1]);
        @expect(umoddi3(c[0], c[1]) == c[0] % c[1]);
    }
}

test "signed 64-bit division rounds toward zero" {
    @expect(divdi3(-7, 2) == -3);
    @expect(moddi3(-7, 2) == -1);
    @expect(divdi3(7, -2) == -3);
    @expect(moddi3(7, -2) == 1);
    @expect(divdi3(-9_000_000_000_000, -3) == 3_000_000_000_000);
    @expect(divdi3(-9_223_372_036_854_775_807 - 1, 1) == -9_223_372_036_854_775_807 - 1);
}
