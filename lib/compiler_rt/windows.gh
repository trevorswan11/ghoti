//! Windows runtime stubs the code generator calls on its own. References:
//!
//! https://github.com/gcc-mirror/gcc/blob/7644f2a3f009da4c32f7acc66c10f947bb455ae6/libgcc/config/i386/cygwin.S#L109
import "compiler_rt.gh" as compiler_rt;

const symbol = compiler_rt.symbol;

@cfg (os == .windows and arch == .x86_64) {
    comptime {
        @cfg (abi == .msvc) {
            symbol(stack_probe, "__chkstk");
        } else {
            symbol(stack_probe, "___chkstk_ms");
        }
    }

    /// This is libgcc's `___chkstk_ms`, which also satisfies MSVC's x64 `__chkstk` contract.
    ///
    @[naked] const stack_probe = fn() callconv(.c): void {
        asm {
            template:
                \\push %%rcx
                \\push %%rax
                \\cmp $0x1000, %%rax
                \\lea 0x18(%%rsp), %%rcx
                \\jb 2f
                \\1:
                \\sub $0x1000, %%rcx
                \\orq $0x0, (%%rcx)
                \\sub $0x1000, %%rax
                \\cmp $0x1000, %%rax
                \\ja 1b
                \\2:
                \\sub %%rax, %%rcx
                \\orq $0x0, (%%rcx)
                \\pop %%rax
                \\pop %%rcx
                \\ret
            ,
            clobbers: ("memory"),
            options: (volatile, noreturn, att),
        };
    };
}

@cfg (os == .windows and arch == .x86) {
    comptime {
        @cfg (abi == .msvc) {
            symbol(stack_probe_x86, "_chkstk");
        } else {
            symbol(stack_probe_x86, "_alloca");
        }
    }

    /// The 32-bit probe allocates as well: it touches each 4 KiB page from %esp down by %eax
    /// bytes, then moves %esp there itself. Every register but %esp and the flags is preserved.
    @[naked] const stack_probe_x86 = fn() callconv(.c): void {
        asm {
            template:
                \\push %%ecx
                \\cmp $0x1000, %%eax
                \\lea 8(%%esp), %%ecx
                \\jb 1f
                \\2:
                \\sub $0x1000, %%ecx
                \\test %%ecx, (%%ecx)
                \\sub $0x1000, %%eax
                \\cmp $0x1000, %%eax
                \\ja 2b
                \\1:
                \\sub %%eax, %%ecx
                \\test %%ecx, (%%ecx)
                \\lea 4(%%esp), %%eax
                \\mov %%ecx, %%esp
                \\mov -4(%%eax), %%ecx
                \\push (%%eax)
                \\sub %%esp, %%eax
                \\ret
            ,
            clobbers: ("memory"),
            options: (volatile, noreturn, att),
        };
    };
}
