//! Cases from:
//! https://codeberg.org/ziglang/zig/src/tag/0.17.0/lib/compiler_rt/float_from_int_test.zig

// ghoti fmt: off
pub const cases = [_]struct { pub a: u64, pub expected: f64 }{
    .{ .a = 0x0,                .expected = 0.0 },
    .{ .a = 0x1,                .expected = 1.0 },
    .{ .a = 0x2,                .expected = 2.0 },
    .{ .a = 0x14,               .expected = 20.0 },
    .{ .a = 0x7FFFFF8000000000, .expected = 0x1.FFFFFEp+62 },
    .{ .a = 0x7FFFFFFFFFFFF800, .expected = 0x1.FFFFFFFFFFFFEp+62 },
    .{ .a = 0x7FFFFF0000000000, .expected = 0x1.FFFFFCp+62 },
    .{ .a = 0x7FFFFFFFFFFFF000, .expected = 0x1.FFFFFFFFFFFFCp+62 },
    .{ .a = 0x8000008000000000, .expected = 0x1.000001p+63 },
    .{ .a = 0x8000000000000800, .expected = 0x1.0000000000001p+63 },
    .{ .a = 0x8000010000000000, .expected = 0x1.000002p+63 },
    .{ .a = 0x8000000000001000, .expected = 0x1.0000000000002p+63 },
    .{ .a = 0x8000000000000000, .expected = 0x1p+63 },
    .{ .a = 0x8000000000000001, .expected = 0x1p+63 },
    .{ .a = 0x7FB72E8000000,    .expected = 0x1.FEDCBAp+50 },
    .{ .a = 0x7FB72EA000000,    .expected = 0x1.FEDCBA8p+50 },
    .{ .a = 0x7FB72EB000000,    .expected = 0x1.FEDCBACp+50 },
    .{ .a = 0x7FB72EBFFFFFF,    .expected = 0x1.FEDCBAFFFFFFCp+50 },
    .{ .a = 0x7FB72EC000000,    .expected = 0x1.FEDCBBp+50 },
    .{ .a = 0x7FB72E8000001,    .expected = 0x1.FEDCBA0000004p+50 },
    .{ .a = 0x7FB72E6000000,    .expected = 0x1.FEDCB98p+50 },
    .{ .a = 0x7FB72E7000000,    .expected = 0x1.FEDCB9Cp+50 },
    .{ .a = 0x7FB72E7FFFFFF,    .expected = 0x1.FEDCB9FFFFFFCp+50 },
    .{ .a = 0x7FB72E4000001,    .expected = 0x1.FEDCB90000004p+50 },
    .{ .a = 0x7FB72E4000000,    .expected = 0x1.FEDCB9p+50 },
    .{ .a = 0x23479FD0E092DC0,  .expected = 0x1.1A3CFE870496Ep+57 },
    .{ .a = 0x23479FD0E092DA1,  .expected = 0x1.1A3CFE870496Dp+57 },
    .{ .a = 0x23479FD0E092DB0,  .expected = 0x1.1A3CFE870496Ep+57 },
    .{ .a = 0x23479FD0E092DB8,  .expected = 0x1.1A3CFE870496Ep+57 },
    .{ .a = 0x23479FD0E092DB6,  .expected = 0x1.1A3CFE870496Ep+57 },
    .{ .a = 0x23479FD0E092DBF,  .expected = 0x1.1A3CFE870496Ep+57 },
    .{ .a = 0x23479FD0E092DC1,  .expected = 0x1.1A3CFE870496Ep+57 },
    .{ .a = 0x23479FD0E092DC7,  .expected = 0x1.1A3CFE870496Ep+57 },
    .{ .a = 0x23479FD0E092DC8,  .expected = 0x1.1A3CFE870496Ep+57 },
    .{ .a = 0x23479FD0E092DCF,  .expected = 0x1.1A3CFE870496Ep+57 },
    .{ .a = 0x23479FD0E092DD0,  .expected = 0x1.1A3CFE870496Ep+57 },
    .{ .a = 0x23479FD0E092DD1,  .expected = 0x1.1A3CFE870496Fp+57 },
