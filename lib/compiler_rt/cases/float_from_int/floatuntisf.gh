//! Cases from:
//! https://codeberg.org/ziglang/zig/src/tag/0.17.0/lib/compiler_rt/float_from_int_test.zig

// ghoti fmt: off
pub const cases = [_]struct { pub a: u128, pub expected: f32 }{
    .{ .a = 0x0,                                .expected = 0.0 },
    .{ .a = 0x1,                                .expected = 1.0 },
    .{ .a = 0x2,                                .expected = 2.0 },
    .{ .a = 0x14,                               .expected = 20.0 },
    .{ .a = 0x7FFFFF8000000000,                 .expected = 0x1.FFFFFEp+62 },
    .{ .a = 0x7FFFFF0000000000,                 .expected = 0x1.FFFFFCp+62 },
    .{ .a = 0x80000080000000000000000000000000, .expected = 0x1.000001p+127 },
    .{ .a = 0x80000000000008000000000000000000, .expected = 0x1.0p+127 },
    .{ .a = 0x80000100000000000000000000000000, .expected = 0x1.000002p+127 },
    .{ .a = 0x80000000000000000000000000000000, .expected = 0x1.000000p+127 },
    .{ .a = 0x7FB72E8000000,                    .expected = 0x1.FEDCBAp+50 },
    .{ .a = 0x7FB72EA000000,                    .expected = 0x1.FEDCBA8p+50 },
    .{ .a = 0x7FB72EB000000,                    .expected = 0x1.FEDCBACp+50 },
    .{ .a = 0x7FB72EC000000,                    .expected = 0x1.FEDCBBp+50 },
    .{ .a = 0x7FB72E6000000,                    .expected = 0x1.FEDCB98p+50 },
    .{ .a = 0x7FB72E7000000,                    .expected = 0x1.FEDCB9Cp+50 },
    .{ .a = 0x7FB72E4000000,                    .expected = 0x1.FEDCB9p+50 },
    .{ .a = 0xFFFFFFFFFFFFFFFE,                 .expected = 0x1p+64 },
    .{ .a = 0xFFFFFFFFFFFFFFFF,                 .expected = 0x1p+64 },
    .{ .a = 0x7FB72E8000000,                    .expected = 0x1.FEDCBAp+50 },
    .{ .a = 0x7FB72EA000000,                    .expected = 0x1.FEDCBAp+50 },
    .{ .a = 0x7FB72EB000000,                    .expected = 0x1.FEDCBAp+50 },
    .{ .a = 0x7FB72EBFFFFFF,                    .expected = 0x1.FEDCBAp+50 },
    .{ .a = 0x7FB72EC000000,                    .expected = 0x1.FEDCBCp+50 },
    .{ .a = 0x7FB72E8000001,                    .expected = 0x1.FEDCBAp+50 },
    .{ .a = 0x7FB72E6000000,                    .expected = 0x1.FEDCBAp+50 },
    .{ .a = 0x7FB72E7000000,                    .expected = 0x1.FEDCBAp+50 },
    .{ .a = 0x7FB72E7FFFFFF,                    .expected = 0x1.FEDCBAp+50 },
    .{ .a = 0x7FB72E4000001,                    .expected = 0x1.FEDCBAp+50 },
    .{ .a = 0x7FB72E4000000,                    .expected = 0x1.FEDCB8p+50 },
    .{ .a = 0x1FEDCB90000000000001,             .expected = 0x1.FEDCBAp+76 },
    .{ .a = 0x1FEDCBA0000000000000,             .expected = 0x1.FEDCBAp+76 },
    .{ .a = 0x1FEDCBAFFFFFFFFFFFFF,             .expected = 0x1.FEDCBAp+76 },
    .{ .a = 0x1FEDCBB0000000000000,             .expected = 0x1.FEDCBCp+76 },
    .{ .a = 0x1FEDCBB0000000000001,             .expected = 0x1.FEDCBCp+76 },
    .{ .a = 0x1FEDCBBFFFFFFFFFFFFF,             .expected = 0x1.FEDCBCp+76 },
    .{ .a = 0x1FEDCBC0000000000000,             .expected = 0x1.FEDCBCp+76 },
    .{ .a = 0x1FEDCBC0000000000001,             .expected = 0x1.FEDCBCp+76 },
    .{ .a = 0x1FEDCBD0000000000000,             .expected = 0x1.FEDCBCp+76 },
    .{ .a = 0x1FEDCBD0000000000001,             .expected = 0x1.FEDCBEp+76 },
    .{ .a = 0x1FEDCBDFFFFFFFFFFFFF,             .expected = 0x1.FEDCBEp+76 },
    .{ .a = 0x1FEDCBE0000000000000,             .expected = 0x1.FEDCBEp+76 },
};
