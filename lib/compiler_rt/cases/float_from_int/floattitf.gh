    .{ .a = 0x2,                                 .expected = 2.0 },
    .{ .a = 0x14,                                .expected = 20.0 },
    .{ .a = -0x1,                                .expected = -1.0 },
    .{ .a = -0x2,                                .expected = -2.0 },
    .{ .a = -0x14,                               .expected = -20.0 },
