//! Cases from:
//! https://codeberg.org/ziglang/zig/src/tag/0.17.0/lib/compiler_rt/float_from_int_test.zig

// ghoti fmt: off
pub const cases = [_]struct { pub a: i128, pub expected: f128 }{
    .{ .a = 0x0,                                 .expected = 0.0 },
