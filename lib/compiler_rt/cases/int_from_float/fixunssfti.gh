//! Cases from:
//! https://codeberg.org/ziglang/zig/src/tag/0.17.0/lib/compiler_rt/int_from_float_test.zig
import std;

const math = std.math;

// ghoti fmt: off
pub const cases = [_]struct { pub a: f32, pub expected: u128 }{
    .{ .a = 0.0,                 .expected = 0 },
    .{ .a = 0.5,                 .expected = 0 },
    .{ .a = 0.99,                .expected = 0 },
    .{ .a = 1.0,                 .expected = 1 },
    .{ .a = 1.5,                 .expected = 1 },
    .{ .a = 1.99,                .expected = 1 },
    .{ .a = 2.0,                 .expected = 2 },
    .{ .a = 2.01,                .expected = 2 },
    .{ .a = -0.5,                .expected = 0 },
    .{ .a = -0.99,               .expected = 0 },
    .{ .a = -1.0,                .expected = 0 },
    .{ .a = -1.5,                .expected = 0 },
    .{ .a = -1.99,               .expected = 0 },
    .{ .a = -2.0,                .expected = 0 },
    .{ .a = -2.01,               .expected = 0 },
    .{ .a = 0x1.FFFFFEp+63,      .expected = 0xFFFFFF0000000000 },
    .{ .a = 0x1.000000p+63,      .expected = 0x8000000000000000 },
    .{ .a = 0x1.FFFFFEp+62,      .expected = 0x7FFFFF8000000000 },
    .{ .a = 0x1.FFFFFCp+62,      .expected = 0x7FFFFF0000000000 },
    .{ .a = 0x1.FFFFFEp+127,     .expected = 0xFFFFFF00000000000000000000000000 },
    .{ .a = 0x1.000000p+127,     .expected = 0x80000000000000000000000000000000 },
    .{ .a = 0x1.FFFFFEp+126,     .expected = 0x7FFFFF80000000000000000000000000 },
    .{ .a = 0x1.FFFFFCp+126,     .expected = 0x7FFFFF00000000000000000000000000 },
    .{ .a = -0x1.FFFFFEp+62,     .expected = 0x0000000000000000 },
    .{ .a = -0x1.FFFFFCp+62,     .expected = 0x0000000000000000 },
    .{ .a = -0x1.FFFFFEp+126,    .expected = 0x0000000000000000 },
    .{ .a = -0x1.FFFFFCp+126,    .expected = 0x0000000000000000 },
    .{ .a = math.float_max(f32), .expected = 0xffffff00000000000000000000000000 },
    .{ .a = math.inf(f32),       .expected = math.max_int(u128) },
};
