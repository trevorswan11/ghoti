//! Cases from:
//! https://codeberg.org/ziglang/zig/src/tag/0.17.0/lib/compiler_rt/mulosi4_test.zig

// ghoti fmt: off
pub const cases = [_]struct { pub a: i32, pub b: i32, pub expected: i32, pub expected_overflow: c_int }{
    .{ .a = 0,           .b = 0,           .expected = 0,           .expected_overflow = 0 },
    .{ .a = 0,           .b = 1,           .expected = 0,           .expected_overflow = 0 },
    .{ .a = 1,           .b = 0,           .expected = 0,           .expected_overflow = 0 },
    .{ .a = 0,           .b = 10,          .expected = 0,           .expected_overflow = 0 },
    .{ .a = 10,          .b = 0,           .expected = 0,           .expected_overflow = 0 },
    .{ .a = 0,           .b = 0x1234567,   .expected = 0,           .expected_overflow = 0 },
    .{ .a = 0x1234567,   .b = 0,           .expected = 0,           .expected_overflow = 0 },
    .{ .a = 0,           .b = -1,          .expected = 0,           .expected_overflow = 0 },
    .{ .a = -1,          .b = 0,           .expected = 0,           .expected_overflow = 0 },
    .{ .a = 0,           .b = -10,         .expected = 0,           .expected_overflow = 0 },
    .{ .a = -10,         .b = 0,           .expected = 0,           .expected_overflow = 0 },
    .{ .a = 0,           .b = -0x1234567,  .expected = 0,           .expected_overflow = 0 },
    .{ .a = -0x1234567,  .b = 0,           .expected = 0,           .expected_overflow = 0 },
    .{ .a = 1,           .b = 1,           .expected = 1,           .expected_overflow = 0 },
    .{ .a = 1,           .b = 10,          .expected = 10,          .expected_overflow = 0 },
    .{ .a = 10,          .b = 1,           .expected = 10,          .expected_overflow = 0 },
    .{ .a = 1,           .b = 0x1234567,   .expected = 0x1234567,   .expected_overflow = 0 },
    .{ .a = 0x1234567,   .b = 1,           .expected = 0x1234567,   .expected_overflow = 0 },
    .{ .a = 1,           .b = -1,          .expected = -1,          .expected_overflow = 0 },
    .{ .a = 1,           .b = -10,         .expected = -10,         .expected_overflow = 0 },
    .{ .a = -10,         .b = 1,           .expected = -10,         .expected_overflow = 0 },
    .{ .a = 1,           .b = -0x1234567,  .expected = -0x1234567,  .expected_overflow = 0 },
    .{ .a = -0x1234567,  .b = 1,           .expected = -0x1234567,  .expected_overflow = 0 },
    .{ .a = 0x7FFFFFFF,  .b = -2,          .expected = -0x7FFFFFFF, .expected_overflow = 1 },
    .{ .a = -2,          .b = 0x7FFFFFFF,  .expected = -0x7FFFFFFF, .expected_overflow = 1 },
    .{ .a = 0x7FFFFFFF,  .b = -1,          .expected = -0x7FFFFFFF, .expected_overflow = 0 },
    .{ .a = -1,          .b = 0x7FFFFFFF,  .expected = -0x7FFFFFFF, .expected_overflow = 0 },
    .{ .a = 0x7FFFFFFF,  .b = 0,           .expected = 0,           .expected_overflow = 0 },
    .{ .a = 0,           .b = 0x7FFFFFFF,  .expected = 0,           .expected_overflow = 0 },
    .{ .a = 0x7FFFFFFF,  .b = 1,           .expected = 0x7FFFFFFF,  .expected_overflow = 0 },
    .{ .a = 1,           .b = 0x7FFFFFFF,  .expected = 0x7FFFFFFF,  .expected_overflow = 0 },
    .{ .a = 0x7FFFFFFF,  .b = 2,           .expected = -0x7FFFFFFF, .expected_overflow = 1 },
    .{ .a = 2,           .b = 0x7FFFFFFF,  .expected = -0x7FFFFFFF, .expected_overflow = 1 },
    .{ .a = -0x80000000, .b = -2,          .expected = -0x80000000, .expected_overflow = 1 },
    .{ .a = -2,          .b = -0x80000000, .expected = -0x80000000, .expected_overflow = 1 },
    .{ .a = -0x80000000, .b = -1,          .expected = -0x80000000, .expected_overflow = 1 },
    .{ .a = -1,          .b = -0x80000000, .expected = -0x80000000, .expected_overflow = 1 },
    .{ .a = -0x80000000, .b = 0,           .expected = 0,           .expected_overflow = 0 },
    .{ .a = 0,           .b = -0x80000000, .expected = 0,           .expected_overflow = 0 },
    .{ .a = -0x80000000, .b = 1,           .expected = -0x80000000, .expected_overflow = 0 },
    .{ .a = 1,           .b = -0x80000000, .expected = -0x80000000, .expected_overflow = 0 },
    .{ .a = -0x80000000, .b = 2,           .expected = -0x80000000, .expected_overflow = 1 },
    .{ .a = 2,           .b = -0x80000000, .expected = -0x80000000, .expected_overflow = 1 },
    .{ .a = -0x7FFFFFFF, .b = -2,          .expected = -0x7FFFFFFF, .expected_overflow = 1 },
    .{ .a = -2,          .b = -0x7FFFFFFF, .expected = -0x7FFFFFFF, .expected_overflow = 1 },
    .{ .a = -0x7FFFFFFF, .b = -1,          .expected = 0x7FFFFFFF,  .expected_overflow = 0 },
    .{ .a = -1,          .b = -0x7FFFFFFF, .expected = 0x7FFFFFFF,  .expected_overflow = 0 },
    .{ .a = -0x7FFFFFFF, .b = 0,           .expected = 0,           .expected_overflow = 0 },
    .{ .a = 0,           .b = -0x7FFFFFFF, .expected = 0,           .expected_overflow = 0 },
    .{ .a = -0x7FFFFFFF, .b = 1,           .expected = -0x7FFFFFFF, .expected_overflow = 0 },
    .{ .a = 1,           .b = -0x7FFFFFFF, .expected = -0x7FFFFFFF, .expected_overflow = 0 },
    .{ .a = -0x7FFFFFFF, .b = 2,           .expected = -0x80000000, .expected_overflow = 1 },
    .{ .a = 2,           .b = -0x7FFFFFFF, .expected = -0x80000000, .expected_overflow = 1 },
};
