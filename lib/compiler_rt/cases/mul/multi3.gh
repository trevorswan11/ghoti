//! Cases from:
//! https://codeberg.org/ziglang/zig/src/tag/0.17.0/lib/compiler_rt/mulXi3_test.zig

// ghoti fmt: off
pub const cases = [_]struct { pub a: i128, pub b: i128, pub expected: i128 }{
    .{ .a = 0,                    .b = 0,                  .expected = 0 },
    .{ .a = 0,                    .b = 1,                  .expected = 0 },
    .{ .a = 1,                    .b = 0,                  .expected = 0 },
    .{ .a = 0,                    .b = 10,                 .expected = 0 },
    .{ .a = 10,                   .b = 0,                  .expected = 0 },
    .{ .a = 0,                    .b = 0x123456789ABCDEF,  .expected = 0 },
    .{ .a = 0x123456789ABCDEF,    .b = 0,                  .expected = 0 },
    .{ .a = 0,                    .b = -1,                 .expected = 0 },
    .{ .a = -1,                   .b = 0,                  .expected = 0 },
    .{ .a = 0,                    .b = -10,                .expected = 0 },
    .{ .a = -10,                  .b = 0,                  .expected = 0 },
    .{ .a = 0,                    .b = -0x123456789ABCDEF, .expected = 0 },
    .{ .a = -0x123456789ABCDEF,   .b = 0,                  .expected = 0 },
    .{ .a = 1,                    .b = 1,                  .expected = 1 },
    .{ .a = 1,                    .b = 10,                 .expected = 10 },
    .{ .a = 10,                   .b = 1,                  .expected = 10 },
    .{ .a = 1,                    .b = 0x123456789ABCDEF,  .expected = 0x123456789ABCDEF },
    .{ .a = 0x123456789ABCDEF,    .b = 1,                  .expected = 0x123456789ABCDEF },
    .{ .a = 1,                    .b = -1,                 .expected = -1 },
    .{ .a = 1,                    .b = -10,                .expected = -10 },
    .{ .a = -10,                  .b = 1,                  .expected = -10 },
    .{ .a = 1,                    .b = -0x123456789ABCDEF, .expected = -0x123456789ABCDEF },
    .{ .a = -0x123456789ABCDEF,   .b = 1,                  .expected = -0x123456789ABCDEF },
    .{ .a = 0xB504F333,           .b = 0xB504F333,         .expected = 0x7FFFFFFE9EA1DC29 },
    .{ .a = -0xB504F333,          .b = 0xB504F333,         .expected = -0x7FFFFFFE9EA1DC29 },
    .{ .a = 0xB504F333,           .b = -0xB504F333,        .expected = -0x7FFFFFFE9EA1DC29 },
    .{ .a = -0xB504F333,          .b = -0xB504F333,        .expected = 0x7FFFFFFE9EA1DC29 },
    .{ .a = 0x3FFFFFFFFFF,        .b = 0x200000,           .expected = 0x7FFFFFFFFFE00000 },
    .{ .a = -0x3FFFFFFFFFF,       .b = 0x200000,           .expected = -0x7FFFFFFFFFE00000 },
    .{ .a = 0x3FFFFFFFFFF,        .b = -0x200000,          .expected = -0x7FFFFFFFFFE00000 },
    .{ .a = -0x3FFFFFFFFFF,       .b = -0x200000,          .expected = 0x7FFFFFFFFFE00000 },
    .{ .a = 0x200000,             .b = 0x3FFFFFFFFFF,      .expected = 0x7FFFFFFFFFE00000 },
    .{ .a = -0x200000,            .b = 0x3FFFFFFFFFF,      .expected = -0x7FFFFFFFFFE00000 },
    .{ .a = 0x200000,             .b = -0x3FFFFFFFFFF,     .expected = -0x7FFFFFFFFFE00000 },
    .{ .a = -0x200000,            .b = -0x3FFFFFFFFFF,     .expected = 0x7FFFFFFFFFE00000 },
    .{ .a = 0xB504F333F9DE5BE000, .b = 0xB504F333F9DE5B,   .expected = 0x7FFFFFFFFFFFF328DF915DA296E8A000 },
};
