//! Cases from:
//! https://codeberg.org/ziglang/zig/src/tag/0.17.0/lib/compiler_rt/mulodi4_test.zig

// ghoti fmt: off
pub const cases = [_]struct { pub a: i64, pub b: i64, pub expected: i64, pub expected_overflow: c_int }{
    .{ .a = 0,                   .b = 0,                   .expected = 0,                   .expected_overflow = 0 },
    .{ .a = 0,                   .b = 1,                   .expected = 0,                   .expected_overflow = 0 },
    .{ .a = 1,                   .b = 0,                   .expected = 0,                   .expected_overflow = 0 },
    .{ .a = 0,                   .b = 10,                  .expected = 0,                   .expected_overflow = 0 },
    .{ .a = 10,                  .b = 0,                   .expected = 0,                   .expected_overflow = 0 },
    .{ .a = 0,                   .b = 0x123456789ABCDEF,   .expected = 0,                   .expected_overflow = 0 },
    .{ .a = 0x123456789ABCDEF,   .b = 0,                   .expected = 0,                   .expected_overflow = 0 },
    .{ .a = 0,                   .b = -1,                  .expected = 0,                   .expected_overflow = 0 },
    .{ .a = -1,                  .b = 0,                   .expected = 0,                   .expected_overflow = 0 },
    .{ .a = 0,                   .b = -10,                 .expected = 0,                   .expected_overflow = 0 },
    .{ .a = -10,                 .b = 0,                   .expected = 0,                   .expected_overflow = 0 },
    .{ .a = 0,                   .b = -0x123456789ABCDEF,  .expected = 0,                   .expected_overflow = 0 },
    .{ .a = -0x123456789ABCDEF,  .b = 0,                   .expected = 0,                   .expected_overflow = 0 },
    .{ .a = 1,                   .b = 1,                   .expected = 1,                   .expected_overflow = 0 },
    .{ .a = 1,                   .b = 10,                  .expected = 10,                  .expected_overflow = 0 },
    .{ .a = 10,                  .b = 1,                   .expected = 10,                  .expected_overflow = 0 },
    .{ .a = 1,                   .b = 0x123456789ABCDEF,   .expected = 0x123456789ABCDEF,   .expected_overflow = 0 },
    .{ .a = 0x123456789ABCDEF,   .b = 1,                   .expected = 0x123456789ABCDEF,   .expected_overflow = 0 },
    .{ .a = 1,                   .b = -1,                  .expected = -1,                  .expected_overflow = 0 },
    .{ .a = 1,                   .b = -10,                 .expected = -10,                 .expected_overflow = 0 },
    .{ .a = -10,                 .b = 1,                   .expected = -10,                 .expected_overflow = 0 },
    .{ .a = 1,                   .b = -0x123456789ABCDEF,  .expected = -0x123456789ABCDEF,  .expected_overflow = 0 },
    .{ .a = -0x123456789ABCDEF,  .b = 1,                   .expected = -0x123456789ABCDEF,  .expected_overflow = 0 },
    .{ .a = 0xB504F333,          .b = 0xB504F333,          .expected = 0x7FFFFFFE9EA1DC29,  .expected_overflow = 0 },
    .{ .a = -0xB504F333,         .b = 0xB504F333,          .expected = -0x7FFFFFFE9EA1DC29, .expected_overflow = 0 },
    .{ .a = 0xB504F333,          .b = -0xB504F333,         .expected = -0x7FFFFFFE9EA1DC29, .expected_overflow = 0 },
    .{ .a = -0xB504F333,         .b = -0xB504F333,         .expected = 0x7FFFFFFE9EA1DC29,  .expected_overflow = 0 },
    .{ .a = 0x3FFFFFFFFFF,       .b = 0x200000,            .expected = 0x7FFFFFFFFFE00000,  .expected_overflow = 0 },
    .{ .a = -0x3FFFFFFFFFF,      .b = 0x200000,            .expected = -0x7FFFFFFFFFE00000, .expected_overflow = 0 },
    .{ .a = 0x3FFFFFFFFFF,       .b = -0x200000,           .expected = -0x7FFFFFFFFFE00000, .expected_overflow = 0 },
    .{ .a = -0x3FFFFFFFFFF,      .b = -0x200000,           .expected = 0x7FFFFFFFFFE00000,  .expected_overflow = 0 },
    .{ .a = 0x200000,            .b = 0x3FFFFFFFFFF,       .expected = 0x7FFFFFFFFFE00000,  .expected_overflow = 0 },
    .{ .a = -0x200000,           .b = 0x3FFFFFFFFFF,       .expected = -0x7FFFFFFFFFE00000, .expected_overflow = 0 },
    .{ .a = 0x200000,            .b = -0x3FFFFFFFFFF,      .expected = -0x7FFFFFFFFFE00000, .expected_overflow = 0 },
    .{ .a = -0x200000,           .b = -0x3FFFFFFFFFF,      .expected = 0x7FFFFFFFFFE00000,  .expected_overflow = 0 },
    .{ .a = 0x7FFFFFFFFFFFFFFF,  .b = -2,                  .expected = 2,                   .expected_overflow = 1 },
    .{ .a = -2,                  .b = 0x7FFFFFFFFFFFFFFF,  .expected = 2,                   .expected_overflow = 1 },
    .{ .a = 0x7FFFFFFFFFFFFFFF,  .b = -1,                  .expected = -0x7FFFFFFFFFFFFFFF, .expected_overflow = 0 },
    .{ .a = -1,                  .b = 0x7FFFFFFFFFFFFFFF,  .expected = -0x7FFFFFFFFFFFFFFF, .expected_overflow = 0 },
    .{ .a = 0x7FFFFFFFFFFFFFFF,  .b = 0,                   .expected = 0,                   .expected_overflow = 0 },
    .{ .a = 0,                   .b = 0x7FFFFFFFFFFFFFFF,  .expected = 0,                   .expected_overflow = 0 },
    .{ .a = 0x7FFFFFFFFFFFFFFF,  .b = 1,                   .expected = 0x7FFFFFFFFFFFFFFF,  .expected_overflow = 0 },
    .{ .a = 1,                   .b = 0x7FFFFFFFFFFFFFFF,  .expected = 0x7FFFFFFFFFFFFFFF,  .expected_overflow = 0 },
    .{ .a = 0x7FFFFFFFFFFFFFFF,  .b = 2,                   .expected = -0x7FFFFFFFFFFFFFFF, .expected_overflow = 1 },
    .{ .a = 2,                   .b = 0x7FFFFFFFFFFFFFFF,  .expected = -0x7FFFFFFFFFFFFFFF, .expected_overflow = 1 },
    .{ .a = -0x8000000000000000, .b = -2,                  .expected = -0x8000000000000000, .expected_overflow = 1 },
    .{ .a = -2,                  .b = -0x8000000000000000, .expected = -0x8000000000000000, .expected_overflow = 1 },
    .{ .a = -0x8000000000000000, .b = -1,                  .expected = -0x8000000000000000, .expected_overflow = 1 },
    .{ .a = -1,                  .b = -0x8000000000000000, .expected = -0x8000000000000000, .expected_overflow = 1 },
    .{ .a = -0x8000000000000000, .b = 0,                   .expected = 0,                   .expected_overflow = 0 },
    .{ .a = 0,                   .b = -0x8000000000000000, .expected = 0,                   .expected_overflow = 0 },
    .{ .a = -0x8000000000000000, .b = 1,                   .expected = -0x8000000000000000, .expected_overflow = 0 },
    .{ .a = 1,                   .b = -0x8000000000000000, .expected = -0x8000000000000000, .expected_overflow = 0 },
    .{ .a = -0x8000000000000000, .b = 2,                   .expected = -0x8000000000000000, .expected_overflow = 1 },
    .{ .a = 2,                   .b = -0x8000000000000000, .expected = -0x8000000000000000, .expected_overflow = 1 },
    .{ .a = -0x7FFFFFFFFFFFFFFF, .b = -2,                  .expected = -0x7FFFFFFFFFFFFFFF, .expected_overflow = 1 },
    .{ .a = -2,                  .b = -0x7FFFFFFFFFFFFFFF, .expected = -0x7FFFFFFFFFFFFFFF, .expected_overflow = 1 },
    .{ .a = -0x7FFFFFFFFFFFFFFF, .b = -1,                  .expected = 0x7FFFFFFFFFFFFFFF,  .expected_overflow = 0 },
    .{ .a = -1,                  .b = -0x7FFFFFFFFFFFFFFF, .expected = 0x7FFFFFFFFFFFFFFF,  .expected_overflow = 0 },
    .{ .a = -0x7FFFFFFFFFFFFFFF, .b = 0,                   .expected = 0,                   .expected_overflow = 0 },
    .{ .a = 0,                   .b = -0x7FFFFFFFFFFFFFFF, .expected = 0,                   .expected_overflow = 0 },
    .{ .a = -0x7FFFFFFFFFFFFFFF, .b = 1,                   .expected = -0x7FFFFFFFFFFFFFFF, .expected_overflow = 0 },
    .{ .a = 1,                   .b = -0x7FFFFFFFFFFFFFFF, .expected = -0x7FFFFFFFFFFFFFFF, .expected_overflow = 0 },
    .{ .a = -0x7FFFFFFFFFFFFFFF, .b = 2,                   .expected = -0x8000000000000000, .expected_overflow = 1 },
    .{ .a = 2,                   .b = -0x7FFFFFFFFFFFFFFF, .expected = -0x8000000000000000, .expected_overflow = 1 },
};
