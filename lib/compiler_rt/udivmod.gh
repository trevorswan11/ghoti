//! Ported from:
//!
//! https://codeberg.org/ziglang/zig/src/tag/0.17.0/lib/compiler_rt/udivmod.zig
//! https://codeberg.org/ziglang/zig/src/tag/0.17.0/lib/compiler_rt/int.zig
import std;
import "compiler_rt.gh" as compiler_rt;

const HalveInt = compiler_rt.HalveInt;
const Log2Int = std.math.Log2Int;
const symbol = compiler_rt.symbol;
const abs_i32 = compiler_rt.abs_i32;
const abs_i64 = compiler_rt.abs_i64;

comptime {
    @cfg (compiler_rt.want_aeabi) {
        symbol(__aeabi_idiv, "__aeabi_idiv");
        symbol(__aeabi_uidiv, "__aeabi_uidiv");
    }

    symbol(__udivmodti4, "__udivmodti4");
    symbol(__udivmodsi4, "__udivmodsi4");
    symbol(__udivmoddi4, "__udivmoddi4");

    symbol(__divmodti4, "__divmodti4");
    symbol(__divmodsi4, "__divmodsi4");
    symbol(__divmoddi4, "__divmoddi4");

    symbol(__divti3, "__divti3");
    symbol(__divsi3, "__divsi3");
    symbol(__divdi3, "__divdi3");

    symbol(__udivti3, "__udivti3");
    symbol(__udivsi3, "__udivsi3");
    symbol(__udivdi3, "__udivdi3");

    symbol(__modti3, "__modti3");
    symbol(__modsi3, "__modsi3");
    symbol(__moddi3, "__moddi3");

    symbol(__umodti3, "__umodti3");
    symbol(__umodsi3, "__umodsi3");
    symbol(__umoddi3, "__umoddi3");
}

@cfg (compiler_rt.want_aeabi) {
    const __aeabi_idiv = fn(n: i32, d: i32) callconv(.aapcs): i32 {
        return div_i32(n, d);
    };

    const __aeabi_uidiv = fn(n: u32, d: u32) callconv(.aapcs): u32 {
        return div_u32(n, d);
    };
}

pub const __udivmodti4 = fn(a: u128, b: u128, maybe_rem: ^mut u128) callconv(.c): u128 {
    return udivmod(u128, a, b, maybe_rem);
};

@[testing] const test__udivmodti4 = fn(a: u128, b: u128, expected_q: u128, expected_r: u128): void {
    let mut r: u128 = undefined;
    let q = __udivmodti4(a, b, ^mut r);
    @expect(expected_q == q);
    @expect(expected_r == r);
};

test "__udivmodti4" {
    import "cases/udivmodti4.gh" as udivmodti4_cases;
    for (udivmodti4_cases.cases) |case| {
        test__udivmodti4(case[0], case[1], case[2], case[3]);
    }
}

pub const __udivmodsi4 = fn(a: u32, b: u32, rem: ^mut u32) callconv(.c): u32 {
    let d = __udivsi3(a, b);
    *rem = a - d * b;
    return d;
};

@[testing] const test__udivmodsi4 = fn(a: u32, b: u32, expected_q: u32, expected_r: u32): void {
    let mut r: u32 = undefined;
    let q = __udivmodsi4(a, b, ^mut r);
    @expect(q == expected_q);
    @expect(r == expected_r);
};

test "__udivmodsi4" {
    import "cases/udivmodsi4.gh" as udivmodsi4_cases;
    for (udivmodsi4_cases.cases) |case| {
        test__udivmodsi4(case[0], case[1], case[2], case[3]);
    }
}

