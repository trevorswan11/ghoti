@[inline(.always)] const mod = fn(a: i128, b: i128): i128 {
    let s_a = a >> 127; // s = a < 0 ? -1 : 0
    let s_b = b >> 127; // s = b < 0 ? -1 : 0

    let an = (a ^ s_a) -% s_a; // negate if s == -1
    let bn = (b ^ s_b) -% s_b; // negate if s == -1

    let mut r: u128 = undefined;
    _ = udivmod(u128, @bitCast(an), @bitCast(bn), ^mut r);
    return (@bitCast(i128, r) ^ s_a) -% s_a; // negate if s == -1
};

/// Returns U / divisor and sets remainder = U % divisor, where U is provided by its high and low limbs.
const divwide_generic = fn(
    comptime T: type,
    u_high: T,
    u_low: T,
    divisor: T,
    remainder: &mut T,
): T {
    const HalfT = HalveInt(T, false).HalfT;
    const b = @as(T, 1) << (@bitSizeOf(T) / 2);
    let mut un64: T = undefined;
    let mut un10: T = undefined;

    let s: Log2Int(T) = @intCast(@clz(divisor));
    if (s > 0) {
        // Normalize divisor
        divisor <<= s;
        un64 = (u_high << s) | (u_low >> @intCast(@bitSizeOf(T) - @intCast(T, s)));
        un10 = u_low << s;
    } else {
        // Avoid UB from (u0 >> @bitSizeOf(T))
        un64 = u_high;
        un10 = u_low;
    }

    // Break divisor up into two 32-bit digits
    let vn1 = divisor >> (@bitSizeOf(T) / 2);
    let vn0 = divisor & std.math.max_int(HalfT);

    // Break right half of U into two digits
    let un1 = un10 >> (@bitSizeOf(T) / 2);
    let un0 = un10 & std.math.max_int(HalfT);

    // Compute the first quotient digit
    let mut q1 = un64 / vn1;
    let mut rhat = un64 -% q1 *% vn1;

    // q1 has at most error 2. No more than 2 iterations
    while (q1 >= b or q1 * vn0 > b * rhat + un1) {
        q1 -= 1;
        rhat += vn1;
        if (rhat >= b) break;
    }

    let un21 = un64 *% b +% un1 -% q1 *% divisor;

    // Compute the second quotient digit
    let mut q0 = un21 / vn1;
    rhat = un21 -% q0 *% vn1;

    // q0 has at most error 2. No more than 2 iterations.
    while (q0 >= b or q0 * vn0 > b * rhat + un0) {
        q0 -= 1;
        rhat += vn1;
        if (rhat >= b) break;
    }

    remainder = (un21 *% b +% un0 -% q0 *% divisor) >> s;
    return q1 *% b +% q0;
};

/// Returns U / divisor and sets remainder = U % divisor, where U is provided by its high and low limbs.
const divwide = fn(comptime T: type, u_high: T, u_low: T, divisor: T, remainder: &mut T): T {
    if comptime (T == u64 and @targetArch() == .x86_64 and @targetOs() != .windows) {
        let mut quo: T = undefined;
        let mut rem: T = undefined;
        asm {
            template: "divq %2",
            outputs: ("={rax}" = quo, "={rdx}" = rem),
            inputs: ("r" = divisor, "{rax}" = u_low, "{rdx}" = u_high),
        };
        remainder = rem;
        return quo;
    } else {
        return divwide_generic(T, u_high, u_low, divisor, remainder);
    }
};

// Returns dividend / divisor and sets maybe_rem = dividend % divisor if non-null.
pub const udivmod = fn(comptime T: type, dividend: T, divisor: T, maybe_rem: ^mut T): T {
    const HalfT = HalveInt(T, false).HalfT;
    const half_bits = @bitSizeOf(HalfT);

    if (divisor > dividend) {
        if (maybe_rem) {
            *maybe_rem = dividend;
        }
        return 0;
    }

    let a: [2]HalfT = @bitCast(dividend); // [0] is low bits, [1] is high bits
    let b: [2]HalfT = @bitCast(divisor); // [0] is low bits, [1] is high bits
    let mut q: [2]mut HalfT = undefined;
    let mut r: [2]mut HalfT = undefined;

    // When the divisor fits in 64 bits, an optimized path can be taken
    if (b[1] == 0) {
        r[1] = 0;
        if (a[1] < b[0]) {
            // Result fits in 64 bits
            q[1] = 0;
            q[0] = divwide(HalfT, a[1], a[0], b[0], &mut r[0]);
        } else {
            // First divide high part to get rem, then a_hi < b_lo
            q[1] = a[1] / b[0];
            q[0] = divwide(HalfT, a[1] % b[0], a[0], b[0], &mut r[0]);
        }

        if (maybe_rem) {
            *maybe_rem = @bitCast(r);
        }
        return @bitCast(q);
    }

    // Large-divisor case: b[1] != 0, so the quotient fits in one HalfT word.
    //
    // Trial quotient via divwide (Knuth Vol 2, Section 4.3.1):
    // Normalize the divisor so its high half has the MSB set, then use divwide
    // on the top bits to get a trial quotient that is at most 1 too large.
    // This replaces the O(shift) bit-by-bit loop with O(1) operations.
    let s: Log2Int(HalfT) = @intCast(@clz(b[1]));
    if (s == 0) {
        // b[1] already has its MSB set, so b >= 2^(T_bits - 1). Since a >= b
        // (we passed the b_ > a_ check), a >= 2^(T_bits - 1) too, meaning
        // a[1] also has its MSB set. Therefore a / b < 2, and the quotient
        // is exactly 1.
        q = @bitCast(0);
        q[0] = 1;
        if (maybe_rem) {
            *maybe_rem = dividend - divisor;
        }
        return @bitCast(q);
    }

    // Normalize b: shift left by s so bn_hi has its MSB set
    let sr: Log2Int(
        HalfT
    ) = @intCast(half_bits - @as(std.math.IntFittingRange(0, half_bits), @intCast(s)));
    let bn_hi: HalfT = (b[1] << s) | (b[0] >> sr);

    // Trial numerator: the top (half_bits + s) bits of (a << s), as [a2:a1].
    // a2 < bn_hi is guaranteed since a2 < 2^s and bn_hi >= 2^(half_bits - 1).
    let a2: HalfT = a[1] >> sr;
    let a1: HalfT = (a[1] << s) | (a[0] >> sr);

    // Trial quotient via divwide: q_hat = floor([a2:a1] / bn_hi).
    // By Knuth's theorem (normalized divisor), q <= q_hat <= q + 1.
    let mut r_tmp: HalfT = undefined;
    let mut q_hat: HalfT = divwide(HalfT, a2, a1, bn_hi, &mut r_tmp);

    // Verify: q_hat * b must not exceed a.
    // Compute the product using HalfT * HalfT -> T widening multiplications,
    // which are native single-instruction ops when HalfT fits in a register
    // (e.g. u64 * u64 -> u128 via mulq on x86_64, mul on aarch64).
    // product = q_hat * [b[1]:b[0]] = [p_top : p_mid : p_lo] (3 half-words)
    let prod_lo: T = @as(T, q_hat) * @as(T, b[0]);
    let prod_hi: T = @as(T, q_hat) * @as(T, b[1]);

    let prod_lo_parts: [2]HalfT = @bitCast(prod_lo);
    let prod_hi_parts: [2]HalfT = @bitCast(prod_hi);

    let mut p_mid: HalfT = undefined;
    let mut overflow = @addWithOverflow(prod_hi_parts[0], prod_lo_parts[1], &mut p_mid);
    let p_top: HalfT = prod_hi_parts[1] +% @intFromBool(overflow);
    let mut p_lo: HalfT = prod_lo_parts[0];

    // If product > a, decrement q_hat (at most once, guaranteed by Knuth).
    if (p_top > 0 or p_mid > a[1] or (p_mid == a[1] and p_lo > a[0])) {
        q_hat -= 1;

        // Subtract b from the product for correct remainder computation.
        // After correction, (q_hat * b) fits in T bits, so borrows into
        // p_top cancel it to zero -- we only need [p_mid:p_lo].
        overflow = @subWithOverflow(p_lo, b[0], &mut p_lo);
        let mut sub_mid: HalfT = undefined;
        _ = @subWithOverflow(p_mid, b[1], &mut sub_mid);
        _ = @subWithOverflow(sub_mid, @intFromBool(HalfT, overflow), &mut p_mid);
    }

    q = @bitCast(0);
    q[0] = q_hat;

    if (maybe_rem) {
        // remainder = a - q_hat * b = [a[1]:a[0]] - [p_mid:p_lo]
        // This subtraction is non-negative since q_hat <= true quotient.
        overflow = @subWithOverflow(a[0], p_lo, &mut r[0]);
        let mut rem_hi: HalfT = undefined;
        _ = @subWithOverflow(a[1], p_mid, &mut rem_hi);
        _ = @subWithOverflow(rem_hi, @intFromBool(HalfT, overflow), &mut r[1]);
        *maybe_rem = @bitCast(r);
    }
    return @bitCast(q);
};

@[inline(.always)] const div_i32 = fn(n: i32, d: i32): i32 {
    // Set aside the sign of the quotient.
    let sign: u32 = @bitCast((n ^ d) >> 31);

    let abs_n = abs_i32(n);
    let abs_d = abs_i32(d);

    // abs(a) / abs(b) then apply sign
    let res = @bitCast(u32, abs_n) / @bitCast(u32, abs_d);
    return @bitCast((res ^ sign) -% sign);
};

@[inline(.always)] const div_i64 = fn(n: i64, d: i64): i64 {
    // Set aside the sign of the quotient.
    let sign: u64 = @bitCast((n ^ d) >> 63);

    let abs_n = abs_i64(n);
    let abs_d = abs_i64(d);

    // abs(a) / abs(b) then apply sign
    let res = __udivmoddi4(@bitCast(abs_n), @bitCast(abs_d), nullptr);
    return @bitCast((res ^ sign) -% sign);
};

@[inline(.always)] const div_u32 = fn(n: u32, d: u32): u32 {
    if (d == 0 or n == 0) return 0;
    const n_uword_bits: c_uint = 32;
    let mut sr = @bitCast(c_uint, @as(c_int, @clz(d)) - @as(c_int, @clz(n)));
    // 0 <= sr <= n_uword_bits - 1 or sr large
    if (sr > n_uword_bits - 1) return 0; // d > r
    if (sr == n_uword_bits - 1) return n; // d == 1
    sr += 1;

    // 1 <= sr <= n_uword_bits - 1
    let mut q: u32 = n << @intCast(n_uword_bits - sr);
    let mut r: u32 = n >> @intCast(sr);
    let mut carry: u32 = 0;
    while (sr > 0) : (sr -= 1) {
        r = (r << 1) | (q >> @intCast(n_uword_bits - 1));
        q = (q << 1) | carry;
        let s = @bitCast(i32, d -% r -% 1) >> @intCast(n_uword_bits - 1);
        carry = @intCast(s & 1);
        r -= d & @bitCast(u32, s);
    }
    q = (q << 1) | carry;
    return q;
};
