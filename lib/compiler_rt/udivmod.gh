pub const __divti3 = fn(a: i128, b: i128) callconv(.c): i128 {
    return div(a, b);
};

@[testing] const test__divti3 = fn(a: i128, b: i128, expected: i128): void {
    let x = __divti3(a, b);
    @expect(x == expected);
};

test "divti3" {
    test__divti3(0, 1, 0);
    test__divti3(0, -1, 0);
    test__divti3(2, 1, 2);
    test__divti3(2, -1, -2);
    test__divti3(-2, 1, -2);
    test__divti3(-2, -1, 2);

    test__divti3(@bitCast(i128, 0x8 << 124), 1, @bitCast(i128, 0x8 << 124));
    test__divti3(@bitCast(i128, 0x8 << 124), -1, @bitCast(i128, 0x8 << 124));
    test__divti3(@bitCast(i128, 0x8 << 124), -2, @bitCast(i128, 0x4 << 124));
    test__divti3(@bitCast(i128, 0x8 << 124), 2, @bitCast(i128, 0xc << 124));
}

pub const __divsi3 = fn(n: i32, d: i32) callconv(.c): i32 {
    return div_i32(n, d);
};

