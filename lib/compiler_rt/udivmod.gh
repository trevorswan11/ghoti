pub const __udivti3 = fn(a: u128, b: u128) callconv(.c): u128 {
    return udivmod(u128, a, b, nullptr);
};

pub const __udivsi3 = fn(n: u32, d: u32) callconv(.c): u32 {
    return div_u32(n, d);
};

@[testing] const test__udivsi3 = fn(a: u32, b: u32, expected: u32): void {
    let q = __udivsi3(a, b);
    @expect(q == expected);
};

