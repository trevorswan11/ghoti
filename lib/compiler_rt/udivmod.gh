        [_]i32{ 0, 1, 0, 0 },
        [_]i32{ 0, -1, 0, 0 },
        [_]i32{ 2, 1, 2, 0 },
        [_]i32{ 2, -1, -2, 0 },
        [_]i32{ -2, 1, -2, 0 },
        [_]i32{ -2, -1, 2, 0 },
        [_]i32{ 7, 5, 1, 2 },
        [_]i32{ -7, 5, -1, -2 },
        [_]i32{ 19, 5, 3, 4 },
        [_]i32{ 19, -5, -3, 4 },
        [_]i32{ @bitCast(0x80000000u32), 8, @bitCast(0xf0000000u32), 0 },
        [_]i32{ @bitCast(0x80000007u32), 8, @bitCast(0xf0000001u32), -1 },
    };

    for (cases) |case| {
        test__divmodsi4(case[0], case[1], case[2], case[3]);
    }
}

