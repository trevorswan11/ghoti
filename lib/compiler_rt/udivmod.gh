test "__udivmoddi4" {
    @skip(); // TODO(tcs): Integer divison by zero panic
    import "cases/udivmoddi4.gh" as udivmoddi4_cases;
    for (udivmoddi4_cases.cases) |case| {
        test__udivmodti4(case[0], case[1], case[2], case[3]);
    }
}

pub const __divmodti4 = fn(a: i128, b: i128, rem: ^mut i128) callconv(.c): i128 {
    let d = __divti3(a, b);
    *rem = a - d *% b;
    return d;
};

@[testing] const test__divmodti4 = fn(a: i128, b: i128, expected_q: i128, expected_r: i128): void {
    let mut r: i128 = undefined;
    let q = __divmodti4(a, b, ^mut r);
    @expect(q == expected_q);
    @expect(r == expected_r);
};

test "__divmodti4" {
    const cases = [_][4]i128{
        [_]i128{ 0, 1, 0, 0 },
        [_]i128{ 0, -1, 0, 0 },
        [_]i128{ 2, 1, 2, 0 },
        [_]i128{ 2, -1, -2, 0 },
        [_]i128{ -2, 1, -2, 0 },
        [_]i128{ -2, -1, 2, 0 },
        [_]i128{ 7, 5, 1, 2 },
        [_]i128{ -7, 5, -1, -2 },
        [_]i128{ 19, 5, 3, 4 },
        [_]i128{ 19, -5, -3, 4 },
        [_]i128{
            @bitCast(0x80000000000000000000000000000000u128),
            8,
            @bitCast(0xf0000000000000000000000000000000u128),
            0,
        },
        [_]i128{
            @bitCast(0x80000000000000000000000000000007u128),
            8,
            @bitCast(0xf0000000000000000000000000000001u128),
            -1,
        },
    };

    for (cases) |case| {
        test__divmodti4(case[0], case[1], case[2], case[3]);
    }
}

pub const __divmodsi4 = fn(a: i32, b: i32, rem: ^mut i32) callconv(.c): i32 {
    let d = __divsi3(a, b);
    *rem = a - d *% b;
    return d;
};

