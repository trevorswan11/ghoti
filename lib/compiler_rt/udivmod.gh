pub const __udivdi3 = fn(a: u64, b: u64) callconv(.c): u64 {
    return __udivmoddi4(a, b, nullptr);
};

@[inline(.always)] const div = fn(a: i128, b: i128): i128 {
    let s_a = a >> 127; // s = a < 0 ? -1 : 0
    let s_b = b >> 127; // s = b < 0 ? -1 : 0

    let an = (a ^ s_a) -% s_a; // negate if s == -1
    let bn = (b ^ s_b) -% s_b; // negate if s == -1

    let r = udivmod(u128, @bitCast(an), @bitCast(bn), nullptr);
    let s = s_a ^ s_b;
    return (@bitCast(i128, r) ^ s) -% s; // negate if s == -1
};

pub const __modti3 = fn(a: i128, b: i128) callconv(.c): i128 {
    return mod(a, b);
};

@[testing] const test__modti3 = fn(a: i128, b: i128, expected: i128): void {
    let x = __modti3(a, b);
    @expect(x == expected);
};

test "__modti3" {
    test__modti3(0, 1, 0);
    test__modti3(0, -1, 0);
    test__modti3(5, 3, 2);
    test__modti3(5, -3, 2);
    test__modti3(-5, 3, -2);
    test__modti3(-5, -3, -2);

    test__modti3(0x8000000000000000, 1, 0x0);
    test__modti3(0x8000000000000000, -1, 0x0);
    test__modti3(0x8000000000000000, 2, 0x0);
    test__modti3(0x8000000000000000, -2, 0x0);
    test__modti3(0x8000000000000000, 3, 2);
    test__modti3(0x8000000000000000, -3, 2);

    const make_ti = fn(high: u64, low: u64): i128 {
        let mut result: u128 = high;
        result <<= 64;
        result |= low;
        return @bitCast(result);
    };

    test__modti3(make_ti(0x8000000000000000, 0), 1, 0x0);
    test__modti3(make_ti(0x8000000000000000, 0), -1, 0x0);
    test__modti3(make_ti(0x8000000000000000, 0), 2, 0x0);
    test__modti3(make_ti(0x8000000000000000, 0), -2, 0x0);
    test__modti3(make_ti(0x8000000000000000, 0), 3, -2);
    test__modti3(make_ti(0x8000000000000000, 0), -3, -2);
}

pub const __modsi3 = fn(n: i32, d: i32) callconv(.c): i32 {
    return n - __divsi3(n, d) *% d;
};

@[testing] const test__modsi3 = fn(a: i32, b: i32, expected_r: i32): void {
    let r = __modsi3(a, b);
    @expect(r == expected_r);
};

test "__modsi3" {
    const cases = [_][3]i32{
        [_]i32{ 0, 1, 0 },
        [_]i32{ 0, -1, 0 },
        [_]i32{ 5, 3, 2 },
        [_]i32{ 5, -3, 2 },
        [_]i32{ -5, 3, -2 },
        [_]i32{ -5, -3, -2 },
        [_]i32{ @bitCast(0x80000000u32), 1, 0x0 },
        [_]i32{ @bitCast(0x80000000u32), 2, 0x0 },
        [_]i32{ @bitCast(0x80000000u32), -2, 0x0 },
        [_]i32{ @bitCast(0x80000000u32), 3, -2 },
        [_]i32{ @bitCast(0x80000000u32), -3, -2 },
    };

    for (cases) |case| {
        test__modsi3(case[0], case[1], case[2]);
    }
}

pub const __moddi3 = fn(a: i64, b: i64) callconv(.c): i64 {
    let abs_a = abs_i64(a);
    let abs_b = abs_i64(b);
    let mut r: u64 = undefined;
    _ = __udivmoddi4(@bitCast(abs_a), @bitCast(abs_b), ^mut r);
    return (@bitCast(i64, r) ^ (a >> 63)) -% (a >> 63);
};

@[testing] const test__moddi3 = fn(a: i64, b: i64, expected_r: i64): void {
    let r = __moddi3(a, b);
    @expect(r == expected_r);
};

test "__moddi3" {
    const cases = [_][3]i64{
        [_]i64{ 0, 1, 0 },
        [_]i64{ 0, -1, 0 },
        [_]i64{ 5, 3, 2 },
        [_]i64{ 5, -3, 2 },
        [_]i64{ -5, 3, -2 },
        [_]i64{ -5, -3, -2 },
        [_]i64{ @bitCast(0x8000000000000000u64), 1, 0 },
        [_]i64{ @bitCast(0x8000000000000000u64), -1, 0 },
        [_]i64{ @bitCast(0x8000000000000000u64), 2, 0 },
        [_]i64{ @bitCast(0x8000000000000000u64), -2, 0 },
        [_]i64{ @bitCast(0x8000000000000000u64), 3, -2 },
        [_]i64{ @bitCast(0x8000000000000000u64), -3, -2 },
    };

    for (cases) |case| {
        test__moddi3(case[0], case[1], case[2]);
    }
}

