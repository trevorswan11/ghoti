//! The `__atomic_*` routines LLVM calls when an atomic access can't be lowered inline
//! Ported from:
//!
//! https://codeberg.org/ziglang/zig/src/tag/0.17.0/lib/compiler_rt/atomics.zig
import std;
import "compiler_rt.gh" as compiler_rt;

const math = std.math;
const symbol = compiler_rt.symbol;

const AtomicRmwOp = builtin.AtomicRmwOp;

/// ARMv6-M has no ldrex/strex, so it can't CAS at all (Linux offers a kernel helper for it, which
/// isn't wired up here). LLVM also sets `v6m` on every later core, so ARMv6-M is the one with it
/// but neither `v6t2` (ARMv7 and up) nor `v8m`.
const is_armv6m = @cfgValue((arch == .arm or arch == .thumb) and cpu.has(.v6m) and
    !cpu.has(.v6t2) and
    !cpu.has(.v8m));

/// A RISC-V without the `A` extension, like the bare-metal `generic` CPU, has no atomics at all
const is_riscv_without_atomics = @cfgValue((arch == .riscv32 or arch == .riscv64) and !cpu.has(.a));

/// This constant is true iff the target architecture supports the bare minimum
/// to implement the atomic load/store intrinsics.
/// Some architectures support atomic load/stores but no CAS, but we ignore this
/// detail to keep the export logic clean and because we need some kind of CAS to
/// implement the spinlocks.
const supports_atomic_ops = @cfgValue(!is_armv6m and !is_riscv_without_atomics);

const is_sparc = @cfgValue(arch == .sparc or arch == .sparc64);
const is_little_endian = @cfgValue(endian == .little);

/// A SPARC without CAS or swap only has test-and-set (`ldstub`), so every access takes the lock.
const sparc_without_cas = @cfgValue(arch == .sparc);

/// The size in bytes of the biggest object the target can load/store atomically.
/// Anything bigger goes through a spinlock.
// TODO: x86/x86_64 could check for cmpxchg8b/cmpxchg16b and raise this accordingly
const largest_atomic_size: usize = if comptime (sparc_without_cas) 0 else @sizeOf(usize);

/// The size in bytes of the smallest object the target can fetch/exchange atomically; loads and
/// stores are not included. Anything smaller is emulated with a CAS on the containing word.
/// Every target ghoti supports handles single bytes. Zig raises this to 4 for AMDGCN, which has
/// no atomics besides load and store (as of LLVM 15).
const smallest_atomic_fetch_exch_size: usize = 1;

const cache_line_size = 64;

/// SPARC's `ldstub` writes 255 into the lock byte, so that's what marks it as held there.
/// See section B.7 of the SPARCv8 spec and A.29 of the SPARCv9 spec.
const LockWord = if comptime (is_sparc) u8 else usize;
const unlocked: LockWord = 0;
const locked: LockWord = if comptime (is_sparc) 255 else 1;

const Spinlock = struct {
    /// Padded out to a cache line so neighboring locks never share one
    @[align(cache_line_size)] pub v: LockWord = unlocked,

    pub const acquire = fn(&mut self): void {
        loop {
            let mut flag: LockWord = undefined;
            if comptime (is_sparc) {
                asm {
                    template: "ldstub [%1], %0",
                    outputs: ("=r" = flag),
                    inputs: ("r" = ^mut self.v),
                    clobbers: ("memory"),
                    options: (volatile),
                };
            } else {
                flag = @atomicRmw(LockWord, ^mut self.v, .xchg, locked, .acquire);
            }
            if (flag == unlocked) {
                return;
            }
        }
    };

    pub const release = fn(&mut self): void {
        if comptime (is_sparc) {
            asm {
                template: "clrb [%0]",
                inputs: ("r" = ^mut self.v),
                clobbers: ("memory"),
                options: (volatile),
            };
        } else {
            @atomicStore(^mut self.v, unlocked, .release);
        }
    };
};

// Allocate ~4096 bytes of memory for the spinlock table
const max_spinlocks = 64;

const SpinlockTable = struct {
    // TODO(tcs) #458: Use a splat if possible
    pub list: [max_spinlocks]mut Spinlock = unlocked_list(),

    /// Acquires the lock guarding `address`
    pub const get = fn(&mut self, address: usize): &mut Spinlock {
        let sl = &mut self.list[(address >> 3) % max_spinlocks];
        sl.acquire();
        return sl;
    };
};

const unlocked_list = fn(): [max_spinlocks]mut Spinlock {
    let mut list: [max_spinlocks]mut Spinlock = undefined;
    for (0..max_spinlocks) |i| {
        list[i] = .{};
    }
    return list;
};

let mut spinlocks: SpinlockTable = .{};

@cfg (supports_atomic_ops) {
    comptime {
        symbol(__atomic_load, "__atomic_load");
        symbol(__atomic_store, "__atomic_store");
        symbol(__atomic_exchange, "__atomic_exchange");
        symbol(__atomic_compare_exchange, "__atomic_compare_exchange");

        symbol(__atomic_fetch_add_1, "__atomic_fetch_add_1");
        symbol(__atomic_fetch_add_2, "__atomic_fetch_add_2");
        symbol(__atomic_fetch_add_4, "__atomic_fetch_add_4");
        symbol(__atomic_fetch_add_8, "__atomic_fetch_add_8");
        symbol(__atomic_fetch_add_16, "__atomic_fetch_add_16");

        symbol(__atomic_fetch_sub_1, "__atomic_fetch_sub_1");
        symbol(__atomic_fetch_sub_2, "__atomic_fetch_sub_2");
        symbol(__atomic_fetch_sub_4, "__atomic_fetch_sub_4");
        symbol(__atomic_fetch_sub_8, "__atomic_fetch_sub_8");
        symbol(__atomic_fetch_sub_16, "__atomic_fetch_sub_16");

        symbol(__atomic_fetch_and_1, "__atomic_fetch_and_1");
        symbol(__atomic_fetch_and_2, "__atomic_fetch_and_2");
        symbol(__atomic_fetch_and_4, "__atomic_fetch_and_4");
        symbol(__atomic_fetch_and_8, "__atomic_fetch_and_8");
        symbol(__atomic_fetch_and_16, "__atomic_fetch_and_16");

        symbol(__atomic_fetch_or_1, "__atomic_fetch_or_1");
        symbol(__atomic_fetch_or_2, "__atomic_fetch_or_2");
        symbol(__atomic_fetch_or_4, "__atomic_fetch_or_4");
        symbol(__atomic_fetch_or_8, "__atomic_fetch_or_8");
        symbol(__atomic_fetch_or_16, "__atomic_fetch_or_16");

        symbol(__atomic_fetch_xor_1, "__atomic_fetch_xor_1");
        symbol(__atomic_fetch_xor_2, "__atomic_fetch_xor_2");
        symbol(__atomic_fetch_xor_4, "__atomic_fetch_xor_4");
        symbol(__atomic_fetch_xor_8, "__atomic_fetch_xor_8");
        symbol(__atomic_fetch_xor_16, "__atomic_fetch_xor_16");

        symbol(__atomic_fetch_nand_1, "__atomic_fetch_nand_1");
        symbol(__atomic_fetch_nand_2, "__atomic_fetch_nand_2");
        symbol(__atomic_fetch_nand_4, "__atomic_fetch_nand_4");
        symbol(__atomic_fetch_nand_8, "__atomic_fetch_nand_8");
        symbol(__atomic_fetch_nand_16, "__atomic_fetch_nand_16");

        symbol(__atomic_fetch_umax_1, "__atomic_fetch_umax_1");
        symbol(__atomic_fetch_umax_2, "__atomic_fetch_umax_2");
        symbol(__atomic_fetch_umax_4, "__atomic_fetch_umax_4");
        symbol(__atomic_fetch_umax_8, "__atomic_fetch_umax_8");
        symbol(__atomic_fetch_umax_16, "__atomic_fetch_umax_16");

        symbol(__atomic_fetch_umin_1, "__atomic_fetch_umin_1");
        symbol(__atomic_fetch_umin_2, "__atomic_fetch_umin_2");
        symbol(__atomic_fetch_umin_4, "__atomic_fetch_umin_4");
        symbol(__atomic_fetch_umin_8, "__atomic_fetch_umin_8");
        symbol(__atomic_fetch_umin_16, "__atomic_fetch_umin_16");

        symbol(__atomic_load_1, "__atomic_load_1");
        symbol(__atomic_load_2, "__atomic_load_2");
        symbol(__atomic_load_4, "__atomic_load_4");
        symbol(__atomic_load_8, "__atomic_load_8");
        symbol(__atomic_load_16, "__atomic_load_16");

        symbol(__atomic_store_1, "__atomic_store_1");
        symbol(__atomic_store_2, "__atomic_store_2");
        symbol(__atomic_store_4, "__atomic_store_4");
        symbol(__atomic_store_8, "__atomic_store_8");
        symbol(__atomic_store_16, "__atomic_store_16");

        symbol(__atomic_exchange_1, "__atomic_exchange_1");
        symbol(__atomic_exchange_2, "__atomic_exchange_2");
        symbol(__atomic_exchange_4, "__atomic_exchange_4");
        symbol(__atomic_exchange_8, "__atomic_exchange_8");
        symbol(__atomic_exchange_16, "__atomic_exchange_16");

        symbol(__atomic_compare_exchange_1, "__atomic_compare_exchange_1");
        symbol(__atomic_compare_exchange_2, "__atomic_compare_exchange_2");
        symbol(__atomic_compare_exchange_4, "__atomic_compare_exchange_4");
        symbol(__atomic_compare_exchange_8, "__atomic_compare_exchange_8");
        symbol(__atomic_compare_exchange_16, "__atomic_compare_exchange_16");
    }
}

// Every routine below ignores the requested memory model and uses seq_cst, the strongest one.

// Generic version of GCC atomic builtin functions.
// Those work on any object no matter the pointer alignment nor its size.

const __atomic_load = fn(size: u32, src: ^u8, dest: ^mut u8, model: i32) callconv(.c): void {
    _ = model;
    let sl = spinlocks.get(@intFromPtr(src));
    defer sl.release();
    @memcpy(dest[0..size], src[0..size]);
};

const __atomic_store = fn(size: u32, dest: ^mut u8, src: ^u8, model: i32) callconv(.c): void {
    _ = model;
    let sl = spinlocks.get(@intFromPtr(dest));
    defer sl.release();
    @memcpy(dest[0..size], src[0..size]);
};

const __atomic_exchange = fn(
    size: u32,
    ptr: ^mut u8,
    val: ^u8,
    old: ^mut u8,
    model: i32,
) callconv(.c): void {
    _ = model;
    let sl = spinlocks.get(@intFromPtr(ptr));
    defer sl.release();
    @memcpy(old[0..size], ptr[0..size]);
    @memcpy(ptr[0..size], val[0..size]);
};

const __atomic_compare_exchange = fn(
    size: u32,
    ptr: ^mut u8,
    expected: ^mut u8,
    desired: ^u8,
    success: i32,
    failure: i32,
) callconv(.c): i32 {
    _ = success;
    _ = failure;
    let sl = spinlocks.get(@intFromPtr(ptr));
    defer sl.release();
    for (0..size) |i| {
        if (expected[i] != ptr[i]) {
            @memcpy(expected[0..size], ptr[0..size]);
            return 0;
        }
    }
    @memcpy(ptr[0..size], desired[0..size]);
    return 1;
};

// The sized GCC atomic builtins, which LLVM emits only when the object's size is known and its
// pointer is suitably aligned

@[inline(.always)] const atomic_load_n = fn(comptime T: type, src: ^mut T, model: i32): T {
    _ = model;
    if comptime (@sizeOf(T) > largest_atomic_size) {
        let sl = spinlocks.get(@intFromPtr(src));
        defer sl.release();
        return *src;
    } else {
        return @atomicLoad(T, src, .seq_cst);
    }
};

const __atomic_load_1 = fn(src: ^mut u8, model: i32) callconv(.c): u8 {
    return atomic_load_n(u8, src, model);
};

const __atomic_load_2 = fn(src: ^mut u16, model: i32) callconv(.c): u16 {
    return atomic_load_n(u16, src, model);
};

const __atomic_load_4 = fn(src: ^mut u32, model: i32) callconv(.c): u32 {
    return atomic_load_n(u32, src, model);
};

const __atomic_load_8 = fn(src: ^mut u64, model: i32) callconv(.c): u64 {
    return atomic_load_n(u64, src, model);
};

const __atomic_load_16 = fn(src: ^mut u128, model: i32) callconv(.c): u128 {
    return atomic_load_n(u128, src, model);
};

@[inline(.always)]
const atomic_store_n = fn(comptime T: type, dst: ^mut T, value: T, model: i32): void {
    _ = model;
    if comptime (@sizeOf(T) > largest_atomic_size) {
        let sl = spinlocks.get(@intFromPtr(dst));
        defer sl.release();
        *dst = value;
    } else {
        @atomicStore(dst, value, .seq_cst);
    }
};

const __atomic_store_1 = fn(dst: ^mut u8, value: u8, model: i32) callconv(.c): void {
    atomic_store_n(u8, dst, value, model);
};

const __atomic_store_2 = fn(dst: ^mut u16, value: u16, model: i32) callconv(.c): void {
    atomic_store_n(u16, dst, value, model);
};

const __atomic_store_4 = fn(dst: ^mut u32, value: u32, model: i32) callconv(.c): void {
    atomic_store_n(u32, dst, value, model);
};

const __atomic_store_8 = fn(dst: ^mut u64, value: u64, model: i32) callconv(.c): void {
    atomic_store_n(u64, dst, value, model);
};

const __atomic_store_16 = fn(dst: ^mut u128, value: u128, model: i32) callconv(.c): void {
    atomic_store_n(u128, dst, value, model);
};

/// What a read-modify-write `op` stores, given the `old` value in memory and the operand `val`
@[inline(.always)]
const apply_op = fn(comptime T: type, comptime op: AtomicRmwOp, old: T, val: T): T {
    return match comptime (op) {
        .xchg => val,
        .add => old +% val,
        .sub => old -% val,
        .band => old & val,
        .nand => ~(old & val),
        .bor => old | val,
        .bxor => old ^ val,
        .umax => @max(old, val),
        .umin => @min(old, val),
        _ => @compileError("unsupported atomic op"),
    };
};

/// Applies `op` to the `T` at `ptr` with a CAS loop over the `wide_size`-byte word containing it,
/// for targets that can't fetch/exchange anything narrower than that word. Returns the old value.
const wide_update = fn(
    comptime T: type,
    comptime wide_size: usize,
    comptime op: AtomicRmwOp,
    ptr: ^mut T,
    val: T,
): T {
    const Wide = @Int(.{ .signedness = .unsigned, .bits = wide_size * 8 });
    const Shift = math.Log2Int(Wide);

    let addr = @intFromPtr(ptr);
    let wide_ptr = @ptrFromInt(^mut Wide, addr & ~@as(usize, wide_size - 1));

    // How many bytes sit below `ptr`'s least significant byte within the word
    let offset = addr & (wide_size - 1);
    let byte_shift = if comptime (is_little_endian) offset else wide_size - offset - @sizeOf(T);
    let shift = @intCast(Shift, byte_shift * 8);
    let mask = @as(Wide, math.max_int(T)) << shift;

    let mut wide_old = @atomicLoad(Wide, wide_ptr, .seq_cst);
    let mut old: T = undefined;
    loop {
        old = @truncate(T, (wide_old & mask) >> shift);
        let new = apply_op(T, op, old, val);
        let wide_new = (wide_old & ~mask) | (@as(Wide, new) << shift);
        if (@cmpxchgWeak(Wide, wide_ptr, wide_old, wide_new, .seq_cst, .seq_cst, ^mut wide_old)) {
            break;
        }
    }
    return old;
};

/// Applies `op` to the `T` at `ptr` and returns the value it replaced
@[inline(.always)] const fetch_op_n = fn(
    comptime T: type,
    comptime op: AtomicRmwOp,
    ptr: ^mut T,
    val: T,
    model: i32,
): T {
    _ = model;
    if comptime (@sizeOf(T) > largest_atomic_size) {
        let sl = spinlocks.get(@intFromPtr(ptr));
        defer sl.release();
        let old = *ptr;
        *ptr = apply_op(T, op, old, val);
        return old;
    } else if comptime (@sizeOf(T) < smallest_atomic_fetch_exch_size) {
        return wide_update(T, smallest_atomic_fetch_exch_size, op, ptr, val);
    } else {
        return @atomicRmw(T, ptr, op, val, .seq_cst);
    }
};

const __atomic_exchange_1 = fn(ptr: ^mut u8, val: u8, model: i32) callconv(.c): u8 {
    return fetch_op_n(u8, .xchg, ptr, val, model);
};

const __atomic_exchange_2 = fn(ptr: ^mut u16, val: u16, model: i32) callconv(.c): u16 {
    return fetch_op_n(u16, .xchg, ptr, val, model);
};

const __atomic_exchange_4 = fn(ptr: ^mut u32, val: u32, model: i32) callconv(.c): u32 {
    return fetch_op_n(u32, .xchg, ptr, val, model);
};

const __atomic_exchange_8 = fn(ptr: ^mut u64, val: u64, model: i32) callconv(.c): u64 {
    return fetch_op_n(u64, .xchg, ptr, val, model);
};

const __atomic_exchange_16 = fn(ptr: ^mut u128, val: u128, model: i32) callconv(.c): u128 {
    return fetch_op_n(u128, .xchg, ptr, val, model);
};

/// Stores `desired` at `ptr` if it holds `expected`, returning 1; otherwise writes the value it
/// does hold into `expected` and returns 0
@[inline(.always)] const atomic_compare_exchange_n = fn(
    comptime T: type,
    ptr: ^mut T,
    expected: ^mut T,
    desired: T,
    success: i32,
    failure: i32,
): i32 {
    _ = success;
    _ = failure;
    if comptime (@sizeOf(T) > largest_atomic_size) {
        let sl = spinlocks.get(@intFromPtr(ptr));
        defer sl.release();
        let value = *ptr;
        if (value == *expected) {
            *ptr = desired;
            return 1;
        }
        *expected = value;
        return 0;
    } else {
        let mut actual: T = undefined;
        if (@cmpxchgStrong(T, ptr, *expected, desired, .seq_cst, .seq_cst, ^mut actual)) {
            return 1;
        }
        *expected = actual;
        return 0;
    }
};

const __atomic_compare_exchange_1 = fn(
    ptr: ^mut u8,
    expected: ^mut u8,
    desired: u8,
    success: i32,
    failure: i32,
) callconv(.c): i32 {
    return atomic_compare_exchange_n(u8, ptr, expected, desired, success, failure);
};

