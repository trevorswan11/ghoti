test "generic __atomic_load/__atomic_store copy an odd-sized object" {
    let mut obj: [13]mut u8 = undefined;
    let mut src: [13]mut u8 = undefined;
    let mut dst: [13]mut u8 = undefined;
    for (0..13) |i| {
        obj[i] = 0;
        src[i] = @truncate(u8, i * 17 + 1);
        dst[i] = 0;
    }
    __atomic_store(13, obj.ptr, src.ptr, 5);
    __atomic_load(13, obj.ptr, dst.ptr, 5);
    for (0..13) |i| {
        @expect(obj[i] == src[i]);
        @expect(dst[i] == src[i]);
    }
}

test "generic __atomic_exchange returns the old bytes and stores the new ones" {
    let mut obj: [13]mut u8 = undefined;
    let mut val: [13]mut u8 = undefined;
    let mut old: [13]mut u8 = undefined;
    for (0..13) |i| {
        obj[i] = @truncate(u8, i);
        val[i] = @truncate(u8, 100 + i);
        old[i] = 0;
    }
    __atomic_exchange(13, obj.ptr, val.ptr, old.ptr, 5);
    for (0..13) |i| {
        @expect(old[i] == @truncate(u8, i));
        @expect(obj[i] == @truncate(u8, 100 + i));
    }
}

test "generic __atomic_compare_exchange swaps on a match and reports the value on a mismatch" {
    let mut obj: [13]mut u8 = undefined;
    let mut expected: [13]mut u8 = undefined;
    let mut desired: [13]mut u8 = undefined;
    for (0..13) |i| {
        obj[i] = @truncate(u8, i);
        expected[i] = @truncate(u8, i);
        desired[i] = @truncate(u8, 50 + i);
    }
    @expect(__atomic_compare_exchange(13, obj.ptr, expected.ptr, desired.ptr, 5, 5) == 1);
    for (0..13) |i| {
        @expect(obj[i] == @truncate(u8, 50 + i));
    }

    // Only the last byte differs, so a byte-at-a-time comparison has to reach it
    for (0..13) |i| {
        expected[i] = @truncate(u8, 50 + i);
    }
    expected[12] = 0;
    @expect(__atomic_compare_exchange(13, obj.ptr, expected.ptr, desired.ptr, 5, 5) == 0);
    for (0..13) |i| {
        @expect(expected[i] == @truncate(u8, 50 + i));
    }
}

test "sized loads and stores round-trip every width" {
    let mut a: u8 = 0;
    let mut b: u16 = 0;
    let mut c: u32 = 0;
    let mut d: u64 = 0;
    let mut e: u128 = 0;
    __atomic_store_1(^mut a, 0xA5, 5);
    __atomic_store_2(^mut b, 0xBEEF, 5);
    __atomic_store_4(^mut c, 0xDEADBEEF, 5);
    __atomic_store_8(^mut d, 0x0123_4567_89AB_CDEF, 5);
    __atomic_store_16(^mut e, 0x0123_4567_89AB_CDEF_FEDC_BA98_7654_3210, 5);
    @expect(__atomic_load_1(^mut a, 5) == 0xA5);
    @expect(__atomic_load_2(^mut b, 5) == 0xBEEF);
    @expect(__atomic_load_4(^mut c, 5) == 0xDEADBEEF);
    @expect(__atomic_load_8(^mut d, 5) == 0x0123_4567_89AB_CDEF);
    @expect(__atomic_load_16(^mut e, 5) == 0x0123_4567_89AB_CDEF_FEDC_BA98_7654_3210);
}

test "sized exchanges return the old value" {
    let mut a: u8 = 1;
    let mut e: u128 = 1;
    @expect(__atomic_exchange_1(^mut a, 2, 5) == 1);
    @expect(a == 2);
    @expect(__atomic_exchange_16(^mut e, 2, 5) == 1);
    @expect(e == 2);
}

test "sized compare-exchanges swap on a match and report the value on a mismatch" {
    let mut x: u32 = 5;
    let mut expected: u32 = 5;
    @expect(__atomic_compare_exchange_4(^mut x, ^mut expected, 9, 5, 5) == 1);
    @expect(x == 9);
    @expect(__atomic_compare_exchange_4(^mut x, ^mut expected, 7, 5, 5) == 0);
    @expect(x == 9);
    @expect(expected == 9);

    let mut y: u128 = 5;
    let mut expected_y: u128 = 5;
    @expect(__atomic_compare_exchange_16(^mut y, ^mut expected_y, 9, 5, 5) == 1);
    @expect(y == 9);
    @expect(__atomic_compare_exchange_16(^mut y, ^mut expected_y, 7, 5, 5) == 0);
    @expect(y == 9);
    @expect(expected_y == 9);
}

/// One fetch op, natively or through `wide_update` on a 4-byte word
@[testing] const fetch = fn(
    comptime T: type,
    comptime wide: bool,
    comptime op: AtomicRmwOp,
    ptr: ^mut T,
    val: T,
): T {
    return if comptime (wide) wide_update(T, 4, op, ptr, val) else fetch_op_n(T, op, ptr, val, 5);
};

/// Checks every fetch op on `T`
@[testing] const check_fetch_ops = fn(comptime T: type, comptime wide: bool): void {
    const high = @as(T, 1) << (@bitSizeOf(T) - 1);
    let mut x: T = 10;
    @expect(fetch(T, wide, .add, ^mut x, 5) == 10);
    @expect(x == 15);
    @expect(fetch(T, wide, .sub, ^mut x, 20) == 15);
    @expect(x == @as(T, 15) -% 20);
    x = 0b1100;
    @expect(fetch(T, wide, .band, ^mut x, 0b1010) == 0b1100);
    @expect(x == 0b1000);
    @expect(fetch(T, wide, .bor, ^mut x, 0b0011) == 0b1000);
    @expect(x == 0b1011);
    @expect(fetch(T, wide, .bxor, ^mut x, 0b0110) == 0b1011);
    @expect(x == 0b1101);
    @expect(fetch(T, wide, .nand, ^mut x, 0b0101) == 0b1101);
    @expect(x == ~@as(T, 0b0101));
    @expect(fetch(T, wide, .xchg, ^mut x, 3) == ~@as(T, 0b0101));
    @expect(x == 3);

    // A set high bit must compare as large, which a signed max/min would get backwards
    @expect(fetch(T, wide, .umax, ^mut x, high) == 3);
    @expect(x == high);
    @expect(fetch(T, wide, .umax, ^mut x, 3) == high);
    @expect(x == high);
    @expect(fetch(T, wide, .umin, ^mut x, 3) == high);
    @expect(x == 3);
    @expect(fetch(T, wide, .umin, ^mut x, high) == 3);
    @expect(x == 3);
};

test "fetch ops at every width" {
    check_fetch_ops(u8, false);
    check_fetch_ops(u16, false);
    check_fetch_ops(u32, false);
    check_fetch_ops(u64, false);
    check_fetch_ops(u128, false);
}

test "exported fetch wrappers forward their op" {
    let mut x: u16 = 0x8000;
    @expect(__atomic_fetch_umax_2(^mut x, 1, 5) == 0x8000);
    @expect(x == 0x8000);
    @expect(__atomic_fetch_umin_2(^mut x, 1, 5) == 0x8000);
    @expect(x == 1);
}

test "wide_update emulates narrow fetch ops with a CAS on the containing word" {
    check_fetch_ops(u8, true);
    check_fetch_ops(u16, true);
}

test "wide_update leaves the rest of the word untouched at every offset" {
    let mut words: [2]mut u32 = undefined;
    let bytes = @ptrCast(^mut u8, words.ptr);
    for (0..4) |off| {
        for (0..8) |k| {
            bytes[k] = @truncate(u8, 0x10 + k);
        }
        @expect(wide_update(u8, 4, .add, bytes + off, 0x40) == @truncate(u8, 0x10 + off));
        for (0..8) |k| {
            let want: u8 = if (k == off) @truncate(u8, 0x50 + k) else @truncate(u8, 0x10 + k);
            @expect(bytes[k] == want);
        }
    }
    for (0..2) |half| {
        let off = half * 2;
        for (0..8) |k| {
            bytes[k] = @truncate(u8, 0x10 + k);
        }
        let halves = @ptrCast(^mut u16, bytes + off);
        let before = *halves;
        @expect(wide_update(u16, 4, .xchg, halves, 0xABCD) == before);
        @expect(*halves == 0xABCD);
        for (0..8) |k| {
            if (k != off and k != off + 1) {
                @expect(bytes[k] == @truncate(u8, 0x10 + k));
            }
        }
    }
}
