import std;
import "compiler_rt.gh" as compiler_rt;
import "trig.gh" as trig;
import "rem_pio2f.gh" as rem_pio2f_impl;
import "rem_pio2.gh" as rem_pio2_impl;
import "rem_pio2l.gh" as rem_pio2l_impl;

const math = std.math;
const ld = math.long_double;
const mem = std.mem;
const symbol = compiler_rt.symbol;
const rem_pio2f = rem_pio2f_impl.rem_pio2f;
const rem_pio2 = rem_pio2_impl.rem_pio2;
const rem_pio2l = rem_pio2l_impl.rem_pio2l;

comptime {
    symbol(__sinh, "__sinh");
    symbol(sinf, "sinf");
    symbol(sin, "sin");
    symbol(__sinx, "__sinx");
    symbol(sinq, "sinf128");
    symbol(sinl, "sinl");

    @cfg (compiler_rt.is_windows_msvc) {
        symbol(sinf64x, "sinf64x");
    }
}

const __sinh = fn(x: f16) callconv(.c): f16 {
    return sin_f16(x);
};

pub const sin_f16 = fn(x: f16): f16 {
    // TODO: more efficient implementation
    return @floatCast(sin_f32(@floatCast(x)));
};

const sinf = fn(x: f32) callconv(.c): f32 {
    return sin_f32(x);
};

pub const sin_f32 = fn(x: f32): f32 {
    // Small multiples of pi/2 rounded to double precision.
    const s1pio2: f64 = 1.0 * math.pi / 2.0; // 0x3FF921FB, 0x54442D18
    const s2pio2: f64 = 2.0 * math.pi / 2.0; // 0x400921FB, 0x54442D18
    const s3pio2: f64 = 3.0 * math.pi / 2.0; // 0x4012D97C, 0x7F3321D2
    const s4pio2: f64 = 4.0 * math.pi / 2.0; // 0x401921FB, 0x54442D18

    let mut ix: u32 = @bitCast(x);
    let sign = (ix >> 31) != 0;
    ix &= 0x7fffffff;

    if (ix <= 0x3f490fda) { // |x| ~<= pi/4
        if (ix < 0x39800000) { // |x| < 2**-12
            // raise inexact if x!=0 and underflow if subnormal
            @cfg (compiler_rt.want_float_exceptions) {
                if (ix < 0x00800000) {
                    mem.do_not_optimize_away(x / 0x1p120);
                } else {
                    mem.do_not_optimize_away(x + 0x1p120);
                }
            }
            return x;
        }
        return trig.sindf(x);
    }
    if (ix <= 0x407b53d1) { // |x| ~<= 5*pi/4
        if (ix <= 0x4016cbe3) { // |x| ~<= 3pi/4
            if (sign) {
                return -trig.cosdf(@floatCast(f64, x) + s1pio2);
            } else {
                return trig.cosdf(@floatCast(f64, x) - s1pio2);
            }
        }
        return trig.sindf(
            if (sign) -(@floatCast(f64, x) + s2pio2) else -(@floatCast(f64, x) - s2pio2),
        );
    }
    if (ix <= 0x40e231d5) { // |x| ~<= 9*pi/4
        if (ix <= 0x40afeddf) { // |x| ~<= 7*pi/4
            if (sign) {
                return trig.cosdf(@floatCast(f64, x) + s3pio2);
            } else {
                return -trig.cosdf(@floatCast(f64, x) - s3pio2);
            }
        }
        return trig.sindf(
            if (sign) @floatCast(f64, x) + s4pio2 else @floatCast(f64, x) - s4pio2,
        );
    }

    // sin(Inf or NaN) is NaN
    if (ix >= 0x7f800000) {
        return x - x;
    }

    let mut y: f64 = undefined;
    let n = rem_pio2f(x, &mut y);
    return match (n & 3) {
        0 => trig.sindf(y),
        1 => trig.cosdf(y),
        2 => trig.sindf(-y),
        _ => -trig.cosdf(y),
    };
};

const sin = fn(x: f64) callconv(.c): f64 {
    return sin_f64(x);
};

pub const sin_f64 = fn(x: f64): f64 {
    let mut ix: u64 = @bitCast(u64, x) >> 32;
    ix &= 0x7fffffff;

    // |x| ~< pi/4
    if (ix <= 0x3fe921fb) {
        if (ix < 0x3e500000) { // |x| < 2**-26
            // raise inexact if x != 0 and underflow if subnormal
            @cfg (compiler_rt.want_float_exceptions) {
                if (ix < 0x00100000) {
                    mem.do_not_optimize_away(x / 0x1p120);
                } else {
                    mem.do_not_optimize_away(x + 0x1p120);
                }
            }
            return x;
        }
        return trig.sin(x, 0.0, 0);
    }

    // sin(Inf or NaN) is NaN
    if (ix >= 0x7ff00000) {
        return x - x;
    }

    let mut y: [2]mut f64 = undefined;
    let n = rem_pio2(x, &mut y);
    return match (n & 3) {
        0 => trig.sin(y[0], y[1], 1),
        1 => trig.cos(y[0], y[1]),
        2 => -trig.sin(y[0], y[1], 1),
        _ => -trig.cos(y[0], y[1]),
    };
};

@cfg (compiler_rt.is_windows_msvc) {
    const sinf64x = fn(a: f80) callconv(.c): f80 {
        return sin_f80(a);
    };
}

const __sinx = fn(x: u80) callconv(.c): u80 {
    return @bitCast(sin_f80(@bitCast(x)));
};

pub const sin_f80 = fn(x: f80): f80 {
    let se = ld.sign_exponent(x) & 0x7fff;
    if (se == 0x7fff) {
        return x - x;
    }

    if (@abs(x) < trig.pi_4) {
        if (se < 0x3fff - (math.float_mantissa_bits(f80) / 2)) {
            // raise inexact if x!=0 and underflow if subnormal
            @cfg (compiler_rt.want_float_exceptions) {
                mem.do_not_optimize_away(if (se == 0) x * 0x1p-120 else x + 0x1p120);
            }
            return x;
        }
        return trig.sinx(x, 0.0, 0);
    }

    let mut y: [2]mut f80 = undefined;
    let n = rem_pio2l(f80, x, &mut y);
    return match (n & 3) {
        0 => trig.sinx(y[0], y[1], 1),
        1 => trig.cosx(y[0], y[1]),
        2 => -trig.sinx(y[0], y[1], 1),
        _ => -trig.cosx(y[0], y[1]),
    };
};

const sinq = fn(x: f128) callconv(.c): f128 {
    return sin_f128(x);
};

pub const sin_f128 = fn(x: f128): f128 {
    let se = ld.sign_exponent(x) & 0x7fff;
    if (se == 0x7fff) {
        return x - x;
    }

    if (@abs(x) < trig.pi_4) {
        if (se < 0x3fff - (math.float_mantissa_bits(f128) / 2)) {
            // raise inexact if x!=0 and underflow if subnormal
            @cfg (compiler_rt.want_float_exceptions) {
                mem.do_not_optimize_away(if (se == 0) x * 0x1p-120 else x + 0x1p120);
            }
            return x;
        }
        return trig.sinq(x, 0.0, 0);
    }

    let mut y: [2]mut f128 = undefined;
    let n = rem_pio2l(f128, x, &mut y);
    return match (n & 3) {
        0 => trig.sinq(y[0], y[1], 1),
        1 => trig.cosq(y[0], y[1]),
        2 => -trig.sinq(y[0], y[1], 1),
        _ => -trig.cosq(y[0], y[1]),
    };
};

pub const sinl = fn(x: c_longdouble) callconv(.c): c_longdouble {
    return match comptime (@typeInfo(c_longdouble).float.bits) {
        64 => sin_f64(x),
        80 => sin_f80(x),
        128 => sin_f128(x),
        _ => unreachable,
    };
};

@[testing] const test_sin_special = fn(comptime T: type): void {
    const sin_t = fn(v: T): T {
        return match comptime (T) {
            f16 => sin_f16(v),
            f32 => sin_f32(v),
            f64 => sin_f64(v),
            f80 => sin_f80(v),
            f128 => sin_f128(v),
            _ => unreachable,
        };
    };

    @expect(math.is_positive_zero(sin_t(0.0)));
    @expect(math.is_negative_zero(sin_t(-0.0)));
    @expect(math.is_nan(sin_t(math.inf(T))));
    @expect(math.is_nan(sin_t(-math.inf(T))));
    @expect(math.is_nan(sin_t(math.nan(T))));
};

test "sin32.normal" {
    const epsilon = math.float_eps(f32);
    @expect(math.approx_eq_abs(f32, 0.0, sin_f32(0.0), epsilon));
    @expect(math.approx_eq_abs(f32, 0.19866933, sin_f32(0.2), epsilon));
    @expect(math.approx_eq_abs(f32, 0.77851737, sin_f32(0.8923), epsilon));
    @expect(math.approx_eq_abs(f32, 0.997495, sin_f32(1.5), epsilon));
    @expect(math.approx_eq_abs(f32, -0.997495, sin_f32(-1.5), epsilon));
    @expect(math.approx_eq_abs(f32, -0.24654257, sin_f32(37.45), epsilon));
    @expect(math.approx_eq_abs(f32, 0.9161657, sin_f32(89.123), epsilon));
}

test "sin32.special" {
    test_sin_special(f32);
}

test "sin64.normal" {
    const epsilon = math.float_eps(f64);
    @expect(math.approx_eq_abs(f64, 0.0, sin_f64(0.0), epsilon));
    @expect(math.approx_eq_abs(f64, 0.19866933079506122, sin_f64(0.2), epsilon));
    @expect(math.approx_eq_abs(f64, 0.7785173385577349, sin_f64(0.8923), epsilon));
    @expect(math.approx_eq_abs(f64, 0.9974949866040544, sin_f64(1.5), epsilon));
    @expect(math.approx_eq_abs(f64, -0.9974949866040544, sin_f64(-1.5), epsilon));
    @expect(math.approx_eq_abs(f64, -0.24654331551411082, sin_f64(37.45), epsilon));
    @expect(math.approx_eq_abs(f64, 0.9161652766622714, sin_f64(89.123), epsilon));
}

test "sin64.special" {
    test_sin_special(f64);
}

test "sin80.normal" {
    const epsilon = math.float_eps(f80);
    @expect(math.approx_eq_abs(f80, 0.0, sin_f80(0.0), epsilon));
    @expect(math.approx_eq_abs(f80, 0.19866933079506121545941262711838975, sin_f80(0.2), epsilon));
    @expect(
        math.approx_eq_abs(f80, 0.77851733855773487830689285621486050, sin_f80(0.8923), epsilon),
    );
    @expect(math.approx_eq_abs(f80, 0.99749498660405443094172337114148732, sin_f80(1.5), epsilon));
    @expect(
        math.approx_eq_abs(f80, -0.99749498660405443094172337114148732, sin_f80(-1.5), epsilon),
    );
    @expect(math.approx_eq_abs(f80, -0.24654331551411356504, sin_f80(37.45), epsilon));
    @expect(math.approx_eq_abs(f80, 0.91616527666226951006, sin_f80(89.123), epsilon));
}

test "sin80.special" {
    test_sin_special(f80);
}

test "sin128.normal" {
    const epsilon = math.float_eps(f128);
    @expect(math.approx_eq_abs(f128, 0.0, sin_f128(0.0), epsilon));
    @expect(
        math.approx_eq_abs(f128, 0.19866933079506121545941262711838975, sin_f128(0.2), epsilon),
    );
    @expect(
        math.approx_eq_abs(f128, 0.77851733855773487830689285621486050, sin_f128(0.8923), epsilon),
    );
    @expect(
        math.approx_eq_abs(f128, 0.99749498660405443094172337114148732, sin_f128(1.5), epsilon),
    );
    @expect(
        math.approx_eq_abs(f128, -0.99749498660405443094172337114148732, sin_f128(-1.5), epsilon),
    );
    @expect(
        math.approx_eq_abs(f128, -0.24654331551411356571238581321661085, sin_f128(37.45), epsilon),
    );
    @expect(
        math.approx_eq_abs(f128, 0.91616527666226951075019849560482170, sin_f128(89.123), epsilon),
    );
}

test "sin128.special" {
    test_sin_special(f128);
}

test "sin32 #9901" {
    const float: f32 = @bitCast(0b11100011111111110000000000000000u32);
    _ = sin_f32(float);
}

test "sin64 #9901" {
    const float: f64 = @bitCast(
        0b1111111101000001000000001111110111111111100000000000000000000001u64,
    );
    _ = sin_f64(float);
}
