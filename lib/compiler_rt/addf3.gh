//! Ported from:
//!
//! https://codeberg.org/ziglang/zig/src/tag/0.17.0/lib/compiler_rt/addf3.zig
import std;
import "compiler_rt.gh" as compiler_rt;

const math = std.math;
const symbol = compiler_rt.symbol;

comptime {
    // Add exports
    @cfg (compiler_rt.want_aeabi) {
        symbol(__aeabi_fadd, "__aeabi_fadd");
        symbol(__aeabi_dadd, "__aeabi_dadd");
    } else {
        symbol(__addsf3, "__addsf3");
        symbol(__adddf3, "__adddf3");
    }

    symbol(__addxf3, "__addxf3");
    symbol(__addtf3, "__addtf3");

    // Sub exports
    @cfg (compiler_rt.want_aeabi) {
        symbol(__aeabi_fsub, "__aeabi_fsub");
        symbol(__aeabi_dsub, "__aeabi_dsub");
    } else {
        symbol(__subsf3, "__subsf3");
        symbol(__subdf3, "__subdf3");
    }

    symbol(__subxf3, "__subxf3");
    symbol(__subtf3, "__subtf3");
}

pub const add_f32 = fn(a: f32, b: f32): f32 {
    return addf3(f32, a, b);
};

const __addsf3 = fn(a: f32, b: f32) callconv(.c): f32 {
    return add_f32(a, b);
};

pub const sub_f32 = fn(a: f32, b: f32): f32 {
    return add_f32(a, compiler_rt.fneg(b));
};

const __subsf3 = fn(a: f32, b: f32) callconv(.c): f32 {
    return sub_f32(a, b);
};

pub const add_f64 = fn(a: f64, b: f64): f64 {
    return addf3(f64, a, b);
};

const __adddf3 = fn(a: f64, b: f64) callconv(.c): f64 {
    return add_f64(a, b);
};

pub const sub_f64 = fn(a: f64, b: f64): f64 {
    return add_f64(a, compiler_rt.fneg(b));
};

const __subdf3 = fn(a: f64, b: f64) callconv(.c): f64 {
    return sub_f64(a, b);
};

pub const add_f80 = fn(a: f80, b: f80): f80 {
    return addf3(f80, a, b);
};

const __addxf3 = fn(a: compiler_rt.f80, b: compiler_rt.f80) callconv(.c): compiler_rt.f80 {
    return @bitCast(add_f80(@bitCast(a), @bitCast(b)));
};

pub const sub_f80 = fn(a: f80, b: f80): f80 {
    return add_f80(a, compiler_rt.fneg(b));
};

const __subxf3 = fn(a: compiler_rt.f80, b: compiler_rt.f80) callconv(.c): compiler_rt.f80 {
    return @bitCast(sub_f80(@bitCast(a), @bitCast(b)));
};

pub const add_f128 = fn(a: f128, b: f128): f128 {
    return addf3(f128, a, b);
};

const __addtf3 = fn(a: f128, b: f128) callconv(.c): f128 {
    return add_f128(a, b);
};

pub const sub_f128 = fn(a: f128, b: f128): f128 {
    return add_f128(a, compiler_rt.fneg(b));
};

const __subtf3 = fn(a: f128, b: f128) callconv(.c): f128 {
    return sub_f128(a, b);
};

@cfg (compiler_rt.want_aeabi) {
    const __aeabi_fadd = fn(a: f32, b: f32) callconv(.aapcs): f32 {
        return add_f32(a, b);
    };

    const __aeabi_fsub = fn(a: f32, b: f32) callconv(.aapcs): f32 {
        return sub_f32(a, b);
    };

    const __aeabi_dadd = fn(a: f64, b: f64) callconv(.aapcs): f64 {
        return add_f64(a, b);
    };

    const __aeabi_dsub = fn(a: f64, b: f64) callconv(.aapcs): f64 {
        return sub_f64(a, b);
    };
}

@[inline(.always)] const addf3 = fn(T: type, a: T, b: T): T {
    const bits = @typeInfo(T).float.bits;
    const Z = @Int(.{ .signedness = .unsigned, .bits = bits });

    const type_width = bits;
    const significand_bits = math.float_mantissa_bits(T);
    const fractional_bits = math.float_fractional_bits(T);
    const exponent_bits = math.float_exponent_bits(T);

    const sign_bit = (@as(Z, 1) << (significand_bits + exponent_bits));
    const max_exponent = ((1 << exponent_bits) - 1);

    const integer_bit = (@as(Z, 1) << fractional_bits);
    const quiet_bit = integer_bit >> 1;
    const significand_mask = (@as(Z, 1) << significand_bits) - 1;

    const abs_mask = sign_bit - 1;
    const qnan_rep = @bitCast(Z, math.nan(T)) | quiet_bit;

    let mut a_rep: Z = @bitCast(a);
    let a_abs = a_rep & abs_mask;
    let mut b_rep: Z = @bitCast(b);
    let b_abs = b_rep & abs_mask;

    const inf_rep: Z = @bitCast(math.inf(T));

    // Detect if a or b is zero, infinity, or NaN.
    if (a_abs -% @as(Z, 1) >= inf_rep - @as(Z, 1) or b_abs -% @as(Z, 1) >= inf_rep - @as(Z, 1)) {
        // NaN + anything = qNaN
        if (a_abs > inf_rep) return @bitCast(@bitCast(Z, a) | quiet_bit);
        // anything + NaN = qNaN
        if (b_abs > inf_rep) return @bitCast(@bitCast(Z, b) | quiet_bit);

        if (a_abs == inf_rep) {
            // +/-infinity + -/+infinity = qNaN
            if ((@bitCast(Z, a) ^ @bitCast(Z, b)) == sign_bit) {
                return @bitCast(qnan_rep);
            } else {
                // +/-infinity + anything remaining = +/- infinity
                return a;
            }
        }

        // anything remaining + +/-infinity = +/-infinity
        if (b_abs == inf_rep) return b;

        // zero + anything = anything
        if (a_abs == 0) {
            // but we need to get the sign right for zero + zero
            if (b_abs == 0) {
                return @bitCast(@bitCast(Z, a) & @bitCast(Z, b));
            } else {
                return b;
            }
        }

        // anything + zero = anything
        if (b_abs == 0) return a;
    }

    // Swap a and b if necessary so that a has the larger absolute value.
    if (b_abs > a_abs) {
        let temp = a_rep;
        a_rep = b_rep;
        b_rep = temp;
    }

    // Extract the exponent and significand from the (possibly swapped) a and b.
    let mut a_exponent: i32 = @intCast((a_rep >> significand_bits) & max_exponent);
    let mut b_exponent: i32 = @intCast((b_rep >> significand_bits) & max_exponent);
    let mut a_significand = a_rep & significand_mask;
    let mut b_significand = b_rep & significand_mask;

    // Normalize any denormals, and adjust the exponent accordingly.
    if (a_exponent == 0) a_exponent = compiler_rt.normalize(T, ^mut a_significand);
    if (b_exponent == 0) b_exponent = compiler_rt.normalize(T, ^mut b_significand);

    // The sign of the result is the sign of the larger operand, a. If they
    // have opposite signs, we are performing a subtraction; otherwise addition.
    let result_sign = a_rep & sign_bit;
    let subtraction = (a_rep ^ b_rep) & sign_bit != 0;

    // Shift the significands to give us round, guard and sticky, and or in the
    // implicit significand bit.  (If we fell through from the denormal path it
    // was already set by normalize( ), but setting it twice won't hurt
    // anything.)
    a_significand = (a_significand | integer_bit) << 3;
    b_significand = (b_significand | integer_bit) << 3;

    // Shift the significand of b by the difference in exponents, with a sticky
    // bottom bit to get rounding correct.
    let align: u32 = @intCast(a_exponent - b_exponent);
    if (align != 0) {
        if (align < type_width) {
            let sticky = if (b_significand << @intCast(type_width - align) != 0) @as(Z, 1) else 0;
            b_significand = (b_significand >> @as(align)) | sticky;
        } else {
            b_significand = 1; // sticky; b is known to be non-zero.
        }
    }

    if (subtraction) {
        a_significand -= b_significand;
        // If a == -b, return +zero.
        if (a_significand == 0) return @bitCast(0);

        // If partial cancellation occurred, we need to left-shift the result
        // and adjust the exponent:
        if (a_significand < integer_bit << 3) {
            let shift = @intCast(i32, @clz(a_significand)) - @intCast(i32, @clz(integer_bit << 3));
            a_significand <<= @intCast(shift);
            a_exponent -= shift;
        }
    } // addition
    else {
        a_significand += b_significand;

        // If the addition carried up, we need to right-shift the result and adjust the exponent:
        if (a_significand & (integer_bit << 4) != 0) {
            let sticky = a_significand & 1;
            a_significand = a_significand >> 1 | sticky;
            a_exponent += 1;
        }
    }

    // If we have overflowed the type, return +/- infinity:
    if (a_exponent >= max_exponent) return @bitCast(inf_rep | result_sign);

    if (a_exponent <= 0) {
        // Result is denormal; the exponent and round/sticky bits are zero.
        // All we need to do is shift the significand and apply the correct sign.
        a_significand >>= @intCast(4 - a_exponent);
        return @bitCast(result_sign | a_significand);
    }

    // Low three bits are round, guard, and sticky.
    let round_guard_sticky = a_significand & 0x7;

    // Shift the significand into place, and mask off the integer bit, if it's implicit.
    let mut result = (a_significand >> 3) & significand_mask;

    // Insert the exponent and sign.
    result |= @intCast(Z, a_exponent) << significand_bits;
    result |= result_sign;

    // Final rounding.  The result may overflow to infinity, but that is the
    // correct result in that case.
    if (round_guard_sticky > 0x4) result += 1;
    if (round_guard_sticky == 0x4) result += result & 1;

    // Restore any explicit integer bit, if it was rounded off
    if (significand_bits != fractional_bits) {
        if ((result >> significand_bits) != 0) result |= integer_bit;
    }
    return @bitCast(result);
};

@[testing] const test__addtf3 = fn(a: f128, b: f128, expected_hi: u64, expected_lo: u64): void {
    let x = add_f128(a, b);

    let rep: u128 = @bitCast(x);
    let hi: u64 = @intCast(rep >> 64);
    let lo: u64 = @truncate(rep);

    if (hi == expected_hi and lo == expected_lo) return;

    // test other possible NaN representation (signal NaN)
    if (expected_hi == 0x7fff800000000000 and expected_lo == 0x0) {
        if ((hi & 0x7fff000000000000) == 0x7fff000000000000 and
            ((hi & 0xffffffffffff) > 0 or lo > 0)) {
            return;
        }
    }

    @expect(false);
};

const qnan128 = math.nan(f128);

test "addtf3" {
    test__addtf3(qnan128, 0x1.23456789abcdefp+5, 0x7fff800000000000, 0x0);

    // NaN + any = NaN
    test__addtf3(
        @bitCast(f128, (0x7fff000000000000u128 << 64) | 0x800030000000u128),
        0x1.23456789abcdefp+5,
        0x7fff800000000000,
        0x0,
    );

    // inf + inf = inf
    test__addtf3(math.inf(f128), math.inf(f128), 0x7fff000000000000, 0x0);

    // inf + any = inf
    test__addtf3(
        math.inf(f128),
        0x1.2335653452436234723489432abcdefp+5,
        0x7fff000000000000,
        0x0,
    );

    // any + any
    test__addtf3(
        0x1.23456734245345543849abcdefp+5,
        0x1.edcba52449872455634654321fp-1,
        0x40042afc95c8b579,
        0x61e58dd6c51eb77c,
    );
    test__addtf3(
        0x1.edcba52449872455634654321fp-1,
        0x1.23456734245345543849abcdefp+5,
        0x40042afc95c8b579,
        0x61e58dd6c51eb77c,
    );
}

@[testing] const test__subtf3 = fn(a: f128, b: f128, expected_hi: u64, expected_lo: u64): void {
    let x = sub_f128(a, b);

    let rep: u128 = @bitCast(x);
    let hi: u64 = @intCast(rep >> 64);
    let lo: u64 = @truncate(rep);

    if (hi == expected_hi and lo == expected_lo) return;

    // test other possible NaN representation (signal NaN)
    if (expected_hi == 0x7fff800000000000 and expected_lo == 0x0) {
        if ((hi & 0x7fff000000000000) == 0x7fff000000000000 and
            ((hi & 0xffffffffffff) > 0 or lo > 0)) {
            return;
        }
    }

    @expect(false);
};

test "subtf3" {
    // qNaN - any = qNaN
    test__subtf3(qnan128, 0x1.23456789abcdefp+5, 0x7fff800000000000, 0x0);

    // NaN + any = NaN
    test__subtf3(
        @bitCast(f128, (0x7fff000000000000u128 << 64) | 0x800030000000u128),
        0x1.23456789abcdefp+5,
        0x7fff800000000000,
        0x0,
    );

    // inf - any = inf
    test__subtf3(math.inf(f128), 0x1.23456789abcdefp+5, 0x7fff000000000000, 0x0);

    // any + any
    test__subtf3(
        0x1.234567829a3bcdef5678ade36734p+5,
        0x1.ee9d7c52354a6936ab8d7654321fp-1,
        0x40041b8af1915166,
        0xa44a7bca780a166c,
    );
    test__subtf3(
        0x1.ee9d7c52354a6936ab8d7654321fp-1,
        0x1.234567829a3bcdef5678ade36734p+5,
        0xc0041b8af1915166,
        0xa44a7bca780a166c,
    );
}

const qnan80 = math.nan(f80);

@[testing] const test__addxf3 = fn(a: f80, b: f80, expected: u80): void {
    let x = add_f80(a, b);
    let rep: u80 = @bitCast(x);

    if (rep == expected) return;
    if (math.is_nan(@bitCast(f80, expected)) and math.is_nan(x)) return;
    @expect(false);
};

test "addxf3" {
    // NaN + any = NaN
    test__addxf3(qnan80, 0x1.23456789abcdefp+5, @bitCast(qnan80));
    test__addxf3(
        @bitCast(0x7fff_8000_8000_3000_0000u80),
        0x1.23456789abcdefp+5,
        @bitCast(qnan80),
    );

    // any + NaN = NaN
    test__addxf3(0x1.23456789abcdefp+5, qnan80, @bitCast(qnan80));
    test__addxf3(
        0x1.23456789abcdefp+5,
        @bitCast(0x7fff_8000_8000_3000_0000),
        @bitCast(qnan80),
    );

    // NaN + inf = NaN
    test__addxf3(qnan80, math.inf(f80), @bitCast(qnan80));

    // inf + NaN = NaN
    test__addxf3(math.inf(f80), qnan80, @bitCast(qnan80));

    // inf + inf = inf
    test__addxf3(math.inf(f80), math.inf(f80), @bitCast(math.inf(f80)));

    // inf + -inf = NaN
    test__addxf3(math.inf(f80), -math.inf(f80), @bitCast(qnan80));

    // -inf + inf = NaN
    test__addxf3(-math.inf(f80), math.inf(f80), @bitCast(qnan80));

    // inf + any = inf
    test__addxf3(
        math.inf(f80),
        0x1.2335653452436234723489432abcdefp+5,
        @bitCast(math.inf(f80)),
    );

    // any + inf = inf
    test__addxf3(
        0x1.2335653452436234723489432abcdefp+5,
        math.inf(f80),
        @bitCast(math.inf(f80)),
    );

    // any + any
    test__addxf3(0x1.23456789abcdp+5, 0x1.dcba987654321p+5, 0x4005_BFFFFFFFFFFFC400);
    test__addxf3(
        0x1.23456734245345543849abcdefp+5,
        0x1.edcba52449872455634654321fp-1,
        0x4004_957E_4AE4_5ABC_B0F3,
    );
    test__addxf3(0x1.ffff_ffff_ffff_fffcp+0, 0x1.0p-63, 0x3FFF_FFFFFFFFFFFFFFFF); // exact
    test__addxf3(0x1.ffff_ffff_ffff_fffep+0, 0x0.0p0, 0x3FFF_FFFFFFFFFFFFFFFF); // exact
    test__addxf3(0x1.ffff_ffff_ffff_fffcp+0, 0x1.4p-63, 0x3FFF_FFFFFFFFFFFFFFFF); // round down
    test__addxf3(0x1.ffff_ffff_ffff_fffcp+0, 0x1.8p-63, 0x4000_8000000000000000); // round up to even
    test__addxf3(0x1.ffff_ffff_ffff_fffcp+0, 0x1.cp-63, 0x4000_8000000000000000); // round up
    test__addxf3(0x1.ffff_ffff_ffff_fffcp+0, 0x2.0p-63, 0x4000_8000000000000000); // exact
    test__addxf3(0x1.ffff_ffff_ffff_fffcp+0, 0x2.1p-63, 0x4000_8000000000000000); // round down
    test__addxf3(0x1.ffff_ffff_ffff_fffcp+0, 0x3.0p-63, 0x4000_8000000000000000); // round down to even
    test__addxf3(0x1.ffff_ffff_ffff_fffcp+0, 0x3.1p-63, 0x4000_8000000000000001); // round up
    test__addxf3(0x1.ffff_ffff_ffff_fffcp+0, 0x4.0p-63, 0x4000_8000000000000001); // exact

    test__addxf3(0x1.0fff_ffff_ffff_fffep+0, 0x1.0p-63, 0x3FFF_8800000000000000); // exact
    test__addxf3(0x1.0fff_ffff_ffff_fffep+0, 0x1.7p-63, 0x3FFF_8800000000000000); // round down
    test__addxf3(0x1.0fff_ffff_ffff_fffep+0, 0x1.8p-63, 0x3FFF_8800000000000000); // round down to even
    test__addxf3(0x1.0fff_ffff_ffff_fffep+0, 0x1.9p-63, 0x3FFF_8800000000000001); // round up
    test__addxf3(0x1.0fff_ffff_ffff_fffep+0, 0x2.0p-63, 0x3FFF_8800000000000001); // exact
    test__addxf3(
        0x0.ffff_ffff_ffff_fffcp-16382,
        0x0.0000_0000_0000_0002p-16382,
        0x0000_7FFFFFFFFFFFFFFF,
    ); // exact
    test__addxf3(
        0x0.1fff_ffff_ffff_fffcp-16382,
        0x0.0000_0000_0000_0002p-16382,
        0x0000_0FFFFFFFFFFFFFFF,
    ); // exact
}
