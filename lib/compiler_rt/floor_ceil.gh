@cfg (compiler_rt.is_windows_msvc) {
    const floorf64x = fn(x: f80) callconv(.c): f80 {
        return floor_f80(x);
    };
}

const __floorx = fn(x: u80) callconv(.c): u80 {
    return @bitCast(floor_f80(@bitCast(x)));
};

@[inline(.always)] const floor_f80 = fn(x: f80): f80 {
    return floor_ceil(f80, .floor, x);
};

test "floor_f80" {
    @expect(floor_f80(1.3) == 1.0);
    @expect(floor_f80(-1.3) == -2.0);
    @expect(floor_f80(-0.2) == -1.0);
    @expect(math.is_positive_zero(floor_f80(0.2)));
    @expect(math.is_positive_zero(floor_f80(0.0)));
    @expect(math.is_negative_zero(floor_f80(-0.0)));
    @expect(math.is_positive_inf(floor_f80(math.inf(f80))));
    @expect(math.is_negative_inf(floor_f80(-math.inf(f80))));
    @expect(math.is_nan(floor_f80(math.nan(f80))));
    @expect(math.is_nan(floor_f80(@bitCast(@as(u80, 0x3251_1dac0c5cd99e87ca)))));
}

