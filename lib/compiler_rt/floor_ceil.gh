//! https://git.musl-libc.org/cgit/musl/tree/src/math/ceil.c
//! https://git.musl-libc.org/cgit/musl/tree/src/math/ceill.c
//!
//! https://git.musl-libc.org/cgit/musl/tree/src/math/floorf.c
//! https://git.musl-libc.org/cgit/musl/tree/src/math/floor.c
//! https://git.musl-libc.org/cgit/musl/tree/src/math/floorl.c
import std;
import "compiler_rt.gh" as compiler_rt;

const math = std.math;
const symbol = compiler_rt.symbol;

comptime {
    symbol(__floorh, "__floorh");
    symbol(floorf, "floorf");
    symbol(floor, "floor");
    symbol(__floorx, "__floorx");
    symbol(floorq, "floorf128");
    symbol(floorl, "floorl");

    @cfg (compiler_rt.is_windows_msvc) {
        symbol(floorf64x, "floorf64x");
    }

    symbol(__ceilh, "__ceilh");
    symbol(ceilf, "ceilf");
    symbol(ceil, "ceil");
    symbol(__ceilx, "__ceilx");
    symbol(ceilq, "ceilf128");
    symbol(ceill, "ceill");

    @cfg (compiler_rt.is_windows_msvc) {
        symbol(ceilf64x, "ceilf64x");
    }
}

const __floorh = fn(x: f16) callconv(.c): f16 {
    return floor_f16(x);
};

@[inline(.always)] const floor_f16 = fn(x: f16): f16 {
    return floor_ceil(f16, .floor, x);
};

test "floor_f16" {
    @expect(floor_f16(1.3) == 1.0);
    @expect(floor_f16(-1.3) == -2.0);
    @expect(floor_f16(-0.2) == -1.0);
    @expect(math.is_positive_zero(floor_f16(0.2)));
    @expect(math.is_positive_zero(floor_f16(0.0)));
    @expect(math.is_negative_zero(floor_f16(-0.0)));
    @expect(math.is_positive_inf(floor_f16(math.inf(f16))));
    @expect(math.is_negative_inf(floor_f16(-math.inf(f16))));
    @expect(math.is_nan(floor_f16(math.nan(f16))));
}

@[inline(.always)] const floor_f32 = fn(x: f32): f32 {
    return floor_ceil(f32, .floor, x);
};

const floorf = fn(x: f32) callconv(.c): f32 {
    return floor_f32(x);
};

test "floor_f32" {
    @expect(floor_f32(1.3) == 1.0);
    @expect(floor_f32(-1.3) == -2.0);
    @expect(floor_f32(-0.2) == -1.0);
    @expect(math.is_positive_zero(floor_f32(0.2)));
    @expect(math.is_positive_zero(floor_f32(0.0)));
    @expect(math.is_negative_zero(floor_f32(-0.0)));
    @expect(math.is_positive_inf(floor_f32(math.inf(f32))));
    @expect(math.is_negative_inf(floor_f32(-math.inf(f32))));
    @expect(math.is_nan(floor_f32(math.nan(f32))));
}

