//! https://git.musl-libc.org/cgit/musl/tree/src/math/floorl.c
import std;

const math = std.math;

@[inline(.always)] const floor_f16 = fn(x: f16): f16 {
    return floor_ceil(f16, .floor, x);
};

test "floor_f16" {
    @expect(floor_f16(1.3) == 1.0);
    @expect(floor_f16(-1.3) == -2.0);
    @expect(floor_f16(-0.2) == -1.0);
    @expect(math.is_positive_zero(floor_f16(0.2)));
    @expect(math.is_positive_zero(floor_f16(0.0)));
    @expect(math.is_negative_zero(floor_f16(-0.0)));
    @expect(math.is_positive_inf(floor_f16(math.inf(f16))));
    @expect(math.is_negative_inf(floor_f16(-math.inf(f16))));
    @expect(math.is_nan(floor_f16(math.nan(f16))));
}

