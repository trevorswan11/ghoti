const ceill = fn(x: c_longdouble) callconv(.c): c_longdouble {
    return match comptime (@typeInfo(c_longdouble).float.bits) {
        64 => ceil_f64(x),
        80 => ceil_f80(x),
        128 => ceil_f128(x),
        _ => unreachable,
    };
};

@[inline(.always)]
const floor_ceil = fn(comptime T: type, comptime op: enum { floor, ceil }, x: T): T {
    const C = 1.0 / math.float_eps(T);
    const mantissa = math.float_mantissa_bits(T);
    const fractional = math.float_fractional_bits(T);
    const exponent = math.float_exponent_bits(T);

    const mask = (1 << exponent) - 1;
    const bias = (1 << exponent - 1) - 1;

    const bits = @bitSizeOf(T);
    const U = @Int(.{ .signedness = .unsigned, .bits = bits });
    const SU = @Int(.{ .signedness = .signed, .bits = bits });
    let mut u: U = @bitCast(x);
    match comptime (T) {
        f16, f32 => {
            let e: SU = @intCast(u >> mantissa & mask) - bias;
            if (e >= mantissa) return x;

            if (e >= 0) {
                let m = (@as(U, 1) << @intCast(mantissa - e)) - 1;
                if (u & m == 0) return x;
                if (u >> bits - 1 == @intFromBool(op == .floor)) u += m;
                return @bitCast(u & ~m);
            } else return match comptime (op) {
                .floor => if (u >> bits - 1 == 0) 0.0 else if (u << 1 != 0) -1.0 else x,
                .ceil => if (u >> bits - 1 != 0) -0.0 else if (u << 1 != 0) 1.0 else x,
            };
        },
        f64, f80, f128 => {
            let e = u >> mantissa & mask;
            // An f80 whose integer bit disagrees with a nonzero exponent is an invalid operand
            if comptime (T == f80) {
                if (e != 0 and u >> mantissa - 1 & 1 == 0) return math.nan(T);
            }
            if (e >= bias + fractional or x == 0) return x;

            let positive = u >> bits - 1 == 0;
            let y: T = if (positive) x + C - C - x else x - C + C - x;

            if (e <= bias - 1) return match comptime (op) {
                .floor => if (positive) 0.0 else -1.0,
                .ceil => if (positive) 1.0 else -0.0,
            };
            return match (op) {
                .floor if (y > 0) => x + y - 1,
                .ceil if (y < 0) => x + y + 1,
                _ => x + y,
            };
        },
        _ => unreachable,
    }
};
