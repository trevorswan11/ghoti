@[inline(.always)] const ceil_f16 = fn(x: f16): f16 {
    return floor_ceil(f16, .ceil, x);
};

test "ceil_f16" {
    @expect(ceil_f16(1.3) == 2.0);
    @expect(ceil_f16(-1.3) == -1.0);
    @expect(ceil_f16(0.2) == 1.0);
    @expect(math.is_negative_zero(ceil_f16(-0.2)));
    @expect(math.is_positive_zero(ceil_f16(0.0)));
    @expect(math.is_negative_zero(ceil_f16(-0.0)));
    @expect(math.is_positive_inf(ceil_f16(math.inf(f16))));
    @expect(math.is_negative_inf(ceil_f16(-math.inf(f16))));
    @expect(math.is_nan(ceil_f16(math.nan(f16))));
}

