    @expect(ceil_f128(1.3) == 2.0);
    @expect(ceil_f128(-1.3) == -1.0);
    @expect(ceil_f128(0.2) == 1.0);
    @expect(math.is_negative_zero(ceil_f128(-0.2)));
    @expect(math.is_positive_zero(ceil_f128(0.0)));
    @expect(math.is_negative_zero(ceil_f128(-0.0)));
    @expect(math.is_positive_inf(ceil_f128(math.inf(f128))));
    @expect(math.is_negative_inf(ceil_f128(-math.inf(f128))));
