@cfg (compiler_rt.want_aeabi) {
    const __aeabi_f2iz = fn(a: f32) callconv(.aapcs): i32 {
        return i32_int_from_float_f32(a);
    };

    const __aeabi_f2lz = fn(a: f32) callconv(.aapcs): i64 {
        return i64_int_from_float_f32(a);
    };

    const __aeabi_d2iz = fn(a: f64) callconv(.aapcs): i32 {
        return i32_int_from_float_f64(a);
    };

    const __aeabi_d2lz = fn(a: f64) callconv(.aapcs): i64 {
        return i64_int_from_float_f64(a);
    };

    const __aeabi_f2uiz = fn(a: f32) callconv(.aapcs): u32 {
        return u32_int_from_float_f32(a);
    };

    const __aeabi_f2ulz = fn(a: f32) callconv(.aapcs): u64 {
        return u64_int_from_float_f32(a);
    };

    const __aeabi_d2uiz = fn(a: f64) callconv(.aapcs): u32 {
        return u32_int_from_float_f64(a);
    };

    const __aeabi_d2ulz = fn(a: f64) callconv(.aapcs): u64 {
        return u64_int_from_float_f64(a);
    };
}

/// Truncates `a` toward zero, saturating to the bounds of `I`. NaN saturates by its sign bit.
@[inline(.always)] const int_from_float = fn(comptime I: type, a: auto): I {
    const F = @TypeOf(a);
    const float_bits = @typeInfo(F).float.bits;
    const int_bits = @typeInfo(I).int.bits;
    const rep_t = @Int(.{ .signedness = .unsigned, .bits = float_bits });
    const sig_bits = math.float_mantissa_bits(F);
    const exp_bits = math.float_exponent_bits(F);
    const fractional_bits = math.float_fractional_bits(F);

    const implicit_bit = if comptime (F != f80) @as(rep_t, 1) << sig_bits else 0;
    const max_exp = 1 << (exp_bits - 1);
    const exp_bias = max_exp - 1;
    const sig_mask = (@as(rep_t, 1) << sig_bits) - 1;

    // Break a into sign, exponent, significand
    let a_rep = @bitCast(rep_t, a);
    let negative = (a_rep >> (float_bits - 1)) != 0;
    let exponent = @as(i32, @intCast((a_rep << 1) >> (sig_bits + 1))) - exp_bias;
    let significand: rep_t = (a_rep & sig_mask) | implicit_bit;

    // If the exponent is negative, the result rounds to zero.
    if (exponent < 0) return 0;

    // If the value is too large for the integer type, saturate.
    match comptime (@typeInfo(I).int.signedness) {
        .unsigned => {
            if (negative) return 0;
            if (@as(c_uint, @intCast(exponent)) >= @min(int_bits, max_exp)) return math.max_int(I);
        },
        .signed => {
            if (@as(c_uint, @intCast(exponent)) >= @min(int_bits - 1, max_exp)) {
                return if (negative) @as(I, math.min_int(I)) else math.max_int(I);
            }
        },
    }

    // If 0 <= exponent < sig_bits, right shift to get the result.
    // Otherwise, shift left.
    let mut result: I = undefined;
    if (exponent < fractional_bits) {
        result = @intCast(significand >> @intCast(fractional_bits - exponent));
    } else {
        result = @as(I, @intCast(significand)) << @intCast(exponent - fractional_bits);
    }

    if (@typeInfo(I).int.signedness == .signed and negative) return ~result +% 1;
    return result;
};

/// Converts `a` into the `bits`-wide integer stored at `r` in its in-memory representation,
/// truncating toward zero and saturating like `int_from_float`. The bits past `bits` in the
/// top byte are filled with the sign so the whole buffer holds the same value.
@[inline(.always)]
const big_int_from_float = fn(comptime is_signed: bool, r: ^mut u8, bits: usize, a: auto): void {
    const F = @TypeOf(a);
    const float_bits = @typeInfo(F).float.bits;
    const rep_t = @Int(.{ .signedness = .unsigned, .bits = float_bits });
    const sig_bits = math.float_mantissa_bits(F);
    const exp_bits = math.float_exponent_bits(F);
    const fractional_bits = math.float_fractional_bits(F);

    // The significand with its integer bit, and room to shift it within a byte
    const Sig = @Int(.{ .signedness = .unsigned, .bits = fractional_bits + 1 });
    const Window = @Int(.{ .signedness = .unsigned, .bits = fractional_bits + 1 + 8 });

    const implicit_bit = if comptime (F != f80) @as(rep_t, 1) << sig_bits else 0;
    const exp_bias = (1 << (exp_bits - 1)) - 1;
    const sig_mask = (@as(rep_t, 1) << sig_bits) - 1;

    let len = (bits + 7) / 8;
    if (len == 0) return;
    let bytes = @sliceFromPtr(r, len);
    @memset(bytes, 0);

    // Break a into sign, exponent, significand
    let a_rep = @bitCast(rep_t, a);
    let negative = (a_rep >> (float_bits - 1)) != 0;
    let exponent = @as(i32, @intCast((a_rep << 1) >> (sig_bits + 1))) - exp_bias;
    let significand = @as(Sig, @truncate((a_rep & sig_mask) | implicit_bit));

    // If the exponent is negative, the result rounds to zero.
    if (exponent < 0 or (!is_signed and negative)) return;

    // Magnitude bits available below the sign
    let value_bits = bits - @intFromBool(is_signed);
    if (@as(usize, @intCast(exponent)) >= value_bits) {
        if (is_signed and negative) {
            // The minimum is the negation of the magnitude 2^value_bits
            bytes[byte_index(len, value_bits / 8)] = @as(u8, 1) << @truncate(u3, value_bits);
            negate(bytes);
        } else {
            let full_bytes = value_bits / 8;
            for (0..full_bytes) |i| {
                bytes[byte_index(len, i)] = 0xff;
            }
            if (full_bytes < len) {
                bytes[byte_index(len, full_bytes)] = (@as(u8, 1) << @truncate(u3, value_bits)) - 1;
            }
        }
        return;
    }

    // Place the truncated magnitude so its top bit lands at `exponent`, which is below `bits`
    let mut window: Window = undefined;
    let mut i: usize = 0;
    if (exponent < fractional_bits) {
        window = significand >> @intCast(fractional_bits - exponent);
    } else {
        let shift = @as(usize, @intCast(exponent)) - fractional_bits;
        window = @as(Window, significand) << @truncate(u3, shift);
        i = shift / 8;
    }
    while (window != 0) : (i += 1) {
        bytes[byte_index(len, i)] = @truncate(window);
        window >>= 8;
    }

    if (is_signed and negative) negate(bytes);
};

/// Two's complement negation of the integer held in `bytes`
@[inline(.always)] const negate = fn(bytes: []mut u8): void {
    let mut carry: u1 = 1;
    for (0..bytes.len) |i| {
        let idx = byte_index(bytes.len, i);
        let sum = @as(u9, ~bytes[idx]) + carry;
        bytes[idx] = @truncate(sum);
        carry = @truncate(sum >> 8);
    }
};

@[testing] const test_int_from_float = fn(comptime T: type, expected: T, a: auto): void {
    const F = @TypeOf(a);
    let mut actual: T = undefined;
    let r = @ptrCast(^mut u8, ^mut actual);
    match comptime (@typeInfo(T).int.signedness) {
        .signed => big_int_from_float(true, r, @bitSizeOf(T), @as(F, a)),
        .unsigned => big_int_from_float(false, r, @bitSizeOf(T), @as(F, a)),
    }
    @expect(expected == actual);
};

test "signed_int_from_float_f32" {
    test_int_from_float(i256, -1 << 127, @as(f32, -0x1p127));
    test_int_from_float(i256, -1 << 100, @as(f32, -0x1p100));
    test_int_from_float(i256, -1 << 50, @as(f32, -0x1p50));
    test_int_from_float(i256, -1 << 1, @as(f32, -0x1p1));
    test_int_from_float(i256, -1 << 0, @as(f32, -0x1p0));
    test_int_from_float(i256, 0, @as(f32, 0));
    test_int_from_float(i256, 1 << 0, @as(f32, 0x1p0));
    test_int_from_float(i256, 1 << 1, @as(f32, 0x1p1));
    test_int_from_float(i256, 1 << 50, @as(f32, 0x1p50));
    test_int_from_float(i256, 1 << 100, @as(f32, 0x1p100));
    test_int_from_float(i256, 1 << 127, @as(f32, 0x1p127));
}

test "unsigned_int_from_float_f32" {
    test_int_from_float(u256, 0, @as(f32, 0));
    test_int_from_float(u256, 1 << 0, @as(f32, 0x1p0));
    test_int_from_float(u256, 1 << 1, @as(f32, 0x1p1));
    test_int_from_float(u256, 1 << 50, @as(f32, 0x1p50));
    test_int_from_float(u256, 1 << 100, @as(f32, 0x1p100));
    test_int_from_float(u256, 1 << 127, @as(f32, 0x1p127));
}

test "signed_int_from_float_f64" {
    test_int_from_float(i256, -1 << 255, @as(f64, -0x1p255));
    test_int_from_float(i256, -1 << 127, @as(f64, -0x1p127));
    test_int_from_float(i256, -1 << 100, @as(f64, -0x1p100));
    test_int_from_float(i256, -1 << 50, @as(f64, -0x1p50));
    test_int_from_float(i256, -1 << 1, @as(f64, -0x1p1));
    test_int_from_float(i256, -1 << 0, @as(f64, -0x1p0));
    test_int_from_float(i256, 0, @as(f64, 0));
    test_int_from_float(i256, 1 << 0, @as(f64, 0x1p0));
    test_int_from_float(i256, 1 << 1, @as(f64, 0x1p1));
    test_int_from_float(i256, 1 << 50, @as(f64, 0x1p50));
    test_int_from_float(i256, 1 << 100, @as(f64, 0x1p100));
    test_int_from_float(i256, 1 << 127, @as(f64, 0x1p127));
    test_int_from_float(i256, 1 << 254, @as(f64, 0x1p254));
}

test "unsigned_int_from_float_f64" {
    test_int_from_float(u256, 0, @as(f64, 0));
    test_int_from_float(u256, 1 << 0, @as(f64, 0x1p0));
    test_int_from_float(u256, 1 << 1, @as(f64, 0x1p1));
    test_int_from_float(u256, 1 << 50, @as(f64, 0x1p50));
    test_int_from_float(u256, 1 << 100, @as(f64, 0x1p100));
    test_int_from_float(u256, 1 << 127, @as(f64, 0x1p127));
    test_int_from_float(u256, 1 << 255, @as(f64, 0x1p255));
}

test "big_int_from_float matches the fixed-width path" {
    let values: [8]f64 = .{
        0,
        1.5,
        -1.5,
        0x1.23456789ABCDEp100,
        -0x1.23456789ABCDEp100,
        -0.75,
        0x1p126,
        -0x1p127,
    };
    for (values) |v| {
        let mut wide: i256 = undefined;
        signed_int_from_float_f64(@ptrCast(^mut u8, ^mut wide), 256, v);
        @expect(wide == i128_int_from_float_f64(v));

        let mut narrow: i128 = undefined;
        signed_int_from_float_f64(@ptrCast(^mut u8, ^mut narrow), 128, v);
        @expect(narrow == i128_int_from_float_f64(v));

        let mut unsigned: u128 = undefined;
        unsigned_int_from_float_f64(@ptrCast(^mut u8, ^mut unsigned), 128, v);
        @expect(unsigned == u128_int_from_float_f64(v));
    }

    let extended: [4]f80 = .{ 0x1.FFFFFFFFFFFFFFFEp63, -0x1p63, 12.75, -0x1.8p100 };
    for (extended) |v| {
        let mut wide: i256 = undefined;
        signed_int_from_float_f80(@ptrCast(^mut u8, ^mut wide), 256, v);
        @expect(wide == i128_int_from_float_f80(v));
    }

    let quad: [3]f128 = .{ 0x1.23456789ABCDEF0123456789ABCDp120, -0x1.8p2, 0x1p-3 };
    for (quad) |v| {
        let mut wide: i256 = undefined;
        signed_int_from_float_f128(@ptrCast(^mut u8, ^mut wide), 256, v);
        @expect(wide == i128_int_from_float_f128(v));
    }

    let half: [3]f16 = .{ 65504, -65504, -2.5 };
    for (half) |v| {
        let mut wide: i256 = undefined;
        signed_int_from_float_f16(@ptrCast(^mut u8, ^mut wide), 256, v);
        @expect(wide == i128_int_from_float_f16(v));
    }
}

test "big_int_from_float saturates" {
    test_int_from_float(i256, math.max_int(i256), math.inf(f64));
    test_int_from_float(i256, math.min_int(i256), -math.inf(f64));
    test_int_from_float(i256, math.max_int(i256), @as(f64, 0x1p256));
    test_int_from_float(i256, math.min_int(i256), @as(f64, -0x1p255));
    test_int_from_float(u256, math.max_int(u256), math.inf(f64));
    test_int_from_float(u256, math.max_int(u256), @as(f64, 0x1p256));
    test_int_from_float(u256, 0, -math.inf(f64));
    test_int_from_float(u256, 0, @as(f64, -0x1p200));
    test_int_from_float(i256, 0, @as(f64, -0.5));
    test_int_from_float(u256, 0, @as(f64, 0.99));
}

test "big_int_from_float odd widths" {
    // The bits past `bits` in the top byte carry the sign
    let mut positive: u256 = 0;
    signed_int_from_float_f64(@ptrCast(^mut u8, ^mut positive), 197, 0x1p195);
    @expect(positive == 1 << 195);
    let mut negative: i256 = 0;
    signed_int_from_float_f64(@ptrCast(^mut u8, ^mut negative), 197, -0x1p196);
    @expect(@as(i200, @truncate(negative)) == -(1 << 196));

    // Saturation stops at `bits`, and bytes past the integer are never written
    let mut big: [4]u64 = .{ 0, 0, 0, 0xAAAA_AAAA_AAAA_AAAA };
    unsigned_int_from_float_f64(@ptrCast(^mut u8, ^mut big), 201, math.inf(f64));
    @expect(big[0] == math.max_int(u64) and big[2] == math.max_int(u64));
    @cfg (endian == .little) {
        @expect(big[3] == 0xAAAA_AAAA_AAAA_01FF);
    }
    let mut smin: i256 = 0;
    signed_int_from_float_f64(@ptrCast(^mut u8, ^mut smin), 197, -0x1p300);
    @expect(@as(i197, @truncate(smin)) == math.min_int(i197));
    let mut smax: i256 = 0;
    signed_int_from_float_f64(@ptrCast(^mut u8, ^mut smax), 197, 0x1p300);
    @expect(smax == math.max_int(i197));
}
