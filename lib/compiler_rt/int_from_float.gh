//! Ported from:
//!
//! https://codeberg.org/ziglang/zig/src/tag/0.17.0/lib/compiler_rt/int_from_float.zig
//! https://codeberg.org/ziglang/zig/src/tag/0.17.0/lib/compiler_rt/int_from_float_test.zig
import std;
import "compiler_rt.gh" as compiler_rt;

const math = std.math;
const symbol = compiler_rt.symbol;
const byte_index = compiler_rt.byte_index;

comptime {
    symbol(__fixhfsi, "__fixhfsi");
    symbol(__fixhfdi, "__fixhfdi");
    symbol(__fixhfti, "__fixhfti");
    symbol(__fixhfei, "__fixhfei");

    @cfg (compiler_rt.want_aeabi) {
        symbol(__aeabi_f2iz, "__aeabi_f2iz");
        symbol(__aeabi_f2lz, "__aeabi_f2lz");
    } else {
        symbol(__fixsfsi, "__fixsfsi");
        symbol(__fixsfdi, "__fixsfdi");
        symbol(__fixsfti, "__fixsfti");
    }
    symbol(__fixsfei, "__fixsfei");

    @cfg (compiler_rt.want_aeabi) {
        symbol(__aeabi_d2iz, "__aeabi_d2iz");
        symbol(__aeabi_d2lz, "__aeabi_d2lz");
    } else {
        symbol(__fixdfsi, "__fixdfsi");
        symbol(__fixdfdi, "__fixdfdi");
        symbol(__fixdfti, "__fixdfti");
    }
    symbol(__fixdfei, "__fixdfei");

    symbol(__fixxfsi, "__fixxfsi");
    symbol(__fixxfdi, "__fixxfdi");
    symbol(__fixxfti, "__fixxfti");
    symbol(__fixxfei, "__fixxfei");

    symbol(__fixtfsi, "__fixtfsi");
    symbol(__fixtfdi, "__fixtfdi");
    symbol(__fixtfti, "__fixtfti");
    symbol(__fixtfei, "__fixtfei");
}

const __fixhfsi = fn(a: f16) callconv(.c): i32 {
    return i32_int_from_float_f16(a);
};

@[inline(.always)] const i32_int_from_float_f16 = fn(a: f16): i32 {
    return int_from_float(i32, a);
};

const __fixhfdi = fn(a: f16) callconv(.c): i64 {
    return i64_int_from_float_f16(a);
};

@[inline(.always)] const i64_int_from_float_f16 = fn(a: f16): i64 {
    return int_from_float(i64, a);
};

const __fixhfti = fn(a: f16) callconv(.c): i128 {
    return i128_int_from_float_f16(a);
};

@[inline(.always)] const i128_int_from_float_f16 = fn(a: f16): i128 {
    return int_from_float(i128, a);
};

const __fixhfei = fn(r: ^mut u8, bits: usize, a: f16) callconv(.c): void {
    signed_int_from_float_f16(r, bits, a);
};

@[inline(.always)] const signed_int_from_float_f16 = fn(r: ^mut u8, bits: usize, a: f16): void {
    big_int_from_float(true, r, bits, a);
};

const __fixsfsi = fn(a: f32) callconv(.c): i32 {
    return i32_int_from_float_f32(a);
};

@[inline(.always)] const i32_int_from_float_f32 = fn(a: f32): i32 {
    return int_from_float(i32, a);
};

test "i32_int_from_float_f32" {
    import "cases/int_from_float/fixsfsi.gh" as fixsfsi_cases;
    for (fixsfsi_cases.cases) |case| {
        @expect(i32_int_from_float_f32(case.a) == case.expected);
    }
}

