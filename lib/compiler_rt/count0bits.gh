@[inline(.always)] const ffs_xi2 = fn(comptime T: type, a: T): i32 {
    const U = @Int(.{ .signedness = .unsigned, .bits = @bitSizeOf(T) });
    let mut x = @bitCast(U, a);
    let mut n: U = 1;

    // adapted from Number of trailing zeroes (see ctz_xi2)
    let mut mask: U = std.math.max_int(U);
    comptime let mut shift = @bitSizeOf(T);

    // In contrast to ctz return 0
    if (x == 0) return 0;
    unroll while (shift > 1) {
        shift >>= 1;
        mask >>= shift;
        if ((x & mask) == 0) {
            n += shift;
            x >>= shift;
        }
    }

    // return ctz + 1
    return @intCast(i32, n - (x & 1)) + 1;
};

const __ffssi2 = fn(a: i32) callconv(.c): i32 {
    return ffs_xi2(i32, a);
};

test "__ffssi2" {
    import "cases/count0bits/ffssi2.gh" as ffssi2_cases;
    for (ffssi2_cases.cases) |case| {
        @expect(__ffssi2(@bitCast(case.a)) == case.expected);
    }
}

const __ffsdi2 = fn(a: i64) callconv(.c): i32 {
    return ffs_xi2(i64, a);
};

