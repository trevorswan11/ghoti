const __ctzti2 = fn(a: i128) callconv(.c): i32 {
    return ctz_xi2(i128, a);
};

test "__ctzti2" {
    import "cases/count0bits/ctzti2.gh" as ctzti2_cases;
    for (ctzti2_cases.cases) |case| {
        @expect(__ctzti2(@bitCast(case.a)) == case.expected);
