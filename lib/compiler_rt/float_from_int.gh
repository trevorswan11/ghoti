//! Ported from:
//!
//! https://codeberg.org/ziglang/zig/src/tag/0.17.0/lib/compiler_rt/float_from_int.zig
//! https://codeberg.org/ziglang/zig/src/tag/0.17.0/lib/compiler_rt/float_from_int_test.zig
import std;
import "compiler_rt.gh" as compiler_rt;

const math = std.math;
const symbol = compiler_rt.symbol;
const byte_index = compiler_rt.byte_index;

comptime {
    symbol(__floatsihf, "__floatsihf");
    symbol(__floatdihf, "__floatdihf");
    symbol(__floattihf, "__floattihf");
    symbol(__floateihf, "__floateihf");

    @cfg (compiler_rt.want_aeabi) {
        symbol(__aeabi_i2f, "__aeabi_i2f");
        symbol(__aeabi_l2f, "__aeabi_l2f");
    } else {
        symbol(__floatsisf, "__floatsisf");
        symbol(__floatdisf, "__floatdisf");
    }
    symbol(__floattisf, "__floattisf");
    symbol(__floateisf, "__floateisf");

    @cfg (compiler_rt.want_aeabi) {
        symbol(__aeabi_i2d, "__aeabi_i2d");
        symbol(__aeabi_l2d, "__aeabi_l2d");
    } else {
        symbol(__floatsidf, "__floatsidf");
        symbol(__floatdidf, "__floatdidf");
    }
    symbol(__floattidf, "__floattidf");
    symbol(__floateidf, "__floateidf");

    symbol(__floatsixf, "__floatsixf");
    symbol(__floatdixf, "__floatdixf");
    symbol(__floattixf, "__floattixf");
    symbol(__floateixf, "__floateixf");

    symbol(__floatsitf, "__floatsitf");
    symbol(__floatditf, "__floatditf");
    @cfg (arch == .x86) {
        symbol(__floattitf_x86, "__floattitf");
    } else {
        symbol(__floattitf, "__floattitf");
    }
    symbol(__floateitf, "__floateitf");
}

const __floatsihf = fn(a: i32) callconv(.c): f16 {
    return f16_float_from_int_i32(a);
};

@[inline(.always)] const f16_float_from_int_i32 = fn(a: i32): f16 {
    return float_from_int(f16, a);
};

const __floatdihf = fn(a: i64) callconv(.c): f16 {
    return f16_float_from_int_i64(a);
};

@[inline(.always)] const f16_float_from_int_i64 = fn(a: i64): f16 {
    return float_from_int(f16, a);
};

const __floattihf = fn(a: i128) callconv(.c): f16 {
    return f16_float_from_int_i128(a);
};

@[inline(.always)] const f16_float_from_int_i128 = fn(a: i128): f16 {
    return float_from_int(f16, a);
};

const __floateihf = fn(a: ^u8, bits: usize) callconv(.c): f16 {
    return f16_float_from_int_signed(a, bits);
};

@[inline(.always)] const f16_float_from_int_signed = fn(a: ^u8, bits: usize): f16 {
    return float_from_big_int(f16, true, a, bits);
};

@cfg (compiler_rt.want_aeabi) {
    const __aeabi_i2f = fn(a: i32) callconv(.aapcs): f32 {
        return f32_float_from_int_i32(a);
    };

    const __aeabi_l2f = fn(a: i64) callconv(.aapcs): f32 {
        return f32_float_from_int_i64(a);
    };

    const __aeabi_i2d = fn(a: i32) callconv(.aapcs): f64 {
        return f64_float_from_int_i32(a);
    };

    const __aeabi_l2d = fn(a: i64) callconv(.aapcs): f64 {
        return f64_float_from_int_i64(a);
    };
}

const __floatsisf = fn(a: i32) callconv(.c): f32 {
    return f32_float_from_int_i32(a);
};

@[inline(.always)] const f32_float_from_int_i32 = fn(a: i32): f32 {
    return float_from_int(f32, a);
};

@[testing] const test_f32_float_from_int_i32 = fn(a: i32, expected: u32): void {
    let r = f32_float_from_int_i32(a);
    @expect(@bitCast(u32, r) == expected);
};

test "f32_float_from_int_i32" {
    test_f32_float_from_int_i32(0, 0x00000000);
    test_f32_float_from_int_i32(1, 0x3f800000);
    test_f32_float_from_int_i32(-1, 0xbf800000);
    test_f32_float_from_int_i32(0x7FFFFFFF, 0x4f000000);
    test_f32_float_from_int_i32(@bitCast(i32, @as(u32, 0x80000000)), 0xcf000000);

    @expect(f32_float_from_int_i32(math.min_int(i32)) == math.min_int(i32));
}

const __floatdisf = fn(a: i64) callconv(.c): f32 {
    return f32_float_from_int_i64(a);
};

@[inline(.always)] const f32_float_from_int_i64 = fn(a: i64): f32 {
    return float_from_int(f32, a);
};

test "f32_float_from_int_i64" {
    import "cases/float_from_int/floatdisf.gh" as floatdisf_cases;
    for (floatdisf_cases.cases) |case| {
        @expect(f32_float_from_int_i64(case.a) == case.expected);
    }
}

