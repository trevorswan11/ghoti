};

@cfg (compiler_rt.want_aeabi) {
    const __aeabi_ui2f = fn(a: u32) callconv(.aapcs): f32 {
        return f32_float_from_int_u32(a);
    };

    const __aeabi_ul2f = fn(a: u64) callconv(.aapcs): f32 {
        return f32_float_from_int_u64(a);
    };

    const __aeabi_ui2d = fn(a: u32) callconv(.aapcs): f64 {
        return f64_float_from_int_u32(a);
    };

    const __aeabi_ul2d = fn(a: u64) callconv(.aapcs): f64 {
