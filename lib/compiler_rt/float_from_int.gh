@[testing] const make_uti = fn(high: u64, low: u64): u128 {
    return @as(u128, high) << 64 | low;
};

@[testing] const make_tf = fn(high: u64, low: u64): f128 {
    return @bitCast(make_uti(high, low));
};

@[inline(.always)] const float_from_int = fn(comptime T: type, x: auto): T {
    if (x == 0) return 0;

    // Various constants whose values follow from the type parameters.
    // Any reasonable optimizer will fold and propagate all of these.
    const I = @TypeOf(x);
    const int_bits = @bitSizeOf(I);
    const float_bits = @bitSizeOf(T);
    const Z = @Int(.{ .signedness = .unsigned, .bits = int_bits });
    const UT = @Int(.{ .signedness = .unsigned, .bits = float_bits });
    const exp_bits = math.float_exponent_bits(T);
    const fractional_bits = math.float_fractional_bits(T);
    const exp_bias = math.max_int(@Int(.{ .signedness = .unsigned, .bits = exp_bits - 1 }));
    const implicit_bit = if comptime (T != f80) @as(UT, 1) << fractional_bits else 0;
    const max_exp = exp_bias;

    // Sign
    let is_negative = @typeInfo(I).int.signedness == .signed and x < 0;
    let bits: Z = @bitCast(x);
    let abs_val = if (is_negative) 0 -% bits else bits;
    let sign_bit: UT = if (is_negative) @as(UT, 1) << (float_bits - 1) else 0;
    let mut result: UT = sign_bit;

    // Compute significand
    let exp: usize = int_bits - 1 - @as(usize, @clz(abs_val));
    if (int_bits <= fractional_bits or exp <= fractional_bits) {
        let shift_amt = @intCast(math.Log2Int(UT), fractional_bits - exp);

        // Shift up result to line up with the significand - no rounding required
        result = @as(UT, @intCast(abs_val)) << shift_amt;
        result ^= implicit_bit; // Remove implicit integer bit
    } else {
        let shift_amt = @intCast(math.Log2Int(Z), exp - fractional_bits);
        let exact_tie = @ctz(abs_val) == shift_amt - 1;

        // Shift down result and remove implicit integer bit
        result = @as(UT, @intCast(abs_val >> (shift_amt - 1))) ^ (implicit_bit << 1);

        // Round result, including round-to-even for exact ties
        result = ((result + 1) >> 1) & ~@as(UT, @intFromBool(exact_tie));
    }

    // Compute exponent
    if (int_bits > max_exp and exp > max_exp) {
        // If exponent too large, overflow to infinity
        return @bitCast(sign_bit | @bitCast(UT, math.inf(T)));
    }

    result += (@as(UT, @intCast(exp)) + exp_bias) << math.float_mantissa_bits(T);

    // If the result included a carry, we need to restore the explicit integer bit
    if comptime (T == f80) {
        result |= 1 << fractional_bits;
    }

    return @bitCast(sign_bit | result);
};

/// Converts the `bits`-wide integer stored at `a` in its in-memory representation.
/// The bits past `bits` in its top byte are unspecified, so they are never read as part of it.
@[inline(.always)]
const float_from_big_int = fn(comptime T: type, comptime is_signed: bool, a: ^u8, bits: usize): T {
    let len = (bits + 7) / 8;
    if (len == 0) return 0;
    let bytes = @sliceFromPtr(a, len);

    // The top byte, extended past the integer's own bits
    let pad = @intCast(u3, 8 * len - bits);
    let top_raw = bytes[byte_index(len, len - 1)] << pad;
    let top: u8 = if (is_signed) @bitCast(@bitCast(i8, top_raw) >> pad) else top_raw >> pad;
    let fill: u8 = if (is_signed and top >> 7 != 0) 0xff else 0;

    if (bits <= 128) {
        let mut x: u128 = if (is_signed) @bitCast(@as(i128, @bitCast(i8, top))) else top;
        let mut i = len - 1;
        while (i > 0) {
            i -= 1;
            x = x << 8 | bytes[byte_index(len, i)];
        }
        return if comptime (is_signed) float_from_int(T, @bitCast(i128, x))
            else float_from_int(T, x);
    }

    // sign implicit fraction round sticky
    const I = @Int(.{
        .signedness = if comptime (is_signed) .signed else .unsigned,
        .bits = @intFromBool(is_signed) + 1 + math.float_fractional_bits(T) + 1 + 1,
    });

    let mut clsb: usize = 0;
    let mut i = len;
    while (i > 0) {
        i -= 1;
        let b = if (i == len - 1) top else bytes[byte_index(len, i)];
        clsb += @clz(b ^ fill);
        if (b != fill) break;
    }
    let clrsb = clsb - @intFromBool(is_signed);
    let active_bits = 8 * len - clrsb;
    let exponent = active_bits -| @bitSizeOf(I);

    // Every bit below the window rounds as one sticky bit
    let exponent_byte = exponent / 8;
    let below = (@as(u8, 1) << @truncate(u3, exponent)) - 1;
    let mut sticky = bytes[byte_index(len, exponent_byte)] & below != 0;
    for (0..exponent_byte) |j| {
        if (bytes[byte_index(len, j)] != 0) {
            sticky = true;
            break;
        }
    }

    let window = std.mem.read_packed_int(I, bytes, exponent, @targetEndian());
    return math.ldexp(float_from_int(T, window | @intFromBool(sticky)), @intCast(i32, exponent));
};

test "float_from_big_int matches the fixed-width path" {
    let small: [5]i256 = .{ 0, 1, -1, 0x123456789ABCDEF0123, -0x7FFF_FFFF_FFFF_FFFF_FFFF };
    for (small) |v| {
        let narrow = @as(i128, @intCast(v));
        @expect(
            f64_float_from_int_signed(@ptrCast(^u8, ^v), 256) == f64_float_from_int_i128(narrow),
        );
        @expect(
            f128_float_from_int_signed(@ptrCast(^u8, ^v), 256) == f128_float_from_int_i128(narrow),
        );
        @expect(
            f80_float_from_int_signed(@ptrCast(^u8, ^v), 256) == f80_float_from_int_i128(narrow),
        );
        @expect(
            f16_float_from_int_signed(@ptrCast(^u8, ^v), 256) == f16_float_from_int_i128(narrow),
        );
    }

    // Widths at or below 128 bits take the narrow path directly
    let x: i128 = -0x8123456789ABCDEF;
    @expect(f32_float_from_int_signed(@ptrCast(^u8, ^x), 128) == f32_float_from_int_i128(x));
    let y: u64 = 0xFFFF_FFFF_FFFF_FFFF;
    @expect(f64_float_from_int_unsigned(@ptrCast(^u8, ^y), 64) == f64_float_from_int_u64(y));
}

test "float_from_big_int odd widths" {
    // Bits past the top of the integer are unspecified and must not leak into the result
    let u: u256 = (0x7F << 201) | (1 << 200) | (1 << 140);
    @expect(f64_float_from_int_unsigned(@ptrCast(^u8, ^u), 201) == 0x1p200 + 0x1p140);

    // A positive `i197` under set padding bits, and a negative one under clear padding bits
    let positive: u256 = (0b111 << 197) | (1 << 195);
    @expect(f64_float_from_int_signed(@ptrCast(^u8, ^positive), 197) == 0x1p195);
    let negative: u256 = 1 << 196;
    @expect(f64_float_from_int_signed(@ptrCast(^u8, ^negative), 197) == -0x1p196);

    // Large magnitudes overflow to infinity in narrow formats
    let big: u256 = math.max_int(u256);
    @expect(f16_float_from_int_unsigned(@ptrCast(^u8, ^big), 256) == math.inf(f16));
    @expect(f128_float_from_int_unsigned(@ptrCast(^u8, ^big), 256) == 0x1p256);
}
