const __floatsitf = fn(a: i32) callconv(.c): f128 {
    return f128_float_from_int_i32(a);
};

@[inline(.always)] const f128_float_from_int_i32 = fn(a: i32): f128 {
    return float_from_int(f128, a);
};

@[testing] const test_f128_float_from_int_i32 = fn(a: i32, expected: u128): void {
    let r = f128_float_from_int_i32(a);
    @expect(@bitCast(u128, r) == expected);
};

test "f128_float_from_int_i32" {
    test_f128_float_from_int_i32(0, 0);
    test_f128_float_from_int_i32(0x7FFFFFFF, 0x401dfffffffc00000000000000000000);
    test_f128_float_from_int_i32(0x12345678, 0x401b2345678000000000000000000000);
    test_f128_float_from_int_i32(-0x12345678, 0xc01b2345678000000000000000000000);
    test_f128_float_from_int_i32(
        @bitCast(i32, @as(u32, 0xffffffff)),
        0xbfff0000000000000000000000000000,
    );
    test_f128_float_from_int_i32(
        @bitCast(i32, @as(u32, 0x80000000)),
        0xc01e0000000000000000000000000000,
    );
}

const __floatditf = fn(a: i64) callconv(.c): f128 {
    return f128_float_from_int_i64(a);
};

@[inline(.always)] const f128_float_from_int_i64 = fn(a: i64): f128 {
    return float_from_int(f128, a);
};

@[testing] const test_f128_float_from_int_i64 = fn(a: i64, expected: f128): void {
    let x = f128_float_from_int_i64(a);
    @expect(x == expected);
};

test "f128_float_from_int_i64" {
    test_f128_float_from_int_i64(
        0x7fffffffffffffff,
        make_tf(0x403dffffffffffff, 0xfffc000000000000),
    );
    test_f128_float_from_int_i64(
        0x123456789abcdef1,
        make_tf(0x403b23456789abcd, 0xef10000000000000),
    );
    test_f128_float_from_int_i64(0x2, make_tf(0x4000000000000000, 0x0));
    test_f128_float_from_int_i64(0x1, make_tf(0x3fff000000000000, 0x0));
    test_f128_float_from_int_i64(0x0, make_tf(0x0, 0x0));
    test_f128_float_from_int_i64(
        @bitCast(i64, @as(u64, 0xffffffffffffffff)),
        make_tf(0xbfff000000000000, 0x0),
    );
    test_f128_float_from_int_i64(
        @bitCast(i64, @as(u64, 0xfffffffffffffffe)),
        make_tf(0xc000000000000000, 0x0),
    );
    test_f128_float_from_int_i64(
        -0x123456789abcdef1,
        make_tf(0xc03b23456789abcd, 0xef10000000000000),
    );
    test_f128_float_from_int_i64(
        @bitCast(i64, @as(u64, 0x8000000000000000)),
        make_tf(0xc03e000000000000, 0x0),
    );
}

