    };
}

const __floatunsisf = fn(a: u32) callconv(.c): f32 {
    return f32_float_from_int_u32(a);
};

@[inline(.always)] const f32_float_from_int_u32 = fn(a: u32): f32 {
    return float_from_int(f32, a);
};

@[testing] const test_f32_float_from_int_u32 = fn(a: u32, expected: u32): void {
    let r = f32_float_from_int_u32(a);
    @expect(@bitCast(u32, r) == expected);
};

test "f32_float_from_int_u32" {
    // Test the produced bit pattern
    test_f32_float_from_int_u32(0, 0);
    test_f32_float_from_int_u32(1, 0x3f800000);
    test_f32_float_from_int_u32(0x7FFFFFFF, 0x4f000000);
    test_f32_float_from_int_u32(0x80000000, 0x4f000000);
    test_f32_float_from_int_u32(0xFFFFFFFF, 0x4f800000);

    @expect(f32_float_from_int_u32(0) == 0.0);
    @expect(f32_float_from_int_u32(math.max_int(u24)) == math.max_int(u24));
    // 0x100_0000 - Exact
    @expect(f32_float_from_int_u32(math.max_int(u24) + 1) == math.max_int(u24) + 1);
    // 0x100_0001 - Tie: Rounds down to even
    @expect(f32_float_from_int_u32(math.max_int(u24) + 2) == math.max_int(u24) + 1);
    // 0x100_0002 - Exact
    @expect(f32_float_from_int_u32(math.max_int(u24) + 3) == math.max_int(u24) + 3);
    // 0x100_0003 - Tie: Rounds up to even
    @expect(f32_float_from_int_u32(math.max_int(u24) + 4) == math.max_int(u24) + 5);
    // 0x100_0004 - Exact
    @expect(f32_float_from_int_u32(math.max_int(u24) + 5) == math.max_int(u24) + 5);
    @expect(f32_float_from_int_u32(math.max_int(u32)) == math.max_int(u32) + 1);
}

