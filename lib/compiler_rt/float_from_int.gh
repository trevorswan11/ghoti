test "f80_float_from_int_u128" {
    @expect(f80_float_from_int_u128(math.max_int(u64) + 1) == math.max_int(u64) + 1);

    @expect(f80_float_from_int_u128(math.max_int(u64) + 0) == math.max_int(u64));
    @expect(f80_float_from_int_u128(math.max_int(u64) + 1) == math.max_int(u64) + 1); // Exact
    @expect(f80_float_from_int_u128(math.max_int(u64) + 2) == math.max_int(u64) + 1); // Rounds down
    @expect(f80_float_from_int_u128(math.max_int(u64) + 3) == math.max_int(u64) + 3); // Tie - Exact
    @expect(f80_float_from_int_u128(math.max_int(u64) + 4) == math.max_int(u64) + 5); // Rounds up

    @expect(f80_float_from_int_u128(math.max_int(u65) + 0) == math.max_int(u65) + 1); // Rounds up
    @expect(f80_float_from_int_u128(math.max_int(u65) + 1) == math.max_int(u65) + 1); // Exact
    @expect(f80_float_from_int_u128(math.max_int(u65) + 2) == math.max_int(u65) + 1); // Rounds down
    @expect(f80_float_from_int_u128(math.max_int(u65) + 3) == math.max_int(u65) + 1); // Tie - Rounds down
    @expect(f80_float_from_int_u128(math.max_int(u65) + 4) == math.max_int(u65) + 5); // Rounds up
    @expect(f80_float_from_int_u128(math.max_int(u65) + 5) == math.max_int(u65) + 5); // Exact
}

