test "f32_float_from_int_unsigned" {
    test_f32_float_from_int(0x00000000, u256, 0);
    test_f32_float_from_int(0x5F012345, u256, 0x8123456789ABCDEF);
    test_f32_float_from_int(0x5F012346, u256, 0x8123458000000000);
    test_f32_float_from_int(0x5F012346, u256, 0x8123458000000001);
    test_f32_float_from_int(0x5F012346, u256, 0x8123458080000000);
    test_f32_float_from_int(0x5F012346, u256, 0x8123468000000000);
    test_f32_float_from_int(0x5F012347, u256, 0x8123468000000001);
    test_f32_float_from_int(0x5F012347, u256, 0x8123468080000000);
    test_f32_float_from_int(0x7F000000, u256, math.max_int(u127));
    test_f32_float_from_int(0x7F000000, u256, 1 << 127);
    test_f32_float_from_int(0x7F800000, u256, math.max_int(u256));
}

