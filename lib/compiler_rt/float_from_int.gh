    return f32_float_from_int_i128(a);
};

@[inline(.always)] const f32_float_from_int_i128 = fn(a: i128): f32 {
    return float_from_int(f32, a);
};

test "f32_float_from_int_i128" {
    import "cases/float_from_int/floattisf.gh" as floattisf_cases;
    for (floattisf_cases.cases) |case| {
        @expect(f32_float_from_int_i128(case.a) == case.expected);
    }
}

const __floateisf = fn(a: ^u8, bits: usize) callconv(.c): f32 {
    return f32_float_from_int_signed(a, bits);
};

@[inline(.always)] const f32_float_from_int_signed = fn(a: ^u8, bits: usize): f32 {
    return float_from_big_int(f32, true, a, bits);
};

@[testing] const test_f32_float_from_int = fn(expected: u32, comptime T: type, a: T): void {
    let r = match comptime (@typeInfo(T).int.signedness) {
        .signed => f32_float_from_int_signed(@ptrCast(^u8, ^a), @bitSizeOf(T)),
        .unsigned => f32_float_from_int_unsigned(@ptrCast(^u8, ^a), @bitSizeOf(T)),
    };
    @expect(expected == @bitCast(u32, r));
};

test "f32_float_from_int_signed" {
    test_f32_float_from_int(0xFF000000, i256, -1 << 127);
    test_f32_float_from_int(0xFF000000, i256, -math.max_int(u127));
    test_f32_float_from_int(0xDF012347, i256, -0x8123468100000000);
    test_f32_float_from_int(0xDF012347, i256, -0x8123468000000001);
    test_f32_float_from_int(0xDF012346, i256, -0x8123468000000000);
    test_f32_float_from_int(0xDF012346, i256, -0x8123458100000000);
    test_f32_float_from_int(0xDF012346, i256, -0x8123458000000001);
    test_f32_float_from_int(0xDF012346, i256, -0x8123458000000000);
    test_f32_float_from_int(0xDF012345, i256, -0x8123456789ABCDEF);
    test_f32_float_from_int(0xBF800000, i256, -1);
    test_f32_float_from_int(0x00000000, i256, 0);
    test_f32_float_from_int(0x5F012345, i256, 0x8123456789ABCDEF);
    test_f32_float_from_int(0x5F012346, i256, 0x8123458000000000);
    test_f32_float_from_int(0x5F012346, i256, 0x8123458000000001);
    test_f32_float_from_int(0x5F012346, i256, 0x8123458100000000);
    test_f32_float_from_int(0x5F012346, i256, 0x8123468000000000);
    test_f32_float_from_int(0x5F012347, i256, 0x8123468000000001);
    test_f32_float_from_int(0x5F012347, i256, 0x8123468100000000);
    test_f32_float_from_int(0x7F000000, i256, math.max_int(u127));
    test_f32_float_from_int(0x7F000000, i256, 1 << 127);
}

const __floatsidf = fn(a: i32) callconv(.c): f64 {
    return f64_float_from_int_i32(a);
};

@[inline(.always)] const f64_float_from_int_i32 = fn(a: i32): f64 {
    return float_from_int(f64, a);
};

@[testing] const test_f64_float_from_int_i32 = fn(a: i32, expected: u64): void {
    let r = f64_float_from_int_i32(a);
    @expect(@bitCast(u64, r) == expected);
};

test "f64_float_from_int_i32" {
    test_f64_float_from_int_i32(0, 0x0000000000000000);
    test_f64_float_from_int_i32(1, 0x3ff0000000000000);
    test_f64_float_from_int_i32(-1, 0xbff0000000000000);
    test_f64_float_from_int_i32(0x7FFFFFFF, 0x41dfffffffc00000);
    test_f64_float_from_int_i32(@bitCast(i32, @as(u32, 0x80000000)), 0xc1e0000000000000);
}

