//! https://git.musl-libc.org/cgit/musl/tree/src/math/tan.c
//! https://git.musl-libc.org/cgit/musl/tree/src/math/tanl.c
import std;
import "compiler_rt.gh" as compiler_rt;
import "trig.gh" as trig;
import "rem_pio2f.gh" as rem_pio2f_impl;
import "rem_pio2.gh" as rem_pio2_impl;
import "rem_pio2l.gh" as rem_pio2l_impl;

const math = std.math;
const ld = math.long_double;
const mem = std.mem;
const symbol = compiler_rt.symbol;
const rem_pio2f = rem_pio2f_impl.rem_pio2f;
const rem_pio2 = rem_pio2_impl.rem_pio2;
const rem_pio2l = rem_pio2l_impl.rem_pio2l;

comptime {
    symbol(__tanh, "__tanh");
    symbol(tanf, "tanf");
    symbol(tan, "tan");
    symbol(__tanx, "__tanx");
    symbol(tanq, "tanf128");
    symbol(tanl, "tanl");

    @cfg (compiler_rt.is_windows_msvc) {
        symbol(tanf64x, "tanf64x");
    }
}

const __tanh = fn(x: f16) callconv(.c): f16 {
    return tan_f16(x);
};

pub const tan_f16 = fn(x: f16): f16 {
    // TODO: more efficient implementation
    return @floatCast(tan_f32(@floatCast(x)));
};

const tanf = fn(x: f32) callconv(.c): f32 {
    return tan_f32(x);
};

pub const tan_f32 = fn(x: f32): f32 {
    // Small multiples of pi/2 rounded to double precision.
    const t1pio2: f64 = 1.0 * math.pi / 2.0; // 0x3FF921FB, 0x54442D18
    const t2pio2: f64 = 2.0 * math.pi / 2.0; // 0x400921FB, 0x54442D18
    const t3pio2: f64 = 3.0 * math.pi / 2.0; // 0x4012D97C, 0x7F3321D2
    const t4pio2: f64 = 4.0 * math.pi / 2.0; // 0x401921FB, 0x54442D18

    let mut ix: u32 = @bitCast(x);
    let sign = (ix >> 31) != 0;
    ix &= 0x7fffffff;

    if (ix <= 0x3f490fda) { // |x| ~<= pi/4
        if (ix < 0x39800000) { // |x| < 2**-12
            // raise inexact if x!=0 and underflow if subnormal
            @cfg (compiler_rt.want_float_exceptions) {
                if (ix < 0x00800000) {
                    mem.do_not_optimize_away(x / 0x1p120);
                } else {
                    mem.do_not_optimize_away(x + 0x1p120);
                }
            }
            return x;
        }
        return trig.tandf(x, false);
    }
    if (ix <= 0x407b53d1) { // |x| ~<= 5*pi/4
        if (ix <= 0x4016cbe3) { // |x| ~<= 3pi/4
            return trig.tandf(
                if (sign) @floatCast(f64, x) + t1pio2 else @floatCast(f64, x) - t1pio2,
                true,
            );
        } else {
            return trig.tandf(
                if (sign) @floatCast(f64, x) + t2pio2 else @floatCast(f64, x) - t2pio2,
                false,
            );
        }
    }
    if (ix <= 0x40e231d5) { // |x| ~<= 9*pi/4
        if (ix <= 0x40afeddf) { // |x| ~<= 7*pi/4
            return trig.tandf(
                if (sign) @floatCast(f64, x) + t3pio2 else @floatCast(f64, x) - t3pio2,
                true,
            );
        } else {
            return trig.tandf(
                if (sign) @floatCast(f64, x) + t4pio2 else @floatCast(f64, x) - t4pio2,
                false,
            );
        }
    }

    // tan(Inf or NaN) is NaN
    if (ix >= 0x7f800000) {
        return x - x;
    }

    let mut y: f64 = undefined;
    let n = rem_pio2f(x, &mut y);
    return trig.tandf(y, (n & 1) != 0);
};

const tan = fn(x: f64) callconv(.c): f64 {
    return tan_f64(x);
};

pub const tan_f64 = fn(x: f64): f64 {
    let mut ix: u64 = @bitCast(u64, x) >> 32;
    ix &= 0x7fffffff;

    // |x| ~< pi/4
    if (ix <= 0x3fe921fb) {
        if (ix < 0x3e400000) { // |x| < 2**-27
            // raise inexact if x!=0 and underflow if subnormal
            @cfg (compiler_rt.want_float_exceptions) {
                if (ix < 0x00100000) {
                    mem.do_not_optimize_away(x / 0x1p120);
                } else {
                    mem.do_not_optimize_away(x + 0x1p120);
                }
            }
            return x;
        }
        return trig.tan(x, 0.0, false);
    }

    // tan(Inf or NaN) is NaN
    if (ix >= 0x7ff00000) {
        return x - x;
    }

    let mut y: [2]mut f64 = undefined;
    let n = rem_pio2(x, &mut y);
    return trig.tan(y[0], y[1], (n & 1) != 0);
};

@cfg (compiler_rt.is_windows_msvc) {
    const tanf64x = fn(a: f80) callconv(.c): f80 {
        return tan_f80(a);
    };
}

const __tanx = fn(x: u80) callconv(.c): u80 {
    return @bitCast(tan_f80(@bitCast(x)));
};

pub const tan_f80 = fn(x: f80): f80 {
    let se = ld.sign_exponent(x) & 0x7fff;
    if (se == 0x7fff) {
        return x - x;
    }

    if (@abs(x) < trig.pi_4) {
        if (se < 0x3fff - (math.float_mantissa_bits(f80) / 2)) {
            @cfg (compiler_rt.want_float_exceptions) {
                mem.do_not_optimize_away(if (se == 0) x * 0x1p-120 else x + 0x1p120);
            }
            return x;
        }
        return trig.tanx(x, 0.0, 0);
    }

    let mut y: [2]mut f80 = undefined;
    let n = rem_pio2l(f80, x, &mut y);
    return trig.tanx(y[0], y[1], n & 1);
};

const tanq = fn(x: f128) callconv(.c): f128 {
    return tan_f128(x);
};

pub const tan_f128 = fn(x: f128): f128 {
    let se = ld.sign_exponent(x) & 0x7fff;
    if (se == 0x7fff) {
        return x - x;
    }

    if (@abs(x) < trig.pi_4) {
        if (se < 0x3fff - (math.float_mantissa_bits(f128) / 2)) {
            @cfg (compiler_rt.want_float_exceptions) {
                mem.do_not_optimize_away(if (se == 0) x * 0x1p-120 else x + 0x1p120);
            }
            return x;
        }
        return trig.tanq(x, 0.0, 0);
    }

    let mut y: [2]mut f128 = undefined;
    let n = rem_pio2l(f128, x, &mut y);
    return trig.tanq(y[0], y[1], n & 1);
};

pub const tanl = fn(x: c_longdouble) callconv(.c): c_longdouble {
    return match comptime (@typeInfo(c_longdouble).float.bits) {
        64 => tan_f64(x),
        80 => tan_f80(x),
        128 => tan_f128(x),
        _ => unreachable,
    };
};

@[testing] const test_tan_normal = fn(comptime T: type): void {
    const tan_t = fn(v: T): T {
        return match comptime (T) {
            f16 => tan_f16(v),
            f32 => tan_f32(v),
            f64 => tan_f64(v),
            f80 => tan_f80(v),
            f128 => tan_f128(v),
            _ => unreachable,
        };
    };

    const epsilon = 0.00001;

    @expect(math.approx_eq_abs(T, 0.0, tan_t(0.0), epsilon));
    @expect(math.approx_eq_abs(T, 0.202710, tan_t(0.2), epsilon));
    @expect(math.approx_eq_abs(T, 1.240422, tan_t(0.8923), epsilon));
    @expect(math.approx_eq_abs(T, 14.101420, tan_t(1.5), epsilon));
    @expect(math.approx_eq_abs(T, -0.254397, tan_t(37.45), epsilon));
    @expect(math.approx_eq_abs(T, 2.285837, tan_t(89.123), epsilon));
};

@[testing] const test_tan_special = fn(comptime T: type): void {
    const tan_t = fn(v: T): T {
        return match comptime (T) {
            f16 => tan_f16(v),
            f32 => tan_f32(v),
            f64 => tan_f64(v),
            f80 => tan_f80(v),
            f128 => tan_f128(v),
            _ => unreachable,
        };
    };

    @expect(math.is_positive_zero(tan_t(0.0)));
    @expect(math.is_negative_zero(tan_t(-0.0)));
    @expect(math.is_nan(tan_t(math.inf(T))));
    @expect(math.is_nan(tan_t(-math.inf(T))));
    @expect(math.is_nan(tan_t(math.nan(T))));
};

test "tan32.normal" {
    test_tan_normal(f32);
}

test "tan64.normal" {
    test_tan_normal(f64);
}

test "tan80.normal" {
    const epsilon = math.float_eps(f80);

    @expect(math.approx_eq_abs(f80, 0.0, tan_f80(0.0), epsilon));
    @expect(math.approx_eq_abs(f80, 0.2027100355086724833213582716475345, tan_f80(0.2), epsilon));
    @expect(
        math.approx_eq_abs(f80, 1.2404217445497097995561220131857544, tan_f80(0.8923), epsilon),
    );
    @expect(math.approx_eq_abs(f80, 14.10141994717171938764, tan_f80(1.5), epsilon));
    @expect(math.approx_eq_abs(f80, -0.25439607116885656232, tan_f80(37.45), epsilon));
    @expect(math.approx_eq_abs(f80, 2.2858376251355320963, tan_f80(89.123), epsilon));
}

test "tan128.normal" {
    const epsilon = math.float_eps(f128);

    @expect(math.approx_eq_abs(f128, 0.0, tan_f128(0.0), epsilon));
    @expect(math.approx_eq_abs(f128, 0.2027100355086724833213582716475345, tan_f128(0.2), epsilon));
    @expect(
        math.approx_eq_abs(f128, 1.2404217445497097995561220131857544, tan_f128(0.8923), epsilon),
    );
    @expect(math.approx_eq_abs(f128, 14.101419947171719387646083651987755, tan_f128(1.5), epsilon));
    @expect(
        math.approx_eq_abs(f128, -0.2543960711688565630469573224504774, tan_f128(37.45), epsilon),
    );
    @expect(
        math.approx_eq_abs(f128, 2.2858376251355321074066028114094292, tan_f128(89.123), epsilon),
    );
}

test "tan32.special" {
    test_tan_special(f32);
}

test "tan64.special" {
    test_tan_special(f64);
}

test "tan80.special" {
    test_tan_special(f80);
}

test "tan128.special" {
    test_tan_special(f128);
}
