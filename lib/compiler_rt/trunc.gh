//! https://git.musl-libc.org/cgit/musl/tree/src/math/truncf.c
//! https://git.musl-libc.org/cgit/musl/tree/src/math/trunc.c
import std;
import "compiler_rt.gh" as compiler_rt;

const mem = std.mem;
const math = std.math;
const symbol = compiler_rt.symbol;

comptime {
    symbol(__trunch, "__trunch");
    symbol(truncf, "truncf");
    symbol(trunc, "trunc");
    symbol(__truncx, "__truncx");
    symbol(truncq, "truncf128");
    symbol(truncl, "truncl");

    @cfg (compiler_rt.is_windows_msvc) {
        symbol(truncf64x, "truncf64x");
    }
}

const __trunch = fn(x: f16) callconv(.c): f16 {
    return trunc_f16(x);
};

@[inline(.always)] const trunc_f16 = fn(x: f16): f16 {
    return trunc_impl(f16, x);
};

test "trunc_f16" {
    @expect(trunc_f16(1.3) == 1.0);
    @expect(trunc_f16(-1.3) == -1.0);
    @expect(math.is_positive_zero(trunc_f16(0.2)));
    @expect(math.is_negative_zero(trunc_f16(-0.2)));
    @expect(math.is_positive_zero(trunc_f16(0.0)));
    @expect(math.is_negative_zero(trunc_f16(-0.0)));
    @expect(math.is_positive_inf(trunc_f16(math.inf(f16))));
    @expect(math.is_negative_inf(trunc_f16(-math.inf(f16))));
    @expect(math.is_nan(trunc_f16(math.nan(f16))));
}

const truncf = fn(x: f32) callconv(.c): f32 {
    return trunc_f32(x);
};

@[inline(.always)] const trunc_f32 = fn(x: f32): f32 {
    return trunc_impl(f32, x);
};

test "trunc_f32" {
    @expect(trunc_f32(1.3) == 1.0);
    @expect(trunc_f32(-1.3) == -1.0);
    @expect(math.is_positive_zero(trunc_f32(0.2)));
    @expect(math.is_negative_zero(trunc_f32(-0.2)));
    @expect(math.is_positive_zero(trunc_f32(0.0)));
    @expect(math.is_negative_zero(trunc_f32(-0.0)));
    @expect(math.is_positive_inf(trunc_f32(math.inf(f32))));
    @expect(math.is_negative_inf(trunc_f32(-math.inf(f32))));
    @expect(math.is_nan(trunc_f32(math.nan(f32))));
}

const trunc = fn(x: f64) callconv(.c): f64 {
    return trunc_f64(x);
};

@[inline(.always)] const trunc_f64 = fn(x: f64): f64 {
    return trunc_impl(f64, x);
};

test "trunc_f64" {
    @expect(trunc_f64(1.3) == 1.0);
    @expect(trunc_f64(-1.3) == -1.0);
    @expect(math.is_positive_zero(trunc_f64(0.2)));
    @expect(math.is_negative_zero(trunc_f64(-0.2)));
    @expect(math.is_positive_zero(trunc_f64(0.0)));
    @expect(math.is_negative_zero(trunc_f64(-0.0)));
    @expect(math.is_positive_inf(trunc_f64(math.inf(f64))));
    @expect(math.is_negative_inf(trunc_f64(-math.inf(f64))));
    @expect(math.is_nan(trunc_f64(math.nan(f64))));
}

@cfg (compiler_rt.is_windows_msvc) {
    const truncf64x = fn(x: f80) callconv(.c): f80 {
        return trunc_f80(x);
    };
}

const __truncx = fn(x: u80) callconv(.c): u80 {
    return @bitCast(trunc_f80(@bitCast(x)));
};

@[inline(.always)] const trunc_f80 = fn(x: f80): f80 {
    // TODO: more efficient implementation
    return @floatCast(f80, trunc_f128(x));
};

test "trunc_f80" {
    @expect(trunc_f80(1.3) == 1.0);
    @expect(trunc_f80(-1.3) == -1.0);
    @expect(math.is_positive_zero(trunc_f80(0.2)));
    @expect(math.is_negative_zero(trunc_f80(-0.2)));
    @expect(math.is_positive_zero(trunc_f80(0.0)));
    @expect(math.is_negative_zero(trunc_f80(-0.0)));
    @expect(math.is_positive_inf(trunc_f80(math.inf(f80))));
    @expect(math.is_negative_inf(trunc_f80(-math.inf(f80))));
    @expect(math.is_nan(trunc_f80(math.nan(f80))));
    @expect(math.is_nan(trunc_f80(@bitCast(@as(u80, 0x3251_1dac0c5cd99e87ca)))));
}

const truncq = fn(x: f128) callconv(.c): f128 {
    return trunc_f128(x);
};

@[inline(.always)] const trunc_f128 = fn(x: f128): f128 {
    return trunc_impl(f128, x);
};

test "trunc_f128" {
    @expect(trunc_f128(1.3) == 1.0);
    @expect(trunc_f128(-1.3) == -1.0);
    @expect(math.is_positive_zero(trunc_f128(0.2)));
    @expect(math.is_negative_zero(trunc_f128(-0.2)));
    @expect(math.is_positive_zero(trunc_f128(0.0)));
    @expect(math.is_negative_zero(trunc_f128(-0.0)));
    @expect(math.is_positive_inf(trunc_f128(math.inf(f128))));
    @expect(math.is_negative_inf(trunc_f128(-math.inf(f128))));
    @expect(math.is_nan(trunc_f128(math.nan(f128))));
}

const truncl = fn(x: c_longdouble) callconv(.c): c_longdouble {
    return match comptime (@typeInfo(c_longdouble).float.bits) {
        64 => trunc_f64(x),
        80 => trunc_f80(x),
        128 => trunc_f128(x),
        _ => unreachable,
    };
};

@[inline(.always)] const trunc_impl = fn(comptime T: type, x: T): T {
    const C = 1.0 / math.float_eps(T);
    const mantissa = math.float_mantissa_bits(T);
    const exponent = math.float_exponent_bits(T);
    const exp_mask = (1 << exponent) - 1;
    const bias = (1 << exponent - 1) - 1;

    const bits = @bitSizeOf(T);
    const U = @Int(.{ .signedness = .unsigned, .bits = bits });
    const shift = bits - mantissa;

    let u: U = @bitCast(x);
    let mut e = @as(i32, @intCast(u >> mantissa & exp_mask)) - bias + shift;
    let mut m: U = undefined;

    if (e >= bits) return x;
    if (e < shift) e = 1;

    m = @as(U, math.max_int(U)) >> @intCast(e);
    if (u & m == 0) return x;
    @cfg (compiler_rt.want_float_exceptions) {
        mem.do_not_optimize_away(x + C);
    }
    return @bitCast(u & ~m);
};
