import std;
import "compiler_rt.gh" as compiler_rt;

const math = std.math;
const symbol = compiler_rt.symbol;

comptime {
    symbol(__fmaxh, "__fmaxh");
    symbol(fmaxf, "fmaxf");
    symbol(fmax, "fmax");
    symbol(__fmaxx, "__fmaxx");
    symbol(fmaxq, "fmaxf128");
    symbol(fmaxl, "fmaxl");

    @cfg (compiler_rt.is_windows_msvc) {
        symbol(fmaxf64x, "fmaxf64x");
    }
}

const __fmaxh = fn(x: f16, y: f16) callconv(.c): f16 {
    return fmax_f16(x, y);
};

pub const fmax_f16 = fn(x: f16, y: f16): f16 {
    return generic_fmax(f16, x, y);
};

const fmaxf = fn(x: f32, y: f32) callconv(.c): f32 {
    return fmax_f32(x, y);
};

pub const fmax_f32 = fn(x: f32, y: f32): f32 {
    return generic_fmax(f32, x, y);
};

const fmax = fn(x: f64, y: f64) callconv(.c): f64 {
    return fmax_f64(x, y);
};

pub const fmax_f64 = fn(x: f64, y: f64): f64 {
    return generic_fmax(f64, x, y);
};

@cfg (compiler_rt.is_windows_msvc) {
    const fmaxf64x = fn(a: f80, b: f80) callconv(.c): f80 {
        return fmax_f80(a, b);
    };
}

const __fmaxx = fn(x: u80, y: u80) callconv(.c): u80 {
    return @bitCast(fmax_f80(@bitCast(x), @bitCast(y)));
};

pub const fmax_f80 = fn(x: f80, y: f80): f80 {
    return generic_fmax(f80, x, y);
};

const fmaxq = fn(x: f128, y: f128) callconv(.c): f128 {
    return fmax_f128(x, y);
};

pub const fmax_f128 = fn(x: f128, y: f128): f128 {
    return generic_fmax(f128, x, y);
};

pub const fmaxl = fn(x: c_longdouble, y: c_longdouble) callconv(.c): c_longdouble {
    return match comptime (@typeInfo(c_longdouble).float.bits) {
        64 => fmax_f64(x, y),
        80 => fmax_f80(x, y),
        128 => fmax_f128(x, y),
        _ => unreachable,
    };
};

@[inline(.always)] pub const generic_fmax = fn(comptime T: type, x: T, y: T): T {
    if (math.is_nan(x)) return y;
    if (math.is_nan(y)) return x;
    if (math.signbit(x) != math.signbit(y)) {
        return if (math.signbit(x)) y else x;
    }
    return if (x < y) y else x;
};

@[testing] const test_generic_fmax = fn(comptime T: type): void {
    let nan_val = math.nan(T);

    @expect(math.is_nan(generic_fmax(T, nan_val, nan_val)));
    @expect(generic_fmax(T, nan_val, @as(T, 1.0)) == @as(T, 1.0));
    @expect(generic_fmax(T, @as(T, 1.0), nan_val) == @as(T, 1.0));

    @expect(generic_fmax(T, @as(T, 1.0), @as(T, 10.0)) == @as(T, 10.0));
    @expect(generic_fmax(T, @as(T, 1.0), @as(T, -1.0)) == @as(T, 1.0));

    @expect(math.is_positive_zero(generic_fmax(T, @as(T, 0.0), @as(T, -0.0))));
    @expect(math.is_positive_zero(generic_fmax(T, @as(T, -0.0), @as(T, 0.0))));
};

test "generic_fmax" {
    test_generic_fmax(f16);
    test_generic_fmax(f32);
    test_generic_fmax(f64);
    test_generic_fmax(f80);
    test_generic_fmax(f128);
}

