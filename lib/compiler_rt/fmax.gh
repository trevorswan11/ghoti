test "fmaxl" {
    let nan_val = math.nan(c_longdouble);
    @expect(math.is_nan(fmaxl(nan_val, nan_val)));
    @expect(fmaxl(nan_val, 1.0) == 1.0);
    @expect(fmaxl(1.0, nan_val) == 1.0);
    @expect(fmaxl(1.0, 10.0) == 10.0);
    @expect(fmaxl(1.0, -1.0) == 1.0);
}

test "fmax_f16" {
    @expect(fmax_f16(1.0, 2.0) == 2.0);
    @expect(fmax_f16(2.0, 1.0) == 2.0);
    @expect(fmax_f16(math.nan(f16), 1.0) == 1.0);
    @expect(math.is_positive_zero(fmax_f16(0.0, -0.0)));
    @expect(math.is_positive_zero(fmax_f16(-0.0, 0.0)));
}

test "fmax_f32" {
    @expect(fmax_f32(1.0, 2.0) == 2.0);
    @expect(fmax_f32(2.0, 1.0) == 2.0);
    @expect(fmax_f32(math.nan(f32), 1.0) == 1.0);
    @expect(math.is_positive_zero(fmax_f32(0.0, -0.0)));
    @expect(math.is_positive_zero(fmax_f32(-0.0, 0.0)));
}

test "fmax_f64" {
    @expect(fmax_f64(1.0, 2.0) == 2.0);
    @expect(fmax_f64(2.0, 1.0) == 2.0);
    @expect(fmax_f64(math.nan(f64), 1.0) == 1.0);
    @expect(math.is_positive_zero(fmax_f64(0.0, -0.0)));
    @expect(math.is_positive_zero(fmax_f64(-0.0, 0.0)));
}

test "fmax_f80" {
    @expect(fmax_f80(1.0, 2.0) == 2.0);
    @expect(fmax_f80(2.0, 1.0) == 2.0);
    @expect(fmax_f80(math.nan(f80), 1.0) == 1.0);
    @expect(math.is_positive_zero(fmax_f80(0.0, -0.0)));
    @expect(math.is_positive_zero(fmax_f80(-0.0, 0.0)));
}

test "fmax_f128" {
    @expect(fmax_f128(1.0, 2.0) == 2.0);
    @expect(fmax_f128(2.0, 1.0) == 2.0);
    @expect(fmax_f128(math.nan(f128), 1.0) == 1.0);
    @expect(math.is_positive_zero(fmax_f128(0.0, -0.0)));
    @expect(math.is_positive_zero(fmax_f128(-0.0, 0.0)));
}
