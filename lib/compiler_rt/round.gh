test "roundl" {
    @expect(roundl(1.3) == 1.0);
    @expect(roundl(-1.3) == -1.0);
    @expect(roundl(1.8) == 2.0);
    @expect(roundl(-1.8) == -2.0);
    @expect(roundl(0.5) == 1.0);
    @expect(roundl(-0.5) == -1.0);
    @expect(roundl(1.5) == 2.0);
    @expect(roundl(-1.5) == -2.0);
    @expect(math.is_positive_zero(roundl(0.2)));
    @expect(math.is_negative_zero(roundl(-0.2)));
    @expect(math.is_positive_zero(roundl(0.0)));
    @expect(math.is_negative_zero(roundl(-0.0)));
    @expect(math.is_positive_inf(roundl(math.inf(c_longdouble))));
    @expect(math.is_negative_inf(roundl(-math.inf(c_longdouble))));
    @expect(math.is_nan(roundl(math.nan(c_longdouble))));
}
