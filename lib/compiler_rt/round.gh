    @expect(math.is_positive_zero(round_f64(0.2)));
    @expect(math.is_negative_zero(round_f64(-0.2)));
    @expect(math.is_positive_zero(round_f64(0.0)));
    @expect(math.is_negative_zero(round_f64(-0.0)));
