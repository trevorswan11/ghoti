import std;

import "allocator.gh" as allocator;

pub using AllocatorVTable = allocator.AllocatorVTable;
pub using Allocator = allocator.Allocator;
pub using AllocError = allocator.AllocError;

/// Stored as a power-of-two.
pub const Alignment := enum : std.math.Log2Int(usize) {
    @"1" = 0,
    @"2" = 1,
    @"4" = 2,
    @"8" = 3,
    @"16" = 4,
    @"32" = 5,
    @"64" = 6,
    _,

    pub constexpr from_byte_units := fn(n: usize): Alignment {
        @assert(std.math.is_power_of_two(n));
        return @as(Alignment, @ctz(n));
    };

    pub constexpr of := fn(T: type): Alignment {
        return from_byte_units(@alignOf(T));
    };
};

test "Alignment.from_byte_units" {
    @expect(Alignment.from_byte_units(0b1) == .@"1");
    @expect(Alignment.from_byte_units(0b1000) == .@"8");
    @expect(Alignment.from_byte_units(0b100000) == .@"32");
}

test "Alignment.of" {
    @expect(Alignment.of(i32) == .@"4");
    @expect(Alignment.of(i64) == .@"8");

    @expect(
        Alignment.of(
            struct {
                a: i32,
                b: i32,
            },
        ) ==
            .@"4",
    );

    @expect(
        Alignment.of(
            struct {
                a: i32,
                b: i64,
            },
        ) ==
            .@"8",
    );
}

pub const round_up_page := fn(len: usize): usize {
    const ps := std.os.page_size();
    return (len + ps - 1uz) & ~(ps - 1uz);
};

/// Returns true if and only if the slices have the same length and all elements
/// compare true using equality operator.
pub constexpr eql := fn(T: type, a: []T, b: []T): bool {
    if (a.len != b.len) return false;
    if (a.len == 0) return true;
    if (@typeInfo(T) != .float and a.ptr == b.ptr) return true;

    for (a, b) |a_elem, b_elem| {
        if (a_elem != b_elem) return false;
    }
    return true;
};

test "eql over bytes" {
    @expect(eql(u8, "abcd", "abcd"));
    @expect(!eql(u8, "abcdef", "abZdef"));
    @expect(!eql(u8, "abcdefg", "abcdef"));
}

/// Returns true if haystack starts with needle.
/// Time complexity: O(needle.len)
pub constexpr starts_with := fn(T: type, haystack: []T, needle: []T): bool {
    return if (needle.len > haystack.len) false else eql(T, haystack[0..needle.len], needle);
};

test "starts_with" {
    @expect(starts_with(u8, "Bob", "Bo"));
    @expect(!starts_with(u8, "haystack", "aystack"));
    @expect(!starts_with(u8, "Needle in haystack", "haystack"));
}
