import std;

import "float.gh" as float;

pub constexpr is_nan := float.is_nan;
pub constexpr reconstruct_float := float.reconstruct_float;
pub constexpr mantissa_one := float.mantissa_one;
pub constexpr float_fractional_bits := float.float_fractional_bits;
pub constexpr float_mantissa_bits := float.float_mantissa_bits;
pub constexpr float_exponent_bits := float.float_exponent_bits;
pub constexpr float_exponent_min := float.float_exponent_min;
pub constexpr float_exponent_max := float.float_exponent_max;
pub constexpr nan := float.nan;
pub constexpr snan := float.snan;

/// Asserts that `int` is strictly positive
pub constexpr is_power_of_two := fn(int: auto): bool {
    @assert(int > 0);
    return (int & (int - 1)) == 0;
};

test "is_power_of_two" {
    @expect(is_power_of_two(1u8));
    @expect(is_power_of_two(2));
    @expect(!is_power_of_two(3i16));
    @expect(is_power_of_two(4));
    @expect(!is_power_of_two(31u32));
    @expect(is_power_of_two(32));
    @expect(!is_power_of_two(63i64));
    @expect(is_power_of_two(128));
    @expect(is_power_of_two(256u128));
}

/// Cast an integer to a different integer type only if it fits.
pub constexpr int_cast := fn(T: type, x: auto): std.Option(T) {
    constexpr {
        @assert(@typeInfo(T) == .int);
        @assert(@typeInfo(@TypeOf(x)) == .int or @typeInfo(@TypeOf(x)) == .@"constexpr_int");
    }

    if constexpr (@TypeOf(x) == constexpr_int) {
        if (x > max_int(T)) {
            return .empty;
        } else if (x < min_int(T)) {
            return .empty;
        }
    } else {
        if (max_int(@TypeOf(x)) > max_int(T) and x > max_int(T)) {
            return .empty;
        } else if (min_int(@TypeOf(x)) < min_int(T) and x < min_int(T)) {
            return .empty;
        }
    }
    return .of(@intCast(T, x));
};

test "int_cast" {
    @expect(int_cast(u8, 300) == .none);
    @expect(int_cast(u8, 300u32) == .none);
    @expect(int_cast(i8, -200) == .none);
    @expect(int_cast(i8, -200i32) == .none);
    @expect(int_cast(u8, -1) == .none);
    @expect(int_cast(u8, -1i8) == .none);
    @expect(int_cast(u64, -1) == .none);
    @expect(int_cast(u64, -1i8) == .none);

    @expect(int_cast(u8, 255)! == 255u8);
    @expect(int_cast(u8, 255u32)! == 255u8);
    @expect(@TypeOf(int_cast(u8, 255)!) == u8);
    @expect(@TypeOf(int_cast(u8, 255u32)!) == u8);
}

/// Returns an unsigned int type that can hold the number of bits in T - 1.
/// Suitable for 0-based bit indices of T.
pub constexpr Log2Int := fn(T: type): type {
    return match constexpr (@typeInfo(T)) {
        .@"constexpr_int" => constexpr_int,
        .int => |info| blk: {
            constexpr bits: u16 = @typeInfo(T).int.bits;
            constexpr log2_bits := if (bits <= 1) 1 else 16 - @clz(bits - 1);
            break :blk @Int(.{ .bits = log2_bits, .signedness = .unsigned });
        },
        _ => @compileError("Log2Int requires an integer argument type"),
    };
};

test "Log2Int construction" {
    @expect(Log2Int(constexpr_int) == constexpr_int);
    @expect(Log2Int(u64) == u6);
    @expect(Log2Int(u65) == u7);
    @expect(Log2Int(u32) == u5);
}

/// Returns the maximum value of integer type T.
pub constexpr max_int := fn(T: type): constexpr_int {
    constexpr info := @typeInfo(T).int;
    return (1 << (info.bits - @intFromBool(info.signedness == .signed))) - 1;
};

test "max_int" {
    @expect(max_int(u1) == 1);
    @expect(max_int(u8) == 255);
    @expect(max_int(u16) == 65535);
    @expect(max_int(u32) == 4294967295);
    @expect(max_int(u64) == 18446744073709551615);
    @expect(max_int(u128) == 340282366920938463463374607431768211455);

    @expect(max_int(i1) == 0);
    @expect(max_int(i8) == 127);
    @expect(max_int(i16) == 32767);
    @expect(max_int(i32) == 2147483647);
    @expect(max_int(i63) == 4611686018427387903);
    @expect(max_int(i64) == 9223372036854775807);
    @expect(max_int(i128) == 170141183460469231731687303715884105727);
}

/// Returns the minimum value of integer type T.
pub constexpr min_int := fn(T: type): constexpr_int {
    constexpr info := @typeInfo(T).int;
    return if constexpr (info.signedness == .signed) -(1 << (info.bits - 1)) else 0;
};

test "min_int" {
    @expect(min_int(u1) == 0);
    @expect(min_int(u8) == 0);
    @expect(min_int(u16) == 0);
    @expect(min_int(u32) == 0);
    @expect(min_int(u63) == 0);
    @expect(min_int(u64) == 0);
    @expect(min_int(u128) == 0);

    @expect(min_int(i1) == -1);
    @expect(min_int(i8) == -128);
    @expect(min_int(i16) == -32768);
    @expect(min_int(i32) == -2147483648);
    @expect(min_int(i63) == -4611686018427387904);
    @expect(min_int(i64) == -9223372036854775808);
    @expect(min_int(i128) == -170141183460469231731687303715884105728);
}

test {
    import "float.gh";
}
