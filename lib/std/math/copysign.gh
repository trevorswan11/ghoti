//! Ported from:
//!
//! https://codeberg.org/ziglang/zig/src/tag/0.17.0/lib/std/math/copysign.zig
import std;

const math = std.math;

/// Returns a value with the magnitude of `magnitude` and the sign of `sign`.
pub const copysign = fn(magnitude: auto, sign: @TypeOf(magnitude)): @TypeOf(magnitude) {
    const T = @TypeOf(magnitude);
    const TBits = @Int(.{ .signedness = .unsigned, .bits = @typeInfo(T).float.bits });
    const sign_bit_mask = @as(TBits, 1) << (@typeInfo(T).float.bits - 1);
    let mag = @bitCast(TBits, magnitude) & ~sign_bit_mask;
    let sgn = @bitCast(TBits, sign) & sign_bit_mask;
    return @bitCast(T, mag | sgn);
};

test "copysign" {
    unroll for ([_]type{ f16, f32, f64, f80, f128 }) |T| {
        @expect(copysign(@as(T, 1.0), @as(T, 1.0)) == 1.0);
        @expect(copysign(@as(T, 2.0), @as(T, -2.0)) == -2.0);
        @expect(copysign(@as(T, -3.0), @as(T, 3.0)) == 3.0);
        @expect(copysign(@as(T, -4.0), @as(T, -4.0)) == -4.0);
        @expect(copysign(@as(T, 5.0), @as(T, -500.0)) == -5.0);
        @expect(copysign(math.inf(T), @as(T, -0.0)) == -math.inf(T));
        @expect(copysign(@as(T, 6.0), -math.nan(T)) == -6.0);
    }
}
