//! Basic wrappers over standard IO streams
import std;

const Result = std.Result;
const Error = std.io.Error;
const File = std.io.File;

/// The standard output stream, infallible on POSIX
pub const stdout = fn(): Result(File, Error) {
    return match (std.os.stdout()) {
        .ok => |h| .of(.{ .handle = h }),
        .err => |e| .fail(.from_os(e)),
    };
};

/// The standard input stream, infallible on POSIX
pub const stdin = fn(): Result(File, Error) {
    return match (std.os.stdin()) {
        .ok => |h| .of(.{ .handle = h }),
        .err => |e| .fail(.from_os(e)),
    };
};

/// The standard error stream, infallible on POSIX
pub const stderr = fn(): Result(File, Error) {
    return match (std.os.stderr()) {
        .ok => |h| .of(.{ .handle = h }),
        .err => |e| .fail(.from_os(e)),
    };
};

const FmtError = std.fmt.Error;

/// Formats `fmt` with `args` into `stream`, optionally followed by a newline
const write_formatted = fn(
    stream: Result(File, Error),
    comptime newline: bool,
    comptime fmt: []u8,
    args...,
): Result(void, FmtError) {
    let mut f = stream?;
    // Gathered so a whole line usually reaches the stream in one write
    let mut scratch: [512]mut u8 = undefined;
    let mut buffered: std.io.BufferedWriter(File) = .{ .inner = ^mut f, .buf = scratch[..] };
    std.fmt.format(&mut buffered, fmt, args...)?;
    if comptime (newline) {
        let w: &mut dyn std.io.Writer = &mut buffered;
        w.write_byte('\n')?;
    }
    buffered.flush()?;
    return .done;
};

/// Prints `fmt` formatted with `args` to stdout, as `std.fmt.format` does
pub const print = fn(comptime fmt: []u8, args...): Result(void, FmtError) {
    return write_formatted(stdout(), false, fmt, args...);
};

/// Prints `fmt` formatted with `args` to stdout, followed by a newline
pub const println = fn(comptime fmt: []u8, args...): Result(void, FmtError) {
    return write_formatted(stdout(), true, fmt, args...);
};

/// Prints `fmt` formatted with `args` to stderr, as `std.fmt.format` does
pub const eprint = fn(comptime fmt: []u8, args...): Result(void, FmtError) {
    return write_formatted(stderr(), false, fmt, args...);
};

/// Prints `fmt` formatted with `args` to stderr, followed by a newline
pub const eprintln = fn(comptime fmt: []u8, args...): Result(void, FmtError) {
    return write_formatted(stderr(), true, fmt, args...);
};
