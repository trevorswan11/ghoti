//! AArch64 NEON operations the portable builtins don't cover, under their ACLE names.
//!
//! Each exists only where the compiled-for CPU has its feature, so a call is a compile error
//! rather than an illegal instruction.
import std;

const u8x16 = @Vector(16, u8);

@cfg (cpu.has(.neon)) {
    /// `vqtbl1q_u8` (`tbl`): byte `i` is `t[idx[i]]`, or 0 when `idx[i]` is 16 or more. A 16-entry
    /// table lookup
    pub const vqtbl1q_u8 = fn(t: u8x16, idx: u8x16): u8x16 {
        return @llvmIntrinsic("llvm.aarch64.neon.tbl1", u8x16, t, idx);
    };

    /// `vqtbx1q_u8` (`tbx`): `vqtbl1q_u8`, keeping `fallback[i]` where `idx[i]` is 16 or more
    pub const vqtbx1q_u8 = fn(fallback: u8x16, t: u8x16, idx: u8x16): u8x16 {
        return @llvmIntrinsic("llvm.aarch64.neon.tbx1", u8x16, fallback, t, idx);
    };
}

test "tbl looks bytes up in a table" {
    @cfg (cpu.has(.neon)) {
        let table: u8x16 = .{ 'a', 'b', 'c', 'd', 'e', 'f', 'g', 'h', 'i', 'j', 'k', 'l', 'm', 'n', 'o', 'p' };
        let mut idx: u8x16 = @splat(200);
        idx[0] = 2;
        idx[1] = 15;
        let looked = vqtbl1q_u8(table, idx);
        @expect(looked[0] == 'c' and looked[1] == 'p' and looked[2] == 0);
        let kept = vqtbx1q_u8(@splat('?'), table, idx);
        @expect(kept[2] == '?');
    }
}
