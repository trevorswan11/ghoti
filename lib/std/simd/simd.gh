//! Portable helpers for `@Vector`: how wide to make one, and moving one in and out of slices.
//!
//! The lane builtins (`@splat`, `@reduce`, `@shuffle`, `@select`, `@maskedLoad`, ...) and the
//! per-lane operators are the core; this module adds what is better written in ghoti itself.
import std;

@cfg (arch == .x86_64 or arch == .x86) {
    /// `pshufb`, `movemask`, and the other x86 operations, under their C intrinsic names
    pub import "x86.gh" as x86;
} else @cfg (arch == .aarch64) {
    /// `tbl` and the other NEON operations, under their ACLE names
    pub import "aarch64.gh" as aarch64;
}

test {
    @cfg (arch == .x86_64 or arch == .x86) {
        import "x86.gh";
    } else @cfg (arch == .aarch64) {
        import "aarch64.gh";
    }
}

pub const i8x16 = @Vector(16, i8);
pub const u8x16 = @Vector(16, u8);
pub const i16x8 = @Vector(8, i16);
pub const u16x8 = @Vector(8, u16);
pub const i32x4 = @Vector(4, i32);
pub const u32x4 = @Vector(4, u32);
pub const i64x2 = @Vector(2, i64);
pub const u64x2 = @Vector(2, u64);
pub const f32x4 = @Vector(4, f32);
pub const f64x2 = @Vector(2, f64);

pub const i8x32 = @Vector(32, i8);
pub const u8x32 = @Vector(32, u8);
pub const i16x16 = @Vector(16, i16);
pub const u16x16 = @Vector(16, u16);
pub const i32x8 = @Vector(8, i32);
pub const u32x8 = @Vector(8, u32);
pub const i64x4 = @Vector(4, i64);
pub const u64x4 = @Vector(4, u64);
pub const f32x8 = @Vector(8, f32);
pub const f64x4 = @Vector(4, f64);

/// The lane type of the vector type `V`
pub const Lane = fn(comptime V: type): type {
    return @typeInfo(V).vector.child;
};

/// How many lanes `V` has
pub const lanes_of = fn(comptime V: type): comptime_int {
    return @typeInfo(V).vector.len;
};

// The widest vector register the compiled-for CPU is guaranteed to have, in bits; 0 for none
const register_bits = fn(): comptime_int {
    @cfg (arch == .x86_64 or arch == .x86) {
        if comptime (builtin.cpu.has(.avx512f)) {
            return 512;
        }
        if comptime (builtin.cpu.has(.avx2) or builtin.cpu.has(.avx)) {
            return 256;
        }
        if comptime (builtin.cpu.has(.sse2)) {
            return 128;
        }
        return 0;
    } else @cfg (arch == .aarch64) {
        // Every AArch64 CPU has NEON, and SVE's registers are at least as wide
        return 128;
    } else @cfg (arch == .arm) {
        return if comptime (builtin.cpu.has(.neon)) 128; else 0;
    } else @cfg (arch == .riscv64 or arch == .riscv32) {
        // The `v` extension's registers are at least 128 bits wide
        return if comptime (builtin.cpu.has(.v)) 128; else 0;
    } else @cfg (arch == .wasm32 or arch == .wasm64) {
        return if comptime (builtin.cpu.has(.simd128)) 128; else 0;
    } else {
        return 0;
    }
};

/// The number of `T` lanes that fill the widest vector register the compiled-for CPU is
/// guaranteed to have, or 1 when it has none. `--cpu native` and `--features` widen it.
///
/// A scalable target (SVE, RISC-V V) reports its minimum width, so code sized by this still
/// runs on every implementation.
pub const suggest_lanes = fn(comptime T: type): comptime_int {
    const lane_bits = @sizeOf(T) * 8;
    const bits = register_bits();
    return if (bits < lane_bits * 2) 1; else bits / lane_bits;
};

/// A vector whose lanes count up from 0: `iota(@Vector(4, u8))` is `.{ 0, 1, 2, 3 }`
pub const iota = fn(comptime V: type): V {
    let mut v: V = undefined;
    for (0..lanes_of(V)) |i| {
        v[i] = match comptime (@typeInfo(Lane(V))) {
            .float => @floatFromInt(i),
            _ => @intCast(i),
        };
    }
    return v;
};

/// Lane `i` of a `bool` vector as bit `i` of an integer: the portable `movemask`
pub const bitmask = fn(v: auto): @Int(.{ .signedness = .unsigned, .bits = lanes_of(@TypeOf(v)) }) {
    return @bitCast(v);
};

/// The first `lanes_of(V)` elements of `s`, read without any alignment. `s` must have that many
pub const load = fn(comptime V: type, s: []Lane(V)): V {
    const len = lanes_of(V);
    if (@runtimeSafety() and s.len < len) {
        @panic("std.simd.load: the slice is shorter than the vector");
    }
    // Memory holds a `bool` as a byte, which a `bool` lane isn't
    if comptime (Lane(V) == bool) {
        let mut v: V = undefined;
        for (0..len) |i| {
            v[i] = s[i];
        }
        return v;
    }
    let every: @Vector(len, bool) = @splat(true);
    return @maskedLoad(s.ptr, every, undefined);
};

/// Writes `v` to the first `lanes_of(V)` elements of `s`, without any alignment. `s` must have
/// that many
pub const store = fn(s: []mut auto, v: auto): void {
    const len = lanes_of(@TypeOf(v));
    if (@runtimeSafety() and s.len < len) {
        @panic("std.simd.store: the slice is shorter than the vector");
    }
    if comptime (Lane(@TypeOf(v)) == bool) {
        for (0..len) |i| {
            s[i] = v[i];
        }
        return;
    }
    let every: @Vector(len, bool) = @splat(true);
    @maskedStore(s.ptr, v, every);
};

/// `@reduce(op, v)` with a float sum or product folded strictly from the first lane to the last,
/// so it rounds the same everywhere. `@reduce` itself adds in any order.
pub const reduce_ordered = fn(comptime op: builtin.ReduceOp, v: auto): Lane(@TypeOf(v)) {
    const ordered = (op == .add or op == .mul) and @typeInfo(Lane(@TypeOf(v))) == .float;
    if comptime (!ordered) {
        return @reduce(op, v);
    }
    let mut acc = v[0];
    for (1..lanes_of(@TypeOf(v))) |i| {
        if comptime (op == .add) {
            acc += v[i];
        } else {
            acc *= v[i];
        }
    }
    return acc;
};

test "suggest_lanes fills a register" {
    const n = suggest_lanes(u8);
    @expect(n >= 1);
    @expect(suggest_lanes(u64) <= n);
    @cfg (arch == .x86_64) {
        @expect(n >= 16);
    }
}

test "iota counts up from zero" {
    const v = iota(@Vector(4, u8));
    @expect(v[0] == 0 and v[3] == 3);
    const f = iota(f32x4);
    @expect(f[2] == 2.0);
}

test "bitmask packs bool lanes into bits" {
    let v: @Vector(4, i32) = .{ 5, -1, 7, 0 };
    @expect(bitmask(v > 0) == 0b0101);
    @expect(@TypeOf(bitmask(v > 0)) == u4);
}

test "load and store move a vector through a slice" {
    let mut buf: [7]mut i32 = .{ 1, 2, 3, 4, 5, 6, 7 };
    let v = load(i32x4, buf[1..]);
    @expect(@reduce(.add, v) == 2 + 3 + 4 + 5);
    store(buf[3..], v * 10);
    @expect(buf[3] == 20 and buf[6] == 50 and buf[2] == 3);

    let flags: [4]bool = .{ true, false, true, true };
    let b = load(@Vector(4, bool), flags[0..]);
    @expect(b[0] and !b[1]);
}

test "reduce_ordered folds floats in lane order" {
    let v: f32x4 = .{ 1.0e8, 1.0, -1.0e8, 1.0 };
    @expect(reduce_ordered(.add, v) == 1.0);
    @expect(reduce_ordered(.max, v) == 1.0e8);
    @expect(reduce_ordered(.add, @as(i32x4, .{ 1, 2, 3, 4 })) == 10);
}
