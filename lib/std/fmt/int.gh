//! Integer formatting low-level API surface
import std;

/// Converts values in the range [0, 100) to a base 10 string.
pub constexpr digits2 := fn(value: u8): [2]u8 {
    @assert(value < 100, "digits2 is bounded above by 100");
    constexpr lookup := "00010203040506070809101112131415161718192021222324252627282930313233343536373839404142434445464748495051525354555657585960616263646566676869707172737475767778798081828384858687888990919293949596979899";
    return *lookup[value * 2..][0..2];
};

test "digits2" {
    const d := digits2(42);
    @expect(d[0] == '4' and d[1] == '2');
    @expect(digits2(7)[0] == '0');
}

pub constexpr digit_to_char := fn(digit: u8, case: std.fmt.Case): u8 {
    return match (digit) {
        0..9 => digit + '0',
        10..35 => digit + ((if (case == .upper) 'A' else 'a') - 10),
        _ => unreachable,
    };
};

test "digit_to_char" {
    @expect(digit_to_char(1, .lower) == '1');
    @expect(digit_to_char(10, .lower) == 'a');
    @expect(digit_to_char(10, .upper) == 'A');
}

/// Formats an integer in an explicit radix and case.
/// Only the padding, sign, and alt fields of `spec` are used, `spec.kind` is ignored
pub const format_radix := fn(
    w: &mut dyn std.io.Writer(Error = std.io.Error),
    value: auto,
    base: u8,
    case: std.fmt.Case,
    spec: std.fmt.Spec,
): std.Result(void, std.fmt.Error) {
    @assert(base >= 2, "Base must be at least 2");
    constexpr value_info := @typeInfo(@TypeOf(value)).int;

    // The type must have the same size as `base` or be wider in order for the division to work
    constexpr min_int_bits := @max(value_info.bits, 8u16);
    using MinInt = @Int(.{ .signedness = .unsigned, .bits = min_int_bits });

    // The worst case in terms of space needed is base 2, plus 1 for the sign and 2 for the alt prefix
    var buf: [1 + 2 + @max(value_info.bits, 1u16)]mut u8 = undefined;

    var is_negative := false;
    var a: MinInt = blk: {
        if constexpr (value_info.signedness == .signed) {
            using SameUnsigned = @Int(.{ .signedness = .unsigned, .bits = value_info.bits });
            const bits := @bitCast(SameUnsigned, value);
            is_negative = value < 0;
            break :blk if (is_negative) 0 -% bits else bits;
        } else {
            break :blk value;
        }
    };
    var index := buf.len;

    if (base == 10) {
        while (a >= 100) : (a = @divTrunc(a, 100)) {
            index -= 2;
            buf[index..][0..2] = digits2(@intCast(a % 100));
        }

        if (a < 10) {
            index -= 1;
            buf[index] = '0' + @as(u8, @intCast(a));
        } else {
            index -= 2;
            buf[index..][0..2] = digits2(@intCast(a % 100));
        }
    } else {
        loop {
            const digit := a % @intCast(MinInt, base);
            index -= 1;
            buf[index] = digit_to_char(@intCast(digit), case);
            a /= base;
            if (a == 0) break;
        }
    }
    const digits_start := index;

    if (spec.alt) {
        const radix_char: u8 = match (base) {
            16 => 'x',
            8 => 'o',
            2 => 'b',
            _ => 0,
        };
        if (radix_char != 0) {
            index -= 2;
            buf[index] = '0';
            buf[index + 1] = radix_char;
        }
    }

    if (is_negative) {
        index -= 1;
        buf[index] = '-';
    } else if (spec.plus) {
        index -= 1;
        buf[index] = '+';
    }

    return std.fmt.pad_number(w, spec, buf[index..], digits_start - index);
};

/// Formats an integer according to `spec.kind`, defaulting to base 10
pub const format := fn(
    w: &mut dyn std.io.Writer(Error = std.io.Error),
    value: auto,
    spec: std.fmt.Spec,
): std.Result(void, std.fmt.Error) {
    return match (spec.kind.unwrap_or(.d)) {
        .d, .@"?" => format_radix(w, value, 10, .lower, spec),
        .x => format_radix(w, value, 16, .lower, spec),
        .X => format_radix(w, value, 16, .upper, spec),
        .b => format_radix(w, value, 2, .lower, spec),
        .o => format_radix(w, value, 8, .lower, spec),
        .c => blk: {
            constexpr value_info := @typeInfo(@TypeOf(value)).int;
            if constexpr (value_info.signedness == .signed) {
                if (value < 0) break :blk .{ .err = .bad_arg };
            }
            if constexpr (value_info.bits > 8) {
                if (value > 255) break :blk .{ .err = .bad_arg };
            }

            break :blk std.fmt.pad(w, spec, ^.{ @intCast(u8, value) }, .left);
        },
        .e => .{ .err = .unsupported },
        .s, .f, .p => .{ .err = .bad_spec },
    };
};

/// Formats `value` with `format` and compares the output against `expected`
const check_fmt := fn(value: auto, spec: std.fmt.Spec, expected: []u8): bool {
    var backing: [64]mut u8 = undefined;
    var stream: std.io.FixedBufferStream = .{ .buf = backing };
    return match (format(&mut stream, value, spec)) {
        .ok => std.mem.eql(u8, expected, backing[..stream.pos]),
        .err => false,
    };
};

/// Formats `value` with `format` and checks that it fails with `expected`
const check_fmt_err := fn(value: auto, spec: std.fmt.Spec, expected: std.fmt.Error): bool {
    var backing: [64]mut u8 = undefined;
    var stream: std.io.FixedBufferStream = .{ .buf = backing };
    return match (format(&mut stream, value, spec)) {
        .ok => false,
        .err => |e| e == expected,
    };
};

test "format_radix base 10" {
    var backing: [32]mut u8 = undefined;
    var stream: std.io.FixedBufferStream = .{ .buf = backing };
    _ = format_radix(&mut stream, 12345u16, 10, .lower, .{});
    @expect(std.mem.eql(u8, "12345", backing[..stream.pos]));

    stream.pos = 0;
    _ = format_radix(&mut stream, 42u16, 10, .lower, .{});
    @expect(std.mem.eql(u8, "42", backing[..stream.pos]));

    stream.pos = 0;
    _ = format_radix(&mut stream, -42i32, 10, .lower, .{});
    @expect(std.mem.eql(u8, "-42", backing[..stream.pos]));

    stream.pos = 0;
    _ = format_radix(&mut stream, 1234567u32, 10, .lower, .{});
    @expect(std.mem.eql(u8, "1234567", backing[..stream.pos]));

    stream.pos = 0;
    _ = format_radix(&mut stream, 7i8, 10, .lower, .{});
    @expect(std.mem.eql(u8, "7", backing[..stream.pos]));

    stream.pos = 0;
    _ = format_radix(&mut stream, -128i8, 10, .lower, .{});
    @expect(std.mem.eql(u8, "-128", backing[..stream.pos]));

    stream.pos = 0;
    _ = format_radix(&mut stream, 18446744073709551615u64, 10, .lower, .{});
    @expect(std.mem.eql(u8, "18446744073709551615", backing[..stream.pos]));
}

test "format_radix other bases" {
    var backing: [32]mut u8 = undefined;
    var stream: std.io.FixedBufferStream = .{ .buf = backing };
    _ = format_radix(&mut stream, 5u16, 2, .lower, .{});
    @expect(std.mem.eql(u8, "101", backing[..stream.pos]));

    stream.pos = 0;
    _ = format_radix(&mut stream, 255u32, 16, .upper, .{});
    @expect(std.mem.eql(u8, "FF", backing[..stream.pos]));

    stream.pos = 0;
    _ = format_radix(&mut stream, -255i64, 16, .lower, .{});
    @expect(std.mem.eql(u8, "-ff", backing[..stream.pos]));
}

test "format width, fill, and align" {
    @expect(check_fmt(42u16, .{ .width = .of(5) }, "   42"));
    @expect(check_fmt(42i32, .{ .width = .of(5) }, "   42"));
    @expect(check_fmt(42i32, .{ .width = .of(5), .align = .of(.left) }, "42   "));
    @expect(check_fmt(42i32, .{ .width = .of(6), .align = .of(.center) }, "  42  "));
    @expect(check_fmt(42i32, .{ .width = .of(6), .fill = '*', .align = .of(.right) }, "****42"));
    @expect(check_fmt(12345i32, .{ .width = .of(2) }, "12345"));
    @expect(check_fmt(
        255u32,
        .{ .width = .of(8), .fill = '0', .align = .of(.right), .kind = .of(.x) },
        "000000ff",
    ));
}

test "format sign and zero padding" {
    @expect(check_fmt(-3i32, .{ .width = .of(8), .zero = true }, "-0000003"));
    @expect(check_fmt(-3i32, .{ .width = .of(8), .zero = true, .align = .of(.left) }, "-0000003"));
    @expect(check_fmt(5u8, .{ .plus = true }, "+5"));
    @expect(check_fmt(5i32, .{ .plus = true, .width = .of(8), .zero = true }, "+0000005"));
    @expect(check_fmt(-128i8, .{ .width = .of(6), .zero = true }, "-00128"));
}

test "format kinds and alt prefixes" {
    @expect(check_fmt(255u32, .{ .kind = .of(.x) }, "ff"));
    @expect(check_fmt(255u32, .{ .kind = .of(.X) }, "FF"));
    @expect(check_fmt(5u32, .{ .kind = .of(.b) }, "101"));
    @expect(check_fmt(8u32, .{ .kind = .of(.o) }, "10"));
    @expect(check_fmt(-7i32, .{ .kind = .of(.@"?") }, "-7"));
    @expect(check_fmt(255u32, .{ .alt = true, .kind = .of(.x) }, "0xff"));
    @expect(check_fmt(255u32, .{ .alt = true, .kind = .of(.X) }, "0xFF"));
    @expect(check_fmt(
        255u32,
        .{ .alt = true, .zero = true, .width = .of(10), .kind = .of(.x) },
        "0x000000ff",
    ));
    @expect(check_fmt(5u32, .{ .alt = true, .kind = .of(.b) }, "0b101"));
    @expect(check_fmt(8u32, .{ .alt = true, .kind = .of(.o) }, "0o10"));
    @expect(check_fmt(0u32, .{ .alt = true, .kind = .of(.x) }, "0x0"));
    @expect(check_fmt(-255i32, .{ .alt = true, .kind = .of(.x) }, "-0xff"));
    @expect(check_fmt(42u32, .{ .alt = true }, "42"));
    @expect(check_fmt(5i32, .{ .precision = .of(3) }, "5"));
}

test "format char kind" {
    @expect(check_fmt(65u8, .{ .kind = .of(.c) }, "A"));
    @expect(check_fmt(65i32, .{ .kind = .of(.c), .width = .of(3), .align = .of(.right) }, "  A"));
    @expect(check_fmt(65u8, .{ .kind = .of(.c), .width = .of(3) }, "A  "));
    @expect(check_fmt_err(300u16, .{ .kind = .of(.c) }, .bad_arg));
    @expect(check_fmt_err(-1i32, .{ .kind = .of(.c) }, .bad_arg));
}

test "format rejects non-integer kinds" {
    @expect(check_fmt_err(1u32, .{ .kind = .of(.s) }, .bad_spec));
    @expect(check_fmt_err(1u32, .{ .kind = .of(.f) }, .bad_spec));
    @expect(check_fmt_err(1u32, .{ .kind = .of(.p) }, .bad_spec));
    @expect(check_fmt_err(1u32, .{ .kind = .of(.e) }, .unsupported));
}
