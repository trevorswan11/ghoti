//! Integer formatting low-level API surface
//! References: https://codeberg.org/ziglang/zig/src/branch/master/lib/std/Io/Writer.zig#L1608
//! Zig is licensed under the MIT license
import std;

/// Converts values in the range [0, 100) to a base 10 string.
pub const digits2 = fn(value: u8): [2]u8 {
    @assert(value < 100, "digits2 is bounded above by 100");
    const lookup = "00010203040506070809101112131415161718192021222324252627282930313233343536373839404142434445464748495051525354555657585960616263646566676869707172737475767778798081828384858687888990919293949596979899";
    return *lookup[value * 2..][0..2];
};

test "digits2" {
    let d = digits2(42);
    @expect(d[0] == '4' and d[1] == '2');
    @expect(digits2(7)[0] == '0');
}

pub const digit_to_char = fn(digit: u8, case: std.fmt.Case): u8 {
    return match (digit) {
        0..9 => digit + '0',
        10..35 => digit + ((if (case == .upper) 'A' else 'a') - 10),
        _ => unreachable,
    };
};

test "digit_to_char" {
    @expect(digit_to_char(1, .lower) == '1');
    @expect(digit_to_char(10, .lower) == 'a');
    @expect(digit_to_char(10, .upper) == 'A');
}

/// Formats an integer in an explicit radix and case.
/// Only the padding, sign, and alt fields of `spec` are used, `spec.kind` is ignored
pub const format_radix = fn(
    w: &mut dyn std.io.Writer,
    value: auto,
    base: u8,
    case: std.fmt.Case,
    spec: std.fmt.Spec,
): std.Result(void, std.fmt.Error) {
    @assert(base >= 2, "Base must be at least 2");
    const value_info = @typeInfo(@TypeOf(value)).int;

    // The type must have the same size as `base` or be wider in order for the division to work
    const min_int_bits = @max(value_info.bits, 8u16);
    const MinInt = @Int(.{ .signedness = .unsigned, .bits = min_int_bits });

    // The worst case in terms of space needed is base 2, plus 1 for the sign and 2 for the alt prefix
    let mut buf: [1 + 2 + @max(value_info.bits, 1u16)]mut u8 = undefined;

    let mut is_negative = false;
    let mut a: MinInt = blk: {
        if comptime (value_info.signedness == .signed) {
            const SameUnsigned = @Int(.{ .signedness = .unsigned, .bits = value_info.bits });
            let bits = @bitCast(SameUnsigned, value);
            is_negative = value < 0;
            break :blk if (is_negative) 0 -% bits else bits;
        } else {
            break :blk value;
        }
    };
    let mut index = buf.len;

    if (base == 10) {
        while (a >= 100) : (a = @divTrunc(a, 100)) {
            index -= 2;
            buf[index..][0..2] = digits2(@intCast(a % 100));
        }

        if (a < 10) {
            index -= 1;
            buf[index] = '0' + @as(u8, @intCast(a));
        } else {
            index -= 2;
            buf[index..][0..2] = digits2(@intCast(a % 100));
        }
    } else {
        loop {
            let digit = a % @intCast(MinInt, base);
            index -= 1;
            buf[index] = digit_to_char(@intCast(digit), case);
            a /= base;
            if (a == 0) break;
        }
    }
    let digits_start = index;

    if (spec.alt) {
        let radix_char: u8 = match (base) {
            16 => 'x',
            8 => 'o',
            2 => 'b',
            _ => 0,
        };
        if (radix_char != 0) {
            index -= 2;
            buf[index] = '0';
            buf[index + 1] = radix_char;
        }
    }

    if (is_negative) {
        index -= 1;
        buf[index] = '-';
    } else if (spec.plus) {
        index -= 1;
        buf[index] = '+';
    }

    return std.fmt.pad_number(w, spec, buf[index..], digits_start - index);
};

/// Formats an integer according to `spec.kind`, defaulting to base 10
pub const format = fn(
    w: &mut dyn std.io.Writer,
    value: auto,
    spec: std.fmt.Spec,
): std.Result(void, std.fmt.Error) {
    return match (spec.kind.unwrap_or(.d)) {
        .d, .@"?" => format_radix(w, value, 10, .lower, spec),
        .x => format_radix(w, value, 16, .lower, spec),
        .X => format_radix(w, value, 16, .upper, spec),
        .b => format_radix(w, value, 2, .lower, spec),
        .o => format_radix(w, value, 8, .lower, spec),
        .c => blk: {
            const value_info = @typeInfo(@TypeOf(value)).int;
            if comptime (value_info.signedness == .signed) {
                if (value < 0) break :blk .fail(.bad_arg);
            }
            if comptime (value_info.bits > 8) {
                if (value > 255) break :blk .fail(.bad_arg);
            }

            break :blk std.fmt.pad(w, spec, ^.{ @intCast(u8, value) }, .left);
        },
        .e => .fail(.unsupported),
        .s, .f, .p => .fail(.bad_spec),
    };
};

/// Formats `value` in `base` with `format_radix` and expects `expected`
@[testing] const check_radix = fn(value: auto, base: u8, case: std.fmt.Case, expected: []u8): void {
    let mut backing: [32]mut u8 = undefined;
    let mut stream: std.io.FixedBufferStream = .{ .buf = backing };
    _ = format_radix(&mut stream, value, base, case, .{});
    @expect(std.mem.eql(u8, expected, backing[..stream.pos]));
};

/// Formats `value` with `format` and expects `expected`
@[testing] const check_fmt = fn(value: auto, spec: std.fmt.Spec, expected: []u8): void {
    let mut backing: [64]mut u8 = undefined;
    let mut stream: std.io.FixedBufferStream = .{ .buf = backing };
    match (format(&mut stream, value, spec)) {
        .ok => {
            @expect(std.mem.eql(u8, expected, backing[..stream.pos]));
        },
        .err => {
            @expect(false, "format failed");
        },
    }
};

/// Formats `value` with `format` and expects it to fail with `expected`
@[testing]
const check_fmt_err = fn(value: auto, spec: std.fmt.Spec, expected: std.fmt.Error): void {
    let mut backing: [64]mut u8 = undefined;
    let mut stream: std.io.FixedBufferStream = .{ .buf = backing };
    match (format(&mut stream, value, spec)) {
        .ok => {
            @expect(false, "format succeeded");
        },
        .err => |e| {
            @expect(e == expected);
        },
    }
};

test "format_radix base 10" {
    check_radix(12345u16, 10, .lower, "12345");
    check_radix(42u16, 10, .lower, "42");
    check_radix(-42i32, 10, .lower, "-42");
    check_radix(1234567u32, 10, .lower, "1234567");
    check_radix(7i8, 10, .lower, "7");
    check_radix(-128i8, 10, .lower, "-128");
    check_radix(18446744073709551615u64, 10, .lower, "18446744073709551615");
}

test "format_radix other bases" {
    check_radix(5u16, 2, .lower, "101");
    check_radix(255u32, 16, .upper, "FF");
    check_radix(-255i64, 16, .lower, "-ff");
}

test "format width, fill, and align" {
    check_fmt(42u16, .{ .width = .of(5) }, "   42");
    check_fmt(42i32, .{ .width = .of(5) }, "   42");
    check_fmt(42i32, .{ .width = .of(5), .align = .of(.left) }, "42   ");
    check_fmt(42i32, .{ .width = .of(6), .align = .of(.center) }, "  42  ");
    check_fmt(42i32, .{ .width = .of(6), .fill = '*', .align = .of(.right) }, "****42");
    check_fmt(12345i32, .{ .width = .of(2) }, "12345");
    check_fmt(
        255u32,
        .{ .width = .of(8), .fill = '0', .align = .of(.right), .kind = .of(.x) },
        "000000ff",
    );
}

test "format sign and zero padding" {
    check_fmt(-3i32, .{ .width = .of(8), .zero = true }, "-0000003");
    check_fmt(-3i32, .{ .width = .of(8), .zero = true, .align = .of(.left) }, "-0000003");
    check_fmt(5u8, .{ .plus = true }, "+5");
    check_fmt(5i32, .{ .plus = true, .width = .of(8), .zero = true }, "+0000005");
    check_fmt(-128i8, .{ .width = .of(6), .zero = true }, "-00128");
}

test "format kinds and alt prefixes" {
    check_fmt(255u32, .{ .kind = .of(.x) }, "ff");
    check_fmt(255u32, .{ .kind = .of(.X) }, "FF");
    check_fmt(5u32, .{ .kind = .of(.b) }, "101");
    check_fmt(8u32, .{ .kind = .of(.o) }, "10");
    check_fmt(-7i32, .{ .kind = .of(.@"?") }, "-7");
    check_fmt(255u32, .{ .alt = true, .kind = .of(.x) }, "0xff");
    check_fmt(255u32, .{ .alt = true, .kind = .of(.X) }, "0xFF");
    check_fmt(
        255u32,
        .{ .alt = true, .zero = true, .width = .of(10), .kind = .of(.x) },
        "0x000000ff",
    );
    check_fmt(5u32, .{ .alt = true, .kind = .of(.b) }, "0b101");
    check_fmt(8u32, .{ .alt = true, .kind = .of(.o) }, "0o10");
    check_fmt(0u32, .{ .alt = true, .kind = .of(.x) }, "0x0");
    check_fmt(-255i32, .{ .alt = true, .kind = .of(.x) }, "-0xff");
    check_fmt(42u32, .{ .alt = true }, "42");
    check_fmt(5i32, .{ .precision = .of(3) }, "5");
}

test "format char kind" {
    check_fmt(65u8, .{ .kind = .of(.c) }, "A");
    check_fmt(65i32, .{ .kind = .of(.c), .width = .of(3), .align = .of(.right) }, "  A");
    check_fmt(65u8, .{ .kind = .of(.c), .width = .of(3) }, "A  ");
    check_fmt_err(300u16, .{ .kind = .of(.c) }, .bad_arg);
    check_fmt_err(-1i32, .{ .kind = .of(.c) }, .bad_arg);
}

test "format rejects non-integer kinds" {
    check_fmt_err(1u32, .{ .kind = .of(.s) }, .bad_spec);
    check_fmt_err(1u32, .{ .kind = .of(.f) }, .bad_spec);
    check_fmt_err(1u32, .{ .kind = .of(.p) }, .bad_spec);
    check_fmt_err(1u32, .{ .kind = .of(.e) }, .unsupported);
}
