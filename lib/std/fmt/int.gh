//! Integer formatting, referencing Zig's implementation
//! https://codeberg.org/ziglang/zig/src/branch/master/lib/std/Io/Writer.zig#L1608
//! Zig is licensed under the MIT license
import std;

/// Converts values in the range [0, 100) to a base 10 string.
pub constexpr digits2 := fn(value: u8): struct { pub first: u8, pub second: u8 } {
    @assert(value < 100, "digits2 is bounded above by 100");
    constexpr lookup := "00010203040506070809101112131415161718192021222324252627282930313233343536373839404142434445464748495051525354555657585960616263646566676869707172737475767778798081828384858687888990919293949596979899";
    const slice := lookup[value * 2..][0..2];
    // TODO(tcs): Make this return a [2]u8 once these can be assigned to slices (#340)
    return .{ .first = slice[0], .second = slice[1] };
};

pub constexpr digit_to_char := fn(digit: u8, case: std.fmt.Case): u8 {
    return match (digit) {
        0..9 => digit + '0',
        10..35 => digit + ((if (case == .upper) 'A' else 'a') - 10),
        _ => unreachable,
    };
};

test "digit_to_char" {
    @expect(digit_to_char(1, .lower) == '1');
    @expect(digit_to_char(10, .lower) == 'a');
    @expect(digit_to_char(10, .upper) == 'A');
}

pub const formatIntAny := fn(
    w: &mut dyn std.io.Writer(Error = std.io.Error),
    value: auto,
    base: u8,
    case: std.fmt.Case,
    spec: std.fmt.Spec,
): std.Result(void, std.fmt.Error) {
    @assert(base >= 2, "Base must be at least 2");
    constexpr value_info := @typeInfo(@TypeOf(value)).int;

    // The type must have the same size as `base` or be wider in order for the division to work
    constexpr min_int_bits := @max(value_info.bits, 8u16);
    using MinInt = @Int(.{ .signedness = .unsigned, .bits = min_int_bits });

    // The worst case in terms of space needed is base 2, plus 1 for the sign
    var buf: [1 + @max(value_info.bits, 1u16)]mut u8 = undefined;
    var a: MinInt = @abs(value);
    var index := buf.len;

    if (base == 10) {
        while (a >= 100) : (a = @divTrunc(a, 100)) {
            index -= 2;
            const digits := digits2(@intCast(a % 100));
            buf[index..][0] = digits.first;
            buf[index..][1] = digits.second;
        }

        if (a < 10) {
            index -= 1;
            buf[index] = '0' + @as(u8, @intCast(a));
        } else {
            index -= 2;
            const digits := digits2(@intCast(a % 100));
            buf[index..][0] = digits.first;
            buf[index..][1] = digits.second;
        }
    } else {
        loop {
            const digit := a % @intCast(MinInt, base);
            index -= 1;
            buf[index] = digit_to_char(@intCast(digit), case);
            a /= base;
            if (a == 0) break;
        }
    }

    if constexpr (value_info.signedness == .signed) {
        if (value < 0) {
            // Negative integer
            index -= 1;
            buf[index] = '-';
        } else if (spec.width == .none or spec.width.some == 0) {
            // Positive integer, omit the plus sign
        } else {
            // Positive integer
            index -= 1;
            buf[index] = '+';
        }
    }

    // TODO(tcs): Use spec here to finish formatting
    return w.write_all(buf[index..]).map_err(fn(_: std.io.Error): std.fmt.Error {
        return .io;
    });
};

test {
    var backing: [1024]mut u8 = undefined;
    var stream: std.io.FixedBufferStream = .{ .buf = backing };
    _ = formatIntAny(&mut stream, 1u16, 2, .lower, .{});
}
