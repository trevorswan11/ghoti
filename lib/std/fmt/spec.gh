import std;

pub const Align = enum : i32 {
    left,
    right,
    center,

    /// Converts the provided byte to an alignment character
    pub const from = fn(comptime c: u8): @This() {
        return match comptime (c) {
            '<' => .left,
            '>' => .right,
            '^' => .center,
            _ => unreachable,
        };
    };

    /// Checks if the provided byte is a valid alignment character
    pub const is_valid = fn(comptime c: u8): bool {
        return match comptime (c) {
            '<', '>', '^' => true,
            _ => false,
        };
    };
};

test "Align at compile time" {
    const a_left = Align.from('<');
    @expect(a_left == .left);
    const a_right = Align.from('>');
    @expect(a_right == .right);
    const a_center = Align.from('^');
    @expect(a_center == .center);

    const v_left = Align.is_valid('<');
    @expect(v_left == true);
    const v_right = Align.is_valid('>');
    @expect(v_right == true);
    const v_center = Align.is_valid('^');
    @expect(v_center == true);
    const v_bad = Align.is_valid('x');
    @expect(v_bad == false);
}

pub const Kind = enum : u8 {
    d = 'd',
    x = 'x',
    X = 'X',
    b = 'b',
    o = 'o',
    c = 'c',
    s = 's',
    e = 'e',
    f = 'f',
    p = 'p',
    @"?" = '?',

    /// Checks if the provided byte is a valid kind character
    pub const is_valid = fn(comptime byte: u8): bool {
        return match comptime (byte) {
            'd', 'x', 'X', 'b', 'o', 'c', 's', 'e', 'f', 'p', '?' => true,
            _ => false,
        };
    };
};

test "Kind.is_valid at compile time" {
    const kinds = [_]u8{ 'd', 'x', 'X', 'b', 'o', 'c', 's', 'e', 'f', 'p', '?' };
    unroll for (kinds) |kind| {
        const k = Kind.is_valid(kind);
        @expect(k == true);
    }
    const k_invalid = Kind.is_valid('z');
    @expect(k_invalid == false);
}

pub const Spec = struct {
    pub arg_idx: std.Option(usize) = .empty,
    pub fill: u8 = ' ',
    pub align: std.Option(Align) = .empty,
    pub plus: bool = false,
    pub alt: bool = false, /// '#'
    pub zero: bool = false, /// literal '0'
    pub width: std.Option(usize) = .empty,
    pub precision: std.Option(usize) = .empty,
    pub kind: std.Option(Kind) = .empty, // none means default '{}'

    /// Populates the spec with parsed information from its body
    pub const parse_body = fn(&mut self, comptime fmt: []u8, comptime start: usize): usize {
        comptime let mut i = start;

        // Fill and align lookahead
        if comptime (i + 1 < fmt.len and Align.is_valid(fmt[i + 1])) {
            self.fill = fmt[i];
            self.align = .of(.from(fmt[i + 1]));
            i += 2;
        } else if comptime (i < fmt.len and Align.is_valid(fmt[i])) {
            self.align = .of(.from(fmt[i]));
            i += 1;
        }

        // sign
        if comptime (i < fmt.len and fmt[i] == '+') {
            self.plus = true;
            i += 1;
        }

        // alt
        if comptime (i < fmt.len and fmt[i] == '#') {
            self.alt = true;
            i += 1;
        }

        // zero
        if comptime (i < fmt.len and fmt[i] == '0') {
            self.zero = true;
            i += 1;
        }

        // width
        const width_start = i;
        unroll while (i < fmt.len and is_digit(fmt[i])) : (i += 1) {}
        if comptime (i > width_start) {
            self.width = .of(parse_usize(fmt[width_start..i]));
        }

        // precision
        if comptime (i < fmt.len and fmt[i] == '.') {
            i += 1;
            const prec_start = i;
            unroll while (i < fmt.len and is_digit(fmt[i])) : (i += 1) {}
            if comptime (i == prec_start) {
                @compileError("fmt: bad spec: '.' with no precision digits");
            }
            self.precision = .of(parse_usize(fmt[prec_start..i]));
        }

        // kind
        if comptime (i < fmt.len and fmt[i] != '}') {
            if comptime (!Kind.is_valid(fmt[i])) {
                @compileError("fmt: bad spec: unrecognized type char");
            }
            self.kind = .of(@fromBackingInt(fmt[i]));
            i += 1;
        }

        return i;
    };
};

test "Spec.parse_body parses all spec inputs at compile time" {
    comptime let mut s: Spec = .{};
    const end = s.parse_body("*^+08.3f}", 0);
    @expect(end == 8);
    @expect(s.fill == '*');
    @expect(s.align.eq(Align.center));
    @expect(s.plus == true);
    @expect(s.alt == false);
    @expect(s.zero == true);
    @expect(s.width.eq(8uz));
    @expect(s.precision.eq(3uz));
    @expect(s.kind.eq(Kind.f));
}

pub const Placeholder = struct {
    pub spec: Spec,
    pub next: usize,

    pub const parse = fn(comptime fmt: []u8, comptime at: usize): @This() {
        comptime let mut i = at + 1;
        comptime let mut s: Spec = .{};

        const digit_start = i;
        unroll while (i < fmt.len and is_digit(fmt[i])) : (i += 1) {}
        if comptime (i > digit_start) {
            s.arg_idx = .of(parse_usize(fmt[digit_start..i]));
        }

        // Without a colon the spec is extremely simple
        if comptime (i < fmt.len and fmt[i] == ':') {
            i += 1;
            i = s.parse_body(fmt, i);
        }

        return .{
            .spec = s,
            .next = i + 1,
        };
    };
};

test "Placeholder.parse at compile time" {
    const p_empty = Placeholder.parse("{}", 0);
    @expect(p_empty.next == 2);
    @expect(p_empty.spec.fill == ' ');
    @expect(p_empty.spec.plus == false);
    @expect(p_empty.spec.alt == false);
    @expect(p_empty.spec.zero == false);
    @expect(p_empty.spec.arg_idx == .none);

    const p_idx: Placeholder = .parse("{3}", 0);
    @expect(p_idx.next == 3);
    @expect(p_idx.spec.arg_idx.eq(3uz));

    const p_spec: Placeholder = .parse("{2:#08x}", 0);
    @expect(p_spec.next == 8);
    @expect(p_spec.spec.arg_idx.eq(2uz));
    @expect(p_spec.spec.alt == true);
    @expect(p_spec.spec.zero == true);
    @expect(p_spec.spec.width.eq(8uz));
    @expect(p_spec.spec.kind.eq(Kind.x));
}

pub const is_digit = fn(comptime c: u8): bool {
    return c >= '0' and c <= '9';
};

test "is_digit at compile time" {
    const d0 = is_digit('0');
    @expect(d0 == true);
    const d9 = is_digit('9');
    @expect(d9 == true);
    const da = is_digit('a');
    @expect(da == false);
}

/// Parses a decimal integer from a slice of ASCII digit bytes at compile time.
pub const parse_usize = fn(comptime digits: []u8): usize {
    comptime let mut n: usize = 0;
    unroll for (digits) |c| {
        n = n * 10 + @intCast(usize, c - '0');
    }
    return n;
};

test "parse_usize at compile time" {
    const n0 = parse_usize("0");
    @expect(n0 == 0);
    const n42 = parse_usize("42");
    @expect(n42 == 42);
    const n1234 = parse_usize("1234");
    @expect(n1234 == 1234);
}

pub const next_placeholder = fn(comptime fmt: []u8, comptime from: usize): usize {
    comptime let mut i = from;
    unroll while (i < fmt.len) : (i += 1) {
        if comptime (fmt[i] == '{') {
            // Ignore double {{
            if comptime (i + 1 < fmt.len and fmt[i + 1] == '{') {
                i += 1;
                continue;
            }
            return i;
        }

        if comptime (fmt[i] == '}') {
            // Ignore double }}
            if comptime (i + 1 < fmt.len and fmt[i + 1] == '}') {
                i += 1;
            }
            continue;
        }
    }
    return fmt.len;
};

test "next_placeholder at compile time" {
    const p1 = next_placeholder("a{{b}}c{}", 0);
    @expect(p1 == 7);
    const p2 = next_placeholder("no placeholders", 0);
    @expect(p2 == 15);
    const p3 = next_placeholder("{}", 0);
    @expect(p3 == 0);
    const p4 = next_placeholder("{{}}", 0);
    @expect(p4 == 4);
}

/// Checks `fmt` against `arg_count` arguments at compile time according to:
/// - A `{}` takes the next argument not yet taken by a `{}`
/// - A `{N}` names an argument at an index
/// - Every argument must be used at least once
pub const validate = fn(comptime fmt: []u8, comptime arg_count: usize): void {
    comptime let mut i: usize = 0;
    comptime let mut next_implicit: usize = 0;
    comptime let mut used = 0;
    unroll while (i < fmt.len) {
        if comptime (fmt[i] == '{') {
            if comptime (i + 1 < fmt.len and fmt[i + 1] == '{') {
                i += 2;
                continue;
            }

            // Placeholder.parse will compile error internally if the spec is bad
            const parsed: Placeholder = .parse(fmt, i);
            if comptime (parsed.next > fmt.len or fmt[parsed.next - 1] != '}') {
                @compileError("fmt: unterminated placeholder, expected '}'");
            }

            const explicit = parsed.spec.arg_idx != .none;
            const arg_idx = parsed.spec.arg_idx.unwrap_or(next_implicit);
            if comptime (arg_idx >= arg_count) {
                if comptime (explicit) {
                    @compileError("fmt: explicit arg index out of range");
                }
                @compileError("fmt: more placeholders than arguments");
            }
            if comptime (!explicit) {
                next_implicit += 1;
            }
            used |= 1 << arg_idx;
            i = parsed.next;
            continue;
        }

        if comptime (fmt[i] == '}') {
            if comptime (i + 1 < fmt.len and fmt[i + 1] == '}') {
                i += 2;
                continue;
            }
            @compileError("fmt: unmatched '}' in format string");
        }
        i += 1;
    }

    if comptime (used != (1 << arg_count) - 1) {
        @compileError("fmt: an argument is never used");
    }
};

test "validate at compile time" {
    validate("{}", 1);
    validate("hello {0} world {1}", 2);
    validate("{1} {0}", 2);
    validate("{0} {0} {}", 1);
    validate("{} {0} {}", 2);
    validate("{{}} {}", 1);
    validate("{:#08x} = {:+5.2f}", 2);
    validate("x {:>5} {:<} {:^8}", 3);
    validate("no placeholders", 0);
}

pub const pad = fn(
    w: &mut dyn std.io.Writer,
    spec: Spec,
    body: []u8,
    default_align: Align,
): std.Result(void, std.fmt.Error) {
    let width = spec.width.unwrap_or(0);
    if (width <= body.len) {
        w.write_all(body)?;
        return .done;
    }

    let padding = width - body.len;
    let left_pad = match (spec.align.unwrap_or(default_align)) {
        .left => 0uz,
        .right => padding,
        .center => padding / 2,
    };
    let right_pad = padding - left_pad;

    for (0..left_pad) |_| {
        w.write_byte(spec.fill)?;
    }
    w.write_all(body)?;

    for (0..right_pad) |_| {
        w.write_byte(spec.fill)?;
    }
    return .done;
};

test "pad applies default and explicit alignment" {
    let mut backing: [16]mut u8 = undefined;
    let mut stream: std.io.FixedBufferStream = .{ .buf = backing };

    @expect(pad(^mut stream, .{ .width = .of(6) }, "hi", .left) == .ok);
    @expect(std.mem.eql(u8, "hi    ", backing[..stream.pos]));

    stream.pos = 0;
    @expect(pad(^mut stream, .{ .width = .of(6), .align = .of(.right) }, "hi", .left) == .ok);
    @expect(std.mem.eql(u8, "    hi", backing[..stream.pos]));
}

/// Write N bytes of value `byte` to the writer
pub const write_fill_n = fn(
    w: &mut dyn std.io.Writer,
    byte: u8,
    n: usize,
): std.Result(void, std.fmt.Error) {
    for (0..n) |_| {
        w.write_byte(byte)?;
    }
    return .done;
};

/// Writes `body` padded per `spec`, where `body[..prefix_len]` is a sign/radix prefix.
/// The zero flag overrides fill/align and places '0's between the prefix and the digits
pub const pad_number = fn(
    w: &mut dyn std.io.Writer,
    spec: Spec,
    body: []u8,
    prefix_len: usize,
): std.Result(void, std.fmt.Error) {
    let width = spec.width.unwrap_or(0);
    if (width <= body.len) {
        w.write_all(body)?;
        return .done;
    }

    if (spec.zero) {
        w.write_all(body[..prefix_len])?;
        write_fill_n(w, '0', width - body.len)?;
        w.write_all(body[prefix_len..])?;
        return .done;
    }
    return pad(w, spec, body, .right);
};

test "pad_number places zeros after the prefix and defers to pad otherwise" {
    let mut backing: [16]mut u8 = undefined;
    let mut stream: std.io.FixedBufferStream = .{ .buf = backing };

    @expect(pad_number(&mut stream, .{}, "-0x1f", 3) == .ok);
    @expect(std.mem.eql(u8, "-0x1f", backing[..stream.pos]));

    stream.pos = 0;
    @expect(pad_number(&mut stream, .{ .width = .of(3), .zero = true }, "-0x1f", 3) == .ok);
    @expect(std.mem.eql(u8, "-0x1f", backing[..stream.pos]));

    stream.pos = 0;
    @expect(pad_number(&mut stream, .{ .width = .of(8), .zero = true }, "-0x1f", 3) == .ok);
    @expect(std.mem.eql(u8, "-0x0001f", backing[..stream.pos]));

    stream.pos = 0;
    let zero_with_align: Spec = .{
        .width = .of(6),
        .zero = true,
        .fill = '*',
        .align = .of(.left),
    };
    @expect(pad_number(&mut stream, zero_with_align, "-42", 1) == .ok);
    @expect(std.mem.eql(u8, "-00042", backing[..stream.pos]));

    stream.pos = 0;
    @expect(pad_number(&mut stream, .{ .width = .of(6) }, "-42", 1) == .ok);
    @expect(std.mem.eql(u8, "   -42", backing[..stream.pos]));

    stream.pos = 0;
    @expect(pad_number(
        &mut stream,
        .{ .width = .of(6), .fill = '*', .align = .of(.center) },
        "42",
        0,
    ) == .ok);
    @expect(std.mem.eql(u8, "**42**", backing[..stream.pos]));
}

/// Writes a literal/escaped curly brace sequence to the writer
pub const write_literal = fn(
    w: &mut dyn std.io.Writer,
    raw: []u8,
): std.Result(void, std.fmt.Error) {
    let mut start: usize = 0;
    let mut i: usize = 0;
    loop {
        if (i >= raw.len) break;
        if (raw[i] == '{' or raw[i] == '}') {
            if (i > start) {
                w.write_all(raw[start..i])?;
            }
            w.write_byte(raw[i])?;
            i += 2;
            start = i;
            continue;
        }
        i += 1;
    }
    if (raw.len > start) {
        w.write_all(raw[start..])?;
    }
    return .done;
};

test "write_literal unescapes braces and coalesces runs" {
    let mut backing: [16]mut u8 = undefined;
    let mut stream: std.io.FixedBufferStream = .{ .buf = backing };
    @expect(write_literal(&mut stream, "a{{b}}c") == .ok);
    @expect(std.mem.eql(u8, "a{b}c", backing[..stream.pos]));
}
