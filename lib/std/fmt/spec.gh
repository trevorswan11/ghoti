import std;

pub const Align := enum : i32 {
    left,
    right,
    center,

    /// Converts the provided byte to an alignment character
    pub constexpr from := fn(constexpr c: u8): @This() {
        return match constexpr (c) {
            '<' => .left,
            '>' => .right,
            '^' => .center,
            _ => unreachable,
        };
    };

    /// Checks if the provided byte is a valid alignment character
    pub constexpr is_valid := fn(constexpr c: u8): bool {
        return match constexpr (c) {
            '<', '>', '^' => true,
            _ => false,
        };
    };
};

test "Align at compile time" {
    constexpr a_left := Align.from('<');
    @expect(a_left == .left);
    constexpr a_right := Align.from('>');
    @expect(a_right == .right);
    constexpr a_center := Align.from('^');
    @expect(a_center == .center);

    constexpr v_left := Align.is_valid('<');
    @expect(v_left == true);
    constexpr v_right := Align.is_valid('>');
    @expect(v_right == true);
    constexpr v_center := Align.is_valid('^');
    @expect(v_center == true);
    constexpr v_bad := Align.is_valid('x');
    @expect(v_bad == false);
}

pub const Kind := enum : u8 {
    d = 'd',
    x = 'x',
    X = 'X',
    b = 'b',
    o = 'o',
    c = 'c',
    s = 's',
    e = 'e',
    f = 'f',
    p = 'p',
    @"?" = '?',

    /// Checks if the provided byte is a valid kind character
    pub constexpr is_valid := fn(constexpr byte: u8): bool {
        return match constexpr (byte) {
            'd', 'x', 'X', 'b', 'o', 'c', 's', 'e', 'f', 'p', '?' => true,
            _ => false,
        };
    };
};

test "Kind.is_valid at compile time" {
    constexpr kinds := [_]u8{ 'd', 'x', 'X', 'b', 'o', 'c', 's', 'e', 'f', 'p', '?' };
    for constexpr (kinds) |kind| {
        constexpr k := Kind.is_valid(kind);
        @expect(k == true);
    }
    constexpr k_invalid := Kind.is_valid('z');
    @expect(k_invalid == false);
}

pub const Spec := struct {
    pub arg_idx: std.Option(usize) = .empty,
    pub fill: u8 = ' ',
    pub align: std.Option(Align) = .empty,
    pub plus: bool = false,
    pub alt: bool = false, /// '#'
    pub zero: bool = false, /// literal '0'
    pub width: std.Option(usize) = .empty,
    pub precision: std.Option(usize) = .empty,
    pub kind: std.Option(Kind) = .empty, // none means default '{}'

    /// Populates the spec with parsed information from its body
    pub constexpr parse_body := fn(&mut self, constexpr fmt: []u8, constexpr start: usize): usize {
        constexpr var i := start;

        // Fill and align lookahead
        if constexpr (i + 1 < fmt.len and Align.is_valid(fmt[i + 1])) {
            self.fill = fmt[i];
            self.align = .of(.from(fmt[i + 1]));
            i += 2;
        } else if constexpr (i < fmt.len and Align.is_valid(fmt[i])) {
            self.align = .of(.from(fmt[i]));
            i += 1;
        }

        // sign
        if constexpr (i < fmt.len and fmt[i] == '+') {
            self.plus = true;
            i += 1;
        }

        // alt
        if constexpr (i < fmt.len and fmt[i] == '#') {
            self.alt = true;
            i += 1;
        }

        // zero
        if constexpr (i < fmt.len and fmt[i] == '0') {
            self.zero = true;
            i += 1;
        }

        // width
        constexpr width_start := i;
        while constexpr (i < fmt.len and is_digit(fmt[i])) : (i += 1) {}
        if constexpr (i > width_start) {
            self.width = .of(parse_usize(fmt[width_start..i]));
        }

        // precision
        if constexpr (i < fmt.len and fmt[i] == '.') {
            i += 1;
            constexpr prec_start := i;
            while constexpr (i < fmt.len and is_digit(fmt[i])) : (i += 1) {}
            if constexpr (i == prec_start) {
                @compileError("fmt: bad spec: '.' with no precision digits");
            }
            self.precision = .of(parse_usize(fmt[prec_start..i]));
        }

        // kind
        if constexpr (i < fmt.len and fmt[i] != '}') {
            if constexpr (!Kind.is_valid(fmt[i])) {
                @compileError("fmt: bad spec: unrecognized type char");
            }
            self.kind = .of(@fromBackingInt(Kind, fmt[i]));
            i += 1;
        }

        return i;
    };
};

test "Spec.parse_body parses all spec inputs at compile time" {
    constexpr var s: Spec = .{};
    constexpr end := s.parse_body("*^+08.3f}", 0);
    @expect(end == 8);
    @expect(s.fill == '*');
    match (s.align) {
        .some => |a| @expect(a == .center),
        .none => unreachable,
    }
    @expect(s.plus == true);
    @expect(s.alt == false);
    @expect(s.zero == true);
    match (s.width) {
        .some => |w| @expect(w == 8),
        .none => unreachable,
    }
    match (s.precision) {
        .some => |p| @expect(p == 3),
        .none => unreachable,
    }
    match (s.kind) {
        .some => |k| @expect(k == .f),
        .none => unreachable,
    }
}

pub const Placeholder := struct {
    spec: Spec,
    next: usize,

    pub constexpr parse := fn(constexpr fmt: []u8, constexpr at: usize): @This() {
        constexpr var i := at + 1;
        constexpr var s: Spec = .{};

        constexpr digit_start := i;
        while constexpr (i < fmt.len and is_digit(fmt[i])) : (i += 1) {}
        if constexpr (i > digit_start) {
            s.arg_idx = .of(parse_usize(fmt[digit_start..i]));
        }

        // Without a colon the spec is extremely simple
        if constexpr (i < fmt.len and fmt[i] == ':') {
            i += 1;
            i = s.parse_body(fmt, i);
        }

        return .{
            .spec = s,
            .next = i + 1,
        };
    };
};

test "Placeholder.parse at compile time" {
    constexpr p_empty := Placeholder.parse("{}", 0);
    @expect(p_empty.next == 2);
    @expect(p_empty.spec.fill == ' ');
    @expect(p_empty.spec.plus == false);
    @expect(p_empty.spec.alt == false);
    @expect(p_empty.spec.zero == false);
    match (p_empty.spec.arg_idx) {
        .some => unreachable,
        .none => {},
    }

    constexpr p_idx: Placeholder = .parse("{3}", 0);
    @expect(p_idx.next == 3);
    match (p_idx.spec.arg_idx) {
        .some => |idx| @expect(idx == 3),
        .none => unreachable,
    }

    constexpr p_spec: Placeholder = .parse("{2:#08x}", 0);
    @expect(p_spec.next == 8);
    match (p_spec.spec.arg_idx) {
        .some => |idx| @expect(idx == 2),
        .none => unreachable,
    }
    @expect(p_spec.spec.alt == true);
    @expect(p_spec.spec.zero == true);
    match (p_spec.spec.width) {
        .some => |w| @expect(w == 8),
        .none => unreachable,
    }
    match (p_spec.spec.kind) {
        .some => |k| @expect(k == .x),
        .none => unreachable,
    }
}

pub constexpr is_digit := fn(constexpr c: u8): bool {
    return c >= '0' and c <= '9';
};

test "is_digit at compile time" {
    constexpr d0 := is_digit('0');
    @expect(d0 == true);
    constexpr d9 := is_digit('9');
    @expect(d9 == true);
    constexpr da := is_digit('a');
    @expect(da == false);
}

/// Parses a decimal integer from a slice of ASCII digit bytes at compile time.
pub constexpr parse_usize := fn(constexpr digits: []u8): usize {
    constexpr var n: usize = 0;
    for constexpr (digits) |c| {
        n = n * 10 + @intCast(usize, c - '0');
    }
    return n;
};

test "parse_usize at compile time" {
    constexpr n0 := parse_usize("0");
    @expect(n0 == 0);
    constexpr n42 := parse_usize("42");
    @expect(n42 == 42);
    constexpr n1234 := parse_usize("1234");
    @expect(n1234 == 1234);
}

pub constexpr next_placeholder := fn(constexpr fmt: []u8, constexpr from: usize): usize {
    constexpr var i := from;
    while constexpr (i < fmt.len) : (i += 1) {
        if constexpr (fmt[i] == '{') {
            // Ignore double {{
            if constexpr (i + 1 < fmt.len and fmt[i + 1] == '{') {
                i += 1;
                continue;
            }
            return i;
        }

        if constexpr (fmt[i] == '}') {
            // Ignore double }}
            if constexpr (i + 1 < fmt.len and fmt[i + 1] == '}') {
                i += 1;
            }
            continue;
        }
    }
    return fmt.len;
};

test "next_placeholder at compile time" {
    constexpr p1 := next_placeholder("a{{b}}c{}", 0);
    @expect(p1 == 7);
    constexpr p2 := next_placeholder("no placeholders", 0);
    @expect(p2 == 15);
    constexpr p3 := next_placeholder("{}", 0);
    @expect(p3 == 0);
    constexpr p4 := next_placeholder("{{}}", 0);
    @expect(p4 == 4);
}

pub constexpr validate := fn(constexpr fmt: []u8, constexpr arg_count: usize): void {
    constexpr var i: usize = 0;
    constexpr var placeholder_count: usize = 0;
    while constexpr (i < fmt.len) {
        if constexpr (fmt[i] == '{') {
            if constexpr (i + 1 < fmt.len and fmt[i + 1] == '{') {
                i += 2;
                continue;
            }

            // parseAt will compile error internally if the spec is bad
            constexpr parsed: Placeholder = .parse(fmt, i);
            match constexpr (parsed.spec.arg_idx) {
                .some => |arg_idx| if constexpr (arg_idx >= arg_count) {
                    @compileError("fmt: explicit arg index out of range");
                },
                .none => {},
            }
            placeholder_count += 1;
            i = parsed.next;
            continue;
        }

        if constexpr (fmt[i] == '}') {
            if constexpr (i + 1 < fmt.len and fmt[i + 1] == '}') {
                i += 2;
                continue;
            }
            @compileError("fmt: unmatched '}' in format string");
        }
        i += 1;
    }

    if constexpr (placeholder_count != arg_count) {
        @compileError("fmt: wrong number of arguments");
    }
};

test "validate at compile time" {
    validate("{}", 1);
    validate("hello {0} world {1}", 2);
    validate("{{}} {}", 1);
    validate("{:#08x} = {:+5.2f}", 2);
}

const to_io_err := fn(_: std.io.Error): std.fmt.Error {
    return .io;
};

pub const pad := fn(
    w: &mut dyn std.io.Writer,
    spec: Spec,
    body: []u8,
    default_align: Align,
): std.Result(void, std.fmt.Error) {
    const width := match (spec.width) {
        .some => |explicit_width| explicit_width,
        .none => return w.write_all(body).map_err(to_io_err),
    };
    if (width <= body.len) return w.write_all(body).map_err(to_io_err);

    const padding := width - body.len;
    const left_pad := match (spec.align.unwrap_or(default_align)) {
        .left => 0uz,
        .right => padding,
        .center => padding / 2,
    };
    const right_pad := padding - left_pad;

    for (0..left_pad) |_| {
        w.write_byte(spec.fill).map_err(to_io_err)?;
    }
    w.write_all(body).map_err(to_io_err)?;

    for (0..right_pad) |_| {
        w.write_byte(spec.fill).map_err(to_io_err)?;
    }
    return .done;
};

test "pad applies default and explicit alignment" {
    var backing: [16]mut u8 = undefined;
    var stream: std.io.FixedBufferStream = .{ .buf = backing };

    @expect(pad(^mut stream, .{ .width = .of(6) }, "hi", .left) == .ok);
    @expect(std.mem.eql(u8, "hi    ", backing[..stream.pos]));

    stream.pos = 0;
    @expect(pad(^mut stream, .{ .width = .of(6), .align = .of(.right) }, "hi", .left) == .ok);
    @expect(std.mem.eql(u8, "    hi", backing[..stream.pos]));
}

/// Write N bytes of value `byte` to the writer
pub const write_fill_n := fn(
    w: &mut dyn std.io.Writer,
    byte: u8,
    n: usize,
): std.Result(void, std.fmt.Error) {
    for (0..n) |_| {
        w.write_byte(byte).map_err(to_io_err)?;
    }
    return .done;
};

/// Writes `body` padded per `spec`, where `body[..prefix_len]` is a sign/radix prefix.
/// The zero flag overrides fill/align and places '0's between the prefix and the digits
pub const pad_number := fn(
    w: &mut dyn std.io.Writer,
    spec: Spec,
    body: []u8,
    prefix_len: usize,
): std.Result(void, std.fmt.Error) {
    const width := match (spec.width) {
        .some => |explicit_width| explicit_width,
        .none => return w.write_all(body).map_err(to_io_err),
    };
    if (width <= body.len) return w.write_all(body).map_err(to_io_err);

    if (spec.zero) {
        w.write_all(body[..prefix_len]).map_err(to_io_err)?;
        write_fill_n(w, '0', width - body.len)?;
        return w.write_all(body[prefix_len..]).map_err(to_io_err);
    }
    return pad(w, spec, body, .right);
};

test "pad_number places zeros after the prefix and defers to pad otherwise" {
    var backing: [16]mut u8 = undefined;
    var stream: std.io.FixedBufferStream = .{ .buf = backing };

    @expect(pad_number(&mut stream, .{}, "-0x1f", 3) == .ok);
    @expect(std.mem.eql(u8, "-0x1f", backing[..stream.pos]));

    stream.pos = 0;
    @expect(pad_number(&mut stream, .{ .width = .of(3), .zero = true }, "-0x1f", 3) == .ok);
    @expect(std.mem.eql(u8, "-0x1f", backing[..stream.pos]));

    stream.pos = 0;
    @expect(pad_number(&mut stream, .{ .width = .of(8), .zero = true }, "-0x1f", 3) == .ok);
    @expect(std.mem.eql(u8, "-0x0001f", backing[..stream.pos]));

    stream.pos = 0;
    const zero_with_align: Spec = .{
        .width = .of(6),
        .zero = true,
        .fill = '*',
        .align = .of(.left),
    };
    @expect(pad_number(&mut stream, zero_with_align, "-42", 1) == .ok);
    @expect(std.mem.eql(u8, "-00042", backing[..stream.pos]));

    stream.pos = 0;
    @expect(pad_number(&mut stream, .{ .width = .of(6) }, "-42", 1) == .ok);
    @expect(std.mem.eql(u8, "   -42", backing[..stream.pos]));

    stream.pos = 0;
    @expect(
        pad_number(&mut stream, .{ .width = .of(6), .fill = '*', .align = .of(.center) }, "42", 0) ==
            .ok,
    );
    @expect(std.mem.eql(u8, "**42**", backing[..stream.pos]));
}

/// Writes a literal/escaped curly brace sequence to the writer
pub const write_literal := fn(
    w: &mut dyn std.io.Writer,
    raw: []u8,
): std.Result(void, std.fmt.Error) {
    var start: usize = 0;
    var i: usize = 0;
    loop {
        if (i >= raw.len) break;
        if (raw[i] == '{' or raw[i] == '}') {
            if (i > start) {
                w.write_all(raw[start..i]).map_err(to_io_err)?;
            }
            w.write_byte(raw[i]).map_err(to_io_err)?;
            i += 2;
            start = i;
            continue;
        }
        i += 1;
    }
    if (raw.len > start) {
        w.write_all(raw[start..]).map_err(to_io_err)?;
    }
    return .done;
};

test "write_literal unescapes braces and coalesces runs" {
    var backing: [16]mut u8 = undefined;
    var stream: std.io.FixedBufferStream = .{ .buf = backing };
    @expect(write_literal(&mut stream, "a{{b}}c") == .ok);
    @expect(std.mem.eql(u8, "a{b}c", backing[..stream.pos]));
}
