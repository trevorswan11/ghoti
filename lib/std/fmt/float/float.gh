test "render f16" {
    check(f16, 0.0, "0e0");
    check(f16, 1.0, "1e0");
    check(f16, -1.5, "-1.5e0");
    check(f16, 65504.0, "6.55e4");
    check(f16, std.math.inf(f16), "inf");
}

test "render decimal mode" {
    check_render(1.5f64, .{ .mode = .decimal }, "1.5");
    check_render(-0.0f64, .{ .mode = .decimal }, "-0");
    check_render(100.0f64, .{ .mode = .decimal }, "100");
    check_render(0.000123f64, .{ .mode = .decimal }, "0.000123");
    check_render(123456.789f64, .{ .mode = .decimal }, "123456.789");
    check_render(1e21f64, .{ .mode = .decimal }, "1000000000000000000000");
    check_render(std.math.nan(f64), .{ .mode = .decimal }, "nan");
}

test "render with precision" {
    check_render(3.14159f64, .{ .mode = .decimal, .precision = .of(2) }, "3.14");
    check_render(2.5f64, .{ .mode = .decimal, .precision = .of(0) }, "3");
    check_render(1.0f64, .{ .mode = .decimal, .precision = .of(3) }, "1.000");
    check_render(9.999f64, .{ .mode = .decimal, .precision = .of(2) }, "10.00");
    check_render(0.001234f64, .{ .mode = .decimal, .precision = .of(5) }, "0.00123");
    check_render(1234.5f64, .{ .mode = .scientific, .precision = .of(2) }, "1.23e3");
    check_render(1.0f64, .{ .mode = .scientific, .precision = .of(2) }, "1.00e0");
    check_render(5.0f64, .{ .mode = .scientific, .precision = .of(0) }, "5e0");
}

test "render comptime_float" {
    check_render(0.1, .{}, "1e-1");
    check_render(0.1, .{ .mode = .decimal }, "0.1");
}

test "render fails on a small decimal buffer" {
    let mut buf: [MIN_BUFFER_SIZE]mut u8 = undefined;
    @expect(render(buf[..], 1e300f64, .{ .mode = .decimal }) == .err);
    @expect(render(buf[..], 1e300f64, .{}) == .ok);
}

test "format float to decimal with zero precision" {
    check_fmt(5.0f64, .{ .precision = .of(0) }, "5");
    check_fmt(6.0f64, .{ .precision = .of(0) }, "6");
    check_fmt(7.0f64, .{ .precision = .of(0) }, "7");
    check_fmt(8.0f64, .{ .precision = .of(0) }, "8");
}

test "format kinds" {
    check_fmt(1.5f64, .{}, "1.5");
    check_fmt(1.5f64, .{ .kind = .of(.d) }, "1.5");
    check_fmt(1.5f64, .{ .kind = .of(.f) }, "1.5");
    check_fmt(1.5f64, .{ .kind = .of(.@"?") }, "1.5");
    check_fmt(1500.0f32, .{ .kind = .of(.e) }, "1.5e3");
    check_fmt(1.25f64, .{ .kind = .of(.f), .precision = .of(1) }, "1.3");
}

test "format sign, width, and zero padding" {
    check_fmt(1.5f64, .{ .plus = true }, "+1.5");
    check_fmt(-1.5f64, .{ .plus = true }, "-1.5");
    check_fmt(1.5f64, .{ .width = .of(6) }, "   1.5");
    check_fmt(1.5f64, .{ .width = .of(6), .align = .of(.left) }, "1.5   ");
    check_fmt(1.5f64, .{ .width = .of(7), .fill = '*', .align = .of(.center) }, "**1.5**");
    check_fmt(-1.5f64, .{ .width = .of(7), .zero = true }, "-0001.5");
    check_fmt(1.5f64, .{ .width = .of(7), .zero = true, .plus = true }, "+0001.5");
    check_fmt(1.5f64, .{ .width = .of(2) }, "1.5");
}

test "format nan and inf ignore zero padding" {
    check_fmt(std.math.nan(f64), .{ .width = .of(5), .zero = true }, "  nan");
    check_fmt(std.math.nan(f64), .{ .plus = true }, "nan");
    check_fmt(std.math.inf(f64), .{ .plus = true }, "+inf");
    check_fmt(std.math.inf(f64), .{ .width = .of(6), .zero = true, .plus = true }, "  +inf");
    check_fmt(-std.math.inf(f64), .{ .width = .of(6) }, "  -inf");
}

test "format rejects non-float kinds" {
    check_fmt_err(1.0f64, .{ .kind = .of(.x) }, .bad_spec);
    check_fmt_err(1.0f64, .{ .kind = .of(.s) }, .bad_spec);
    check_fmt_err(1.0f64, .{ .kind = .of(.c) }, .bad_spec);
}

test "format fails when precision overflows the buffer" {
    check_fmt_err(1.0f32, .{ .precision = .of(500) }, .overflow);
}
