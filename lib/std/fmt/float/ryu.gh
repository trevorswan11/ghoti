//! Ryu's binary to shortest decimal conversion, the part of float formatting that finds the digits
//! Paper: https://dl.acm.org/doi/pdf/10.1145/3360595
//! Ported from: https://codeberg.org/ziglang/zig/src/tag/0.17.0/lib/std/fmt/float.zig
//! Zig is licensed under the MIT license
import std;

import "backend.gh" as backend;

const Backend = backend.Backend;
const pow5_bits = backend.pow5_bits;

/// The exponent of a nan or inf, whose `mantissa` is nonzero exactly for nan
pub const SPECIAL_EXPONENT: i32 = 0x7fffffff;

/// A float decomposed into `mantissa * 10^exponent`, with nan and inf flagged by `SPECIAL_EXPONENT`
pub const FloatDecimal = fn(comptime T: type): type {
    comptime @assert(T == u64 or T == u128);
    return struct {
        pub mantissa: T,
        pub exponent: i32,
        pub sign: bool,
    };
};

/// The integer width Ryu works in for float type `T`, which is its backend's
pub const DecimalInt = fn(comptime T: type): type {
    return Backend(T).T;
};

/// Decomposes `value` into its shortest round-trip decimal form
pub const to_decimal = fn(comptime T: type, value: T): FloatDecimal(DecimalInt(T)) {
    comptime @assert(@typeInfo(T) == .float);
    const Bits = @Int(.{ .signedness = .unsigned, .bits = @bitSizeOf(T) });
    const mantissa_bits = std.math.float_mantissa_bits(T);
    const explicit_leading_bit = mantissa_bits != std.math.float_fractional_bits(T);

    return binary_to_decimal(
        Backend(T),
        @bitCast(Bits, value),
        mantissa_bits,
        std.math.float_exponent_bits(T),
        explicit_leading_bit,
    );
};

/// Converts the raw bits of a binary float to its shortest round-trip decimal form,
/// doing the wide arithmetic in the backend `B`'s integer type
pub const binary_to_decimal = fn(
    comptime B: type,
    bits: B.T,
    comptime mantissa_bits: comptime_int,
    comptime exponent_bits: comptime_int,
    comptime explicit_leading_bit: bool,
): FloatDecimal(B.T) {
    const T = B.T;
    const bias = (1 << (exponent_bits - 1)) - 1;
    const exponent_mask = (1 << exponent_bits) - 1;
    const mantissa_mask = (1 << mantissa_bits) - 1;
    let ieee_sign = ((bits >> (mantissa_bits + exponent_bits)) & 1) != 0;
    let ieee_mantissa = bits & mantissa_mask;
    let ieee_exponent = @intCast(u32, (bits >> mantissa_bits) & exponent_mask);

    if (ieee_exponent == 0 and ieee_mantissa == 0) {
        return .{ .mantissa = 0, .exponent = 0, .sign = ieee_sign };
    }
    if (ieee_exponent == exponent_mask) {
        // The explicit integer bit of f80 is not part of the nan payload
        let payload = if comptime (explicit_leading_bit)
            ieee_mantissa & ((1 << (mantissa_bits - 1)) - 1)
            else ieee_mantissa;
        return .{ .mantissa = payload, .exponent = SPECIAL_EXPONENT, .sign = ieee_sign };
    }

    // Step 1: Decode the float into the unified form `m2 * 2^e2`
    let biased_exponent = if (ieee_exponent == 0) 1i32 else @intCast(i32, ieee_exponent);
    let mut e2: i32 = biased_exponent - bias - mantissa_bits - 2;
    let mut m2: T = ieee_mantissa;
    if comptime (explicit_leading_bit) {
        e2 += 1;
    } else if (ieee_exponent != 0) {
        m2 |= 1 << mantissa_bits;
    }
    let even = (m2 & 1) == 0;
    let accept_bounds = even;

    // Step 2: Determine the interval of legal decimal representations
    let mv = 4 * m2;
    const lowest_mantissa = if comptime (explicit_leading_bit) 1 << (mantissa_bits - 1) else 0;
    let mm_shift = @intFromBool(T, ieee_mantissa != lowest_mantissa or ieee_exponent == 0);

    // Step 3: Convert to a decimal power base using wide arithmetic
    let mut vr: T = undefined;
    let mut vp: T = undefined;
    let mut vm: T = undefined;
    let mut e10: i32 = undefined;
    let mut vm_is_trailing_zeros = false;
    let mut vr_is_trailing_zeros = false;
    if (e2 >= 0) {
        let q = log10_pow2(@intCast(u32, e2)) - @intFromBool(u32, e2 > 3);
        e10 = @intCast(i32, q);
        let k = @intCast(i32, B.POW5_INV_BITCOUNT + pow5_bits(q) - 1);
        let i = @intCast(u32, -e2 + @intCast(i32, q) + k);

        let pow5 = B.compute_inv_pow5(q);
        vr = B.mul_shift(4 * m2, pow5, i);
        vp = B.mul_shift(4 * m2 + 2, pow5, i);
        vm = B.mul_shift(4 * m2 - 1 - mm_shift, pow5, i);

        if (q <= B.bound1) {
            if (mv % 5 == 0) {
                vr_is_trailing_zeros = multiple_of_power_of_5(mv, if (B.adjust_q) q -% 1 else q);
            } else if (accept_bounds) {
                vm_is_trailing_zeros = multiple_of_power_of_5(mv - 1 - mm_shift, q);
            } else {
                vp -= @intFromBool(T, multiple_of_power_of_5(mv + 2, q));
            }
        }
    } else {
        let q = log10_pow5(@intCast(u32, -e2)) - @intFromBool(u32, -e2 > 1);
        e10 = @intCast(i32, q) + e2;
        let i = -e2 - @intCast(i32, q);
        let k = @intCast(i32, pow5_bits(@intCast(u32, i))) - B.POW5_BITCOUNT;
        let j = @intCast(u32, @intCast(i32, q) - k);

        let pow5 = B.compute_pow5(@intCast(u32, i));
        vr = B.mul_shift(4 * m2, pow5, j);
        vp = B.mul_shift(4 * m2 + 2, pow5, j);
        vm = B.mul_shift(4 * m2 - 1 - mm_shift, pow5, j);

        if (q <= 1) {
            vr_is_trailing_zeros = true;
            if (accept_bounds) {
                vm_is_trailing_zeros = mm_shift == 1;
            } else {
                vp -= 1;
            }
        } else if (q < B.bound2) {
            vr_is_trailing_zeros = multiple_of_power_of_2(mv, if (B.adjust_q) q - 1 else q);
        }
    }

    // Step 4: Find the shortest decimal representation in the interval of legal representations
    let mut removed: u32 = 0;
    let mut last_removed_digit: u8 = 0;

    while (vp / 10 > vm / 10) {
        vm_is_trailing_zeros = vm_is_trailing_zeros and vm % 10 == 0;
        vr_is_trailing_zeros = vr_is_trailing_zeros and last_removed_digit == 0;
        last_removed_digit = @intCast(vr % 10);
        vr /= 10;
        vp /= 10;
        vm /= 10;
        removed += 1;
    }

    if (vm_is_trailing_zeros) {
        while (vm % 10 == 0) {
            vr_is_trailing_zeros = vr_is_trailing_zeros and last_removed_digit == 0;
            last_removed_digit = @intCast(vr % 10);
            vr /= 10;
            vp /= 10;
            vm /= 10;
            removed += 1;
        }
    }

    if (vr_is_trailing_zeros and last_removed_digit == 5 and vr % 2 == 0) {
        // Round even if the exact number is .....50..0
        last_removed_digit = 4;
    }

    let round_up = (vr == vm and (!accept_bounds or !vm_is_trailing_zeros)) or
        last_removed_digit >= 5;
    return .{
        .mantissa = vr + @intFromBool(T, round_up),
        .exponent = e10 + @intCast(i32, removed),
        .sign = ieee_sign,
    };
};

/// Returns the number of decimal digits in `v`, which is at least 1
pub const decimal_length = fn(v: auto): usize {
    const V = @TypeOf(v);
    if comptime (V == u128) {
        let mut p10: u128 = 100000000000000000000000000000000000000;
        let mut digits: usize = 39;
        while (digits > 0) : (digits -= 1) {
            if (v >= p10) return digits;
            p10 /= 10;
        }
        return 1;
    } else {
        comptime @assert(V == u32 or V == u64);
        @assert(v < 100000000000000000);
        let mut p10: u64 = 10000000000000000;
        let mut digits: usize = 17;
        while (digits > 1) : (digits -= 1) {
            if (v >= p10) return digits;
            p10 /= 10;
        }
        return 1;
    }
};

/// floor(log_10(2^e))
const log10_pow2 = fn(e: u32): u32 {
    @assert(e <= 1 << 15);
    return @intCast((@as(u64, e) * 169464822037455) >> 49);
};

/// floor(log_10(5^e))
const log10_pow5 = fn(e: u32): u32 {
    @assert(e <= 1 << 15);
    return @intCast((@as(u64, e) * 196742565691928) >> 48);
};

const pow5_factor = fn(value: auto): u32 {
    let mut count: u32 = 0;
    let mut remaining = value;
    while (remaining > 0) : (remaining /= 5) {
        if (remaining % 5 != 0) return count;
        count += 1;
    }
    return 0;
};

const multiple_of_power_of_5 = fn(value: auto, p: u32): bool {
    return pow5_factor(value) >= p;
};

const multiple_of_power_of_2 = fn(value: auto, p: u32): bool {
    const V = @TypeOf(value);
    return (value & ((@as(V, 1) << @intCast(p)) - 1)) == 0;
};
