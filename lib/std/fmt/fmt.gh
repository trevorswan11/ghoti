import std;

import "spec.gh" as spec;

pub const Spec := spec.Spec;
pub const pad := spec.pad;
pub const write_fill_n := spec.write_fill_n;
pub const pad_number := spec.pad_number;
pub const write_literal := spec.write_literal;

test {
    import "spec.gh";
}

pub import "int.gh" as int;

pub constexpr digits2 := int.digits2;
pub constexpr digit_to_char := int.digit_to_char;

test {
    import "int.gh";
}

const Writer := std.io.Writer;

pub const Error := enum { overflow, bad_spec, bad_arg, unsupported, io };

pub const Format := interface {
    const format := fn(
        &self,
        spec: Spec,
        w: &mut dyn Writer(Error = std.io.Error),
    ): std.Result(void, Error);
};

pub const Case := enum : u1 { lower, upper };

pub const format := fn(w: &mut impl Writer, constexpr fmt: []u8, args...): std.Result(void, Error) {
    constexpr {
        spec.validate(fmt, args.len);
    }

    var dyn_w: &mut dyn Writer(Error = std.io.Error) = w;
    constexpr var cursor: usize = 0;

    for constexpr (args, 0..) |arg, i| {}
};
