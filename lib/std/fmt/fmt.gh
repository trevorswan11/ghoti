import std;

import "spec.gh" as spec;

pub const Spec = spec.Spec;
pub const pad = spec.pad;
pub const write_fill_n = spec.write_fill_n;
pub const pad_number = spec.pad_number;
pub const write_literal = spec.write_literal;

test {
    import "spec.gh";
}

pub import "int.gh" as int;

pub const digits2 = int.digits2;
pub const digit_to_char = int.digit_to_char;

test {
    import "int.gh";
}

pub import "float/float.gh" as float;

test {
    import "float/float.gh";
}

const Writer = std.io.Writer;
const Result = std.Result;

/// Every `std.io.Error`, so a failed write keeps its cause, and the failures of formatting itself
pub const Error = std.io.Error || enum { overflow, bad_spec, bad_arg, unsupported };

/// Implemented by types that format themselves inside a `{}`
pub const Format = interface {
    const format = fn(
        &self,
        spec: Spec,
        w: &mut dyn Writer,
    ): Result(void, Error);
};

pub const Case = enum : u1 { lower, upper };

/// Writes `fmt` to `w`, replacing each placeholder with its formatted argument.
/// The format string is checked against `args` at compile time
pub const format = fn(w: &mut impl Writer, comptime fmt: []u8, args...): Result(void, Error) {
    comptime spec.validate(fmt, args.len);

    let mut dyn_w: &mut dyn Writer = w;
    comptime let mut cursor: usize = 0;
    comptime let mut next_implicit: usize = 0;

    unroll while (cursor < fmt.len) {
        const lit_end = spec.next_placeholder(fmt, cursor);
        if comptime (lit_end > cursor) {
            write_literal(dyn_w, fmt[cursor..lit_end])?;
        }
        if comptime (lit_end == fmt.len) break;

        const parsed: spec.Placeholder = .parse(fmt, lit_end);
        const arg_idx = parsed.spec.arg_idx.unwrap_or(next_implicit);
        if comptime (parsed.spec.arg_idx == .none) {
            next_implicit += 1;
        }
        format_value(dyn_w, args[arg_idx], parsed.spec)?;
        cursor = parsed.next;
    }
    return .done;
};

/// Formats `fmt` into `buf`, returning the written prefix of `buf`.
/// Fails with `.no_space` if `buf` is too small
pub const buf_print = fn(buf: []mut u8, comptime fmt: []u8, args...): Result([]u8, Error) {
    let mut stream: std.io.FixedBufferStream = .{ .buf = buf };
    format(&mut stream, fmt, args...)?;
    return .of(buf[..stream.pos]);
};

/// What `alloc_print` fails with: a formatting failure, or no memory to hold the result
pub const AllocPrintError = Error || std.mem.AllocError;

/// Formats `fmt` into memory from `allocator`, measured by a first pass so it is exactly as long
/// as the output. The caller frees it with `allocator.free`
pub const alloc_print = fn(
    allocator: std.mem.Allocator,
    comptime fmt: []u8,
    args...,
): Result([]mut u8, AllocPrintError) {
    let mut counter: CountingWriter = .{};
    format(&mut counter, fmt, args...)?;
    let buf = allocator.alloc(u8, counter.count)?;
    match (buf_print(buf, fmt, args...)) {
        .ok => {},
        .err => |e| {
            allocator.free(buf);
            return .fail(e);
        },
    }
    return .of(buf);
};

/// Discards what it is given, keeping only how many bytes that was
const CountingWriter = struct {
    pub count: usize = 0,
};

impl Writer for CountingWriter {
    const Error = std.io.Error;
    pub const write = fn(&mut self, bytes: []u8): Result(usize, Error) {
        self.count += bytes.len;
        return .of(bytes.len);
    };
}

/// Formats one value according to `spec`, dispatching on its type.
/// Types that implement `Format` take precedence over the builtin formatting
pub const format_value = fn(w: &mut dyn Writer, value: auto, spec_: Spec): Result(void, Error) {
    const T = @TypeOf(value);
    if comptime (@implements(T, Format)) {
        return value.format(spec_, w);
    }

    return match comptime (@typeInfo(T)) {
        .int => int.format(w, value, spec_),
        // Through the narrowest integer type that holds it
        .comptime_int => int.format(
            w,
            @as(std.math.IntFittingRange(@min(value, 0), @max(value, 1)), value),
            spec_,
        ),
        .float, .comptime_float => float.format(w, value, spec_),
        .bool => format_str(w, if (value) "true" else "false", spec_),
        .enum => format_str(w, @tagName(value), spec_),
        .void => format_str(w, "void", spec_),
        .array => |info| if comptime (info.child == u8) format_text(w, value[..], spec_)
            else format_list(w, value[..], spec_),
        .slice => |info| if comptime (info.child == u8) format_text(w, value, spec_)
            else format_list(w, value, spec_),
        // `{:p}` is where the reference points, anything else what it points at
        .reference => if (has_kind(spec_, .p)) format_address(w, @intFromPtr(^*value), spec_)
            else format_value(w, *value, spec_),
        .pointer => format_address(w, @intFromPtr(value), spec_),
        .union => match comptime (union_shape(T)) {
            .option => format_option(w, value, spec_),
            .result => format_result(w, value, spec_),
            .other => @compileError("fmt: no formatter for " ++ @typeName(T)),
        },
        _ => @compileError("fmt: no formatter for " ++ @typeName(T)),
    };
};

/// Whether `spec_` names `kind` explicitly
const has_kind = fn(spec_: Spec, kind: spec.Kind): bool {
    return match (spec_.kind) {
        .some => |k| k == kind,
        .none => false,
    };
};

const UnionShape = enum { option, result, other };

/// Whether a union is an `Option` (`some`/`none`) or a `Result` (`ok`/`err`), by its tags
const union_shape = fn(comptime T: type): UnionShape {
    const fields = @typeInfo(T).union.fields;
    if comptime (fields.len != 2) return .other;
    if comptime (std.mem.eql(u8, fields[0].name, "some") and
        std.mem.eql(u8, fields[1].name, "none")) {
        return .option;
    }
    if comptime (std.mem.eql(u8, fields[0].name, "ok") and std.mem.eql(u8, fields[1].name, "err")) {
        return .result;
    }
    return .other;
};

/// Formats `.some` as `some(value)` and `.none` as `none`
const format_option = fn(w: &mut dyn Writer, value: auto, spec_: Spec): Result(void, Error) {
    return match (value) {
        .some => |inner| format_wrapped(w, "some(", inner, spec_),
        .none => format_str(w, "none", spec_),
    };
};

/// Formats `.ok` as `ok(value)` and `.err` as `err(error)`
const format_result = fn(w: &mut dyn Writer, value: auto, spec_: Spec): Result(void, Error) {
    return match (value) {
        .ok => |inner| format_wrapped(w, "ok(", inner, spec_),
        .err => |e| format_wrapped(w, "err(", e, spec_),
    };
};

const format_wrapped = fn(
    w: &mut dyn Writer,
    open: []u8,
    inner: auto,
    spec_: Spec,
): Result(void, Error) {
    w.write_all(open)?;
    format_value(w, inner, spec_)?;
    w.write_byte(')')?;
    return .done;
};

/// Formats a string. `{:?}` quotes it and escapes what isn't printable, as Rust's `Debug` does
const format_text = fn(w: &mut dyn Writer, text: []u8, spec_: Spec): Result(void, Error) {
    if (!has_kind(spec_, .@"?")) return format_str(w, text, spec_);

    let len = match (spec_.precision) {
        .some => |max| @min(max, text.len),
        .none => text.len,
    };
    let body = text[..len];
    let mut quoted_len: usize = 2;
    for (body) |c| {
        quoted_len += escaped_len(c);
    }
    let width = spec_.width.unwrap_or(0);
    let padding = if (width > quoted_len) width - quoted_len else 0;
    let left = match (spec_.align.unwrap_or(.left)) {
        .left => 0uz,
        .right => padding,
        .center => padding / 2,
    };

    write_fill_n(w, spec_.fill, left)?;
    w.write_byte('"')?;
    for (body) |c| {
        write_escaped(w, c)?;
    }
    w.write_byte('"')?;
    write_fill_n(w, spec_.fill, padding - left)?;
    return .done;
};

/// How many bytes `write_escaped` writes for `c`
const escaped_len = fn(c: u8): usize {
    return match (c) {
        '\n', '\r', '\t', '\\', '"' => 2,
        0..=0x1f, 0x7f => 4,
        _ => 1,
    };
};

/// Writes `c` as it reads inside a quoted string: a backslash escape, `\xNN`, or itself
const write_escaped = fn(w: &mut dyn Writer, c: u8): Result(void, Error) {
    match (c) {
        '\n' => w.write_all("\\n")?,
        '\r' => w.write_all("\\r")?,
        '\t' => w.write_all("\\t")?,
        '\\' => w.write_all("\\\\")?,
        '"' => w.write_all("\\\"")?,
        0..=0x1f, 0x7f => {
            w.write_all("\\x")?;
            w.write_byte(int.digit_to_char(c >> 4, .lower))?;
            w.write_byte(int.digit_to_char(c & 0xf, .lower))?;
        },
        _ => w.write_byte(c)?,
    }
    return .done;
};

/// Formats text, where a precision caps how many bytes are written
const format_str = fn(w: &mut dyn Writer, text: []u8, spec_: Spec): Result(void, Error) {
    match (spec_.kind.unwrap_or(.s)) {
        .s, .@"?" => {},
        _ => return .fail(.bad_spec),
    }
    let len = match (spec_.precision) {
        .some => |max| @min(max, text.len),
        .none => text.len,
    };
    return pad(w, spec_, text[..len], .left);
};

/// Formats an address as `0x` followed by lowercase hex digits
const format_address = fn(w: &mut dyn Writer, address: usize, spec_: Spec): Result(void, Error) {
    match (spec_.kind.unwrap_or(.p)) {
        .p, .x, .@"?" => {},
        _ => return .fail(.bad_spec),
    }
    let mut hex_spec = spec_;
    hex_spec.alt = true;
    hex_spec.kind = .of(.x);
    return int.format(w, address, hex_spec);
};

/// Formats each element with `spec_`, written as `[a, b, c]`
const format_list = fn(w: &mut dyn Writer, items: auto, spec_: Spec): Result(void, Error) {
    w.write_byte('[')?;
    for (items, 0..) |item, i| {
        if (i > 0) {
            w.write_all(", ")?;
        }
        format_value(w, item, spec_)?;
    }
    w.write_byte(']')?;
    return .done;
};

/// Formats with `format` into a scratch buffer and expects `expected`
@[testing] const check = fn(expected: []u8, comptime fmt: []u8, args...): void {
    let mut backing: [256]mut u8 = undefined;
    match (buf_print(backing[..], fmt, args...)) {
        .ok => |written| {
            if (!std.mem.eql(u8, expected, written)) {
                let mut err = std.io.stderr()!;
                format(&mut err, "expected '{}' but got '{}'\n", expected, written)!;
                @expect(false);
            }
        },
        .err => |e| {
            let mut err = std.io.stderr()!;
            format(&mut err, "expected '{}' but formatting failed with {}\n", expected, e)!;
            @expect(false, "format failed");
        },
    }
};

/// Formats with `format` and expects it to fail with `expected`
@[testing] const check_err = fn(expected: Error, comptime fmt: []u8, args...): void {
    let mut backing: [256]mut u8 = undefined;
    match (buf_print(backing[..], fmt, args...)) {
        .ok => {
            @expect(false, "format succeeded");
        },
        .err => |e| {
            @expect(e == expected);
        },
    }
};

test "format literals and escapes" {
    check("", "");
    check("no placeholders", "no placeholders");
    check("{}", "{{}}");
    check("a{b}c", "a{{b}}c");
    check("{7}", "{{{}}}", 7);
}

test "format integers" {
    check("42", "{}", 42);
    check("-42", "{}", -42);
    check("x = 7, y = -3", "x = {}, y = {}", 7u8, -3i64);
    check("0xff", "{:#x}", 255u32);
    check("99 1a9", "{:x} {:x}", 0x99u16, 0x1a9u16);
    check("   42|42   ", "{:5}|{:<5}", 42u16, 42u16);
    check("00042", "{:05}", 42);
    check("+5", "{:+}", 5i32);
    check("A", "{:c}", 65u8);
    check("12", "{}", 12uz);
    check(
        "340282366920938463463374607431768211455",
        "{}",
        @as(u128, 340282366920938463463374607431768211455),
    );
}

test "format keeps a comptime_int argument's full range" {
    check("340282366920938463463374607431768211455", "{}", 340282366920938463463374607431768211455);
    check("-9223372036854775809", "{}", -9223372036854775809);
    check("18446744073709551615 -2147483649", "{} {}", 18446744073709551615, -2147483649);
    check("0 1 ff", "{} {} {:x}", 0, 1, 255);
}

test "format_value keeps a comptime_int's full range" {
    let mut backing: [64]mut u8 = undefined;
    let mut stream: std.io.FixedBufferStream = .{ .buf = backing };
    @expect(format_value(&mut stream, 340282366920938463463374607431768211455, .{}) == .ok);
    @expect(format_value(&mut stream, -9223372036854775809, .{}) == .ok);
    @expect(std.mem.eql(
        u8,
        "340282366920938463463374607431768211455-9223372036854775809",
        backing[..stream.pos],
    ));
}

test "format floats" {
    check("1.5", "{}", 1.5);
    check("0.1", "{}", 0.1);
    check("3.14", "{:.2}", 3.14159f64);
    check("1.5e0", "{:e}", 1.5f32);
    check("  2.50", "{:6.2}", 2.5f64);
}

test "format text, bools, and enums" {
    const Color = enum { red, green };

    let s: []u8 = "hi";
    check("hi", "{}", s);
    check("lit", "{}", "lit");
    check("hi   |   hi", "{:<5}|{:>5}", s, s);
    check("he", "{:.2}", "hello");
    check("true false", "{} {}", true, false);
    check("green", "{}", Color.green);
    check("void", "{}", {});
}

test "format quotes and escapes text under {:?}" {
    check("\"hi\"", "{:?}", "hi");
    check("\"a\\nb\\t\\\"c\\\\\"", "{:?}", "a\nb\t\"c\\");
    check("\"\\x01\\x7f\"", "{:?}", "\x01\x7f");
    check("  \"ab\"", "{:>6?}", "ab");
    check("\"ab\"", "{:.2?}", "abc");
    // Words that aren't strings stay bare
    check("true green", "{:?} {:?}", true, Color2.green);
}

const Color2 = enum { red, green };

test "format options and results" {
    let some: std.Option(i32) = .of(5);
    let none: std.Option(i32) = .empty;
    let ok: std.Result(u8, Error) = .of(7);
    let err: std.Result(u8, Error) = .fail(.bad_spec);
    check("some(5) none", "{} {}", some, none);
    check("ok(7) err(bad_spec)", "{} {}", ok, err);
    check("some(0x5)", "{:#x}", some);
}

test "alloc_print allocates exactly the formatted output" {
    let allocator = std.heap.page_allocator;
    match (alloc_print(allocator, "{} + {} = {}", 2, 40, 42)) {
        .ok => |text| {
            defer allocator.free(text);
            @expect(std.mem.eql(u8, "2 + 40 = 42", text));
        },
        .err => {
            @expect(false, "alloc_print failed");
        },
    }
    // An allocation failure and a formatting failure are both `AllocPrintError`s
    let failure: AllocPrintError = .out_of_memory;
    let bad: AllocPrintError = Error.bad_spec;
    @expect(failure != bad);
}

test "format a reference's address with {:p}" {
    let n: u32 = 9;
    let r: &u32 = &n;
    let mut backing: [32]mut u8 = undefined;
    match (buf_print(backing[..], "{:p} {}", r, r)) {
        .ok => |written| {
            @expect(std.mem.eql(u8, "0x", written[..2]));
            @expect(written[written.len - 2] == ' ' and written[written.len - 1] == '9');
        },
        .err => {
            @expect(false, "format failed");
        },
    }
}

test "format arrays, slices, and references" {
    let nums = [_]i32{ 1, -2, 3 };
    check("[1, -2, 3]", "{}", nums);
    check("[1, -2, 3]", "{}", nums[..]);
    check("[0x1, 0xa]", "{:#x}", [_]u16{ 1, 10 }[..]);
    let n: u32 = 9;
    check("9", "{}", &n);

    let mut backing: [32]mut u8 = undefined;
    let p = ^n;
    match (buf_print(backing[..], "{:p}", p)) {
        .ok => |written| {
            @expect(written.len > 2 and std.mem.eql(u8, "0x", written[..2]));
        },
        .err => {
            @expect(false, "format failed");
        },
    }
}

test "format explicit and reused argument indices" {
    check("b a", "{1} {0}", "a", "b");
    check("x x", "{0} {0}", "x");
    check("1 2 1", "{} {} {0}", 1, 2);
    check("1 1 2", "{} {0} {}", 1, 2);
}

test "format reports runtime spec errors" {
    check_err(.bad_spec, "{:x}", true);
    check_err(.bad_spec, "{:d}", "text");
    check_err(.bad_arg, "{:c}", 300u16);
    let mut tiny: [2]mut u8 = undefined;
    @expect(buf_print(tiny[..], "{}", 12345) == .err);
}

@cfg (testing) {
    const Point = struct {
        pub x: i32,
        pub y: i32,
    };

    impl Format for Point {
        const format = fn(&self, spec_: Spec, w: &mut dyn Writer): Result(void, Error) {
            w.write_byte('(')?;
            format_value(w, self.x, spec_)?;
            w.write_all(", ")?;
            format_value(w, self.y, spec_)?;
            w.write_byte(')')?;
            return .done;
        };
    }
}

test "format a user type through Format" {
    let p: Point = .{ .x = 3, .y = -4 };
    check("(3, -4)", "{}", p);
    check("(+3, -4)", "{:+}", p);
    check("at (3, -4)!", "at {}!", p);
}
