import "../../result.gh" as result;
pub import "errno.gh" as errno;

pub using Handle = i32;
pub using Errno = errno::Errno;
pub constexpr EWOULDBLOCK := errno::EWOULDBLOCK;

// <sys/fcntl.h> and its transitive includes
pub const O_RDONLY: i32 = 0x0000; // open for reading only
pub const O_WRONLY: i32 = 0x0001; // open for writing only
pub const O_RDWR: i32 = 0x0002; // open for reading and writing
pub const O_ACCMODE: i32 = 0x0003; // mask for above modes
pub const O_NONBLOCK: i32 = 0x0004; // no delay
pub const O_APPEND: i32 = 0x0008; // set append mode
pub const O_CREAT: i32 = 0x0200; // create if nonexistant
pub const O_TRUNC: i32 = 0x0400; // truncate to zero length
pub const O_EXCL: i32 = 0x0800; // error if already exists
pub const O_CLOEXEC: i32 = 0x1000000; // implicitly set FD_CLOEXEC
pub const O_DIRECTORY: i32 = 0x100000;

pub const SEEK_SET: i32 = 0; // set file offset to offset
pub const SEEK_CUR: i32 = 1; // set file offset to current plus offset
pub const SEEK_END: i32 = 2; // set file offset to EOF plus offset

pub using mode_t = u16;
pub using dev_t = i32; // Device number
pub using nlink_t = u16; // Link count
pub using ino64_t = u64;
pub using uid_t = u32;
pub using gid_t = u32;
pub using time_t = i64;
pub using blkcnt_t = i64;
pub using blksize_t = i32;

// Reference: sys/stat.h
// This structure is used as the second parameter to the fstat64(),
// lstat64(), and stat64() functions, and for struct stat when
// __DARWIN_64_BIT_INO_T is set.
//
// This is simillar to stat except for 64bit inode number
// number instead of 32bit ino_t and the addition of create(birth) time.
pub const Stat := extern struct {
    pub st_dev: dev_t, // [XSI] ID of device containing file
    pub st_mode: mode_t, // [XSI] Mode of file
    pub st_nlink: nlink_t, // [XSI] Number of hard links
    pub st_ino: ino64_t, // [XSI] File serial number
    pub st_uid: uid_t, // [XSI] User ID of the file
    pub st_gid: gid_t, // [XSI] Group ID of the file
    pub st_rdev: dev_t, // [XSI] Device ID
    pub st_atime: time_t, // [XSI] Time of last access
    pub st_atimensec: i64, // nsec of last access
    pub st_mtime: time_t, // [XSI] Last data modification time
    pub st_mtimensec: i64, // last data modification nsec
    pub st_ctime: time_t, // [XSI] Time of last status change
    pub st_ctimensec: i64, // nsec of last status change
    pub st_birthtime: time_t, // File creation time (birth)
    pub st_birthtimensec: i64, // nsec of File creation time
    pub st_blocks: blkcnt_t, // [XSI] blocks allocated for file
    pub st_blksize: blksize_t, // [XSI] optimal blocksize for I/O
    pub st_flags: u32, // user defined flags for file
    pub st_gen: u32, // file generation number
    pub st_lspare: i32, // RESERVED: DO NOT USE!
    pub st_qspare: [2]i64, // RESERVED: DO NOT USE!
};

extern("System", "__error") const sys_errno_loc: fn(): ^mut i32;
extern("System", "read") const sys_read: fn(fd: Handle, buf: ^mut u8, count: usize): isize;
extern("System", "write") const sys_write: fn(fd: Handle, buf: ^u8, count: usize): isize;
extern("System", "close") const sys_close: fn(fd: Handle): i32;
extern("System", "open") const sys_open: fn(path: ^u8, flags: i32, ...): i32;
extern("System", "lseek") const sys_lseek: fn(fd: i32, offset: i64, whence: i32): i64;

extern("System", "fstat") const sys_fstat: fn(file_desc: Handle, stat: ^mut Stat): i32;
extern("System", "mkdir") const sys_mkdir: fn(path: ^u8, mode: mode_t): i32;
extern("System", "stat") const sys_stat: fn(path: ^u8, stat: ^mut Stat): i32;

pub const stdin: Handle = 0;
pub const stdout: Handle = 1;
pub const stderr: Handle = 2;

constexpr R := fn(T: type): type {
    return result::Result(T, Errno);
};

pub const write := fn(h: Handle, buf: []u8): R(usize) {
    const r := sys_write(h, buf.ptr, buf.len);
    return if (r < 0) .{ .err = @as(Errno, *sys_errno_loc()) } else .{ .ok = @as(usize, r) };
};

pub const read := fn(h: Handle, buf: []mut u8): R(usize) {
    const r := sys_read(h, buf.ptr, buf.len);
    return if (r < 0) .{ .err = @as(Errno, *sys_errno_loc()) } else .{ .ok = @as(usize, r) };
};

pub const open := fn(path: [:0]u8, flags: i32, mode: mode_t): R(Handle) {
    const fd := sys_open(path.ptr, flags, @as(i32, mode));
    return if (fd < 0) .{ .err = @as(Errno, *sys_errno_loc()) } else .{ .ok = fd };
};

pub const close := fn(h: Handle): R(void) {
    const r := sys_close(h);
    return if (r < 0) .{ .err = @as(Errno, *sys_errno_loc()) } else .{ .ok = {} };
};

pub const lseek := fn(h: Handle, off: i64, whence: i32): R(i64) {
    const r := sys_lseek(h, off, whence);
    return if (r < 0) .{ .err = @as(Errno, *sys_errno_loc()) } else .{ .ok = r };
};

pub const fstat := fn(file: Handle): R(Stat) {
    var s: Stat = undefined;
    const r := sys_fstat(file, ^mut s);
    return if (r < 0) .{ .err = @as(Errno, *sys_errno_loc()) } else .{ .ok = s };
};

pub const mkdir := fn(path: [:0]u8, mode: mode_t): R(void) {
    const r := sys_mkdir(path.ptr, mode);
    return if (r < 0) .{ .err = @as(Errno, *sys_errno_loc()) } else .{ .ok = {} };
};

pub const stat := fn(path: [:0]u8): R(Stat) {
    var s: Stat = undefined;
    const r := sys_stat(path.ptr, ^mut s);
    return if (r < 0) .{ .err = @as(Errno, *sys_errno_loc()) } else .{ .ok = s };
};
