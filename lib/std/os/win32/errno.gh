//! Win32 error codes as returned by `GetLastError()`.
//! - https://learn.microsoft.com/en-us/windows/win32/debug/system-error-codes
pub const Win32Error := enum : u32 {
    ERROR_SUCCESS = 0u32,
    ERROR_FILE_NOT_FOUND = 2u32,
    ERROR_PATH_NOT_FOUND = 3u32,
    ERROR_ACCESS_DENIED = 5u32,
    ERROR_INVALID_HANDLE = 6u32,
    ERROR_NOT_ENOUGH_MEMORY = 8u32,
    ERROR_INVALID_ACCESS = 12u32,
    ERROR_INVALID_DATA = 13u32,
    ERROR_OUTOFMEMORY = 14u32,
    ERROR_WRITE_PROTECT = 19u32,
    ERROR_NOT_READY = 21u32,
    ERROR_SHARING_VIOLATION = 32u32,
    ERROR_LOCK_VIOLATION = 33u32,
    ERROR_HANDLE_EOF = 38u32,
    ERROR_HANDLE_DISK_FULL = 39u32,
    ERROR_NOT_SUPPORTED = 50u32,
    ERROR_FILE_EXISTS = 80u32,
    ERROR_INVALID_PARAMETER = 87u32,
    ERROR_BROKEN_PIPE = 109u32,
    ERROR_DISK_FULL = 112u32,
    ERROR_CALL_NOT_IMPLEMENTED = 120u32,
    ERROR_INSUFFICIENT_BUFFER = 122u32,
    ERROR_INVALID_NAME = 123u32,
    ERROR_NEGATIVE_SEEK = 131u32,
    ERROR_DIR_NOT_EMPTY = 145u32,
    ERROR_ALREADY_EXISTS = 183u32,
    ERROR_FILENAME_EXCED_RANGE = 206u32,
    ERROR_NO_DATA = 232u32, // the pipe is being closed
    ERROR_DIRECTORY = 267u32, // "The directory name is invalid"
    ERROR_OPERATION_ABORTED = 995u32,
    ERROR_IO_INCOMPLETE = 996u32,
    ERROR_IO_PENDING = 997u32,
    ERROR_NO_UNICODE_TRANSLATION = 1113u32,
    _,
};
