//! Raw Linux primitives, implemented with direct `syscall` instructions
//! Supported architectures:
//! - `x86_64`
//! - `aarch64`
//! Everything else is a `@compileError`
import "../../result.gh" as result;
pub import "errno.gh" as errno;

pub using Handle = i32;
pub using Errno = errno::Errno;
pub using mode_t = u16; /// matches the darwin backend so `io/file.gh`'s mode literals coerce
pub constexpr EWOULDBLOCK := errno::EWOULDBLOCK;

// <asm-generic/fcntl.h> — note these values differ from Darwin's.
pub const O_RDONLY: i32 = 0o0; /// open for reading only
pub const O_WRONLY: i32 = 0o1; /// open for writing only
pub const O_RDWR: i32 = 0o2; /// open for reading and writing
pub const O_ACCMODE: i32 = 0o3; /// mask for the access modes above
pub const O_CREAT: i32 = 0o100; /// create the file if it does not exist
pub const O_EXCL: i32 = 0o200; /// with O_CREAT, fail if the file exists
pub const O_TRUNC: i32 = 0o1000; /// truncate to zero length
pub const O_APPEND: i32 = 0o2000; /// append on each write
pub const O_NONBLOCK: i32 = 0o4000; /// non-blocking mode
pub const O_DIRECTORY: i32 = 0o200000; /// fail if not a directory
pub const O_CLOEXEC: i32 = 0o2000000; /// set close-on-exec

pub const SEEK_SET: i32 = 0; /// set the file offset to `offset`
pub const SEEK_CUR: i32 = 1; /// set the file offset to current + `offset`
pub const SEEK_END: i32 = 2; /// set the file offset to EOF + `offset`

/// `openat`/`mkdirat`/... resolve a relative path against the cwd when the dirfd is `AT_FDCWD`.
pub const AT_FDCWD: usize = @as(usize, -100); // `(int)-100` reinterpreted as a register-wide unsigned

// <linux/fcntl.h> / <linux/stat.h> — flags and masks for the *at() / statx calls.
pub const AT_SYMLINK_NOFOLLOW: usize = 0x100uz; /// do not follow a trailing symlink
pub const AT_EMPTY_PATH: usize = 0x1000uz; /// operate on the dirfd itself (empty path)
pub const STATX_BASIC_STATS: usize = 0x7ffuz; /// the traditional stat(2) field set

const S_IFMT: u16 = 0o170000u16; /// file-type mask within `stx_mode`
const S_IFDIR: u16 = 0o040000u16; /// directory

@cfg (arch == .x86_64) {
    // <asm/unistd_64.h>
    const NR_read: usize = 0uz;
    const NR_write: usize = 1uz;
    const NR_close: usize = 3uz;
    const NR_lseek: usize = 8uz;
    const NR_openat: usize = 257uz;
    const NR_mkdirat: usize = 258uz;
    const NR_statx: usize = 332uz;

    // System V AMD64 syscall ABI: nr in rax; args in rdi, rsi, rdx, r10, r8, r9;
    // result in rax; the `syscall` instruction clobbers rcx and r11.
    const syscall0 := fn(nr: usize): usize {
        return asm usize {
            template: "syscall",
            outputs: ("={rax}" = _),
            inputs: ("{rax}" = nr),
            clobbers: ("rcx", "r11", "memory"),
            options: (volatile),
        };
    };

    const syscall1 := fn(nr: usize, a1: usize): usize {
        return asm usize {
            template: "syscall",
            outputs: ("={rax}" = _),
            inputs: ("{rax}" = nr, "{rdi}" = a1),
            clobbers: ("rcx", "r11", "memory"),
            options: (volatile),
        };
    };

    const syscall2 := fn(nr: usize, a1: usize, a2: usize): usize {
        return asm usize {
            template: "syscall",
            outputs: ("={rax}" = _),
            inputs: ("{rax}" = nr, "{rdi}" = a1, "{rsi}" = a2),
            clobbers: ("rcx", "r11", "memory"),
            options: (volatile),
        };
    };

    const syscall3 := fn(nr: usize, a1: usize, a2: usize, a3: usize): usize {
        return asm usize {
            template: "syscall",
            outputs: ("={rax}" = _),
            inputs: ("{rax}" = nr, "{rdi}" = a1, "{rsi}" = a2, "{rdx}" = a3),
            clobbers: ("rcx", "r11", "memory"),
            options: (volatile),
        };
    };

    const syscall4 := fn(nr: usize, a1: usize, a2: usize, a3: usize, a4: usize): usize {
        return asm usize {
            template: "syscall",
            outputs: ("={rax}" = _),
            inputs: ("{rax}" = nr, "{rdi}" = a1, "{rsi}" = a2, "{rdx}" = a3, "{r10}" = a4),
            clobbers: ("rcx", "r11", "memory"),
            options: (volatile),
        };
    };

    const syscall5 := fn(nr: usize, a1: usize, a2: usize, a3: usize, a4: usize, a5: usize): usize {
        return asm usize {
            template: "syscall",
            outputs: (
                "={rax}" = _,
            ),
            inputs: (
                "{rax}" = nr,
                "{rdi}" = a1,
                "{rsi}" = a2,
                "{rdx}" = a3,
                "{r10}" = a4,
                "{r8}" = a5,
            ),
            clobbers: (
                "rcx",
                "r11",
                "memory",
            ),
            options: (
                volatile,
            ),
        };
    };

    const syscall6 := fn(
        nr: usize,
        a1: usize,
        a2: usize,
        a3: usize,
        a4: usize,
        a5: usize,
        a6: usize,
    ): usize {
        return asm usize {
            template: "syscall",
            outputs: (
                "={rax}" = _,
            ),
            inputs: (
                "{rax}" = nr,
                "{rdi}" = a1,
                "{rsi}" = a2,
                "{rdx}" = a3,
                "{r10}" = a4,
                "{r8}" = a5,
                "{r9}" = a6,
            ),
            clobbers: (
                "rcx",
                "r11",
                "memory",
            ),
            options: (
                volatile,
            ),
        };
    };
} else @cfg (arch == .aarch64) {
    // <asm-generic/unistd.h>
    const NR_read: usize = 63uz;
    const NR_write: usize = 64uz;
    const NR_close: usize = 57uz;
    const NR_lseek: usize = 62uz;
    const NR_openat: usize = 56uz;
    const NR_mkdirat: usize = 34uz;
    const NR_statx: usize = 291uz;

    // AArch64 Linux syscall ABI: nr in x8; args in x0..x5; result in x0.
    // `svc #0` clobbers no general registers beyond x0's result.
    const syscall0 := fn(nr: usize): usize {
        return asm usize {
            template: "svc #0",
            outputs: ("={x0}" = _),
            inputs: ("{x8}" = nr),
            clobbers: ("memory"),
            options: (volatile),
        };
    };

    const syscall1 := fn(nr: usize, a1: usize): usize {
        return asm usize {
            template: "svc #0",
            outputs: ("={x0}" = _),
            inputs: ("{x8}" = nr, "{x0}" = a1),
            clobbers: ("memory"),
            options: (volatile),
        };
    };

    const syscall2 := fn(nr: usize, a1: usize, a2: usize): usize {
        return asm usize {
            template: "svc #0",
            outputs: ("={x0}" = _),
            inputs: ("{x8}" = nr, "{x0}" = a1, "{x1}" = a2),
            clobbers: ("memory"),
            options: (volatile),
        };
    };

    const syscall3 := fn(nr: usize, a1: usize, a2: usize, a3: usize): usize {
        return asm usize {
            template: "svc #0",
            outputs: ("={x0}" = _),
            inputs: ("{x8}" = nr, "{x0}" = a1, "{x1}" = a2, "{x2}" = a3),
            clobbers: ("memory"),
            options: (volatile),
        };
    };

    const syscall4 := fn(nr: usize, a1: usize, a2: usize, a3: usize, a4: usize): usize {
        return asm usize {
            template: "svc #0",
            outputs: ("={x0}" = _),
            inputs: ("{x8}" = nr, "{x0}" = a1, "{x1}" = a2, "{x2}" = a3, "{x3}" = a4),
            clobbers: ("memory"),
            options: (volatile),
        };
    };

    const syscall5 := fn(nr: usize, a1: usize, a2: usize, a3: usize, a4: usize, a5: usize): usize {
        return asm usize {
            template: "svc #0",
            outputs: ("={x0}" = _),
            inputs: ("{x8}" = nr, "{x0}" = a1, "{x1}" = a2, "{x2}" = a3, "{x3}" = a4, "{x4}" = a5),
            clobbers: ("memory"),
            options: (volatile),
        };
    };

    const syscall6 := fn(
        nr: usize,
        a1: usize,
        a2: usize,
        a3: usize,
        a4: usize,
        a5: usize,
        a6: usize,
    ): usize {
        return asm usize {
            template: "svc #0",
            outputs: (
                "={x0}" = _,
            ),
            inputs: (
                "{x8}" = nr,
                "{x0}" = a1,
                "{x1}" = a2,
                "{x2}" = a3,
                "{x3}" = a4,
                "{x4}" = a5,
                "{x5}" = a6,
            ),
            clobbers: (
                "memory",
            ),
            options: (
                volatile,
            ),
        };
    };
} else {
    @compileError("std::os: unsupported Linux architecture (only x86_64 and aarch64)");
}

/// A raw return in `-4095..=-1` is `-errno`; every other value is success.
const failed := fn(ret: usize): bool {
    const s := @as(isize, ret);
    return s < 0 and s >= -4095;
};

/// Negate a failed raw return into its `Errno`.
const to_errno := fn(ret: usize): Errno {
    return @as(Errno, @as(i32, -@as(isize, ret)));
};

constexpr R := fn(T: type): type {
    return result::Result(T, Errno);
};

/// One timestamp field of `struct statx` (`struct statx_timestamp`).
pub const StatxTimestamp := extern struct {
    pub tv_sec: i64, /// seconds since the Unix epoch
    pub tv_nsec: u32, /// nanoseconds within the second
    __reserved: i32,
};

/// The arch-independent metadata block filled by the `statx(2)` syscall (Linux 4.11+)
pub const Statx := extern struct {
    pub stx_mask: u32, /// which fields the kernel actually filled (STATX_* bits)
    pub stx_blksize: u32, /// preferred I/O block size
    pub stx_attributes: u64, /// extra attribute flags (STATX_ATTR_*)
    pub stx_nlink: u32, /// hard link count
    pub stx_uid: u32, /// owning user id
    pub stx_gid: u32, /// owning group id
    pub stx_mode: u16, /// file type (S_IFMT bits) + permission bits
    __spare0: u16,
    pub stx_ino: u64, /// inode number
    pub stx_size: u64, /// size in bytes
    pub stx_blocks: u64, /// number of 512-byte blocks allocated
    pub stx_attributes_mask: u64, /// which `stx_attributes` bits are supported
    pub stx_atime: StatxTimestamp, /// last access
    pub stx_btime: StatxTimestamp, /// creation (birth)
    pub stx_ctime: StatxTimestamp, /// last status change
    pub stx_mtime: StatxTimestamp, /// last modification
    pub stx_rdev_major: u32, /// device id (for a device special file) — major
    pub stx_rdev_minor: u32, /// ... minor
    pub stx_dev_major: u32, /// id of the device containing the file — major
    pub stx_dev_minor: u32, /// ... minor
    pub stx_mnt_id: u64, /// mount id (Linux 5.8+)
    pub stx_dio_mem_align: u32, /// memory alignment for direct I/O (Linux 6.1+)
    pub stx_dio_offset_align: u32, /// file-offset alignment for direct I/O
    __spare3: [12]u64,

    /// File size in bytes.
    pub const size := fn(&self): u64 {
        return self.stx_size;
    };

    /// Whether the entry is a directory.
    pub const is_dir := fn(&self): bool {
        return (self.stx_mode & S_IFMT) == S_IFDIR;
    };

    /// Last-modification time in nanoseconds since the Unix epoch.
    pub const modified_time_ns := fn(&self): u64 {
        return @as(u64, self.stx_mtime.tv_sec) * 1000000000u64 + @as(u64, self.stx_mtime.tv_nsec);
    };
};

pub using Stat = Statx;

pub constexpr stdin := fn(): R(Handle) {
    return .{ .ok = 0 };
};

pub constexpr stdout := fn(): R(Handle) {
    return .{ .ok = 1 };
};

pub constexpr stderr := fn(): R(Handle) {
    return .{ .ok = 2 };
};

/// Write the contents of `buf` to the file, returning the number of written bytes
pub const write := fn(h: Handle, buf: []u8): R(usize) {
    const ret := syscall3(NR_write, @as(usize, h), @intFromPtr(buf.ptr), buf.len);
    return if (failed(ret)) .{ .err = to_errno(ret) } else .{ .ok = @as(usize, ret) };
};

/// Read the contents of the file into `buf`, returning the number of read bytes
pub const read := fn(h: Handle, buf: []mut u8): R(usize) {
    const ret := syscall3(NR_read, @as(usize, h), @intFromPtr(buf.ptr), buf.len);
    return if (failed(ret)) .{ .err = to_errno(ret) } else .{ .ok = @as(usize, ret) };
};

/// Open the file at the provided path with the desired flags and mode.
pub const open := fn(path: [:0]u8, flags: i32, mode: mode_t): R(Handle) {
    const ret := syscall4(
        NR_openat,
        AT_FDCWD,
        @intFromPtr(path.ptr),
        @as(usize, flags),
        @as(usize, mode),
    );
    return if (failed(ret)) .{ .err = to_errno(ret) } else .{ .ok = @as(Handle, @as(isize, ret)) };
};

/// Close the file associated with the given handle
pub const close := fn(h: Handle): R(void) {
    const ret := syscall1(NR_close, @as(usize, h));
    return if (failed(ret)) .{ .err = to_errno(ret) } else .{ .ok = {} };
};

/// Reposition a read/write file to offset `off` where:
/// - If `whence` is `SEEK_SET`, the offset is set to `off` bytes.
/// - If `whence` is `SEEK_CUR`, the offset is set to its current location plus `off` bytes.
/// - If `whence` is `SEEK_END`, the offset is set to the size of the file plus `off` bytes.
pub const lseek := fn(h: Handle, off: i64, whence: i32): R(i64) {
    const ret := syscall3(NR_lseek, @as(usize, h), @as(usize, off), @as(usize, whence));
    return if (failed(ret)) .{ .err = to_errno(ret) } else .{ .ok = @as(i64, @as(isize, ret)) };
};

/// Fill `out` from a `statx` call. `dirfd`/`path`/`flags` select the target:
/// `stat` passes `AT_FDCWD` + a real path, `fstat` passes the handle + an empty
/// path + `AT_EMPTY_PATH`.
const statx_into := fn(dirfd: usize, path: [:0]u8, flags: usize, out: ^mut Statx): R(void) {
    const ret := syscall5(
        NR_statx,
        dirfd,
        @intFromPtr(path.ptr),
        flags,
        STATX_BASIC_STATS,
        @intFromPtr(out),
    );
    return if (failed(ret)) .{ .err = to_errno(ret) } else .{ .ok = {} };
};

/// Metadata for the file or directory at `path` (follows symlinks).
pub const stat := fn(path: [:0]u8): R(Stat) {
    var s: Statx = undefined;
    return match (statx_into(AT_FDCWD, path, 0uz, ^mut s)) {
        .ok => .{ .ok = s },
        .err => |e| .{ .err = e },
    };
};

/// Metadata for an already-open file or directory handle.
pub const fstat := fn(h: Handle): R(Stat) {
    var s: Statx = undefined;
    const empty: [:0]u8 = "";
    return match (statx_into(@as(usize, h), empty, AT_EMPTY_PATH, ^mut s)) {
        .ok => .{ .ok = s },
        .err => |e| .{ .err = e },
    };
};

/// Create a directory at the provided path.
/// - Fails with `EEXIST` when the directory already exists
/// - Fails with `ENOENT` when a parent is missing
pub const mkdir := fn(path: [:0]u8, mode: mode_t): R(void) {
    const ret := syscall3(NR_mkdirat, AT_FDCWD, @intFromPtr(path.ptr), @as(usize, mode));
    return if (failed(ret)) .{ .err = to_errno(ret) } else .{ .ok = {} };
};
