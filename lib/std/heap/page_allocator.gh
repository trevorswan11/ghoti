import std;

/// A horribly inefficient allocator that allocates full OS pages at a time
pub const PageAllocator = struct {};

impl std.mem.AllocatorVTable for PageAllocator {
    pub const alloc = fn(
        &mut self,
        len: usize,
        alignment: std.mem.Alignment,
    ): std.Option(^mut u8) {
        let ps = std.os.page_size();
        @assert(
            1uz << @as(usize, @backingInt(alignment)) <= ps,
            "PageAllocator: alignment above the page size is not supported",
        );
        if (len > std.math.max_int(usize) - ps) {
            return .empty;
        }
        return match (std.os.alloc(len)) {
            .ok => |p| .of(p),
            .err => .empty,
        };
    };

    pub const resize = fn(
        &mut self,
        memory: []mut u8,
        alignment: std.mem.Alignment,
        new_len: usize,
    ): bool {
        let ps = std.os.page_size();
        if (new_len > std.math.max_int(usize) - ps) {
            return false;
        }
        return std.mem.round_up_page(new_len) <= std.mem.round_up_page(memory.len);
    };

    pub const remap = fn(
        &mut self,
        memory: []mut u8,
        alignment: std.mem.Alignment,
        new_len: usize,
    ): std.Option(^mut u8) {
        if (self.resize(memory, alignment, new_len)) {
            return .of(memory.ptr);
        }
        return .empty;
    };

    pub const free = fn(
        &mut self,
        memory: []mut u8,
        _: std.mem.Alignment,
    ): void {
        if (memory.len == 0uz) return;
        if (std.os.free(memory.ptr, memory.len) == .err) {
            @panic("PageAllocator.free: munmap/VirtualFree failed");
        }
    };
}

test "PageAllocator: allocator test framework happy paths" {
    std.heap.test_allocator(std.heap.page_allocator);
}

test "PageAllocator: allocator test framework sad paths" {
    std.heap.test_allocator_errors(std.heap.page_allocator);
}
