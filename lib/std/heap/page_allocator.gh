import std;

/// A horribly inefficient allocator that allocates full OS pages at a time
pub const PageAllocator := struct {};

impl std.mem.AllocatorVTable for PageAllocator {
    pub const alloc := fn(
        &mut self,
        len: usize,
        alignment: std.mem.Alignment,
    ): std.Option(^mut u8) {
        @assert(
            @as(usize, alignment) <= std.os.page_size(),
            "PageAllocator: alignment above the page size is not supported",
        );
        return match (std.os.alloc(len)) {
            .ok => |p| .{ .some = p },
            .err => .{ .none = {} },
        };
    };
    pub const resize := fn(
        &mut self,
        memory: []mut u8,
        alignment: std.mem.Alignment,
        new_len: usize,
    ): bool {
        return std.mem.roundUpPage(new_len) <= std.mem.roundUpPage(memory.len);
    };
    pub const remap := fn(
        &mut self,
        memory: []mut u8,
        alignment: std.mem.Alignment,
        new_len: usize,
    ): std.Option(^mut u8) {
        if (self.resize(memory, alignment, new_len)) {
            return .{ .some = memory.ptr };
        }
        return .{ .none = {} };
    };
    pub const free := fn(
        &mut self,
        memory: []mut u8,
        _: std.mem.Alignment,
    ): void {
        if (std.os.free(memory.ptr, memory.len) == .err) {
            @panic("PageAllocator.free: munmap/VirtualFree failed");
        }
    };
}

test "PageAllocator: alloc/write/free round-trips through the global singleton" {
    match (std.heap.page_allocator().alloc(u8, 64uz)) {
        .ok => |buf| {
            @expect(buf.len == 64uz);
            buf[0] = 42u8;
            buf[63] = 7u8;
            @expect(buf[0] == 42u8);
            @expect(buf[63] == 7u8);
            std.heap.page_allocator().free(u8, buf);
        },
        .err => { @panic("PageAllocator.alloc failed"); },
    }
}

test "PageAllocator: a local instance also works, not just the global singleton" {
    var local: PageAllocator = .{};
    const a := std.mem.Allocator{ .vtable = ^mut local };
    match (a.alloc(u8, std.os.page_size() * 2uz)) {
        .ok => |buf| {
            buf[0] = 1u8;
            a.free(u8, buf);
        },
        .err => { @panic("PageAllocator.alloc failed"); },
    }
}
