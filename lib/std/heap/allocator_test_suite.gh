import std;

const Allocator = std.mem.Allocator;
const max_int = std.math.max_int;

/// Test framework for testing standard allocator happy paths.
/// Verifies standard allocator operations: alloc, free, create, destroy,
/// realloc (grow/shrink), resize, remap, dupe, and dupeZ.
@[testing] pub const test_allocator = fn(allocator: Allocator): void {
    // 1. Basic array alloc, write, read-back, and free
    match (allocator.alloc(i32, 20uz)) {
        .ok => |buf| {
            defer allocator.free(buf);
            @expect(buf.len == 20uz);
            for (buf, 0..) |&mut v, i| {
                v = @intCast(i32, (i + 1) * 10);
            }
            for (buf, 0..) |v, i| {
                @expect(v == @intCast(i32, (i + 1) * 10));
            }
        },
        .err => @expect(false, "alloc(i32, 20) failed"),
    }

    // 2. Single item create, write, read-back, and destroy
    const Item = struct {
        x: u64,
        y: u32,
        z: u16,
    };

    match (allocator.create(Item)) {
        .ok => |p| {
            defer allocator.destroy(p);
            p.x = 0x1122334455667788u64;
            p.y = 0x88776655u32;
            p.z = 0x4321u16;
            @expect(p.x == 0x1122334455667788u64);
            @expect(p.y == 0x88776655u32);
            @expect(p.z == 0x4321u16);
        },
        .err => @expect(false, "create(Item) failed"),
    }

    // 3. Realloc: grow, preserve contents, initialize new region
    match (allocator.alloc(u64, 16uz)) {
        .ok => |initial| {
            for (initial, 0..) |&mut v, i| {
                v = @intCast(u64, i + 100);
            }

            match (allocator.realloc(initial, 64uz)) {
                .ok => |grown| {
                    @expect(grown.len == 64uz);
                    // Check preserved data
                    for (0..16uz) |i| {
                        @expect(grown[i] == @intCast(u64, i + 100));
                    }
                    // Write to grown region
                    for (16uz..64uz) |i| {
                        grown[i] = @intCast(u64, i + 200);
                    }
                    for (16uz..64uz) |i| {
                        @expect(grown[i] == @intCast(u64, i + 200));
                    }

                    // 4. Realloc: shrink and preserve remaining contents
                    match (allocator.realloc(grown, 8uz)) {
                        .ok => |shrunk| {
                            @expect(shrunk.len == 8uz);
                            for (0..8uz) |i| {
                                @expect(shrunk[i] == @intCast(u64, i + 100));
                            }

                            // 5. Realloc: down to zero frees allocation
                            match (allocator.realloc(shrunk, 0uz)) {
                                .ok => |empty| {
                                    @expect(empty.len == 0uz);
                                },
                                .err => @expect(false, "realloc to 0 failed"),
                            }
                        },
                        .err => @expect(false, "realloc shrink failed"),
                    }
                },
                .err => @expect(false, "realloc grow failed"),
            }
        },
        .err => @expect(false, "initial alloc failed"),
    }

    // 6. Realloc from empty allocation
    let empty_slice: []mut u16 = @sliceFromPtr(@ptrFromInt(^mut u16, 2uz), 0uz);
    match (allocator.realloc(empty_slice, 10uz)) {
        .ok => |fresh| {
            @expect(fresh.len == 10uz);
            fresh[0] = 777u16;
            fresh[9] = 999u16;
            @expect(fresh[0] == 777u16 and fresh[9] == 999u16);
            allocator.free(fresh);
        },
        .err => @expect(false, "realloc from empty failed"),
    }

    // 7. Resize in-place
    match (allocator.alloc(u8, 64uz)) {
        .ok => |mem| {
            // Resize to 0 always succeeds and frees
            @expect(allocator.resize(mem, 0uz));
        },
        .err => @expect(false, "alloc for resize failed"),
    }

    // 8. Dupe slice
    let original = [5uz]mut i32{ 10, 20, 30, 40, 50 };
    match (allocator.dupe(i32, original)) {
        .ok => |dup| {
            defer allocator.free(dup);
            @expect(dup.len == 5uz);
            @expect(dup.ptr != ^mut original[0uz]);
            for (dup, 0..) |v, i| {
                @expect(v == original[i]);
            }
        },
        .err => @expect(false, "dupe failed"),
    }

    // 9. DupeZ null-terminated slice
    let text: []u8 = "ghoti-allocator";
    match (allocator.dupeZ(u8, text)) {
        .ok => |z| {
            defer allocator.free(z);
            @expect(z.len == text.len);
            for (z, 0..) |c, i| {
                @expect(c == text[i]);
            }
            @expect(z.ptr[text.len] == 0u8);
        },
        .err => @expect(false, "dupeZ failed"),
    }

    // 10. Free empty slice is a no-op
    let no_op_empty: []mut u8 = @sliceFromPtr(@ptrFromInt(^mut u8, 1uz), 0uz);
    allocator.free(no_op_empty);
};

/// Test framework for testing standard allocator error conditions.
/// Verifies that OOM, overflow, and invalid operations fail gracefully and
/// leave existing allocations intact without data corruption.
@[testing] pub const test_allocator_errors = fn(allocator: Allocator): void {
    // 1. Extreme length allocation triggers OutOfMemory
    match (allocator.alloc(u8, max_int(usize))) {
        .ok => @expect(false, "alloc(max_int(usize)) should fail"),
        .err => |e| @expect(e == .out_of_memory),
    }

    // 2. Element size multiplication overflow triggers OutOfMemory
    let overflow_count = (max_int(usize) / 4uz) + 100uz;
    match (allocator.alloc(u32, overflow_count)) {
        .ok => @expect(false, "alloc with multiply overflow should fail"),
        .err => |e| @expect(e == .out_of_memory),
    }

    let overflow_count64 = (max_int(usize) / 8uz) + 100uz;
    match (allocator.alloc(u64, overflow_count64)) {
        .ok => @expect(false, "alloc with u64 multiply overflow should fail"),
        .err => |e| @expect(e == .out_of_memory),
    }

    // 3. Realloc with extreme length fails with OutOfMemory AND preserves original allocation
    match (allocator.alloc(u32, 8uz)) {
        .ok => |orig| {
            defer allocator.free(orig);
            for (orig, 0..) |&mut v, i| {
                v = @intCast(u32, i + 55);
            }

            match (allocator.realloc(orig, max_int(usize))) {
                .ok => @expect(false, "realloc(max_int(usize)) should fail"),
                .err => |e| {
                    @expect(e == .out_of_memory);
                    @expect(orig.len == 8uz); // Must preserve mem on failure
                    for (orig, 0..) |v, i| {
                        @expect(v == @intCast(u32, i + 55));
                    }
                },
            }
        },
        .err => @expect(false, "initial alloc failed"),
    }

    // 4. Realloc with multiplication overflow fails with OOM AND preserves original allocation
    match (allocator.alloc(u64, 4uz)) {
        .ok => |orig| {
            defer allocator.free(orig);
            orig[0] = 111u64;
            orig[1] = 222u64;
            orig[2] = 333u64;
            orig[3] = 444u64;

            match (allocator.realloc(orig, overflow_count64)) {
                .ok => @expect(false, "realloc multiply overflow should fail"),
                .err => |e| {
                    @expect(e == .out_of_memory);
                    @expect(
                        orig[0] == 111u64 and orig[1] == 222u64 and orig[2] == 333u64 and
                            orig[3] == 444u64,
                    );
                },
            }
        },
        .err => @expect(false, "initial alloc failed"),
    }

    // 5. Resize on empty allocation (new_len > 0) returns false
    let empty_buf: []mut u8 = @sliceFromPtr(@ptrFromInt(^mut u8, 1uz), 0uz);
    @expect(!allocator.resize(empty_buf, 10uz));

    // 6. Resize with extreme length returns false
    match (allocator.alloc(u8, 16uz)) {
        .ok => |buf| {
            defer allocator.free(buf);
            @expect(!allocator.resize(buf, max_int(usize)));
        },
        .err => @expect(false, "alloc failed"),
    }

    // 7. Remap on empty allocation returns .none
    match (allocator.remap(empty_buf, 10uz)) {
        .some => @expect(false, "remap on empty should be none"),
        .none => {},
    }

    // 8. Remap with extreme length returns .none
    match (allocator.alloc(u8, 16uz)) {
        .ok => |buf| {
            defer allocator.free(buf);
            match (allocator.remap(buf, max_int(usize))) {
                .some => @expect(false, "remap with extreme length should be none"),
                .none => {},
            }
        },
        .err => @expect(false, "alloc failed"),
    }

    // 9. dupeZ with slice of max_int(usize) length overflows len + 1
    let fake_huge_slice: []u8 = @sliceFromPtr(@ptrFromInt(^u8, 1uz), max_int(usize));
    match (allocator.dupeZ(u8, fake_huge_slice)) {
        .ok => @expect(false, "dupeZ with huge length should fail"),
        .err => |e| @expect(e == .out_of_memory),
    }
};
