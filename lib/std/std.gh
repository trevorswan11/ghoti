pub const version = "0.4.0-alpha.2";

import "types/result.gh" as result;
import "types/option.gh" as option;

pub const Result = result.Result;
pub const Option = option.Option;

pub import "os/os.gh" as os;
pub import "io/io.gh" as io;
pub import "testing/testing.gh" as testing;
pub import "mem/mem.gh" as mem;
pub import "heap/heap.gh" as heap;
pub import "fmt/fmt.gh" as fmt;
pub import "math/math.gh" as math;
pub import "meta/meta.gh" as meta;

test {
    import "os/os.gh";
    import "io/io.gh";
    import "mem/mem.gh";
    import "heap/heap.gh";
    import "fmt/fmt.gh";
    import "math/math.gh";
    import "meta/meta.gh";
    import "types/result.gh";
    import "types/option.gh";
}

// Whether std has an OS backend for the target (the same test as `std.os.HAS_BACKEND`)
const HAS_OS = @cfgValue(os == .macos or os == .windows or
    (os == .linux and (arch == .x86_64 or arch == .aarch64)));

@cfg (HAS_OS) {
    pub const panic_handler = fn(msg: []u8, loc: builtin.SourceLocation): noreturn {
        _ = io.eprint(loc.file);
        _ = io.eprint(": ");
        _ = io.eprintln(msg);
        @trap();
    };

    pub const assert_handler = fn(msg: []u8, loc: builtin.SourceLocation): void {
        _ = io.eprint(loc.file);
        _ = io.eprint(": ");
        _ = io.eprintln(msg);
        @trap();
    };
}
