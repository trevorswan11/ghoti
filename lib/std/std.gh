pub const panic_handler := fn(msg: []u8, file: []u8, _: u32, _: u32): noreturn {
    _ = io.eprint(file);
    _ = io.eprint(": ");
    _ = io.eprintln(msg);
    @trap();
};

pub const assert_handler := fn(msg: []u8, file: []u8, _: u32, _: u32): void {
    _ = io.eprint(file);
    _ = io.eprint(": ");
    _ = io.eprintln(msg);
    @trap();
};
