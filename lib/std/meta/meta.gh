import std;

/// The return type of a callable type: a function, a closure, or an erased `fn`, directly or
/// through a `^` / `&`
pub const return_type = fn(T: type): type {
    const info = @typeInfo(T);
    if comptime (info == .pointer) {
        return return_type(info.pointer.child);
    }
    if comptime (info == .reference) {
        return return_type(info.reference.child);
    }
    @assert(info == .function, "return_type expects a callable type");
    return info.function.return_type;
};

test "Return type of global functions" {
    @expect(return_type(@TypeOf(return_type)) == type);
    @expect(return_type(@TypeOf(std.panic_handler)) == noreturn);
    @expect(return_type(@TypeOf(std.assert_handler)) == void);
}

test "Return type of local functions" {
    let func = fn(): bool {
        return true;
    };
    @expect(return_type(@TypeOf(func)) == bool);

    let mut a = 2;
    let closure = fn(): f32 {
        a += 1;
        return 1.0f32;
    };
    @expect(return_type(@TypeOf(closure)) == f32);
}

test "Return type of function types" {
    @expect(return_type(fn(x: i32): u8) == u8);
    @expect(return_type(extern fn(x: i32): i64) == i64);
    @expect(return_type(^fn(): []u8) == []u8);
    @expect(return_type(&fn(): void) == void);
}

test "Return type through erased values and pointers" {
    const twice = fn(x: i32): i32 {
        return x * 2;
    };
    let erased: fn(x: i32): i32 = twice;
    @expect(return_type(@TypeOf(erased)) == i32);
    @expect(return_type(@TypeOf(^twice)) == i32);
}

test "Return type of methods and aggregate results" {
    const Point = struct {
        x: i32,
        y: i32,

        pub const of = fn(px: i32, py: i32): @This() {
            return .{ .x = px, .y = py };
        };
        pub const sum = fn(&self): i64 {
            return @as(i64, self.x) + @as(i64, self.y);
        };
    };
    @expect(return_type(@TypeOf(Point.of)) == Point);
    @expect(return_type(@TypeOf(Point.sum)) == i64);

    const parse = fn(s: []u8): std.Result(u32, bool) {
        return .of(@intCast(s.len));
    };
    @expect(return_type(@TypeOf(parse)) == std.Result(u32, bool));
}

test "Return type names a dependent return type" {
    const apply = fn(f: auto): return_type(@TypeOf(f)) {
        return f();
    };
    const seven = fn(): u16 {
        return 7;
    };
    let got = apply(seven);
    @expect(@TypeOf(got) == u16);
    @expect(got == 7);
}

test "Return type folds at compile time" {
    comptime {
        @assert(return_type(fn(): bool) == bool);
    }
}
