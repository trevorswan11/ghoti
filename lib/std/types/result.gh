import std;

pub constexpr Result := fn(T: type, E: type): type {
    return union {
        ok: T,
        err: E,

        pub constexpr map := fn(&self, func: auto): auto {
            constexpr fn_info := @typeInfo(@typeOf(func));
            @assert(fn_info == .function, "map requires a function argument");
            const NewOk := fn_info.function.return_type;
            using NewRes = Result(NewOk, E);

            return match (self) {
                .ok => |happy| NewRes{ .ok = func(happy) },
                .err => |sad| NewRes{ .err = sad },
            };
        };

        pub constexpr map_err := fn(&self, func: auto): auto {
            constexpr fn_info := @typeInfo(@typeOf(func));
            @assert(fn_info == .function, "map_err requires a function argument");
            const NewErr := fn_info.function.return_type;
            using NewRes = Result(T, NewErr);

            return match (self) {
                .ok => |happy| NewRes{ .ok = happy },
                .err => |sad| NewRes{ .err = func(sad) },
            };
        };
    };
};

test "Result.map transforms ok variant" {
    const a: Result(i32, bool) = .{ .ok = 1 };
    const mapped := a.map(fn(val: i32): []u8 {
        return "Hello, World!";
    });

    @expect(match (mapped) {
        .ok => |o| std.mem.eql(u8, o, "Hello, World!"),
        .err => false,
    });
}

test "Result.map_err transforms error variant" {
    const a: Result(void, i32) = .{ .err = 1 };
    const mapped := a.map_err(fn(val: i32): bool {
        return false;
    });

    @expect(match (mapped) {
        .ok => false,
        .err => |e| e == false,
    });

    const b: Result(void, i32) = .{ .err = 2 };
    const mapped_u8 := b.map_err(fn(_: i32): u8 {
        return 7;
    });

    @expect(match (mapped_u8) {
        .ok => false,
        .err => |e| e == 7,
    });
}

impl(T: type, E: type) builtin.Unwrappable for Result(T, E) {
    using Output = T;
    using Residual = E;
    pub const branch := fn(self): builtin.Flow(T, E) {
        return match (self) {
            .ok => |v| builtin.Flow(T, E){ .@"continue" = v },
            .err => |e| builtin.Flow(T, E){ .@"break" = e },
        };
    };
}

impl(T: type, E: type) builtin.Rewrappable for Result(T, E) {
    using From = E;
    pub const from_residual := fn(r: E): @This() {
        return .{ .err = r };
    };
}
