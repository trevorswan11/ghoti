import "../io/io.gh" as io;

using Test = builtin::Test;

extern const __ghoti_test_take_skipped: fn(): bool;

pub const test_runner := fn(args: [][:0]u8, tests: []Test): i32 {
    var failures: i32 = 0;
    var skipped: i32 = 0;
    for (tests) |entry| {
        const passed := entry.func();
        if (__ghoti_test_take_skipped()) {
            skipped += 1;
        } else if (!passed) {
            failures += 1;
        }
    }

    // TODO(tcs): print the number of failures and skips once std::fmt lands
    if (failures > 0 or skipped > 0) {
        if (failures > 0) io::eprintln("Some tests failed!")!;
        if (skipped > 0) io::eprintln("Some tests were skipped!")!;
    } else {
        io::println("All tests passed!")!;
    }

    return if (failures > 0) 1 else 0;
};

pub const expect_handler := fn(msg: []u8, file: []u8, line: u32, column: u32): void {
    io::eprint("Test failed: ")!;
    io::eprint(file)!;
    if (msg.len > 0) {
        io::eprint(": (EXPECTED)")!;
        io::eprintln(msg)!;
    } else {
        io::eprintln(": (EXPECTED)")!;
    }

    // TODO(tcs): add line:col formatting once std::fmt lands
    _ = line;
    _ = column;
};

pub const require_handler := fn(msg: []u8, file: []u8, line: u32, column: u32): void {
    io::eprint("Test failed: ")!;
    io::eprint(file)!;
    if (msg.len > 0) {
        io::eprint(": (REQUIRED) ")!;
        io::eprintln(msg)!;
    } else {
        io::eprintln(": (REQUIRED)")!;
    }

    // TODO(tcs): add line:col formatting once std::fmt lands
    _ = line;
    _ = column;
};

pub const skip_handler := fn(msg: []u8, file: []u8, line: u32, column: u32): void {
    io::eprint("Test failed: ")!;
    io::eprint(file)!;
    if (msg.len > 0) {
        io::eprint(": (SKIPP ED)")!;
        io::eprintln(msg)!;
    } else {
        io::eprintln(": (SKIPPED)")!;
    }

    // TODO(tcs): add line:col formatting once std::fmt lands
    _ = line;
    _ = column;
};
