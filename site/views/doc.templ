package views

import "webserver/internal/render"

templ DocPage(page render.Page, prev, next render.NavItem) {
	<article class="doc">
		@templ.Raw(page.HTML)
		<nav class="pager">
			if prev.Title != "" {
				<a class="pager-link pager-prev" href={ templ.URL(render.Href(prev)) }>
					<span class="pager-label">← Previous</span>
					<span class="pager-title">{ prev.Title }</span>
				</a>
			} else {
				<span></span>
			}
			if next.Title != "" {
				<a class="pager-link pager-next" href={ templ.URL(render.Href(next)) }>
					<span class="pager-label">Next →</span>
					<span class="pager-title">{ next.Title }</span>
				</a>
			}
		</nav>
	</article>
}
