package pages

templ InternalsBuiltinsPage() {
	<h1>Builtin Functions</h1>
	<p>Ghoti has the following builtin functions that are provided by the runtime and can be called from any scope. They are typically functions that facilitate low-level control and often make use of dedicated hardware instructions when available.</p>
	<h2>Casting</h2>
	<h3>{ "@alignCast" }</h3>
	<pre><code class="language-ghoti">{ `@alignCast(T: type, expression: auto): T` }</code></pre>
	<p>Casts the alignment of the expression's pointer value to that of the provided type. Both <code>T</code> and <code>expression</code> must be pointer types.</p>
	<h3>{ "@ptrCast" }</h3>
	<pre><code class="language-ghoti">{ `@ptrCast(T: type, expression: auto): T` }</code></pre>
	<p>Casts the pointer result of <code>expression</code> to pointer <code>T</code>. Both <code>T</code> and <code>expression</code> must be pointer types.</p>
	<h3>{ "@bitCast" }</h3>
	<pre><code class="language-ghoti">{ `@bitCast(T: type, expression: auto): T` }</code></pre>
	<p>Converts a value of one type to another provided type.</p>
	<h3>{ "@constCast" }</h3>
	<pre><code class="language-ghoti">{ `@constCast(expression: auto): auto` }</code></pre>
	<p>Casts away top-level <code>const</code>-ness of the expression, preserving all other aspects of the type.</p>
	<h3>{ "@volatileCast" }</h3>
	<pre><code class="language-ghoti">{ `@volatileCast(expression: auto): auto` }</code></pre>
	<p>Casts away top-level <code>volatile</code>-ness of the expression, preserving all other aspects of the type.</p>
	<h3>{ "@as" }</h3>
	<pre><code class="language-ghoti">{ `@as(T: type, expression: auto): T` }</code></pre>
	<p>Coerces the value of <code>expression</code> into a value of type <code>T</code>.</p>
	<h3>{ "@dynCast" }</h3>
	<pre><code class="language-ghoti">{ `@dynCast(T: type, expression: auto): T` }</code></pre>
	<p><strong>Unsafe.</strong> Recovers a concrete pointer or reference from a <code>&amp;dyn I</code> / <code>^dyn I</code> fat pointer: <code>T</code> must be a pointer/reference type and <code>expression</code> a <code>&amp;dyn</code> / <code>^dyn</code>. It reinterprets the erased <code>data</code> pointer with <strong>no runtime type check</strong>. If <code>expression</code> does not actually point at the underlying type of <code>T</code>, behavior is undefined. The caller acknowledges the risk.</p>
	<h2>Pointer Operations</h2>
	<h3>{ "@intFromPtr" }</h3>
	<pre><code class="language-ghoti">{ `@intFromPtr(expression: auto): usize` }</code></pre>
	<p>Returns the memory address as a <code>usize</code> integer.</p>
	<h3>{ "@ptrFromInt" }</h3>
	<pre><code class="language-ghoti">{ `@ptrFromInt(T: type, expression: usize): T` }</code></pre>
	<p>Returns a pointer type <code>T</code> at the memory address represented by the <code>usize</code> integer. <code>T</code> must be a pointer type.</p>
	<h3>{ "@ptrFromArray" }</h3>
	<pre><code class="language-ghoti">{ `@ptrFromArray(expression: auto): auto` }</code></pre>
	<p>Returns a pointer to the first element of the array-yielding expression.</p>
	<h3>{ "@sliceFromPtr" }</h3>
	<pre><code class="language-ghoti">{ `@sliceFromPtr(expression: auto, len: usize): auto` }</code></pre>
	<p>Constructs a slice from the pointer-yielding expression and length.</p>
	<h3>{ "@fieldParentPtr" }</h3>
	<pre><code class="language-ghoti">{ `@fieldParentPtr(Parent: type, field: [:0]u8, ptr: auto): ^Parent` }</code></pre>
	<p>
		Given a pointer to the <code>field</code> member of a <code>Parent</code> struct, returns a pointer to the
		enclosing <code>Parent</code>. <code>field</code> must be a string literal naming a field of <code>Parent</code>,
		and <code>ptr</code> must be a pointer. The result mirrors the mutability of <code>ptr</code>. Behaviour is
		undefined if <code>ptr</code> does not actually point at that field of a live <code>Parent</code>.
	</p>
	<h2>Introspection &amp; Metadata</h2>
	<h3>{ "@alignOf" }</h3>
	<pre><code class="language-ghoti">{ `@alignOf(expression: auto): usize` }</code></pre>
	<p>Computes the alignment of the provided expression in bytes.</p>
	<h3>{ "@sizeOf" }</h3>
	<pre><code class="language-ghoti">{ `@sizeOf(expression: auto): usize` }</code></pre>
	<p>Computes the size of the provided expression in bytes (its ABI allocation size, so a 9-bit <code>u9</code> reports <code>2</code>).</p>
	<h3>{ "@bitSizeOf" }</h3>
	<pre><code class="language-ghoti">{ `@bitSizeOf(expression: auto): usize` }</code></pre>
	<p>Computes the exact bit width of the provided type or value, which is distinct from <code>{ "@sizeOf" }</code>'s ABI byte size:</p>
	<ul>
		<li><code>iN</code> / <code>uN</code> &rarr; <code>N</code></li>
		<li><code>usize</code> / <code>isize</code> &rarr; the target pointer width</li>
		<li><code>bool</code> &rarr; <code>1</code></li>
		<li><code>f16</code> / <code>f32</code> / <code>f64</code> / <code>f80</code> / <code>f128</code> &rarr; <code>16</code> / <code>32</code> / <code>64</code> / <code>80</code> / <code>128</code></li>
		<li>a bit-packed <code>packed struct</code> / <code>packed union</code> &rarr; the backing-integer width</li>
		<li>anything else &rarr; <code>{ "@sizeOf" }(T) * 8</code></li>
	</ul>
	<h3>{ "@typeOf" }</h3>
	<pre><code class="language-ghoti">{ `@typeOf(expression: auto): type` }</code></pre>
	<p>Returns the type of the provided expression.</p>
	<h3>{ "@this" }</h3>
	<pre><code class="language-ghoti">{ `@this(): type` }</code></pre>
	<p>Returns the type of the current enclosing structural type (i.e. struct, enum, union). Invalid in all other contexts.</p>
	<h3>{ "@tagName" }</h3>
	<pre><code class="language-ghoti">{ `@tagName(expression: auto): [:0]u8` }</code></pre>
	<p>Returns a null-terminated static string representing the name of the enum or active union tag yielded by the expression.</p>
	<h3>{ "@typeName" }</h3>
	<pre><code class="language-ghoti">{ `@typeName(T: auto): [N:0]u8` }</code></pre>
	<p>
		Folds at compile time to a fixed-length, null-terminated byte array naming its argument.
	</p>
	<h3>{ "@implements" }</h3>
	<pre><code class="language-ghoti">{ `@implements(T_or_value: auto, I: type): bool` }</code></pre>
	<p>
		A <code>constexpr</code> is-a predicate. The first argument may be a type or a value (a value is treated as <code>{ "@typeOf(value)" }</code>); <code>I</code> is an interface or an intersection <code>(A + B)</code>. Folds to <code>true</code> when the type implements every interface named, <code>false</code> otherwise.
	</p>
	<h2>Target Information</h2>
	<h3>{ "@targetOs" }</h3>
	<pre><code class="language-ghoti">{ `@targetOs(): [:0]u8` }</code></pre>
	<p>Returns a null-terminated string literal representing the compilation target operating system (e.g. <code>"windows"</code>, <code>"linux"</code>, <code>"macos"</code>).</p>
	<h3>{ "@targetArch" }</h3>
	<pre><code class="language-ghoti">{ `@targetArch(): [:0]u8` }</code></pre>
	<p>Returns a null-terminated string literal representing the compilation target architecture (e.g. <code>"x86_64"</code>, <code>"aarch64"</code>).</p>
	<h3>{ "@targetTriple" }</h3>
	<pre><code class="language-ghoti">{ `@targetTriple(): [:0]u8` }</code></pre>
	<p>Returns a null-terminated string literal representing the target triple string (e.g. <code>"x86_64-pc-windows-msvc"</code>).</p>
	<h2>C Variadics</h2>
	<h3>{ "@cVaStart" }</h3>
	<pre><code class="language-ghoti">{ `@cVaStart(ap: ^u8): void` }</code></pre>
	<p>Initializes a C variadic argument list pointer <code>ap</code> { "for interop with C variadic functions." }</p>
	<h3>{ "@cVaArg" }</h3>
	<pre><code class="language-ghoti">{ `@cVaArg(ap: ^u8, T: type): T` }</code></pre>
	<p>Extracts the next argument of type <code>T</code> from the C variadic argument list <code>ap</code>.</p>
	<h3>{ "@cVaCopy" }</h3>
	<pre><code class="language-ghoti">{ `@cVaCopy(dest: ^u8, src: ^u8): void` }</code></pre>
	<p>Copies state from C variadic argument list <code>src</code> to <code>dest</code>.</p>
	<h3>{ "@cVaEnd" }</h3>
	<pre><code class="language-ghoti">{ `@cVaEnd(ap: ^u8): void` }</code></pre>
	<p>Cleans up the C variadic argument list pointer <code>ap</code>.</p>
	<h2>Memory Operations</h2>
	<h3>{ "@memcpy" }</h3>
	<pre><code class="language-ghoti">{ `@memcpy(src: auto, dest: auto): void` }</code></pre>
	<p>Copies all bytes from src to dest. Requires the two memory regions to be unique.</p>
	<h3>{ "@memset" }</h3>
	<pre><code class="language-ghoti">{ `@memset(mem: auto, expression: auto): void` }</code></pre>
	<p>Sets all values in the array or slice to the expression.</p>
	<h3>{ "@memmove" }</h3>
	<pre><code class="language-ghoti">{ `@memmove(src: auto, dest: auto): void` }</code></pre>
	<p>Moves all bytes from src to dest. Allows the two memory regions to overlap.</p>
	<h2>Math</h2>
	<h3>{ "@mulAdd" }</h3>
	<pre><code class="language-ghoti">{ `@mulAdd(T: type, a: T, b: T, c: T): T` }</code></pre>
	<p>Fused multiply-add, similar to (a * b) + c, except only rounds once, and is thus more accurate. T must be a floating point type.</p>
	<h3>{ "@clz" }</h3>
	<pre><code class="language-ghoti">{ `@clz(expression: auto): usize` }</code></pre>
	<p>Count the number of leading zeros in the expression's bit representation.</p>
	<h3>{ "@ctz" }</h3>
	<pre><code class="language-ghoti">{ `@ctz(expression: auto): usize` }</code></pre>
	<p>Count the number of trailing zeros in the expression's bit representation.</p>
	<h3>{ "@popCount" }</h3>
	<pre><code class="language-ghoti">{ `@popCount(expression: auto): usize` }</code></pre>
	<p>Computes the number of set bits in the expression's binary representation.</p>
	<h3>{ "@abs" }</h3>
	<pre><code class="language-ghoti">{ `@abs(expression: auto): @typeOf(expression)` }</code></pre>
	<p>Computes the absolute value of the passed expression.</p>
	<h3>{ "@min / @max" }</h3>
	<pre>
		<code class="language-ghoti">
			{ `@min(a: T, b: T): T
@max(a: T, b: T): T` }
		</code>
	</pre>
	<p>Smallest / largest of two operands of the same integer or floating-point type.</p>
	<h3>{ "@divTrunc / @divFloor / @rem / @mod" }</h3>
	<pre>
		<code class="language-ghoti">
			{ `@divTrunc(a: T, b: T): T  // integer division truncated toward zero
@divFloor(a: T, b: T): T  // integer division rounded toward negative infinity
@rem(a: T, b: T): T       // remainder; sign follows the dividend
@mod(a: T, b: T): T       // modulo; sign follows the divisor` }
		</code>
	</pre>
	<p>Integer-only. A zero divisor in a compile-time constant expression is an error.</p>
	<h3>{ "@addWithOverflow / @subWithOverflow / @mulWithOverflow / @shlWithOverflow" }</h3>
	<pre><code class="language-ghoti">{ `@addWithOverflow(a: T, b: T, result: &mut T): bool` }</code></pre>
	<p>Integer-only. Writes the wrapped result through <code>result</code> and returns whether the operation overflowed. For the same wrapped value without the overflow flag, use the wrapping operators <code>+% -% *% &lt;&lt;%</code> (see the <a href="/doc/syntax/types">types</a> page). Unlike the plain operators, they never trap under <code>--runtime-safety</code>.</p>
	<h2>Atomics</h2>
	<p>
		The order and (for <code>{ "@atomicRmw" }</code>) op arguments below are <code>{ "MemoryOrder" }</code> / <code>{ "AtomicRmwOp" }</code> members, both compiler-provided enums that must be referenced through the <code>{ "builtin" }</code> module; e.g. <code>{ "builtin::MemoryOrder.seq_cst" }</code>, <code>{ "builtin::AtomicRmwOp.add" }</code> &mdash; and given as a compile-time constant; a runtime value is a compile error.
	</p>
	<pre>
		<code class="language-ghoti">
			{ `pub const MemoryOrder := enum { relaxed, acquire, release, acq_rel, seq_cst };
pub const AtomicRmwOp := enum {
    xchg, add, sub, band, nand, bor, bxor, max, min, umax, umin,
};` }
		</code>
	</pre>
	<p><code>{ "ptr" }</code> is the atomic memory location itself (e.g. <code>{ "^mut i32" }</code>), evaluated as a normal expression &mdash; no <code>{ "&" }</code> needed. Every operand's width must be a native atomic width for the target: 8/16/32/64 bits always, 128 only on x86_64/aarch64.</p>
	<h3>{ "@atomicLoad / @atomicStore" }</h3>
	<pre>
		<code class="language-ghoti">
			{ `@atomicLoad(T: type, ptr: auto, order: MemoryOrder): T
@atomicStore(ptr: auto, val: auto, order: MemoryOrder): void` }
		</code>
	</pre>
	<p>
		<code>{ "@atomicLoad" }</code> accepts <code>{ "relaxed" }</code>, <code>{ "acquire" }</code>, or <code>{ "seq_cst" }</code>. <code>{ "@atomicStore" }</code> accepts <code>{ "relaxed" }</code>, <code>{ "release" }</code>, or <code>{ "seq_cst" }</code>. Any other order is a compile error.
	</p>
	<h3>{ "@atomicRmw" }</h3>
	<pre><code class="language-ghoti">{ `@atomicRmw(T: type, ptr: auto, op: AtomicRmwOp, val: auto, order: MemoryOrder): T` }</code></pre>
	<p>Atomically applies <code>{ "op" }</code> to <code>{ "*ptr" }</code> and <code>{ "val" }</code>, storing the result and returning <code>{ "*ptr" }</code>'s <em>previous</em> value. Any <code>{ "MemoryOrder" }</code> is accepted.</p>
	<h3>{ "@cmpxchgWeak / @cmpxchgStrong" }</h3>
	<pre>
		<code class="language-ghoti">
			{ `@cmpxchgWeak(T: type, ptr: auto, expected: auto, new: auto,
             succ_order: MemoryOrder, fail_order: MemoryOrder, out: auto): bool
@cmpxchgStrong(T: type, ptr: auto, expected: auto, new: auto,
               succ_order: MemoryOrder, fail_order: MemoryOrder, out: auto): bool` }
		</code>
	</pre>
	<p>
		Compares <code>{ "*ptr" }</code> against <code>{ "expected" }</code>; if equal, atomically stores <code>{ "new" }</code> and returns <code>{ "true" }</code> (<strong>success</strong>). If not equal, no store happens and the function returns <code>{ "false" }</code> &mdash; the inverse sense of <code>{ "@addWithOverflow" }</code>'s bool, which signals failure. Either way, <code>{ "*ptr" }</code>'s current value (matched or not) is written through <code>{ "out" }</code>, which follows the same <code>{ "&mut T" }</code> / <code>{ "^mut T" }</code> convention as <code>{ "@addWithOverflow" }</code>'s result slot.
	</p>
	<p>
		<code>{ "fail_order" }</code> may not be <code>{ "release" }</code> or <code>{ "acq_rel" }</code>, and may not be stronger than <code>{ "succ_order" }</code>. The <code>{ "weak" }</code> form may spuriously fail even when <code>{ "*ptr" }</code> does equal <code>{ "expected" }</code> (typically cheaper in a retry loop on some targets); <code>{ "strong" }</code> never does.
	</p>
	<h3>{ "@fence" }</h3>
	<pre><code class="language-ghoti">{ `@fence(order: MemoryOrder): void` }</code></pre>
	<p>A standalone memory fence. Any <code>{ "MemoryOrder" }</code> is accepted; a <code>{ "relaxed" }</code> fence is a legal no-op.</p>
	<h2>Self-Recursion</h2>
	<h3>{ "@fnCtx" }</h3>
	<pre><code class="language-ghoti">{ `@fnCtx(): auto` }</code></pre>
	<p>Returns the innermost enclosing function as a callable value, enabling self-recursion for anonymous functions or closures.</p>
	<h2>Compiler &amp; Alignment Directives</h2>
	<h3>{ "@alignas" }</h3>
	<pre><code class="language-ghoti">{ `@alignas(alignment: usize)` }</code></pre>
	<p>Explicit alignment modifier specifier applied to struct fields or types.</p>
	<h3>{ "@setEvalRecursionLimit" }</h3>
	<pre><code class="language-ghoti">{ `@setEvalRecursionLimit(limit: usize): void` }</code></pre>
	<p>Sets the maximum recursion depth limit for compile-time (<code>constexpr</code>) expression evaluation.</p>
	<h3>{ "@setMainSymbol" }</h3>
	<pre><code class="language-ghoti">{ `@setMainSymbol(symbol_name: [:0]u8): void` }</code></pre>
	<p>Overrides the default entry point symbol name used by the compiler when linking the executable.</p>
	<h2>Control Flow</h2>
	<h3>{ "@panic" }</h3>
	<pre><code class="language-ghoti">{ `@panic(message: [:0]u8): noreturn` }</code></pre>
	<p>Immediately terminates execution and panics with the provided message.</p>
	<h3>{ "@assert" }</h3>
	<pre><code class="language-ghoti">{ `@assert(cond: bool, msg: []u8 = "assertion failed"): void` }</code></pre>
	<p>
		An advisory assertion. A comptime-known-false <code>cond</code> is a compile error; a comptime-known-true one emits nothing. Otherwise it emits a runtime check that, on failure, calls the weak <code>{ "builtin::assert_handler" }</code> hook with source location and the message. <code>{ "@assert" }</code> is stripped by <code>--unsafe</code> and its false path carries no semantic guarantee.
	</p>
	<h3>{ "@verify" }</h3>
	<pre><code class="language-ghoti">{ `@verify(cond: bool, msg: []u8 = "verification failed"): void` }</code></pre>
	<p>
		An enforced assertion. Same front end as <code>{ "@assert" }</code> (comptime-known-false is a compile error), but the runtime check is <strong>never</strong> elided. On failure it delegates to the same weak <code>{ "builtin::panic_handler" }</code> that <code>{ "@panic" }</code> uses; a <code>{ "@verify" }</code> failure <em>is</em> a panic. Use it for invariants the program's correctness or safety depends on.
	</p>
}
